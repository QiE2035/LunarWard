<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Avalonia 侧的嵌入自检：把 Frameworks/WebView 的控件放进一个真实的 Avalonia 窗口，
    验证 NativeControlHost 的 X11 子窗口 + GtkPlug XEmbed 这条链路（SelfTest 只验证原生层）。

    运行：dotnet run，project 参数指向本目录。退出码 0 表示全部通过，
    证据（截图 + 日志）落在 artifacts/webview-selftest/。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>LunarWard.Frameworks.WebView.SelfTestAvalonia</RootNamespace>
    <AssemblyName>LunarWard.WebView.SelfTestAvalonia</AssemblyName>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../WebView.cs" />
    <Compile Include="../CoreWebView2Compat.cs" />
    <Compile Include="../WebKitWebViewCore.cs" />
    <Compile Include="../GtkRuntime.cs" />
    <Compile Include="../WebViewAvailability.cs" />
    <Compile Include="../VirtualHostMapping.cs" />
    <Compile Include="../Interop/NativeMethods.cs" />
  </ItemGroup>

</Project>
