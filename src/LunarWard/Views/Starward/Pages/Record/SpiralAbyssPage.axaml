<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:LunarWard.Views.Starward.Pages"
             xmlns:vm="using:LunarWard.ViewModels.Starward"
             x:Class="LunarWard.Views.Starward.Pages.Record.SpiralAbyssPage"
             x:DataType="vm:SpiralAbyssPageViewModel">

  <!--
    深境螺旋页：逐行对照 Starward Features/GameRecord/Genshin/SpiralAbyssPage.xaml。
    结构 = 左栏（刷新 + 周期列表） + 右侧（周期 / 出战统计 / 出战次数 / 战斗数据榜 / 每层每间）。
    Starward 用 Assets 里的深境图标与稀有度底图，LunarWard 没有素材：
    星星用 FontIcon &#xE735; 替代，稀有度底图用同色半透明底（GachaRarityBackgroundConverter）。
  -->
  <UserControl.Resources>
    <pages:GachaRarityBackgroundConverter x:Key="RarityBackgroundConverter" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

    <!-- ══ 空态（Starward Image_Emoji：派蒙 + 暂无数据） ═══════════════ -->
    <StackPanel Grid.RowSpan="2"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                IsVisible="{Binding ShowEmpty}">
      <Border Width="160"
              Height="160"
              CornerRadius="80"
              Background="{StaticResource StarControlFillBrush}">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="64"
                   Foreground="{StaticResource StarTextTertiary}"
                   Text="&#xE7BA;" />
      </Border>
      <TextBlock HorizontalAlignment="Center"
                 FontSize="16"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="{Binding Strings[Common.NoData]}" />
    </StackPanel>

    <!-- ══ 左栏：刷新（Starward StackPanel Margin="0,24,0,0"） ═════════ -->
    <StackPanel Margin="0,24,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Spacing="12">
      <Button Height="36"
              BorderThickness="0"
              Classes="accent"
              CornerRadius="0,18,18,0"
              Command="{Binding RefreshCommand}">
        <StackPanel Margin="4,0,4,0" Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon" FontSize="16" Text="&#xE72C;" />
          <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Common.Refresh]}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- ══ 左栏：周期列表 ═══════════════════════════════════════════════ -->
    <ListBox Grid.Row="1"
             Margin="0,12,0,0"
             Padding="12,0,12,0"
             Background="Transparent"
             ItemsSource="{Binding AbyssList}"
             SelectedItem="{Binding CurrentAbyss, Mode=TwoWay}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="4,0" />
          <Setter Property="Margin" Value="0,4" />
          <Setter Property="CornerRadius" Value="4" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:AbyssPeriodItem">
          <Border Padding="12,8"
                  Background="{StaticResource StarOverlayAcrylicBrush}"
                  CornerRadius="4">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding DateText}" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Foreground="#E4C891" FontSize="16" Text="&#xE735;" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource StarTextSecondary}"
                           Text="{Binding TotalStarText}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- ══ 右侧详情（Starward ScrollViewer Grid.Column="1"） ═══════════ -->
    <ScrollViewer Grid.RowSpan="2"
                  Grid.Column="1"
                  IsVisible="{Binding CurrentAbyss, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Margin="24" Spacing="8">

        <!-- 统计周期 -->
        <TextBlock Foreground="{StaticResource StarTextSecondary}" Text="{Binding PeriodText}" />

        <!-- 出战统计：TotalStar / 最深抵达 / 战斗次数 -->
        <Border Margin="0,-4,0,0"
                Padding="8"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                BoxShadow="0 4 16 0 #40000000">
          <Grid ColumnDefinitions="*,*,*">
            <StackPanel Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
              <TextBlock VerticalAlignment="Center" FontSize="24" Foreground="#E4C891" Text="&#xE735;" />
              <TextBlock VerticalAlignment="Center" FontSize="16" Text="{Binding TotalStarText}" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16">
              <Run Text="{Binding Strings[SpiralAbyss.DeepestDescent]}" />
              <Run Text=" " />
              <Run Text="{Binding MaxFloorText}" />
            </TextBlock>
            <TextBlock Grid.Column="2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16">
              <Run Text="{Binding Strings[SpiralAbyss.BattlesFought]}" />
              <Run Text=" " />
              <Run Text="{Binding BattleCountText}" />
            </TextBlock>
          </Grid>
        </Border>

        <!-- 出战次数（HasData） -->
        <TextBlock Margin="0,8,0,0"
                   FontSize="16"
                   Foreground="{StaticResource StarTextSecondary}"
                   IsVisible="{Binding HasData}"
                   Text="{Binding Strings[SpiralAbyss.Picked]}" />
        <Border Padding="12"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                BoxShadow="0 4 16 0 #40000000"
                IsVisible="{Binding HasData}">
          <ItemsControl HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding RevealRanks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="36" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AbyssAvatarItem">
                <Grid Width="80" Height="97">
                  <Border Background="{Binding Rarity, Converter={StaticResource RarityBackgroundConverter}}" CornerRadius="4" />
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Classes="icon"
                             FontSize="36"
                             Foreground="#66FFFFFF"
                             Text="&#xE77B;" />
                  <Border Height="80"
                          VerticalAlignment="Top"
                          CornerRadius="0,0,16,0"
                          ClipToBounds="True">
                    <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                  </Border>
                  <TextBlock Margin="0,0,0,1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="#84603D"
                             Text="{Binding ValueText}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- 战斗数据榜（HasData） -->
        <TextBlock Margin="0,8,0,0"
                   FontSize="16"
                   Foreground="{StaticResource StarTextSecondary}"
                   IsVisible="{Binding HasData}"
                   Text="{Binding Strings[SpiralAbyss.CombatStats]}" />
        <Border Padding="24,0"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                BoxShadow="0 4 16 0 #40000000"
                IsVisible="{Binding HasData}">
          <ItemsControl ItemsSource="{Binding CombatRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AbyssRankRow">
                <Grid ColumnDefinitions="2*,*,*" Height="44">
                  <Border Grid.ColumnSpan="3"
                          Margin="-24,0,-24,0"
                          Background="#0DFFFFFF"
                          IsVisible="{Binding IsAlternating}" />
                  <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Label}" />
                  <Image Grid.Column="1"
                         Width="44"
                         Height="36"
                         Margin="0,-2,0,2"
                         VerticalAlignment="Bottom"
                         Source="{Binding Icon}"
                         Stretch="UniformToFill" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding ValueText}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- 每层每间 -->
        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Floors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AbyssFloorItem">
              <Border Margin="0,0,0,16"
                      Padding="24,12"
                      Background="{StaticResource StarOverlayAcrylicBrush}"
                      CornerRadius="8"
                      BoxShadow="0 4 16 0 #40000000">
                <StackPanel Spacing="8">
                  <Grid Height="28" ColumnDefinitions="*,Auto">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="16"
                               Text="{Binding Title}" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                      <TextBlock VerticalAlignment="Center" FontSize="24" Foreground="#E4C891" Text="&#xE735;" />
                      <TextBlock VerticalAlignment="Center" FontSize="16" Text="{Binding StarText}" />
                    </StackPanel>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding Levels}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AbyssLevelItem">
                        <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto">
                          <Border Grid.ColumnSpan="3"
                                  Grid.Row="0"
                                  Height="1"
                                  Margin="0,8"
                                  Background="{StaticResource StarDividerBrush}" />

                          <!-- 上半阵容 -->
                          <ItemsControl Grid.Row="1"
                                        Grid.Column="0"
                                        MinHeight="73"
                                        HorizontalAlignment="Left"
                                        ItemsSource="{Binding UpperAvatars}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:AbyssAvatarItem">
                                <Grid Width="60" Height="73">
                                  <Border Background="{Binding Rarity, Converter={StaticResource RarityBackgroundConverter}}" CornerRadius="4" />
                                  <TextBlock HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Classes="icon"
                                             FontSize="28"
                                             Foreground="#66FFFFFF"
                                             Text="&#xE77B;" />
                                  <Border Height="60"
                                          VerticalAlignment="Top"
                                          CornerRadius="0,0,12,0"
                                          ClipToBounds="True">
                                    <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                  </Border>
                                  <TextBlock Margin="0,0,0,-1"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Bottom"
                                             FontSize="12"
                                             Foreground="#84603D"
                                             Text="{Binding LevelText}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <!-- 间名 / 时间 / 星星 -->
                          <StackPanel Grid.Row="1"
                                      Grid.Column="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Spacing="4">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{StaticResource StarTextSecondary}"
                                       Text="{Binding Title}" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource StarTextSecondary}"
                                       Text="{Binding TimeText}" />
                            <ItemsControl HorizontalAlignment="Center" ItemsSource="{Binding StarMarks}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock FontSize="20" Foreground="#E4C891" Text="&#xE735;" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>

                          <!-- 下半阵容 -->
                          <ItemsControl Grid.Row="1"
                                        Grid.Column="2"
                                        MinHeight="73"
                                        HorizontalAlignment="Right"
                                        ItemsSource="{Binding LowerAvatars}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:AbyssAvatarItem">
                                <Grid Width="60" Height="73">
                                  <Border Background="{Binding Rarity, Converter={StaticResource RarityBackgroundConverter}}" CornerRadius="4" />
                                  <TextBlock HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Classes="icon"
                                             FontSize="28"
                                             Foreground="#66FFFFFF"
                                             Text="&#xE77B;" />
                                  <Border Height="60"
                                          VerticalAlignment="Top"
                                          CornerRadius="0,0,12,0"
                                          ClipToBounds="True">
                                    <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                  </Border>
                                  <TextBlock Margin="0,0,0,-1"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Bottom"
                                             FontSize="12"
                                             Foreground="#84603D"
                                             Text="{Binding LevelText}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 网络 / 接口错误（Starward 用 InfoBar / ContentDialog，这里放页内提示） -->
        <TextBlock Margin="0,8,0,0"
                   FontSize="12"
                   Foreground="{StaticResource StarErrorBrush}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasError}"
                   Text="{Binding ErrorText}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
