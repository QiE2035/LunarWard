<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunarWard.ViewModels.Starward"
             xmlns:controls="using:LunarWard.Views.Starward.Controls"
             x:Class="LunarWard.Views.Starward.Pages.Record.InterKnotMonthlyReportPage"
             x:DataType="vm:InterKnotMonthlyReportPageViewModel">

  <!--
    1:1 复刻 Starward Features/GameRecord/ZZZ/InterKnotMonthlyReportPage.xaml（403 行）。
      Row 0 / Auto  左栏：刷新胶囊 + 获取明细（MenuFlyout 月份）
      Row 1 / *     左栏：月份列表（DataMonth + 菲林数）
      右侧：实时数据卡（当月奖励 / 菲林收入组成条 + 图例）
            历史数据卡（选中月份同上）
            每日数据（菲林 / 母带 / 邦布券三条进度条）
    素材说明：菲林/母带/邦布券/邦布表情 PNG 未打包，用同色字形占位；百分比色条是自绘
    controls:ColorRectChart（Starward sc:ColorRectChart 的等价物）。
  -->

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

    <!-- ══ 空态（Starward Image_Emoji + 暂无数据） ══════════════════════ -->
    <StackPanel Grid.RowSpan="2"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                IsVisible="{Binding ShowEmpty}">
      <Border Width="160"
              Height="160"
              CornerRadius="80"
              Background="{StaticResource StarControlFillBrush}">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="64"
                   Foreground="{StaticResource StarTextTertiary}"
                   Text="&#xE7B8;" />
      </Border>
      <TextBlock HorizontalAlignment="Center"
                 FontSize="16"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="{Binding Strings[Common.NoData]}" />
    </StackPanel>

    <!-- ══ 左栏：刷新 + 获取明细（Starward StackPanel Margin="0,24,0,0"） ══ -->
    <StackPanel Margin="0,24,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Spacing="12">
      <Button Height="36"
              BorderThickness="0"
              Classes="accent"
              CornerRadius="0,18,18,0"
              Command="{Binding RefreshCommand}">
        <StackPanel Margin="4,0,4,0" Orientation="Horizontal" Spacing="8">
          <Grid>
            <ProgressBar Width="16" Height="16" IsIndeterminate="True" Background="Transparent" IsVisible="{Binding IsBusy}" />
            <TextBlock Classes="icon" FontSize="16" Text="&#xE72C;" IsVisible="{Binding !IsBusy}" />
          </Grid>
          <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Common.Refresh]}" />
        </StackPanel>
      </Button>
      <Button x:Name="Button_GetDetails"
              Height="36"
              BorderThickness="0"
              Classes="accent"
              CornerRadius="0,18,18,0"
              Click="OnGetDetailsClick"
              IsEnabled="{Binding !IsBusy}">
        <StackPanel Margin="4,0,4,0" Orientation="Horizontal" Spacing="8">
          <Grid>
            <ProgressBar Width="16" Height="16" IsIndeterminate="True" Background="Transparent" IsVisible="{Binding IsBusy}" />
            <TextBlock Classes="icon" FontSize="16" Text="&#xEA37;" IsVisible="{Binding !IsBusy}" />
          </Grid>
          <TextBlock VerticalAlignment="Center" Text="{Binding Strings[InterKnot.GetDetails]}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- ══ 左栏：月份列表 ═══════════════════════════════════════════════ -->
    <ListBox Grid.Row="1"
             Margin="0,12,0,0"
             Padding="12,0,12,0"
             Background="Transparent"
             ItemsSource="{Binding MonthList}"
             SelectedItem="{Binding SelectedMonth, Mode=TwoWay}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="4,0" />
          <Setter Property="Margin" Value="0,4" />
          <Setter Property="CornerRadius" Value="4" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:InterKnotMonthItem">
          <Border Padding="12,8"
                  Background="{StaticResource StarOverlayAcrylicBrush}"
                  CornerRadius="4">
            <StackPanel Spacing="2">
              <TextBlock FontSize="16" Text="{Binding DataMonth}" />
              <Grid>
                <!-- Starward：Image 20×20 IconCurrency.png + 24 左边距 -->
                <TextBlock FontSize="20" Foreground="#E8C47B" Text="&#x2726;" />
                <TextBlock Margin="24,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource StarTextSecondary}"
                           Text="{Binding PolychromeText}" />
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- ══ 右侧详情（Starward ScrollViewer Grid.RowSpan=2 Grid.Column=1） ══ -->
    <ScrollViewer Grid.RowSpan="2" Grid.Column="1">
      <StackPanel Margin="24" Spacing="8">

        <!--  Real-Time Data  -->
        <TextBlock FontSize="16"
                   Foreground="{StaticResource StarTextSecondary}"
                   IsVisible="{Binding HasCurrent}"
                   Text="{Binding Strings[InterKnot.RealTimeData]}" />
        <Border Padding="24,8"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                IsVisible="{Binding HasCurrent}">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

          <ItemsControl Grid.Row="0" ItemsSource="{Binding CurrentAwards}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="24" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InterKnotAwardItem">
                <StackPanel Spacing="4">
                  <!-- 32×32 资源图标占位（IconCurrency / GachaTicket2Big / GachaTicket3Big） -->
                  <TextBlock HorizontalAlignment="Center"
                             FontSize="32"
                             Foreground="{Binding GlyphBrush}"
                             Text="{Binding Glyph}" />
                  <TextBlock HorizontalAlignment="Center"
                             Foreground="{StaticResource StarTextSecondary}"
                             Text="{Binding Name}" />
                  <TextBlock HorizontalAlignment="Center" Text="{Binding CountText}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Row="1"
                  Height="1"
                  Margin="0,8"
                  Background="{StaticResource StarDividerBrush}" />

          <TextBlock Grid.Row="2"
                     Foreground="{StaticResource StarTextSecondary}"
                     Text="{Binding Strings[InterKnot.PolychromeRevenueStreams]}" />
          <controls:ColorRectChart Grid.Row="3"
                                   Height="20"
                                   Margin="0,8,0,0"
                                   Series="{Binding CurrentSeries}" />
          <ItemsControl Grid.Row="4" Margin="0,8,-4,0" ItemsSource="{Binding CurrentSeries}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:IncomeSeriesItem">
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4">
                  <Border Width="16"
                          Height="16"
                          Background="{Binding Brush}"
                          CornerRadius="4" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding PercentText}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </Grid>
        </Border>

        <!--  Historical Data  -->
        <TextBlock Margin="0,8,0,0"
                   FontSize="16"
                   Foreground="{StaticResource StarTextSecondary}"
                   IsVisible="{Binding HasSelect}">
          <Run Text="{Binding Strings[InterKnot.HistoricalData]}" />
          <Run Text=" " />
          <Run Text="{Binding SelectMonthData.DataMonth}" />
        </TextBlock>
        <Border Padding="24,8"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                IsVisible="{Binding HasSelect}">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

          <ItemsControl Grid.Row="0" ItemsSource="{Binding SelectAwards}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="24" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InterKnotAwardItem">
                <StackPanel Spacing="4">
                  <TextBlock HorizontalAlignment="Center"
                             FontSize="32"
                             Foreground="{Binding GlyphBrush}"
                             Text="{Binding Glyph}" />
                  <TextBlock HorizontalAlignment="Center"
                             Foreground="{StaticResource StarTextSecondary}"
                             Text="{Binding Name}" />
                  <TextBlock HorizontalAlignment="Center" Text="{Binding CountText}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Row="1"
                  Height="1"
                  Margin="0,8"
                  Background="{StaticResource StarDividerBrush}" />

          <TextBlock Grid.Row="2"
                     Foreground="{StaticResource StarTextSecondary}"
                     Text="{Binding Strings[InterKnot.PolychromeRevenueStreams]}" />
          <controls:ColorRectChart Grid.Row="3"
                                   Height="20"
                                   Margin="0,8,0,0"
                                   Series="{Binding SelectSeries}" />
          <ItemsControl Grid.Row="4" Margin="0,8,-4,0" ItemsSource="{Binding SelectSeries}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:IncomeSeriesItem">
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4">
                  <Border Width="16"
                          Height="16"
                          Background="{Binding Brush}"
                          CornerRadius="4" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding PercentText}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </Grid>
        </Border>

        <!--  Daily Data  -->
        <TextBlock Margin="0,8,0,0"
                   FontSize="16"
                   Foreground="{StaticResource StarTextSecondary}"
                   IsVisible="{Binding HasSelect}">
          <Run Text="{Binding Strings[InterKnot.DailyData]}" />
          <Run Text=" " />
          <Run Text="{Binding SelectMonthData.DataMonth}" />
        </TextBlock>
        <Border Padding="12,8"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                IsVisible="{Binding HasSelect}">
          <ItemsControl ItemsSource="{Binding DayList}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InterKnotDayItem">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource StarTextSecondary}"
                             Text="{Binding Day}" />
                  <TextBlock Grid.Column="1"
                             VerticalAlignment="Center"
                             FontSize="24"
                             Foreground="#E8C47B"
                             Text="&#x2726;" />
                  <TextBlock Grid.Column="2"
                             VerticalAlignment="Center"
                             Text="{Binding Poly}" />
                  <ProgressBar Grid.Column="3"
                               MinHeight="20"
                               HorizontalAlignment="Stretch"
                               Background="Transparent"
                               Foreground="#A0FF53B2"
                               Maximum="1"
                               Value="{Binding PolyProgress}" />
                  <TextBlock Grid.Column="4"
                             VerticalAlignment="Center"
                             FontSize="24"
                             Foreground="#8FB8E8"
                             Text="&#x25A4;" />
                  <TextBlock Grid.Column="5"
                             VerticalAlignment="Center"
                             Text="{Binding Tape}" />
                  <ProgressBar Grid.Column="6"
                               MinHeight="20"
                               HorizontalAlignment="Stretch"
                               Background="Transparent"
                               Foreground="#A066BCF2"
                               Maximum="1"
                               Value="{Binding TapeProgress}" />
                  <TextBlock Grid.Column="7"
                             VerticalAlignment="Center"
                             FontSize="24"
                             Foreground="#F0D060"
                             Text="&#x25C9;" />
                  <TextBlock Grid.Column="8"
                             VerticalAlignment="Center"
                             Text="{Binding Boopon}" />
                  <ProgressBar Grid.Column="9"
                               MinHeight="20"
                               HorizontalAlignment="Stretch"
                               Background="Transparent"
                               Foreground="#A0F2DE77"
                               Maximum="1"
                               Value="{Binding BooponProgress}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <TextBlock Margin="0,8,0,0"
                   Foreground="{StaticResource StarErrorBrush}"
                   IsVisible="{Binding HasError}"
                   Text="{Binding ErrorText}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
