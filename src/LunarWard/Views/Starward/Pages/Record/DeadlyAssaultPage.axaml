<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunarWard.ViewModels.Starward"
             x:Class="LunarWard.Views.Starward.Pages.Record.DeadlyAssaultPage"
             x:DataType="vm:DeadlyAssaultPageViewModel">

  <!--
    危局强袭战页：逐行对照 Starward Features/GameRecord/ZZZ/DeadlyAssaultPage.xaml。
    结构 = 左栏（刷新 + 赛期列表） + 右侧（统计周期 / 绝境模式卡 / 试炼模式卡 + 若干 Boss 节点）。
    Starward 的 rank-bg-*.png、稀有度图标、星形图不在仓库里，用渐变排名底 + S/A 字形 + 星形字形占位。
  -->

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

    <!-- ══ 空态（Starward Image_Emoji：邦布 + 没有数据） ══════════════════ -->
    <StackPanel Grid.RowSpan="2"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                IsVisible="{Binding ShowEmpty}">
      <Border Width="160"
              Height="160"
              CornerRadius="80"
              Background="{StaticResource StarControlFillBrush}">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="64"
                   Foreground="{StaticResource StarTextTertiary}"
                   Text="&#xE7FC;" />
      </Border>
      <TextBlock HorizontalAlignment="Center"
                 FontSize="16"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="{Binding Strings[Common.NoData]}" />
    </StackPanel>

    <!-- ══ 左栏：刷新（Starward StackPanel Margin="0,24,0,0"） ═══════════ -->
    <StackPanel Margin="0,24,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Spacing="12">
      <Button Height="36"
              BorderThickness="0"
              Classes="accent"
              CornerRadius="0,18,18,0"
              Command="{Binding RefreshCommand}">
        <StackPanel Margin="4,0,4,0" Orientation="Horizontal" Spacing="8">
          <Grid>
            <ProgressBar Width="16" Height="16" IsIndeterminate="True" Background="Transparent" IsVisible="{Binding IsBusy}" />
            <TextBlock Classes="icon" FontSize="16" Text="&#xE72C;" IsVisible="{Binding !IsBusy}" />
          </Grid>
          <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Common.Refresh]}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- ══ 左栏：赛期列表（Starward ListView_DeadlyAssault） ═════════════ -->
    <ListBox Grid.Row="1"
             Padding="12,0,12,0"
             Background="Transparent"
             ItemsSource="{Binding AssaultList}"
             SelectedItem="{Binding CurrentAssault, Mode=TwoWay}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             IsVisible="{Binding AssaultList.Count}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="4,0,4,0" />
          <Setter Property="Margin" Value="0,4" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Background" Value="Transparent" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:DeadlyAssaultPeriodItem">
          <Border Padding="12,8"
                  Background="{StaticResource StarOverlayAcrylicBrush}"
                  CornerRadius="4">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding DateText}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="4"
                          IsVisible="{Binding Info.HasHard}">
                <TextBlock MinWidth="46"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource StarTextSecondary}"
                           Text="{Binding HardTotalScore}" />
                <TextBlock VerticalAlignment="Center" FontSize="20" Text="&#xE735;" Foreground="#FFA94D" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource StarTextSecondary}"
                           Text="{Binding $parent[UserControl].DataContext.HardStarText}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock MinWidth="46"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource StarTextSecondary}"
                           Text="{Binding Info.TotalScore}" />
                <TextBlock VerticalAlignment="Center" FontSize="20" Text="&#xE735;" Foreground="#CFE3FF" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource StarTextSecondary}"
                           Text="{Binding $parent[UserControl].DataContext.TrialStarText}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- ══ 右侧详情（Starward ScrollViewer Grid.RowSpan=2 Grid.Column=1） ══ -->
    <ScrollViewer Grid.RowSpan="2"
                  Grid.Column="1"
                  IsVisible="{Binding CurrentAssault, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Margin="24" Spacing="8">

        <!-- 统计周期 -->
        <TextBlock Foreground="{StaticResource StarTextSecondary}" Text="{Binding PeriodText}" />

        <TextBlock Foreground="#FF6B6B"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding ErrorText}" />

        <!-- 绝境模式（Starward Grid Width=680，仅 HasHard 时显示） -->
        <Border Width="680"
                Padding="16,12"
                HorizontalAlignment="Center"
                Background="{StaticResource StarControlFillBrush}"
                BoxShadow="0 0 16 0 #33000000"
                CornerRadius="8"
                IsVisible="{Binding HasHard}">
          <StackPanel Spacing="8">
            <Grid>
              <StackPanel Margin="4,4,0,0" Spacing="2">
                <TextBlock FontWeight="Bold" Text="{Binding Strings[DeadlyAssault.AdversityMode]}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock FontSize="28" FontWeight="Bold" Text="{Binding HardScoreText}" />
                  <Border Margin="0,0,0,6"
                          VerticalAlignment="Bottom"
                          MinWidth="56"
                          Height="20"
                          Background="{Binding HardRankBrush}"
                          CornerRadius="4">
                    <TextBlock Margin="8,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#1A1A1A"
                               Text="{Binding HardRankText}" />
                  </Border>
                </StackPanel>
              </StackPanel>
              <StackPanel HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Orientation="Horizontal"
                          Spacing="8">
                <TextBlock VerticalAlignment="Center" FontSize="36" Text="&#xE735;" Foreground="#FFA94D" />
                <TextBlock Margin="0,0,4,0"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Text="{Binding HardStarText}" />
              </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding HardNodes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DeadlyAssaultNodeItem">
                  <Border Padding="12"
                          Background="{StaticResource StarOverlayAcrylicBrush}"
                          BoxShadow="0 0 16 0 #33000000"
                          CornerRadius="12">
                    <Grid RowDefinitions="Auto,Auto,Auto,*"
                          ColumnDefinitions="Auto,Auto,*"
                          ColumnSpacing="16"
                          RowSpacing="4">

                      <!-- Boss 立绘（Starward Grid Width=142 Height=194） -->
                      <Grid Grid.RowSpan="4"
                            Width="142"
                            Height="194"
                            VerticalAlignment="Top">
                        <Border CornerRadius="16" ClipToBounds="True" Background="#16203A">
                          <Grid>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="48"
                                       Foreground="#66FFFFFF"
                                       Text="&#xE7FC;" />
                            <Image Source="{Binding BossBg}" Stretch="UniformToFill"
                                   IsVisible="{Binding BossBg, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          </Grid>
                        </Border>
                        <Image Source="{Binding BossIcon}" Stretch="Uniform" Margin="10"
                               IsVisible="{Binding BossIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Margin="0,0,8,8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   FontSize="28"
                                   Foreground="#CCFFFFFF"
                                   Text="&#xE7FC;"
                                   IsVisible="{Binding BossRaceIcon, Converter={x:Static ObjectConverters.IsNull}}" />
                        <Image Width="48" Height="48" Margin="0,0,4,4"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Source="{Binding BossRaceIcon}"
                               IsVisible="{Binding BossRaceIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Border BorderBrush="#70FFFFFF" BorderThickness="2" CornerRadius="16" />
                      </Grid>

                      <!-- Boss 名 -->
                      <TextBlock Grid.Column="1"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Text="{Binding BossName}" />

                      <!-- 分数 + 星星 -->
                      <StackPanel Grid.Row="1"
                                  Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  Orientation="Horizontal"
                                  Spacing="2">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Text="{Binding ScoreText}" />
                        <ItemsControl Margin="4,3,0,0" VerticalAlignment="Center" ItemsSource="{Binding Stars}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock FontSize="24" Text="&#xE735;" Foreground="{Binding $parent[ItemsControl].DataContext.StarBrush}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <!-- 通关时刻 -->
                      <TextBlock Grid.Row="2"
                                 Grid.Column="1"
                                 FontSize="12"
                                 Foreground="{StaticResource StarTextSecondary}"
                                 Text="{Binding ClearedText}" />

                      <!-- 出战角色 + 邦布（Starward StackPanel Spacing=8） -->
                      <StackPanel Grid.Row="3"
                                  Grid.Column="1"
                                  Margin="0,4,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Orientation="Horizontal"
                                  Spacing="8">
                        <ItemsControl ItemsSource="{Binding Avatars}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeadlyAssaultAvatarItem">
                              <Grid Width="76" Height="94">
                                <Border Width="76" Height="94" VerticalAlignment="Top"
                                        Background="#0A0A0A" CornerRadius="8" />
                                <Border Width="72" Height="72" Margin="2,2,2,2"
                                        VerticalAlignment="Top"
                                        CornerRadius="8,8,0,0"
                                        ClipToBounds="True">
                                  <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="28"
                                               Foreground="#66FFFFFF"
                                               Text="&#xE77B;" />
                                    <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                           IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                  </Grid>
                                </Border>
                                <TextBlock Margin="0,0,0,2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           FontSize="12"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="{Binding LevelText}" />
                                <Border Width="22" Height="22"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="Black"
                                        CornerRadius="8,0,4,0">
                                  <TextBlock HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             FontSize="12"
                                             FontWeight="Bold"
                                             Foreground="{Binding RarityBrush}"
                                             Text="{Binding RarityText}" />
                                </Border>
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#A0000000"
                                        CornerRadius="0,8,0,4"
                                        IsVisible="{Binding HasRank}">
                                  <TextBlock Margin="4,2"
                                             FontSize="14"
                                             Foreground="{StaticResource StarTextSecondary}"
                                             Text="{Binding RankText}" />
                                </Border>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Width="58" Height="78" Margin="0,15,0,0"
                              IsVisible="{Binding Buddy, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <Border Background="#0A0A0A" CornerRadius="8" IsHitTestVisible="False" />
                          <Border Width="54" Height="56" Margin="2,2,2,2"
                                  VerticalAlignment="Top"
                                  CornerRadius="8,8,0,0"
                                  ClipToBounds="True">
                            <Grid>
                              <TextBlock HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontSize="24"
                                         Foreground="#66FFFFFF"
                                         Text="&#xE7FC;" />
                              <Image Height="84" Margin="-8,-8,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Source="{Binding Buddy.Icon}"
                                     Stretch="UniformToFill"
                                     IsVisible="{Binding Buddy.Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Grid>
                          </Border>
                          <TextBlock Margin="0,0,0,2"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     FontSize="12"
                                     Foreground="{StaticResource StarTextSecondary}"
                                     Text="{Binding Buddy.LevelText}" />
                          <Border Width="20" Height="20"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Background="Black"
                                  CornerRadius="8,0,4,0">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{Binding Buddy.RarityBrush}"
                                       Text="{Binding Buddy.RarityText}" />
                          </Border>
                        </Grid>
                      </StackPanel>

                      <!-- 增益（Starward Grid RowSpan=4 Column=2） -->
                      <Grid Grid.RowSpan="4" Grid.Column="2" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                          <RowDefinition />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                          <Border Width="32" Height="32" CornerRadius="6" Background="#1F2A44" ClipToBounds="True">
                            <Grid>
                              <TextBlock HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontSize="16"
                                         Foreground="#66FFFFFF"
                                         Text="&#xE7FC;" />
                              <Image Source="{Binding BuffIcon}" Stretch="UniformToFill"
                                     IsVisible="{Binding BuffIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Grid>
                          </Border>
                          <TextBlock Margin="8,0,0,2"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="16"
                                     Text="{Binding BuffName}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource StarTextSecondary}"
                                   Text="{Binding BuffDesc}"
                                   TextWrapping="Wrap" />
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 试炼模式 -->
        <Border Width="680"
                Padding="16,12"
                HorizontalAlignment="Center"
                Background="{StaticResource StarControlFillBrush}"
                BoxShadow="0 0 16 0 #33000000"
                CornerRadius="8">
          <StackPanel Spacing="8">
            <Grid>
              <StackPanel Margin="4,4,0,0" Spacing="2">
                <TextBlock FontWeight="Bold" Text="{Binding Strings[DeadlyAssault.TrialMode]}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock FontSize="28" FontWeight="Bold" Text="{Binding TrialScoreText}" />
                  <Border Margin="0,0,0,6"
                          VerticalAlignment="Bottom"
                          MinWidth="56"
                          Height="20"
                          Background="{Binding TrialRankBrush}"
                          CornerRadius="4">
                    <TextBlock Margin="8,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#1A1A1A"
                               Text="{Binding TrialRankText}" />
                  </Border>
                </StackPanel>
              </StackPanel>
              <StackPanel HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Orientation="Horizontal"
                          Spacing="8">
                <TextBlock VerticalAlignment="Center" FontSize="36" Text="&#xE735;" Foreground="#CFE3FF" />
                <TextBlock Margin="0,0,4,0"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Text="{Binding TrialStarText}" />
              </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding TrialNodes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="12" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DeadlyAssaultNodeItem">
                  <Border Padding="12"
                          Background="{StaticResource StarOverlayAcrylicBrush}"
                          BoxShadow="0 0 16 0 #33000000"
                          CornerRadius="12">
                    <Grid RowDefinitions="Auto,Auto,Auto,*"
                          ColumnDefinitions="Auto,Auto,*"
                          ColumnSpacing="16"
                          RowSpacing="4">

                      <Grid Grid.RowSpan="4"
                            Width="142"
                            Height="194"
                            VerticalAlignment="Top">
                        <Border CornerRadius="16" ClipToBounds="True" Background="#16203A">
                          <Grid>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="48"
                                       Foreground="#66FFFFFF"
                                       Text="&#xE7FC;" />
                            <Image Source="{Binding BossBg}" Stretch="UniformToFill"
                                   IsVisible="{Binding BossBg, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          </Grid>
                        </Border>
                        <Image Source="{Binding BossIcon}" Stretch="Uniform" Margin="10"
                               IsVisible="{Binding BossIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Margin="0,0,8,8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   FontSize="28"
                                   Foreground="#CCFFFFFF"
                                   Text="&#xE7FC;"
                                   IsVisible="{Binding BossRaceIcon, Converter={x:Static ObjectConverters.IsNull}}" />
                        <Image Width="48" Height="48" Margin="0,0,4,4"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Source="{Binding BossRaceIcon}"
                               IsVisible="{Binding BossRaceIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Border BorderBrush="#70FFFFFF" BorderThickness="2" CornerRadius="16" />
                      </Grid>

                      <TextBlock Grid.Column="1"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Text="{Binding BossName}" />

                      <StackPanel Grid.Row="1"
                                  Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  Orientation="Horizontal"
                                  Spacing="2">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Text="{Binding ScoreText}" />
                        <ItemsControl Margin="4,3,0,0" VerticalAlignment="Center" ItemsSource="{Binding Stars}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock FontSize="24" Text="&#xE735;" Foreground="{Binding $parent[ItemsControl].DataContext.StarBrush}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>

                      <TextBlock Grid.Row="2"
                                 Grid.Column="1"
                                 FontSize="12"
                                 Foreground="{StaticResource StarTextSecondary}"
                                 Text="{Binding ClearedText}" />

                      <StackPanel Grid.Row="3"
                                  Grid.Column="1"
                                  Margin="0,4,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Orientation="Horizontal"
                                  Spacing="8">
                        <ItemsControl ItemsSource="{Binding Avatars}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeadlyAssaultAvatarItem">
                              <Grid Width="76" Height="94">
                                <Border Width="76" Height="94" VerticalAlignment="Top"
                                        Background="#0A0A0A" CornerRadius="8" />
                                <Border Width="72" Height="72" Margin="2,2,2,2"
                                        VerticalAlignment="Top"
                                        CornerRadius="8,8,0,0"
                                        ClipToBounds="True">
                                  <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="28"
                                               Foreground="#66FFFFFF"
                                               Text="&#xE77B;" />
                                    <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                           IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                  </Grid>
                                </Border>
                                <TextBlock Margin="0,0,0,2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           FontSize="12"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="{Binding LevelText}" />
                                <Border Width="22" Height="22"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="Black"
                                        CornerRadius="8,0,4,0">
                                  <TextBlock HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             FontSize="12"
                                             FontWeight="Bold"
                                             Foreground="{Binding RarityBrush}"
                                             Text="{Binding RarityText}" />
                                </Border>
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="#A0000000"
                                        CornerRadius="0,8,0,4"
                                        IsVisible="{Binding HasRank}">
                                  <TextBlock Margin="4,2"
                                             FontSize="14"
                                             Foreground="{StaticResource StarTextSecondary}"
                                             Text="{Binding RankText}" />
                                </Border>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Width="58" Height="78" Margin="0,15,0,0"
                              IsVisible="{Binding Buddy, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <Border Background="#0A0A0A" CornerRadius="8" IsHitTestVisible="False" />
                          <Border Width="54" Height="56" Margin="2,2,2,2"
                                  VerticalAlignment="Top"
                                  CornerRadius="8,8,0,0"
                                  ClipToBounds="True">
                            <Grid>
                              <TextBlock HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontSize="24"
                                         Foreground="#66FFFFFF"
                                         Text="&#xE7FC;" />
                              <Image Height="84" Margin="-8,-8,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Source="{Binding Buddy.Icon}"
                                     Stretch="UniformToFill"
                                     IsVisible="{Binding Buddy.Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Grid>
                          </Border>
                          <TextBlock Margin="0,0,0,2"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     FontSize="12"
                                     Foreground="{StaticResource StarTextSecondary}"
                                     Text="{Binding Buddy.LevelText}" />
                          <Border Width="20" Height="20"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Background="Black"
                                  CornerRadius="8,0,4,0">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{Binding Buddy.RarityBrush}"
                                       Text="{Binding Buddy.RarityText}" />
                          </Border>
                        </Grid>
                      </StackPanel>

                      <Grid Grid.RowSpan="4" Grid.Column="2" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                          <RowDefinition />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                          <Border Width="32" Height="32" CornerRadius="6" Background="#1F2A44" ClipToBounds="True">
                            <Grid>
                              <TextBlock HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         FontSize="16"
                                         Foreground="#66FFFFFF"
                                         Text="&#xE7FC;" />
                              <Image Source="{Binding BuffIcon}" Stretch="UniformToFill"
                                     IsVisible="{Binding BuffIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Grid>
                          </Border>
                          <TextBlock Margin="8,0,0,2"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="16"
                                     Text="{Binding BuffName}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource StarTextSecondary}"
                                   Text="{Binding BuffDesc}"
                                   TextWrapping="Wrap" />
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
