<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LunarWard.Views.Starward.Controls"
             xmlns:vm="using:LunarWard.ViewModels.Starward"
             x:Class="LunarWard.Views.Starward.Pages.Record.TrailblazeCalendarPage"
             x:DataType="vm:TrailblazeCalendarPageViewModel">
  <!--
    开拓月历页：逐段对照 Starward Features/GameRecord/StarRail/TrailblazeCalendarPage.xaml（444 行）。

    结构：
    · 左栏 = 圆头「刷新」+「获取明细」（Flyout 列出可选月份）+ 月份列表（yyyy-MM + 星琼数）。
    · 右侧 = 实时数据卡（今日/当月获取 + 星琼收入组成图 + 图例）
             → 历史数据卡（选中月，同构 + 获取比例）
             → 每日数据卡（按月内每天两条进度条：星琼 / 古老梦华）
             → 明细面板（获取明细的结果）。

    素材差异：源码的星琼/古老梦华图标是游戏内 PNG（900001/101/102.png），
    本仓库没有随包素材，改用字形 + 文字，颜色沿用 Starward 的假日红/蓝。
  -->
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

    <!-- ══ 空态（源码 Image_Emoji + HoyolabToolboxPage_NoData） ══════════════ -->
    <StackPanel Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="12"
                IsVisible="{Binding ShowEmpty}">
      <Border Width="160"
              Height="160"
              Background="{StaticResource StarControlFillBrush}"
              CornerRadius="80">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="64"
                   Foreground="{StaticResource StarTextTertiary}"
                   Text="&#xE8A1;" />
      </Border>
      <TextBlock HorizontalAlignment="Center"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="{Binding Strings[Common.NoData]}" />
    </StackPanel>

    <!-- ══ 左栏：刷新 / 获取明细 / 月份列表 ═══════════════════════════════════ -->
    <ScrollViewer Grid.Row="0"
                  Grid.RowSpan="2"
                  HorizontalScrollBarVisibility="Disabled"
                  IsVisible="{Binding !ShowEmpty}">
      <StackPanel Width="112" Margin="0,24,0,0" Spacing="16">
        <StackPanel Margin="4,0,4,0" Spacing="8">
          <Button Classes="accent"
                  Height="36"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  CornerRadius="0,18,18,0"
                  Command="{Binding RefreshCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="icon"
                         VerticalAlignment="Center"
                         FontSize="16"
                         Text="&#xE72C;" />
              <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Common.Refresh]}" />
            </StackPanel>
          </Button>

          <!--  源码是「获取明细」SplitButton：主按钮 + 下拉列出 OptionalMonth  -->
          <Button Height="36"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Background="{StaticResource StarControlFillBrush}"
                  CornerRadius="0,18,18,0">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel MinWidth="120" Spacing="4">
                  <TextBlock Classes="caption"
                             Margin="8,4"
                             Foreground="{StaticResource StarTextSecondary}"
                             Text="{Binding Strings[TravelersDiary.GetDetails]}" />
                  <ItemsControl ItemsSource="{Binding MonthList}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TrailblazeMonthItem">
                        <Button Classes="link"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Command="{Binding $parent[UserControl].((vm:TrailblazeCalendarPageViewModel)DataContext).GetDetailsCommand}"
                                CommandParameter="{Binding Month}"
                                Content="{Binding MonthText}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="icon"
                         VerticalAlignment="Center"
                         FontSize="16"
                         Text="&#xE8A5;" />
              <TextBlock VerticalAlignment="Center" Text="{Binding Strings[TravelersDiary.GetDetails]}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <ListBox Margin="4,0,4,16"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemsSource="{Binding MonthList}"
                 SelectedItem="{Binding SelectedMonth}">
          <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem" x:DataType="vm:TrailblazeMonthItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,8" />
              <Setter Property="CornerRadius" Value="4" />
              <Setter Property="Template">
                <ControlTemplate>
                  <Border Padding="8,6"
                          Background="{StaticResource StarOverlayAcrylicBrush}"
                          CornerRadius="4">
                    <StackPanel Spacing="2">
                      <TextBlock FontSize="14"
                                 FontWeight="SemiBold"
                                 Text="{Binding MonthText}" />
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="icon"
                                   FontSize="12"
                                   Foreground="#FFC29B62"
                                   Text="&#xE8A0;" />
                        <TextBlock Foreground="{StaticResource StarTextSecondary}" Text="{Binding HcoinText}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </ControlTemplate>
              </Setter>
            </ControlTheme>
          </ListBox.ItemContainerTheme>
        </ListBox>
      </StackPanel>
    </ScrollViewer>

    <!-- ══ 右侧内容 ═══════════════════════════════════════════════════════════ -->
    <ScrollViewer Grid.Row="0"
                  Grid.RowSpan="2"
                  Grid.Column="1"
                  HorizontalScrollBarVisibility="Disabled"
                  IsVisible="{Binding !ShowEmpty}">
      <StackPanel Margin="24,0,24,16" Spacing="8">

        <!--  错误条  -->
        <Border Padding="12,8"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                IsVisible="{Binding HasError}">
          <TextBlock VerticalAlignment="Center"
                     Foreground="{StaticResource StarErrorBrush}"
                     Text="{Binding ErrorText}"
                     TextWrapping="Wrap" />
        </Border>

        <!--  ── 实时数据 ───────────────────────────────────────────────────  -->
        <TextBlock Margin="0,24,0,0"
                   FontSize="16"
                   Foreground="{StaticResource StarTextSecondary}"
                   Text="{Binding Strings[TravelersDiary.RealTimeData]}" />
        <Border Padding="24,8"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                IsVisible="{Binding HasCurrent}">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

            <!--  今日 / 当月获取（源码两张计数卡横排）  -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Foreground="{StaticResource StarTextSecondary}" Text="{Binding Strings[TravelersDiary.AcquiredThisDay]}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="icon" FontSize="16" Foreground="#FFE0B080" Text="&#xE8A0;" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding CurrentDayHcoin}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="icon" FontSize="16" Foreground="#FF6FA8DC" Text="&#xE8B0;" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding CurrentDayRailsPass}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Foreground="{StaticResource StarTextSecondary}" Text="{Binding Strings[TravelersDiary.AcquiredThisMonth]}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="icon" FontSize="16" Foreground="#FFE0B080" Text="&#xE8A0;" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding CurrentMonthHcoin}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="icon" FontSize="16" Foreground="#FF6FA8DC" Text="&#xE8B0;" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding CurrentMonthRailsPass}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Height="1"
                    Margin="0,8"
                    Background="{StaticResource StarDividerBrush}" />

            <TextBlock Grid.Row="2"
                       Foreground="{StaticResource StarTextSecondary}"
                       Text="{Binding Strings[TrailblazeCalendar.StellarJadeSources]}" />
            <controls:ColorRectChart Grid.Row="3"
                                     Height="20"
                                     Margin="0,8,0,0"
                                     Series="{Binding CurrentSeries}" />
            <ItemsControl Grid.Row="4" Margin="0,8,-4,0" ItemsSource="{Binding CurrentSeries}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:IncomeSeriesItem">
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4">
                    <Border Width="16"
                            Height="16"
                            Background="{Binding Brush}"
                            CornerRadius="4" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding PercentText}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <!--  ── 历史数据（选中月） ──────────────────────────────────────────  -->
        <TextBlock Margin="0,8,0,0"
                   FontSize="16"
                   Foreground="{StaticResource StarTextSecondary}"
                   IsVisible="{Binding HasSelect}">
          <Run Text="{Binding Strings[TravelersDiary.HistoricalData]}" />
          <Run Text=" " />
          <Run Text="{Binding SelectMonthText}" />
        </TextBlock>
        <Border Padding="24,8"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                IsVisible="{Binding HasSelect}">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto">

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="24">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="icon" FontSize="16" Foreground="#FFE0B080" Text="&#xE8A0;" />
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding SelectMonthHcoin}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="icon" FontSize="16" Foreground="#FF6FA8DC" Text="&#xE8B0;" />
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding SelectMonthRailsPass}" />
              </StackPanel>
            </StackPanel>

            <Border Grid.Row="1"
                    Height="1"
                    Margin="0,8"
                    Background="{StaticResource StarDividerBrush}" />

            <controls:ColorRectChart Grid.Row="2"
                                     Height="20"
                                     Margin="0,8,0,0"
                                     Series="{Binding SelectSeries}" />
            <ItemsControl Grid.Row="3" Margin="0,8,-4,0" ItemsSource="{Binding SelectSeries}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:IncomeSeriesItem">
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,12,4">
                    <Border Width="16"
                            Height="16"
                            Background="{Binding Brush}"
                            CornerRadius="4" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding PercentText}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <!--  ── 每日数据 ───────────────────────────────────────────────────  -->
        <TextBlock Margin="0,8,0,8"
                   FontSize="16"
                   Foreground="{StaticResource StarTextSecondary}"
                   Text="{Binding Strings[TravelersDiary.DailyData]}" />
        <Border Padding="24,12"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8">
          <ItemsControl ItemsSource="{Binding DayList}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TrailblazeDayItem">
                <Grid Margin="0,2"
                      ColumnDefinitions="56,220,40,220,40"
                      ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource StarTextSecondary}"
                             Text="{Binding Day}" />

                  <ProgressBar Grid.Column="1"
                               Height="8"
                               VerticalAlignment="Center"
                               Maximum="1"
                               Value="{Binding JadeProgress}" />
                  <TextBlock Grid.Column="2"
                             VerticalAlignment="Center"
                             Text="{Binding JadeText}" />

                  <ProgressBar Grid.Column="3"
                               Height="8"
                               VerticalAlignment="Center"
                               Maximum="1"
                               Value="{Binding RailsPassProgress}" />
                  <TextBlock Grid.Column="4"
                             VerticalAlignment="Center"
                             Text="{Binding RailsPassText}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!--  ── 明细（获取明细的结果） ──────────────────────────────────────  -->
        <Border Margin="0,8,0,0"
                Padding="24,12"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                IsVisible="{Binding IsDetailsOpen}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         FontSize="16"
                         Foreground="{StaticResource StarTextSecondary}"
                         Text="{Binding Strings[TravelersDiary.GetDetails]}" />
              <Button Grid.Column="1"
                      Classes="icon"
                      FontSize="14"
                      Command="{Binding $parent[UserControl].((vm:TrailblazeCalendarPageViewModel)DataContext).GetDetailsCommand}"
                      CommandParameter=""
                      Content="&#xE711;" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Details}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TrailblazeDetailItem">
                  <Grid Margin="0,2"
                        ColumnDefinitions="120,*,100,80"
                        ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource StarTextSecondary}"
                               Text="{Binding TimeText}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{Binding ActionName}" />
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource StarTextSecondary}"
                               Text="{Binding TypeText}" />
                    <TextBlock Grid.Column="3"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Text="{Binding NumberText}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
