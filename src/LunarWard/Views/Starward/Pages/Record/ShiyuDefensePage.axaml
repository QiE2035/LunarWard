<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunarWard.ViewModels.Starward"
             x:Class="LunarWard.Views.Starward.Pages.Record.ShiyuDefensePage"
             x:DataType="vm:ShiyuDefensePageViewModel">

  <!--
    式舆防卫战页：逐块对照 Starward Features/GameRecord/ZZZ/ShiyuDefensePage.xaml。
    v1：出战统计（S/A/B 次数 + 最高防线 + 4-7 层时长）+ 逐防线卡（阵容 1 / 阵容 2 + 敌方详情 Flyout）。
    v2：第五防线 680 宽卡（概要 + 逐关 208 高卡）+ 第四防线卡（增益 + 两套阵容）。
    缺 S_Level/A_Level/B_Level、属性图标、怪物/邦布/角色卡素材，用同色文字章 + 字形 + 渐变占位。
  -->

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

    <!-- ══ 空态 ══════════════════════════════════════════════════════════ -->
    <StackPanel Grid.RowSpan="2"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                IsVisible="{Binding ShowEmpty}">
      <Border Width="160"
              Height="160"
              CornerRadius="80"
              Background="{StaticResource StarControlFillBrush}">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="64"
                   Foreground="{StaticResource StarTextTertiary}"
                   Text="&#xE7FC;" />
      </Border>
      <TextBlock HorizontalAlignment="Center"
                 FontSize="16"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="{Binding Strings[Common.NoData]}" />
    </StackPanel>

    <!-- ══ 左栏：刷新 ═══════════════════════════════════════════════════ -->
    <StackPanel Margin="0,24,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Spacing="12">
      <Button Height="36"
              BorderThickness="0"
              Classes="accent"
              CornerRadius="0,18,18,0"
              Command="{Binding RefreshCommand}">
        <StackPanel Margin="4,0,4,0" Orientation="Horizontal" Spacing="8">
          <Grid>
            <ProgressBar Width="16" Height="16" IsIndeterminate="True" Background="Transparent" IsVisible="{Binding IsBusy}" />
            <TextBlock Classes="icon" FontSize="16" Text="&#xE72C;" IsVisible="{Binding !IsBusy}" />
          </Grid>
          <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Common.Refresh]}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- ══ 左栏：赛期列表 ═══════════════════════════════════════════════ -->
    <ListBox Grid.Row="1"
             Margin="0,12,0,0"
             Padding="12,0,12,0"
             Background="Transparent"
             ItemsSource="{Binding DefenseList}"
             SelectedItem="{Binding CurrentDefense, Mode=TwoWay}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             IsVisible="{Binding DefenseList.Count}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="4,0,4,0" />
          <Setter Property="Margin" Value="0,4" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Background" Value="Transparent" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ShiyuDefensePeriodItem">
          <Border Padding="12,8"
                  Background="{StaticResource StarOverlayAcrylicBrush}"
                  CornerRadius="4">
            <StackPanel Spacing="4">
              <TextBlock FontSize="16" Text="{Binding DateText}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="20" Height="20" Background="Black" CornerRadius="4">
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontSize="11"
                             FontWeight="Bold"
                             Foreground="{Binding RatingBrush}"
                             Text="{Binding RatingLetter}" />
                </Border>
                <TextBlock Margin="0,0,0,2"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource StarTextSecondary}"
                           IsVisible="{Binding HasTimes}"
                           Text="{Binding TimesText}" />
                <TextBlock Margin="0,0,0,2"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource StarTextSecondary}"
                           IsVisible="{Binding HasScore}"
                           Text="{Binding ScoreText}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ScrollViewer Grid.RowSpan="2"
                  Grid.Column="1"
                  IsVisible="{Binding CurrentDefense, Converter={x:Static ObjectConverters.IsNotNull}}">

      <StackPanel Margin="24" Spacing="8">

        <TextBlock Foreground="{StaticResource StarTextSecondary}" Text="{Binding PeriodText}" />

        <TextBlock Foreground="#FF6B6B"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Text="{Binding ErrorText}" />

        <!-- ══ v1 ═════════════════════════════════════════════════════════ -->
        <StackPanel Spacing="8" IsVisible="{Binding ShowV1}">

          <!-- 出战统计 -->
          <Border Padding="24,8"
                  Background="{StaticResource StarOverlayAcrylicBrush}"
                  CornerRadius="8"
                  BoxShadow="0 0 16 0 #33000000">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">

              <Grid ColumnDefinitions="*,*,*">
                <StackPanel Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                  <Border Width="40" Height="40" Background="Black" CornerRadius="6">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="22" FontWeight="Bold" Foreground="#FFB13F" Text="S" />
                  </Border>
                  <TextBlock VerticalAlignment="Center" Foreground="{StaticResource StarTextSecondary}" Text="x" />
                  <TextBlock VerticalAlignment="Center" FontSize="16" Text="{Binding CurrentDefense.V1.STimes}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                  <Border Width="40" Height="40" Background="Black" CornerRadius="6">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="22" FontWeight="Bold" Foreground="#B57EDC" Text="A" />
                  </Border>
                  <TextBlock VerticalAlignment="Center" Foreground="{StaticResource StarTextSecondary}" Text="x" />
                  <TextBlock VerticalAlignment="Center" FontSize="16" Text="{Binding CurrentDefense.V1.ATimes}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                  <Border Width="40" Height="40" Background="Black" CornerRadius="6">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="22" FontWeight="Bold" Foreground="#7FB3FF" Text="B" />
                  </Border>
                  <TextBlock VerticalAlignment="Center" Foreground="{StaticResource StarTextSecondary}" Text="x" />
                  <TextBlock VerticalAlignment="Center" FontSize="16" Text="{Binding CurrentDefense.V1.BTimes}" />
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="*,*">
                <TextBlock Grid.Column="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                  <Run Foreground="{StaticResource StarTextSecondary}" Text="{Binding Strings[ShiyuDefense.HighestStageCleared]}" />
                  <Run Text=" " />
                  <Run Text="{Binding CurrentDefense.V1.MaxLayerText}" />
                </TextBlock>
                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                  <Run Foreground="{StaticResource StarTextSecondary}" Text="{Binding Strings[ShiyuDefense.Layer47ClearTime]}" />
                  <Run Text=" " />
                  <Run Text="{Binding CurrentDefense.V1.BattleTime47Text}" />
                </TextBlock>
              </Grid>
            </Grid>
          </Border>

          <!-- 逐防线卡片 -->
          <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding CurrentDefense.V1.Floors}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShiyuFloorItem">
                <Border Padding="20,8"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource StarOverlayAcrylicBrush}"
                        CornerRadius="8"
                        BoxShadow="0 0 16 0 #33000000">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                        ColumnDefinitions="Auto,*,Auto"
                        RowSpacing="8">

                    <!-- 关卡名称 + 防线效果 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                      <TextBlock FontWeight="Bold"
                                 Foreground="{StaticResource StarTextSecondary}"
                                 Text="{Binding ZoneName}" />
                      <Button Margin="-2,0,0,0"
                              Padding="2"
                              HorizontalAlignment="Left"
                              Background="Transparent"
                              BorderThickness="0"
                              FontSize="12"
                              Foreground="{StaticResource StarTextTertiary}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock VerticalAlignment="Center" Text="{Binding EffectsLabel}" />
                          <TextBlock Margin="2,1,0,0" VerticalAlignment="Center" FontSize="10" Text="&#x25BE;" />
                        </StackPanel>
                        <Button.Flyout>
                          <Flyout>
                            <Grid MaxWidth="320">
                              <ItemsControl ItemsSource="{Binding Buffs}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ShiyuBuffItem">
                                    <StackPanel Spacing="4">
                                      <TextBlock Text="{Binding Title}" />
                                      <TextBlock FontSize="12"
                                                 Foreground="{StaticResource StarTextSecondary}"
                                                 Text="{Binding Text}"
                                                 TextWrapping="Wrap" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Grid>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                    </StackPanel>

                    <!-- 评级 + 通关时间 -->
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Spacing="2">
                      <Border Width="24" Height="24"
                              HorizontalAlignment="Right"
                              Background="Black"
                              CornerRadius="4">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{Binding RatingBrush}"
                                   Text="{Binding RatingLetter}" />
                      </Border>
                      <TextBlock HorizontalAlignment="Right"
                                 FontSize="12"
                                 Foreground="{StaticResource StarTextSecondary}"
                                 Text="{Binding ChallengeTimeText}" />
                    </StackPanel>

                    <!-- 分隔线 -->
                    <Border Grid.Row="1" Grid.ColumnSpan="3"
                            Height="1"
                            Background="#14FFFFFF"
                            VerticalAlignment="Center" />

                    <!-- 阵容 1 标题 -->
                    <Grid Grid.Row="2" Grid.Column="0" Width="312">
                      <TextBlock HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource StarTextTertiary}"
                                 Text="{Binding Team1Label}" />
                      <Button Padding="2"
                              HorizontalAlignment="Right"
                              Background="Transparent"
                              BorderThickness="0"
                              FontSize="12"
                              Foreground="{StaticResource StarTextTertiary}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock VerticalAlignment="Center" Text="{Binding EnemyLabel}" />
                          <TextBlock Margin="2,1,0,0" VerticalAlignment="Center" FontSize="10" Text="&#x25BE;" />
                        </StackPanel>
                        <Button.Flyout>
                          <Flyout>
                            <Grid MaxWidth="320">
                              <ItemsControl ItemsSource="{Binding Node1.Monsters}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ShiyuMonsterItem">
                                    <Grid ColumnSpacing="16">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                      </Grid.ColumnDefinitions>
                                      <Grid Width="68" Height="68">
                                        <Border Background="#16203A" CornerRadius="8">
                                          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     FontSize="24" Foreground="#66FFFFFF" Text="&#xE7FC;" />
                                        </Border>
                                        <Image Source="{Binding BgIcon}" Stretch="UniformToFill"
                                               IsVisible="{Binding BgIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                               IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <Image Width="28" Height="28"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Source="{Binding RaceIcon}"
                                               IsVisible="{Binding RaceIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                      </Grid>
                                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasWeakness}">
                                          <TextBlock Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource StarTextSecondary}"
                                                     Text="{Binding WeaknessLabel}" />
                                          <ItemsControl ItemsSource="{Binding Weakness}">
                                            <ItemsControl.ItemsPanel>
                                              <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                              </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                              <DataTemplate x:DataType="vm:ShiyuElementChip">
                                                <Border Padding="3,0" Background="{Binding Brush}" CornerRadius="3">
                                                  <TextBlock FontSize="10" Foreground="#1A1A1A" Text="{Binding Label}" />
                                                </Border>
                                              </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasResistance}">
                                          <TextBlock Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource StarTextSecondary}"
                                                     Text="{Binding ResistanceLabel}" />
                                          <ItemsControl ItemsSource="{Binding Resistance}">
                                            <ItemsControl.ItemsPanel>
                                              <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                              </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                              <DataTemplate x:DataType="vm:ShiyuElementChip">
                                                <Border Padding="3,0" Background="{Binding Brush}" CornerRadius="3">
                                                  <TextBlock FontSize="10" Foreground="#1A1A1A" Text="{Binding Label}" />
                                                </Border>
                                              </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                        </StackPanel>
                                      </StackPanel>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Grid>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                    </Grid>

                    <!-- 中场竖分割线 -->
                    <Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="1"
                            Width="1"
                            Margin="16,4"
                            Background="#14FFFFFF" />

                    <!-- 阵容 2 标题 -->
                    <Grid Grid.Row="2" Grid.Column="2" Width="312">
                      <TextBlock HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 FontWeight="Bold"
                                 Foreground="{StaticResource StarTextTertiary}"
                                 Text="{Binding Team2Label}" />
                      <Button Padding="2"
                              HorizontalAlignment="Right"
                              Background="Transparent"
                              BorderThickness="0"
                              FontSize="12"
                              Foreground="{StaticResource StarTextTertiary}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock VerticalAlignment="Center" Text="{Binding EnemyLabel}" />
                          <TextBlock Margin="2,1,0,0" VerticalAlignment="Center" FontSize="10" Text="&#x25BE;" />
                        </StackPanel>
                        <Button.Flyout>
                          <Flyout>
                            <Grid MaxWidth="320">
                              <ItemsControl ItemsSource="{Binding Node2.Monsters}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ShiyuMonsterItem">
                                    <Grid ColumnSpacing="16">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                      </Grid.ColumnDefinitions>
                                      <Grid Width="68" Height="68">
                                        <Border Background="#16203A" CornerRadius="8">
                                          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     FontSize="24" Foreground="#66FFFFFF" Text="&#xE7FC;" />
                                        </Border>
                                        <Image Source="{Binding BgIcon}" Stretch="UniformToFill"
                                               IsVisible="{Binding BgIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                               IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <Image Width="28" Height="28"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Source="{Binding RaceIcon}"
                                               IsVisible="{Binding RaceIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                      </Grid>
                                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasWeakness}">
                                          <TextBlock Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource StarTextSecondary}"
                                                     Text="{Binding WeaknessLabel}" />
                                          <ItemsControl ItemsSource="{Binding Weakness}">
                                            <ItemsControl.ItemsPanel>
                                              <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                              </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                              <DataTemplate x:DataType="vm:ShiyuElementChip">
                                                <Border Padding="3,0" Background="{Binding Brush}" CornerRadius="3">
                                                  <TextBlock FontSize="10" Foreground="#1A1A1A" Text="{Binding Label}" />
                                                </Border>
                                              </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasResistance}">
                                          <TextBlock Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource StarTextSecondary}"
                                                     Text="{Binding ResistanceLabel}" />
                                          <ItemsControl ItemsSource="{Binding Resistance}">
                                            <ItemsControl.ItemsPanel>
                                              <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                              </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                              <DataTemplate x:DataType="vm:ShiyuElementChip">
                                                <Border Padding="3,0" Background="{Binding Brush}" CornerRadius="3">
                                                  <TextBlock FontSize="10" Foreground="#1A1A1A" Text="{Binding Label}" />
                                                </Border>
                                              </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                        </StackPanel>
                                      </StackPanel>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Grid>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                    </Grid>

                    <!-- 阵容 1 角色 + 邦布 -->
                    <StackPanel Grid.Row="3" Grid.Column="0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal"
                                Spacing="8">
                      <ItemsControl ItemsSource="{Binding Node1.Avatars}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ShiyuAvatarItem">
                            <Grid Width="76" Height="94">
                              <Border Width="76" Height="94" Background="#0A0A0A" CornerRadius="8" />
                              <Border Width="72" Height="72" Margin="2,2,2,2"
                                      VerticalAlignment="Top" CornerRadius="8,8,0,0" ClipToBounds="True">
                                <Grid>
                                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                             FontSize="28" Foreground="#66FFFFFF" Text="&#xE77B;" />
                                  <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                         IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </Grid>
                              </Border>
                              <TextBlock Margin="0,0,0,2" HorizontalAlignment="Center"
                                         VerticalAlignment="Bottom" FontSize="12"
                                         Foreground="{StaticResource StarTextSecondary}"
                                         Text="{Binding LevelText}" />
                              <Border Width="22" Height="22" HorizontalAlignment="Left"
                                      VerticalAlignment="Top" Background="Black" CornerRadius="8,0,4,0">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{Binding RarityBrush}"
                                           Text="{Binding RarityText}" />
                              </Border>
                              <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Background="#A0000000" CornerRadius="0,8,0,4"
                                      IsVisible="{Binding HasRank}">
                                <TextBlock Margin="4,2" FontSize="14"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="{Binding RankText}" />
                              </Border>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Grid Width="58" Height="78" Margin="0,15,0,0"
                            IsVisible="{Binding Node1.Buddy, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Border Background="#0A0A0A" CornerRadius="8" />
                        <Border Width="54" Height="56" Margin="2,2,2,2"
                                VerticalAlignment="Top" CornerRadius="8,8,0,0" ClipToBounds="True">
                          <Grid>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="24" Foreground="#66FFFFFF" Text="&#xE7FC;" />
                            <Image Height="84" Margin="-8,-8,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Source="{Binding Node1.Buddy.Icon}" Stretch="UniformToFill"
                                   IsVisible="{Binding Node1.Buddy.Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          </Grid>
                        </Border>
                        <TextBlock Margin="0,0,0,2" HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom" FontSize="12"
                                   Foreground="{StaticResource StarTextSecondary}"
                                   Text="{Binding Node1.Buddy.LevelText}" />
                        <Border Width="20" Height="20" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Background="Black" CornerRadius="8,0,4,0">
                          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                     FontSize="11" FontWeight="Bold"
                                     Foreground="{Binding Node1.Buddy.RarityBrush}"
                                     Text="{Binding Node1.Buddy.RarityText}" />
                        </Border>
                      </Grid>
                    </StackPanel>

                    <!-- 阵容 2 角色 + 邦布 -->
                    <StackPanel Grid.Row="3" Grid.Column="2"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal"
                                Spacing="8">
                      <ItemsControl ItemsSource="{Binding Node2.Avatars}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ShiyuAvatarItem">
                            <Grid Width="76" Height="94">
                              <Border Width="76" Height="94" Background="#0A0A0A" CornerRadius="8" />
                              <Border Width="72" Height="72" Margin="2,2,2,2"
                                      VerticalAlignment="Top" CornerRadius="8,8,0,0" ClipToBounds="True">
                                <Grid>
                                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                             FontSize="28" Foreground="#66FFFFFF" Text="&#xE77B;" />
                                  <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                         IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </Grid>
                              </Border>
                              <TextBlock Margin="0,0,0,2" HorizontalAlignment="Center"
                                         VerticalAlignment="Bottom" FontSize="12"
                                         Foreground="{StaticResource StarTextSecondary}"
                                         Text="{Binding LevelText}" />
                              <Border Width="22" Height="22" HorizontalAlignment="Left"
                                      VerticalAlignment="Top" Background="Black" CornerRadius="8,0,4,0">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{Binding RarityBrush}"
                                           Text="{Binding RarityText}" />
                              </Border>
                              <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Background="#A0000000" CornerRadius="0,8,0,4"
                                      IsVisible="{Binding HasRank}">
                                <TextBlock Margin="4,2" FontSize="14"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="{Binding RankText}" />
                              </Border>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Grid Width="58" Height="78" Margin="0,15,0,0"
                            IsVisible="{Binding Node2.Buddy, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Border Background="#0A0A0A" CornerRadius="8" />
                        <Border Width="54" Height="56" Margin="2,2,2,2"
                                VerticalAlignment="Top" CornerRadius="8,8,0,0" ClipToBounds="True">
                          <Grid>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="24" Foreground="#66FFFFFF" Text="&#xE7FC;" />
                            <Image Height="84" Margin="-8,-8,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Source="{Binding Node2.Buddy.Icon}" Stretch="UniformToFill"
                                   IsVisible="{Binding Node2.Buddy.Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          </Grid>
                        </Border>
                        <TextBlock Margin="0,0,0,2" HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom" FontSize="12"
                                   Foreground="{StaticResource StarTextSecondary}"
                                   Text="{Binding Node2.Buddy.LevelText}" />
                        <Border Width="20" Height="20" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Background="Black" CornerRadius="8,0,4,0">
                          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                     FontSize="11" FontWeight="Bold"
                                     Foreground="{Binding Node2.Buddy.RarityBrush}"
                                     Text="{Binding Node2.Buddy.RarityText}" />
                        </Border>
                      </Grid>
                    </StackPanel>

                    <!-- 通关时长 1 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="2,0,0,0" FontSize="12">
                      <Run Foreground="{StaticResource StarTextSecondary}" Text="{Binding ClearTimeLabel}" />
                      <Run Text=" " />
                      <Run Text="{Binding Node1.ClearTimeText}" />
                    </TextBlock>

                    <!-- 通关时长 2 -->
                    <TextBlock Grid.Row="4" Grid.Column="2" Margin="2,0,0,0" FontSize="12">
                      <Run Foreground="{StaticResource StarTextSecondary}" Text="{Binding ClearTimeLabel}" />
                      <Run Text=" " />
                      <Run Text="{Binding Node2.ClearTimeText}" />
                    </TextBlock>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ══ v2 ═════════════════════════════════════════════════════════ -->
        <StackPanel Spacing="8" IsVisible="{Binding ShowV2}">

          <!-- 第五防线 -->
          <Border Width="680"
                  Padding="16,12"
                  HorizontalAlignment="Center"
                  Background="{StaticResource StarOverlayAcrylicBrush}"
                  CornerRadius="8"
                  BoxShadow="0 0 16 0 #33000000">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">

              <Grid>
                <StackPanel>
                  <TextBlock FontWeight="Bold" Text="{Binding Strings[ShiyuDefense.FifthFrontier]}" />
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock FontSize="28" FontWeight="Bold" Text="{Binding CurrentDefense.V2.BriefScoreText}" />
                    <Border Margin="0,0,0,6"
                            MinWidth="58"
                            Height="20"
                            VerticalAlignment="Bottom"
                            Background="{Binding CurrentDefense.V2.RankPercentBrush}"
                            CornerRadius="4">
                      <TextBlock Margin="8,0,0,1"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 FontWeight="Bold"
                                 Foreground="Black"
                                 Text="{Binding CurrentDefense.V2.RankPercentText}" />
                    </Border>
                  </StackPanel>
                  <TextBlock FontSize="12"
                             Foreground="{StaticResource StarTextSecondary}"
                             IsVisible="{Binding CurrentDefense.V2.HasChallengeTime}"
                             Text="{Binding CurrentDefense.V2.ChallengeTimeText}" />
                </StackPanel>

                <Border Width="44" Height="44"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Black"
                        CornerRadius="8">
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                             FontSize="24" FontWeight="Bold"
                             Foreground="{Binding CurrentDefense.V2.RatingBrush}"
                             Text="{Binding CurrentDefense.V2.RatingLetter}" />
                </Border>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                  <TextBlock FontSize="12"
                             HorizontalAlignment="Right"
                             Foreground="{StaticResource StarTextSecondary}"
                             IsVisible="{Binding CurrentDefense.V2.HasBattleTime}">
                    <Run Text="{Binding Strings[ShiyuDefense.ClearTimeLabel]}" />
                    <Run Text=" " />
                    <Run Text="{Binding CurrentDefense.V2.BattleTimeText}" />
                  </TextBlock>
                </StackPanel>
              </Grid>

              <ItemsControl Grid.Row="1" ItemsSource="{Binding CurrentDefense.V2.Fifth}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShiyuV2ChallengeItem">
                    <Border MinHeight="208"
                            BorderBrush="#2EFFFFFF"
                            BorderThickness="1"
                            CornerRadius="8">
                      <Grid ColumnSpacing="24" RowSpacing="8" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

                        <!-- 怪物图 -->
                        <Grid Grid.RowSpan="2" Grid.Column="1"
                              Width="220"
                              Height="208"
                              Margin="0,8,0,8"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right">
                          <Border Background="#1416203A" CornerRadius="8">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="48" Foreground="#33FFFFFF" Text="&#xE7FC;" />
                          </Border>
                          <Image Source="{Binding MonsterPic}" Stretch="UniformToFill"
                                 IsVisible="{Binding MonsterPic, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Grid>

                        <!-- 得分 / buff / 时长 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="16,12,0,0" Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding ScoreText}" />
                            <Border Width="24" Height="24" VerticalAlignment="Center"
                                    Background="Black" CornerRadius="4"
                                    IsVisible="{Binding HasRating}">
                              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                         FontSize="13" FontWeight="Bold"
                                         Foreground="{Binding RatingBrush}"
                                         Text="{Binding RatingLetter}" />
                            </Border>
                          </StackPanel>

                          <Button Margin="-2,2,0,0"
                                  Padding="2"
                                  HorizontalAlignment="Left"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="12"
                                  Foreground="{StaticResource StarTextTertiary}">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock VerticalAlignment="Center" Text="{Binding EffectsLabel}" />
                              <TextBlock Margin="2,1,0,0" VerticalAlignment="Center" FontSize="10" Text="&#x25BE;" />
                            </StackPanel>
                            <Button.Flyout>
                              <Flyout>
                                <Grid MaxWidth="320">
                                  <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Buff.Title}" />
                                    <TextBlock FontSize="12"
                                               Foreground="{StaticResource StarTextSecondary}"
                                               Text="{Binding Buff.Text}"
                                               TextWrapping="Wrap" />
                                  </StackPanel>
                                </Grid>
                              </Flyout>
                            </Button.Flyout>
                          </Button>

                          <TextBlock Margin="0,4,0,0" FontSize="12"
                                     Foreground="{StaticResource StarTextSecondary}"
                                     IsVisible="{Binding HasBattleTime}">
                            <Run Text="{Binding ClearTimeLabel}" />
                            <Run Text=" " />
                            <Run Text="{Binding BattleTimeText}" />
                          </TextBlock>

                          <TextBlock Margin="0,4,0,0" FontSize="12"
                                     Foreground="{StaticResource StarTextSecondary}"
                                     IsVisible="{Binding HasClearedAt}">
                            <Run Text="{Binding ClearedAtLabel}" />
                            <Run Text=" " />
                            <Run Text="{Binding ChallengeTimeText}" />
                          </TextBlock>
                        </StackPanel>

                        <!-- 代理人阵容 -->
                        <StackPanel Grid.Row="1" Grid.Column="0"
                                    Margin="16,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal"
                                    Spacing="16">
                          <ItemsControl ItemsSource="{Binding Avatars}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="16" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ShiyuAvatarItem">
                                <Grid Width="76" Height="94">
                                  <Border Width="76" Height="94" Background="#0A0A0A" CornerRadius="8" />
                                  <Border Width="72" Height="72" Margin="2,2,2,2"
                                          VerticalAlignment="Top" CornerRadius="8,8,0,0" ClipToBounds="True">
                                    <Grid>
                                      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 FontSize="28" Foreground="#66FFFFFF" Text="&#xE77B;" />
                                      <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                             IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </Grid>
                                  </Border>
                                  <TextBlock Margin="0,0,0,2" HorizontalAlignment="Center"
                                             VerticalAlignment="Bottom" FontSize="12"
                                             Foreground="{StaticResource StarTextSecondary}"
                                             Text="{Binding LevelText}" />
                                  <Border Width="22" Height="22" HorizontalAlignment="Left"
                                          VerticalAlignment="Top" Background="Black" CornerRadius="8,0,4,0">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{Binding RarityBrush}"
                                               Text="{Binding RarityText}" />
                                  </Border>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <Grid Width="58" Height="78" Margin="0,15,0,0"
                                IsVisible="{Binding Buddy, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Border Background="#0A0A0A" CornerRadius="8" />
                            <Border Width="54" Height="56" Margin="2,2,2,2"
                                    VerticalAlignment="Top" CornerRadius="8,8,0,0" ClipToBounds="True">
                              <Grid>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="24" Foreground="#66FFFFFF" Text="&#xE7FC;" />
                                <Image Height="84" Margin="-8,-8,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Source="{Binding Buddy.Icon}" Stretch="UniformToFill"
                                       IsVisible="{Binding Buddy.Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                              </Grid>
                            </Border>
                            <TextBlock Margin="0,0,0,2" HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom" FontSize="12"
                                       Foreground="{StaticResource StarTextSecondary}"
                                       Text="{Binding Buddy.LevelText}" />
                            <Border Width="20" Height="20" HorizontalAlignment="Left"
                                    VerticalAlignment="Top" Background="Black" CornerRadius="8,0,4,0">
                              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                         FontSize="11" FontWeight="Bold"
                                         Foreground="{Binding Buddy.RarityBrush}"
                                         Text="{Binding Buddy.RarityText}" />
                            </Border>
                          </Grid>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>

          <!-- 第四防线 -->
          <Border Width="680"
                  Margin="0,8,0,0"
                  Padding="16,12"
                  HorizontalAlignment="Center"
                  Background="{StaticResource StarOverlayAcrylicBrush}"
                  CornerRadius="8"
                  BoxShadow="0 0 16 0 #33000000">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

              <Grid>
                <StackPanel>
                  <TextBlock FontWeight="Bold" Text="{Binding Strings[ShiyuDefense.FourthFrontier]}" />
                  <Button Margin="-2,2,0,0"
                          Padding="2"
                          HorizontalAlignment="Left"
                          Background="Transparent"
                          BorderThickness="0"
                          FontSize="12"
                          Foreground="{StaticResource StarTextTertiary}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock VerticalAlignment="Center" Text="{Binding Strings[ShiyuDefense.FrontierEffects]}" />
                      <TextBlock Margin="2,1,0,0" VerticalAlignment="Center" FontSize="10" Text="&#x25BE;" />
                    </StackPanel>
                    <Button.Flyout>
                      <Flyout>
                        <Grid MaxWidth="320">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{Binding CurrentDefense.V2.FourthBuff.Title}" />
                            <TextBlock FontSize="12"
                                       Foreground="{StaticResource StarTextSecondary}"
                                       Text="{Binding CurrentDefense.V2.FourthBuff.Text}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <TextBlock FontSize="12"
                             Foreground="{StaticResource StarTextSecondary}"
                             Text="{Binding CurrentDefense.V2.FourthChallengeTimeText}" />
                </StackPanel>

                <Border Width="32" Height="32"
                        Margin="0,4,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Black"
                        CornerRadius="6">
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                             FontSize="16" FontWeight="Bold"
                             Foreground="{Binding CurrentDefense.V2.RatingBrush}"
                             Text="{Binding CurrentDefense.V2.RatingLetter}" />
                </Border>
              </Grid>

              <Border Grid.Row="1" Height="1" Background="#14FFFFFF" />

              <ItemsControl Grid.Row="2" ItemsSource="{Binding CurrentDefense.V2.Fourth}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="24" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShiyuV2ChallengeItem">
                    <Grid Width="312" RowDefinitions="Auto,Auto" RowSpacing="6">
                      <TextBlock Margin="2,0,0,0"
                                 FontSize="12"
                                 IsVisible="{Binding HasBattleTime}">
                        <Run Foreground="{StaticResource StarTextSecondary}" Text="{Binding ClearTimeLabel}" />
                        <Run Text=" " />
                        <Run Text="{Binding BattleTimeText}" />
                      </TextBlock>

                      <StackPanel Grid.Row="1"
                                  HorizontalAlignment="Left"
                                  Orientation="Horizontal"
                                  Spacing="8">
                        <ItemsControl ItemsSource="{Binding Avatars}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShiyuAvatarItem">
                              <Grid Width="76" Height="94">
                                <Border Width="76" Height="94" Background="#0A0A0A" CornerRadius="8" />
                                <Border Width="72" Height="72" Margin="2,2,2,2"
                                        VerticalAlignment="Top" CornerRadius="8,8,0,0" ClipToBounds="True">
                                  <Grid>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="28" Foreground="#66FFFFFF" Text="&#xE77B;" />
                                    <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                           IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                  </Grid>
                                </Border>
                                <TextBlock Margin="0,0,0,2" HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom" FontSize="12"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="{Binding LevelText}" />
                                <Border Width="22" Height="22" HorizontalAlignment="Left"
                                        VerticalAlignment="Top" Background="Black" CornerRadius="8,0,4,0">
                                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                             FontSize="12" FontWeight="Bold"
                                             Foreground="{Binding RarityBrush}"
                                             Text="{Binding RarityText}" />
                                </Border>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Width="58" Height="78" Margin="0,15,0,0"
                              IsVisible="{Binding Buddy, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <Border Background="#0A0A0A" CornerRadius="8" />
                          <Border Width="54" Height="56" Margin="2,2,2,2"
                                  VerticalAlignment="Top" CornerRadius="8,8,0,0" ClipToBounds="True">
                            <Grid>
                              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                         FontSize="24" Foreground="#66FFFFFF" Text="&#xE7FC;" />
                              <Image Height="84" Margin="-8,-8,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Source="{Binding Buddy.Icon}" Stretch="UniformToFill"
                                     IsVisible="{Binding Buddy.Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Grid>
                          </Border>
                          <TextBlock Margin="0,0,0,2" HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom" FontSize="12"
                                     Foreground="{StaticResource StarTextSecondary}"
                                     Text="{Binding Buddy.LevelText}" />
                          <Border Width="20" Height="20" HorizontalAlignment="Left"
                                  VerticalAlignment="Top" Background="Black" CornerRadius="8,0,4,0">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{Binding Buddy.RarityBrush}"
                                       Text="{Binding Buddy.RarityText}" />
                          </Border>
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
