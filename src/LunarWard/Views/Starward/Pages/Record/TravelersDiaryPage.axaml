<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LunarWard.Controls"
             xmlns:vm="using:LunarWard.ViewModels.Starward"
             x:Class="LunarWard.Views.Starward.Pages.Record.TravelersDiaryPage"
             x:DataType="vm:TravelersDiaryPageViewModel">

  <!--
    旅行者札记页：逐块对照 Starward Features/GameRecord/Genshin/TravelersDiaryPage.xaml。
    左：月份卡列表 + 刷新；右：实时数据卡（今日/当月原石摩拉 + 原石收入组成分段条 + 图例）、
    历史数据卡（选中月份）、每日数据表（原石/摩拉进度条）。
    Starward 的 MenuFlyout 月份列表 → Avalonia Flyout + ItemsControl；原石/摩拉图标用 ◆/● 字形占位。
  -->

  <Grid ColumnDefinitions="280,*">

    <!-- ══ 空态 ══════════════════════════════════════════════════════════ -->
    <StackPanel Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                IsVisible="{Binding ShowEmpty}">
      <Border Width="160"
              Height="160"
              CornerRadius="80"
              Background="{StaticResource StarControlFillBrush}">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="64"
                   Foreground="{StaticResource StarTextTertiary}"
                   Text="&#xE7FC;" />
      </Border>
      <TextBlock HorizontalAlignment="Center"
                 FontSize="16"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="{Binding Strings[Common.NoData]}" />
    </StackPanel>

    <!-- ══ 左栏：月份卡列表 ═════════════════════════════════════════════ -->
    <Grid RowDefinitions="*,Auto">
      <ListBox Margin="0,24,0,0"
               Padding="12,0"
               Background="Transparent"
               ItemsSource="{Binding MonthDataList}"
               SelectedItem="{Binding SelectedMonth, Mode=TwoWay}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TravelersDiaryMonthItem">
            <Border Padding="12"
                    Background="{StaticResource StarOverlayAcrylicBrush}"
                    CornerRadius="4">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <TextBlock VerticalAlignment="Center"
                           FontSize="20"
                           Foreground="{StaticResource StarTextPrimary}"
                           Text="&#xE787;" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock FontSize="16" Text="{Binding MonthText}" />
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#FF8FE3FF"
                               Text="&#x25C6;" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource StarTextSecondary}"
                               Text="{Binding PrimogemsText}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="1" Margin="12,8,12,12" Spacing="8">
        <Button Height="36"
                HorizontalAlignment="Stretch"
                BorderThickness="0"
                Classes="accent"
                Command="{Binding RefreshCommand}">
          <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
            <Grid>
              <ProgressBar Width="16"
                           Height="16"
                           Background="Transparent"
                           IsIndeterminate="True"
                           IsVisible="{Binding IsBusy}" />
              <TextBlock Classes="icon" FontSize="16" Text="&#xE72C;" IsVisible="{Binding !IsBusy}" />
            </Grid>
            <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Common.Refresh]}" />
          </StackPanel>
        </Button>

        <Button x:Name="GetDetailsButton"
                Height="36"
                HorizontalAlignment="Stretch"
                BorderThickness="0"
                Click="OnGetDetailsClick"
                IsEnabled="{Binding !IsDetailsBusy}">
          <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
            <ProgressBar Width="16"
                         Height="16"
                         Background="Transparent"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsDetailsBusy}" />
            <TextBlock Classes="icon" FontSize="16" Text="&#xE7C3;" IsVisible="{Binding !IsDetailsBusy}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Strings[TravelersDiary.GetDetails]}" />
          </StackPanel>
        </Button>

        <TextBlock FontSize="12"
                   Foreground="#FF6B6B"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasError}"
                   Text="{Binding ErrorText}" />
      </StackPanel>
    </Grid>

    <!-- ══ 右栏 ══════════════════════════════════════════════════════════ -->
    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="24" Spacing="16">

        <!-- 实时数据卡 -->
        <Border Padding="16"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                IsVisible="{Binding HasCurrentSummary}">
          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
            <TextBlock FontSize="18" Text="{Binding Strings[TravelersDiary.RealTimeData]}" />

            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
              <StackPanel Spacing="4">
                <TextBlock FontSize="12"
                           Foreground="{StaticResource StarTextSecondary}"
                           Text="{Binding Strings[TravelersDiary.AcquiredThisDay]}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock VerticalAlignment="Center" FontSize="20" Foreground="#FF8FE3FF" Text="&#x25C6;" />
                  <TextBlock FontSize="20" Text="{Binding DayPrimogems}" />
                  <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="20" Foreground="#FFFFD27A" Text="&#x25CF;" />
                  <TextBlock FontSize="20" Text="{Binding DayMora}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock FontSize="12"
                           Foreground="{StaticResource StarTextSecondary}"
                           Text="{Binding Strings[TravelersDiary.AcquiredThisMonth]}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock VerticalAlignment="Center" FontSize="20" Foreground="#FF8FE3FF" Text="&#x25C6;" />
                  <TextBlock FontSize="20" Text="{Binding MonthPrimogems}" />
                  <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="20" Foreground="#FFFFD27A" Text="&#x25CF;" />
                  <TextBlock FontSize="20" Text="{Binding MonthMora}" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Spacing="8">
              <TextBlock FontSize="12"
                         Foreground="{StaticResource StarTextSecondary}"
                         Text="{Binding Strings[TravelersDiary.PrimogemsObtained]}" />
              <controls:ColorRectChart Height="20" Series="{Binding CurrentSeries}" />
              <ItemsControl ItemsSource="{Binding CurrentSeries}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="controls:ChartLegend">
                    <StackPanel Margin="0,4,12,0" Orientation="Horizontal" Spacing="4">
                      <Border Width="12"
                              Height="12"
                              VerticalAlignment="Center"
                              Background="{Binding Color}"
                              CornerRadius="2" />
                      <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Legend}" />
                      <TextBlock VerticalAlignment="Center" FontSize="12">
                        <Run Text="{Binding Percent}" /><Run Text="%" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Border>

        <!-- 历史数据卡 -->
        <Border Padding="16"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                IsVisible="{Binding HasSelectedMonth}">
          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
            <TextBlock FontSize="18" Text="{Binding HistoryTitle}" />

            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
              <StackPanel Spacing="4">
                <TextBlock FontSize="12"
                           Foreground="{StaticResource StarTextSecondary}"
                           Text="{Binding Strings[TravelersDiary.AcquiredThisMonth]}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock VerticalAlignment="Center" FontSize="20" Foreground="#FF8FE3FF" Text="&#x25C6;" />
                  <TextBlock FontSize="20" Text="{Binding SelectPrimogems}" />
                  <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" FontSize="20" Foreground="#FFFFD27A" Text="&#x25CF;" />
                  <TextBlock FontSize="20" Text="{Binding SelectMora}" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Spacing="8">
              <TextBlock FontSize="12"
                         Foreground="{StaticResource StarTextSecondary}"
                         Text="{Binding Strings[TravelersDiary.PrimogemsObtained]}" />
              <controls:ColorRectChart Height="20" Series="{Binding SelectSeries}" />
              <ItemsControl ItemsSource="{Binding SelectSeries}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="controls:ChartLegend">
                    <StackPanel Margin="0,4,12,0" Orientation="Horizontal" Spacing="4">
                      <Border Width="12"
                              Height="12"
                              VerticalAlignment="Center"
                              Background="{Binding Color}"
                              CornerRadius="2" />
                      <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Legend}" />
                      <TextBlock VerticalAlignment="Center" FontSize="12">
                        <Run Text="{Binding Percent}" /><Run Text="%" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </Border>

        <!-- 每日数据表 -->
        <Border Padding="16"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                IsVisible="{Binding HasDailyData}">
          <StackPanel Spacing="8">
            <TextBlock FontSize="16"
                       Foreground="{StaticResource StarTextSecondary}"
                       Text="{Binding DailyDataTitle}" />


            <ItemsControl ItemsSource="{Binding DayDataList}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TravelersDiaryDayItem">
                  <Grid Margin="0,2" ColumnDefinitions="60,24,48,*,24,60,*" ColumnSpacing="8">
                    <TextBlock VerticalAlignment="Center" FontSize="13" Text="{Binding Day}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="#FF8FE3FF"
                               Text="&#x25C6;" />
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Text="{Binding Primogems}" />
                    <ProgressBar Grid.Column="3"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 Foreground="#A066BCF2"
                                 Maximum="1"
                                 Value="{Binding PrimogemsProgress}" />
                    <TextBlock Grid.Column="4"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="#FFFFD27A"
                               Text="&#x25CF;" />
                    <TextBlock Grid.Column="5"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Text="{Binding Mora}" />
                    <ProgressBar Grid.Column="6"
                                 Height="8"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 Foreground="#A0F2DE77"
                                 Maximum="1"
                                 Value="{Binding MoraProgress}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
