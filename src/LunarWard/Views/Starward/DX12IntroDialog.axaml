<controls:StarwardContentDialog xmlns="https://github.com/avaloniaui"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:controls="using:LunarWard.Views.Starward.Controls"
                                xmlns:local="using:LunarWard.Views.Starward"
                                x:Class="LunarWard.Views.Starward.DX12IntroDialog"
                                x:DataType="local:DX12IntroDialog"
                                MaxWidth="728">
  <!--
    1:1 复刻 Starward Features/GameLauncher/DX12IntroDialog.xaml（93 行）。
    上游是 ContentDialog(ContentDialogMaxWidth=1200, Padding=0) + Grid MaxWidth=680 Padding=24；
    源码用 GameDXConfig.DX11PreviewImage / DX12PreviewImage 官方截图 + I18nIntro 接口文案；
    LunarWard 没有这两张素材、也没有游戏 DX 配置接口，改用同尺寸占位面板 + 固定说明文案。
    关闭按钮与右上角 X 由 StarwardContentDialog 容器提供（上游自绘的 X 已删）。
  -->
  <Border MaxWidth="680" Padding="24">
    <Grid RowDefinitions="Auto,*">
      <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding Heading}" />

      <StackPanel Grid.Row="1" Spacing="20" Margin="0,20,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
          <Panel Width="300" Height="225">
            <Border CornerRadius="16" Background="{DynamicResource StarControlFillBrush}" />
            <Border Padding="0,4" VerticalAlignment="Bottom" Background="#8C000000" CornerRadius="0,0,16,16">
              <TextBlock HorizontalAlignment="Center" FontWeight="Bold" FontSize="12"
                         Foreground="{DynamicResource StarTextSecondary}" Text="{Binding RegularGraphics}" />
            </Border>
          </Panel>
          <Panel Width="300" Height="225">
            <Border CornerRadius="16" Background="{DynamicResource StarControlFillBrush}" />
            <Border Padding="0,4" VerticalAlignment="Bottom" Background="#8C000000" CornerRadius="0,0,16,16">
              <TextBlock HorizontalAlignment="Center" FontWeight="Bold" FontSize="12"
                         Foreground="{DynamicResource StarTextSecondary}" Text="{Binding EnhancedGraphics}" />
            </Border>
          </Panel>
        </StackPanel>

        <TextBlock FontSize="16" TextWrapping="Wrap"
                   Foreground="{DynamicResource StarTextPrimary}" Text="{Binding Description}" />
      </StackPanel>
    </Grid>
  </Border>
</controls:StarwardContentDialog>
