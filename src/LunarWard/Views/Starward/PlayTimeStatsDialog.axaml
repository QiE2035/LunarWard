<controls:StarwardContentDialog xmlns="https://github.com/avaloniaui"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:chart="using:LunarWard.Controls"
                                xmlns:controls="using:LunarWard.Views.Starward.Controls"
                                xmlns:loc="using:LunarWard.Localization"
                                x:Class="LunarWard.Views.Starward.PlayTimeStatsDialog"
                                MaxWidth="1008">

  <!-- Starward PlayTimeStatsDialog：1008×564 的内容（上游 ContentDialog 里就是 Grid Width=1008 Height=564），
       亚克力底/圆角/右上角 X 由 StarwardContentDialog 容器提供。 -->
  <Grid Width="1008" Height="548" RowDefinitions="Auto,*">

    <!-- 标题（Starward：标题 Margin 24,12,0,0；关闭按钮已收敛到容器右上角） -->
    <Grid Grid.Row="0" Margin="24,12,56,0">
      <TextBlock Text="{Binding [PlayTime.StatsTitle], Source={x:Static loc:AppStrings.Instance}}"
                 FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
    </Grid>

    <!-- 内容（Starward：Margin 24,12,24,24）；主窗口只有 676 高，内容超高时在框内滚动 -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,12,24,24">

      <!-- 统计卡片：3 列 × 2 行，间距 4 -->
      <Grid x:Name="StatCardsGrid" ColumnSpacing="4" RowSpacing="4" />

      <!-- 分段切换 + 区间总计（Starward：Margin 4,20,4,0） -->
      <Grid Margin="4,20,4,0">
        <Border Classes="segmented" Background="Transparent" Padding="0" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="RangeDaysButton" Classes="segmented selected" Click="OnRangeClick" Tag="0" MinWidth="60"
                    Content="{Binding [PlayTime.RangeDays], Source={x:Static loc:AppStrings.Instance}}" />
            <Button x:Name="RangeWeeksButton" Classes="segmented" Click="OnRangeClick" Tag="1" MinWidth="60"
                    Content="{Binding [PlayTime.RangeWeeks], Source={x:Static loc:AppStrings.Instance}}" />
            <Button x:Name="RangeMonthsButton" Classes="segmented" Click="OnRangeClick" Tag="2" MinWidth="60"
                    Content="{Binding [PlayTime.RangeMonths], Source={x:Static loc:AppStrings.Instance}}" />
          </StackPanel>
        </Border>
        <TextBlock x:Name="RangeTotalText" HorizontalAlignment="Right" VerticalAlignment="Center"
                   FontSize="12" Foreground="{DynamicResource StarTextSecondary}" />
      </Grid>

      <!-- 柱状图（Starward：Margin 0,20,0,0; PlotHeight 132） -->
      <chart:PlayTimeBarChart x:Name="BarChart" Margin="0,20,0,0" PlotHeight="132" />

      <!-- 日历热力图（Starward：Margin 0,24,0,0，方块自动铺满宽度） -->
      <chart:PlayTimeCalendarHeatmap x:Name="Heatmap" Margin="0,24,0,0" />

      <TextBlock x:Name="EmptyText" Margin="0,8,0,0"
                 Text="{Binding [PlayTime.Empty], Source={x:Static loc:AppStrings.Instance}}"
                 Foreground="{DynamicResource StarTextSecondary}"
                 TextWrapping="Wrap"
                 IsVisible="False" />
    </StackPanel>
    </ScrollViewer>
  </Grid>
</controls:StarwardContentDialog>
