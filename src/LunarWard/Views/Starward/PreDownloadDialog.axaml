<controls:StarwardContentDialog xmlns="https://github.com/avaloniaui"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:controls="using:LunarWard.Views.Starward.Controls"
                                xmlns:loc="using:LunarWard.Localization"
                                x:Class="LunarWard.Views.Starward.PreDownloadDialog"
                                MaxWidth="400">

    <!--  Starward Features/GameInstall/PreDownloadDialog.xaml：400 宽、24 内边距、标题 18 Bold、
          一块 12,8 的浅底卡片写三个体积、两条 Caution 警告、右下 Accent 主按钮。
          上游的悬浮层（ContentDialog + 亚克力 Border）与右上角关闭按钮由 StarwardContentDialog 容器提供。  -->
    <Border Width="400" Padding="24">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

            <TextBlock FontSize="18"
                       FontWeight="Bold"
                       Text="{Binding [Launcher.PreInstall], Source={x:Static loc:AppStrings.Instance}}" />

            <!--  体积信息卡  -->
            <Border Grid.Row="1"
                    Margin="0,20,0,0"
                    Padding="12,8"
                    Background="{DynamicResource StarControlFillBrush}"
                    CornerRadius="8">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,Auto">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource StarTextSecondary}"
                                   Text="{Binding [PreDownloadDialog.PackageSize], Source={x:Static loc:AppStrings.Instance}}" />
                        <TextBlock x:Name="PackageSizeValue" Grid.Column="1" Margin="4,0,0,0" FontSize="12" Foreground="{DynamicResource StarTextSecondary}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource StarTextSecondary}"
                                   Text="{Binding [InstallGameDialog.SpaceRequired], Source={x:Static loc:AppStrings.Instance}}" />
                        <TextBlock x:Name="UnzipSpaceValue" Grid.Column="1" Margin="4,0,0,0" FontSize="12" Foreground="{DynamicResource StarTextSecondary}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource StarTextSecondary}"
                                   Text="{Binding [InstallGameDialog.SpaceAvailable], Source={x:Static loc:AppStrings.Instance}}" />
                        <TextBlock x:Name="AvailableSpaceValue" Grid.Column="1" Margin="4,0,0,0" FontSize="12" Foreground="{DynamicResource StarTextSecondary}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  两条 Caution 警告（源码是同一 StackPanel 里两行）  -->
            <StackPanel Grid.Row="2" Margin="1,8,1,0" Spacing="4">
                <!--  无补丁包可用，建议先更新  -->
                <TextBlock x:Name="NoPatchesText"
                           FontSize="12"
                           Foreground="{DynamicResource StarCautionBrush}"
                           TextWrapping="Wrap"
                           IsVisible="False" />
                <!--  预下载不可用  -->
                <TextBlock x:Name="UnavailableText"
                           FontSize="12"
                           Foreground="{DynamicResource StarCautionBrush}"
                           TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>

            <!--  不兼容提醒（源码默认折叠，这里同样默认折叠）  -->
            <StackPanel x:Name="IncompatibilityPanel"
                        Grid.Row="4"
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        Spacing="4"
                        IsVisible="False">
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource StarTextSecondary}"
                           Text="{Binding [PreDownloadDialog.IncompatibilityNotice], Source={x:Static loc:AppStrings.Instance}}" />
                <Button Padding="4" Classes="link" ToolTip.Tip="{Binding [PreDownloadDialog.IncompatibilityNoticeContent], Source={x:Static loc:AppStrings.Instance}}">
                    <TextBlock Classes="icon" FontSize="12" Foreground="{DynamicResource StarTextSecondary}" Text="&#xE9CE;" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</controls:StarwardContentDialog>
