<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunarWard.ViewModels.Starward"
             x:Class="LunarWard.Views.Starward.Settings.SettingHotkeyView"
             x:DataType="vm:SettingHotkeyViewModel">

  <!--
    1:1 复刻 Starward Features/Setting/HotkeySetting.xaml（62 行）：
      17      20px「键盘快捷键」
      20-23   0,12 说明（14px 次要色）
      26-39   0,20 水平 StackPanel Spacing=12：TextBlock MinWidth=200 / 垂直居中「打开主窗口」
              + HotkeyInput（MinWidth=200）
      42-55   0,8 同样的行：「游戏截图」+ HotkeyInput
    行号均指 Starward/src/Starward/Features/Setting/HotkeySetting.xaml。

    HotkeyInput（Starward Features/Setting/HotkeyInput.xaml 117 行）的等价物：
      边框 1 / 圆角 4 / 文字「点击设置快捷键」（12,6 内边距、居中、次要色）。
      Linux 没有 RegisterHotKey 的等价 API，框保留位置、禁用；原因写在 tooltip 和
      下方 LunarWard 追加的说明里。

    LunarWard 追加（排在 Starward 两行之后）：
      Linux 全局热键说明 + .desktop 启动项位置 + 桌面入口内容预览。
  -->
  <ScrollViewer Background="{x:Null}"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel HorizontalAlignment="Stretch">

      <!-- HotkeySetting.xaml:17 -->
      <TextBlock Classes="section" Text="{Binding Strings[Settings.KeyboardShortcuts]}" />

      <!-- HotkeySetting.xaml:20-23（Starward 原文是「单键快捷键需管理员权限」，
           Linux 换成同样位置的说明） -->
      <TextBlock Margin="0,12,0,0"
                 Classes="description"
                 Text="{Binding Strings[Settings.Hotkey.SingleKeyTips]}" />

      <!-- HotkeySetting.xaml:26-39 「打开主窗口」 -->
      <StackPanel Margin="0,20,0,0" Orientation="Horizontal" Spacing="12">
        <TextBlock MinWidth="200"
                   VerticalAlignment="Center"
                   Text="{Binding Strings[Settings.Hotkey.OpenMainWindow]}" />

        <!-- HotkeySetting.xaml:32-38 HotkeyInput（禁用占位，视觉同 HotkeyInput.xaml） -->
        <Border MinWidth="200"
                Height="34"
                Background="Transparent"
                BorderBrush="{StaticResource StarTextTertiary}"
                BorderThickness="1"
                CornerRadius="4"
                ToolTip.Tip="{Binding Strings[Settings.Hotkey.HotkeyUnavailable]}">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="12,6"
                     Foreground="{StaticResource StarTextSecondary}"
                     Text="{Binding Strings[Settings.Hotkey.ClickToSet]}" />
        </Border>
      </StackPanel>

      <!-- HotkeySetting.xaml:42-55 「游戏截图」 -->
      <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="12">
        <TextBlock MinWidth="200"
                   VerticalAlignment="Center"
                   Text="{Binding Strings[Settings.Hotkey.GameScreenshot]}" />

        <!-- HotkeySetting.xaml:48-54 HotkeyInput（禁用占位） -->
        <Border MinWidth="200"
                Height="34"
                Background="Transparent"
                BorderBrush="{StaticResource StarTextTertiary}"
                BorderThickness="1"
                CornerRadius="4"
                ToolTip.Tip="{Binding Strings[Settings.Hotkey.HotkeyUnavailable]}">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="12,6"
                     Foreground="{StaticResource StarTextSecondary}"
                     Text="{Binding Strings[Settings.Hotkey.ClickToSet]}" />
        </Border>
      </StackPanel>

      <!-- ── LunarWard 追加：Linux 全局热键说明（Starward 没有这块）──────────── -->
      <TextBlock Margin="0,20,0,0"
                 Classes="section"
                 Text="{Binding Strings[Settings.Hotkey.LinuxSection]}" />

      <TextBlock Margin="0,12,0,0"
                 MaxWidth="820"
                 HorizontalAlignment="Left"
                 Classes="description"
                 Text="{Binding Strings[Settings.Hotkey.LinuxWay]}" />

      <!-- 桌面入口文件（等价于 Starward「热键已注册」的信息位） -->
      <Grid Margin="0,12,0,0" ColumnDefinitions="200,*" ColumnSpacing="12">
        <TextBlock Grid.Column="0"
                   MinWidth="200"
                   VerticalAlignment="Center"
                   Text="{Binding Strings[Settings.Hotkey.DesktopEntry]}" />

        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock FontFamily="{StaticResource StarMonoFontFamily}"
                     FontSize="12"
                     Foreground="{StaticResource StarTextSecondary}"
                     TextWrapping="Wrap"
                     Text="{Binding DesktopEntryPath}"
                     IsVisible="{Binding HasDesktopEntry}" />
          <TextBlock FontSize="12"
                     Foreground="{StaticResource StarTextSecondary}"
                     TextWrapping="Wrap"
                     Text="{Binding Strings[Settings.Hotkey.DesktopEntryMissing]}"
                     IsVisible="{Binding !HasDesktopEntry}" />
          <Button Height="32"
                  HorizontalAlignment="Left"
                  IsEnabled="{Binding HasDesktopEntry}"
                  Command="{Binding OpenDesktopEntryCommand}"
                  Content="{Binding Strings[Settings.Hotkey.OpenDesktopEntry]}" />
        </StackPanel>
      </Grid>

      <!-- 桌面入口内容（只读展示） -->
      <TextBlock Margin="0,20,0,0"
                 Classes="section"
                 Text="{Binding Strings[Settings.Hotkey.DesktopEntryContent]}" />

      <Border Classes="card" Margin="0,12,0,0">
        <TextBox IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="{StaticResource StarMonoFontFamily}"
                 FontSize="12"
                 Background="Transparent"
                 BorderThickness="0"
                 Text="{Binding DesktopEntryPreview}" />
      </Border>

      <TextBlock Margin="0,8,0,0"
                 FontSize="12"
                 Foreground="{StaticResource StarCautionBrush}"
                 TextWrapping="Wrap"
                 Text="{Binding Status}"
                 IsVisible="{Binding HasStatus}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
