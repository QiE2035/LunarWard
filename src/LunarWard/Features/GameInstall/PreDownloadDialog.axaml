<?xml version="1.0" encoding="utf-8" ?>
<controls:StarwardContentDialog x:Class="LunarWard.Features.GameInstall.PreDownloadDialog"
                           xmlns:controls="using:LunarWard.Views.Starward.Controls"
               xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:lang="using:LunarWard.Language"
               xmlns:local="using:LunarWard.Features.GameInstall"
               xmlns:sh="using:LunarWard.Helpers"
               x:CompileBindings="False"
               Background="{DynamicResource CustomAcrylicBrush}"
               BorderThickness="0"
               CornerRadius="8">

    <Border Padding="24"><Grid Width="400">

        <StackPanel>

            <!--  Title  -->
            <TextBlock FontSize="18"
                       FontWeight="Bold"
                       Text="{x:Static lang:Lang.LauncherPage_PreInstall}" />

            <Border Margin="0,20,0,0"
                    Padding="12,8,12,8"
                    CornerRadius="8">
                <StackPanel Spacing="8">
                    <!--  安装包大小  -->
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="">
                        <Run Text="{x:Static lang:Lang.DownloadGameDialog_PackageSize}" />
                        <Run Text="" />
                        <Run Text="{Binding PackageSizeText}" />
                    </TextBlock>
                    <!--  解压占用空间  -->
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="">
                        <Run Text="{x:Static lang:Lang.InstallGameDialog_SpaceRequiredToUnzip}" />
                        <Run Text="" />
                        <Run Text="{Binding UnzipSpaceText}" />
                    </TextBlock>
                    <!--  可以空间  -->
                    <TextBlock x:Name="TextBlock_AvailableSpace"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Static lang:Lang.InstallGameDialog_SpaceAvailable}" />
                        <Run Text="" />
                        <Run Text="{Binding AvailableSpaceText}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--  无补丁包可用，建议先更新  -->
            <TextBlock x:Name="TextBlock_NoPatches"
                       Margin="1,8,1,0"
                       FontSize="12"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Text="{x:Static lang:Lang.PreDownloadDialog_NoPatchesWarning}"
                       TextWrapping="Wrap"
                       IsVisible="False" />

            <!--  预下载不可用  -->
            <TextBlock x:Name="TextBlock_PredownloadUnavailable"
                       Margin="1,8,1,0"
                       FontSize="12"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Text="{x:Static lang:Lang.PreDownloadDialog_PreInstallIsNotAvailable}"
                       TextWrapping="Wrap"
                       IsVisible="False" />

            <!--  Start Predownload  -->
            <Button x:Name="Button_StartPredownload"
                    Grid.Column="2"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding StartPredownloadCommand}"
                    Content="{x:Static lang:Lang.PreDownloadDialog_StartPreInstall}"
                    FontSize="14"
                    IsEnabled="False" Classes="accent" />

        </StackPanel>

        <!--  不兼容提醒  -->
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="4"
                    IsVisible="False">
            <TextBlock Margin="0,0,0,2"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static lang:Lang.PreDownloadDialog_IncompatibilityNotice}" />
            <Button Padding="4" Cursor="Hand">
                <TextBlock Classes="icon" Text="&#xE9CE;" FontSize="12"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Button.Flyout>
                    <Flyout>
                        <TextBlock MaxWidth="380"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{x:Static lang:Lang.PreDownloadDialog_IncompatibilityNoticeContent}"
                                   TextWrapping="Wrap" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <!--  Close Button  -->
        <Button Width="32"
                Height="32"
                Margin="-20"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                BorderThickness="0"
                Command="{Binding CloseDialogCommand}"
                CornerRadius="8">
            <TextBlock Classes="icon" Text="&#xE711;" FontSize="16"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Button>

    </Grid>
    </Border>

</controls:StarwardContentDialog>
