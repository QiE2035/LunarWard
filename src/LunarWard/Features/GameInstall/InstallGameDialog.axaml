<?xml version="1.0" encoding="utf-8" ?>
<controls:StarwardContentDialog x:Class="LunarWard.Features.GameInstall.InstallGameDialog"
                           xmlns:controls="using:LunarWard.Views.Starward.Controls"
               xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:lang="using:LunarWard.Language"
               xmlns:local="using:LunarWard.Features.GameInstall"
               xmlns:sh="using:LunarWard.Helpers"
               x:CompileBindings="False"
               Background="{DynamicResource CustomAcrylicBrush}"
               BorderThickness="0"
               CornerRadius="8">

    <Border Padding="24"><Grid Width="560">

        <StackPanel>

            <!--  Title  -->
            <TextBlock FontSize="18"
                       FontWeight="Bold"
                       Text="{x:Static lang:Lang.InstallGameDialog_SelectInstallationPath}" />

            <!--  Path  -->
            <Border CornerRadius="8"><Grid Height="36" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TextBlock_InstallationPath"
                           Margin="12,4,12,4"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           MaxLines="2"
                           Text="{Binding InstallationPath}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" />
                <!--  Change Path  -->
                <Button Grid.Column="1"
                        Padding="12,0,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        BorderThickness="0"
                        Command="{Binding ChangeInstallationPathCommand}"
                        CornerRadius="8">
                    <TextBlock FontSize="14"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               Text="{x:Static lang:Lang.Common_Change}" />
                </Button>
            </Grid></Border>

            <!--  Select Language  -->
            <ListBox x:Name="Segmented_SelectLanguage"
                     Margin="0,8,0,0"
                     HorizontalAlignment="Stretch"
                     SelectionChanged="Segmented_SelectLanguage_SelectionChanged"
                     SelectionMode="Multiple"
                     IsVisible="False">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem Content="{x:Static lang:Lang.Language_Chinese}" Tag="zh-cn" />
                <ListBoxItem Content="{x:Static lang:Lang.Language_English}" Tag="en-us" />
                <ListBoxItem Content="{x:Static lang:Lang.Language_Japanese}" Tag="ja-jp" />
                <ListBoxItem Content="{x:Static lang:Lang.Language_Korean}" Tag="ko-kr" />
            </ListBox>

            <!--  Free Space  -->
            <StackPanel x:Name="StackPanel_FreeSpace"
                        Margin="1,8,0,0"
                        Orientation="Horizontal"
                        Spacing="8"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource ObjectToVisibilityReversedConverter}}">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="">
                    <Run Text="{x:Static lang:Lang.InstallGameDialog_SpaceRequiredToUnzip}" />
                    <Run Text="" />
                    <Run Text="{Binding UnzipSpaceText}" />
                </TextBlock>
                <Separator Margin="0,2" />
                <TextBlock x:Name="TextBlock_AvailableSpace"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Static lang:Lang.InstallGameDialog_SpaceAvailable}" />
                    <Run Text="" />
                    <Run Text="{Binding AvailableSpaceText}" />
                </TextBlock>
            </StackPanel>

            <!--  不要选择驱动器的根目录  -->
            <TextBlock Margin="1,8,1,0"
                       FontSize="12"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource ObjectToVisibilityConverter}}" />

            <!--  Auto Create Subfolder  -->
            <CheckBox Margin="0,8,0,0" IsChecked="{Binding AutomaticallyCreateSubfolderForInstall, Mode=TwoWay}">
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{x:Static lang:Lang.InstallGameDialog_AutomaticallyCreateASubfolder}" />
            </CheckBox>

            <!--  Start Install  -->
            <Button x:Name="Button_StartInstallation"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding StartInstallationCommand}"
                    Content="{x:Static lang:Lang.InstallGameDialog_StartInstallation}"
                    FontSize="14"
                    IsEnabled="False" Classes="accent" />

        </StackPanel>

        <!--  Support Hard Links  -->
        <StackPanel x:Name="StackPanel_HardLink"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="4"
                    IsVisible="False">
            <TextBlock Margin="0,0,0,2"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static lang:Lang.InstallGameDialog_SupportHardLinks}" />
            <Button Padding="4" Cursor="Hand">
                <TextBlock Classes="icon" Text="&#xE9CE;" FontSize="12"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Button.Flyout>
                    <Flyout>
                        <TextBlock MaxWidth="380"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{x:Static lang:Lang.InstallGameDialog_HardLinkDesc}"
                                   TextWrapping="Wrap" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <!--  Close Button  -->
        <Button Width="32"
                Height="32"
                Margin="-20"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                BorderThickness="0"
                Command="{Binding CloseDialogCommand}"
                CornerRadius="8">
            <TextBlock Classes="icon" Text="&#xE711;" FontSize="16"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Button>

    </Grid>
    </Border>

</controls:StarwardContentDialog>
