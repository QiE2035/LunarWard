<local:MainWindow xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:helpers="using:LunarWard.Helpers"
                  xmlns:local="using:LunarWard.Features.ViewHost"
                  xmlns:dh="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
                  x:Class="LunarWard.Features.ViewHost.MainWindow"
                  Title="LunarWard">

  <!--
    上游 Features/ViewHost/MainWindow.xaml 的 1:1 移植：
    MainView + 底部通知区（InAppToast 挂在该 StackPanel 上）。
    Avalonia 差异：InAppToast 不是 Behavior 而是 StackPanel 自身（见 Helpers/InAppToast.cs），
    因此这里直接放一个 <helpers:InAppToast/> 到通知区。docs/09 §五。
  -->

  <!--
    平台等价：WinUI 的 ContentDialog 是「窗口内浮层」，Avalonia 用 DialogHost.Avalonia 提供同一语义。
    旧壳 Views/Starward/MainWindow 同样用它；新外壳在这里也放一个，`DialogService` 会优先取它。
  -->
  <dh:DialogHost x:Name="RootDialogHost" CloseOnClickAway="False" OverlayBackground="Transparent">

  <Grid Background="{DynamicResource StarAcrylicBrush}">

    <local:MainView x:Name="MainContentHost"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

    <!-- 对话框遮罩：DialogHost 的 OverlayBackground 设为透明，由这一层负责可淡入淡出的暗化（旧壳同款）。 -->
    <Border x:Name="DialogScrim"
            Background="#66000000"
            IsHitTestVisible="False"
            Opacity="0" />

    <StackPanel MaxWidth="600"
                Margin="24,72,24,72"
                VerticalAlignment="Bottom">
      <helpers:InAppToast Tag="MainWindow" />
    </StackPanel>

  </Grid>

  </dh:DialogHost>

</local:MainWindow>
