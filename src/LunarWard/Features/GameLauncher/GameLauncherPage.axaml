<sf:PageBase xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fw="using:LunarWard.Frameworks"
             xmlns:controls="using:LunarWard.Views.Starward.Controls"
             xmlns:lang="using:LunarWard.Language"
             xmlns:core="using:LunarWard.Core.HoYoPlay"
             xmlns:local="using:LunarWard.Features.GameLauncher"
             xmlns:sc="using:LunarWard.Controls"
             xmlns:sf="using:LunarWard.Frameworks"
             xmlns:sfc="using:LunarWard.Features.CloudGame"
             xmlns:sfg="using:LunarWard.Features.GameInstall"
             xmlns:sfgd="using:LunarWard.Features.GameRecord.DailyNote"
             xmlns:sfp="using:LunarWard.Features.PlayTime"
             xmlns:sfga="using:LunarWard.Features.GameAccount"
             x:Class="LunarWard.Features.GameLauncher.GameLauncherPage"
             x:CompileBindings="False">

    <sf:PageBase.Styles>
        <StyleInclude Source="avares://LunarWard/Features/GameLauncher/CompactCheckBoxStyle.axaml" />
    </sf:PageBase.Styles>






    <Grid x:Name="RootGrid"
          DragDrop.AllowDrop="True"
          Background="Transparent"
          DragDrop.DragLeave="RootGrid_DragLeave"
          DragDrop.DragOver="RootGrid_DragOver"
          DragDrop.Drop="RootGrid_Drop">

        <!--  拖放图片/视频文件提醒  -->
        <Border x:Name="Border_BackgroundDragIn"
                Margin="0,40,0,0"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{DynamicResource ControlOnImageFillColorDefaultBrush}"
                CornerRadius="8"
                IsHitTestVisible="False"
                Opacity="0">
            <StackPanel HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                <TextBlock FontSize="24"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Classes="icon" Text="&#xE91B;" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{x:Static lang:Lang.GameLauncherSettingDialog_DragAndDropImageOrVideoFiles}}" />
            </StackPanel>
        </Border>

        <!--  背景图切换  -->
        <Border x:Name="Border_SwitchBackgroundImage"
                Height="60"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Opacity="0"
                PointerEntered="Border_SwitchBackgroundImage_PointerEntered"
                PointerExited="Border_SwitchBackgroundImage_PointerExited"
                PointerWheelChanged="Border_SwitchBackgroundImage_PointerWheelChanged"
                IsVisible="False">
            <StackPanel Margin="20,0,0,4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        Orientation="Horizontal"
                        Spacing="4">
                <!--  index 指示器  -->
                <!--  平台替换：WinUI PipsPager 无 Avalonia 等价控件，用圆点指示当前背景（点击切换）。  -->
                <ItemsControl x:Name="ItemsControl_SwitchBackgroundImage"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              ItemsSource="{Binding BackgroundImages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="6"
                                    Height="6"
                                    Margin="2"
                                    Background="{DynamicResource StarTextTertiary}"
                                    CornerRadius="3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator Margin="0,4" />
                <!--  图库  -->
                <Button Padding="4"
                        VerticalAlignment="Center"
                        Command="{Binding OpenBackgroundViewWindowCommand}"
                        
                        ToolTip.Tip="{x:Static lang:Lang.GameLauncherPage_Gallery}">
                    <TextBlock FontSize="16"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Classes="icon" Text="&#xE91B;"
                               />
                </Button>
                <!--  复制  -->
                <Button Padding="4"
                        VerticalAlignment="Center"
                        Command="{Binding CopyCurrentBackgroundImageCommand}"
                        
                        ToolTip.Tip="{x:Static lang:Lang.Common_Copy}}">
                    <TextBlock FontSize="16"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Classes="icon" Text="&#xE8C8;"
                               />
                </Button>
                <!--  另存为  -->
                <Button Padding="4"
                        Command="{Binding SaveCurrentBackgroundImageCommand}"
                        
                        ToolTip.Tip="{x:Static lang:Lang.ImageViewWindow2_SaveAs}}">
                    <TextBlock FontSize="16"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Classes="icon" Text="&#xE74E;"
                               />
                </Button>
                <!--  播放/暂停  -->
                <Button Padding="4"
                        Command="{Binding StartOrStopVideoBackgroundCommand}"
                        
                        ToolTip.Tip="{x:Static lang:Lang.GameLauncherPage_PlayPause}}"
                        IsVisible="{Binding CanStopVideo}">
                    <fw:FontIcon FontSize="16"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Glyph="{Binding StartStopButtonIcon}"
                               />
                </Button>
                <!--  占位  -->
                <Button Padding="4"
                        IsHitTestVisible="False"
                        Opacity="0"
                        
                        IsVisible="{Binding CanStopVideo, Converter={StaticResource BoolReversed}}">
                    <fw:FontIcon FontSize="16"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Glyph="{Binding StartStopButtonIcon}"
                               />
                </Button>
            </StackPanel>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.0" Color="#00000000" />
                    <GradientStop Offset="1.0" Color="#88000000" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!--  游戏通知  -->
        <local:GameBannerAndPost x:Name="GameBannerAndPost"
                                 Margin="60,0,0,40"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Bottom"
                                 CurrentGameId="{Binding CurrentGameId}" />

        <!--  右下角按键  -->
        <Grid Margin="0,0,40,0"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              ColumnSpacing="12">

            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>



            <!--  预下载  -->
            <sfg:PreDownloadButton x:Name="Button_Predownload"
                                   Grid.Column="0"
                                   IsPredownloadFinished="{Binding IsPredownloadFinished}"
                                   PredownloadCommand="{Binding PredownloadCommand}"
                                   IsVisible="{Binding IsPredownloadButtonEnabled}" />

            <!--  游戏时间  -->
            <sfp:PlayTimeButton x:Name="Button_PlayTime"
                                Grid.Column="1"
                                CurrentGameBiz="{Binding CurrentGameBiz}" />

            <!--  启动游戏  -->
            <local:StartGameButton x:Name="Button_StartGame"
                                   Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   GameCommand="{Binding ClickStartGameButtonCommand}"
                                   GameState="{Binding GameState}"
                                   RunningGameInfo="{Binding RunningGameInfo}"
                                   RunningGameTime="{Binding RunningGameTime}"
                                   SettingCommand="{Binding OpenGameLauncherSettingDialogCommand}" />


            <!--  文字阴影  -->
            <Border x:Name="Border_TextShadowTarget"
                    Grid.Row="1"
                    Grid.Column="2" />


            <!--  定位游戏  -->
            <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        IsVisible="{Binding InstalledLocateGameEnabled}">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource StarTextSecondary}"
                           Text="{x:Static lang:Lang.InstallGameDialog_Installed}" />
                <Button Classes="link"
                        Padding="0"
                        FontSize="12"
                        Foreground="{DynamicResource StarCautionBrush}"
                        Click="Hyperlink_LocateGame_Click"
                        Content="{x:Static lang:Lang.InstallGameDialog_LocateGame}" />
            </StackPanel>

            <!--  可移动存储设备未连接  -->
            <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        IsVisible="{Binding IsInstallPathRemovableTipEnabled}">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource StarTextSecondary}"
                           Text="{x:Static lang:Lang.GameLauncherPage_RemovableStorageDeviceNotConnected}" />
                <Button Classes="link"
                        Padding="0"
                        FontSize="12"
                        Foreground="{DynamicResource StarCautionBrush}"
                        Click="Hyperlink_LocateGame_Click"
                        Content="{x:Static lang:Lang.GameLauncherPage_Relocate}" />
            </StackPanel>

            <!--  DX12 选项  -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Padding="10,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ControlOnImageFillColorDefaultBrush}"
                    CornerRadius="12"
                    IsVisible="{Binding IsDX12OptionVisible}">

                <StackPanel Margin="0,-2,0,-2"
                            Orientation="Horizontal"
                            Spacing="8">
                    <CheckBox MinWidth="0"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              IsChecked="{Binding EnableDX12, Mode=TwoWay}"
                              Classes="compact">
                        <TextBlock Margin="-2,0,0,4"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   
                                   Text="{x:Static lang:Lang.GameLauncherPage_LaunchWithDX12}}" />
                    </CheckBox>
                    <Button x:Name="Hyperlink_DX12Intro"
                            Classes="link"
                            Padding="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Click="Hyperlink_DX12Intro_Click"
                            Content="{x:Static lang:Lang.GameLauncherPage_DetailsGt}" />
                </StackPanel>
            </Border>


        </Grid>

        <!--  游戏账号切换  -->
        <sfga:GameAccountSwitcher x:Name="GameLauncherPage_GameAccountSwitcher"
                                  Margin="0,0,40,100"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  x:Load="{Binding EnableGameAccountSwitcher}"
                                  CurrentGameBiz="{Binding CurrentGameBiz}" />

        <!--  崩坏三区服选择  -->
        <ComboBox Height="28"
                  Margin="172,14,0,0"
                  Padding="18.5,0,8,0"
                  ItemsSource="{Binding GameServers}"
                  SelectedItem="{Binding SelectedGameServer, Mode=TwoWay}"
                  IsVisible="{Binding GameServers, Converter={StaticResource ObjectToVisibility}}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:GameServerConfig">
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               
                               Text="{Binding I18nDescription}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!--  右边侧栏  -->
        <StackPanel Margin="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Spacing="4">
            <!--  云游戏  -->
            <sfc:CloudGameButton x:Name="Button_CloudGame"
                                 Width="40"
                                 Height="40"
                                 CurrentGameId="{Binding CurrentGameId}"
                                 IsVisible="False" />
            <!--  每日便笺  -->
            <sfgd:DailyNoteButton Width="40"
                                  Height="40"
                                  CurrentGameId="{Binding CurrentGameId}" />
            <!--  通行证授权登录  -->
            <local:GameAuthLoginButton Width="40"
                                       Height="40"
                                       CurrentGameId="{Binding CurrentGameId}" />
        </StackPanel>

    </Grid>

</sf:PageBase>
