<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LunarWard.Features.GameLauncher"
             x:Class="LunarWard.Features.GameLauncher.GameAuthLoginButton"
             x:DataType="local:GameAuthLoginButton">
  <!-- 移植自 Starward/src/Starward/Features/GameLauncher/GameAuthLoginButton.xaml -->
  <Button Name="Button_GameAuthLogin"
          Padding="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          BorderThickness="0"
          CornerRadius="8"
          Loaded="Button_GameAuthLogin_Loaded">
    <Grid>
      <Border Width="24" Height="24" CornerRadius="4">
        <Image Width="24"
               Height="24"
               Stretch="UniformToFill"
               Source="avares://LunarWard/Assets/Image/icon_hyperion.png" />
      </Border>
      <Image Name="Image_GameAuthLoginErrorAlert"
             Width="20"
             Margin="0,-10,-10,0"
             HorizontalAlignment="Right"
             VerticalAlignment="Top"
             Source="avares://LunarWard/Assets/Image/alert.png"
             IsVisible="{Binding ErrorMessage, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />
    </Grid>
    <Button.Flyout>
      <Flyout Placement="BottomEdgeAlignedLeft">
        <StackPanel Spacing="12">
          <Border Width="60"
                  Height="60"
                  HorizontalAlignment="Center"
                  CornerRadius="8">
            <Image Source="avares://LunarWard/Assets/Image/icon_hyperion.png" Stretch="UniformToFill" />
          </Border>
          <TextBlock HorizontalAlignment="Center">
            <Run Text="通行证 ID: " />
            <Run Text="{Binding HyperionAid, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Foreground="{DynamicResource StarTextSecondary}"
                     Text="{Binding ErrorMessage, Mode=OneWay}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding ErrorMessage, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />
          <Button MinWidth="120"
                  HorizontalAlignment="Center"
                  Command="{Binding InitializeGameAuthLoginCommand}"
                  Content="重新认证"
                  IsVisible="{Binding ErrorMessage, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />
          <ToggleSwitch HorizontalAlignment="Center"
                        IsChecked="{Binding EnableLoginAuthTicket, Mode=TwoWay}"
                        OffContent="已禁用授权登录"
                        OnContent="已启用授权登录" />
        </StackPanel>
      </Flyout>
    </Button.Flyout>
  </Button>
</UserControl>
