<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="using:LunarWard.Language"
             xmlns:local="using:LunarWard.Features.Setting"
             x:Class="LunarWard.Features.Setting.HotkeySetting"
             x:DataType="local:HotkeySetting">

  <!--
    1:1 复刻 Starward Features/Setting/HotkeySetting.xaml（62 行）：
      17      20px「键盘快捷键」
      20-23   0,12 说明（14px 次要色）
      26-39   0,20 水平 StackPanel Spacing=12：TextBlock MinWidth=200 / 垂直居中「打开主窗口」
              + HotkeyInput（MinWidth=200）
      42-55   0,8 同样的行：「游戏截图」+ HotkeyInput
    行号均指 Starward/src/Starward/Features/Setting/HotkeySetting.xaml。

    HotkeyInput（Starward Features/Setting/HotkeyInput.xaml 117 行）见同目录 HotkeyInput.axaml：
      边框 1 / 圆角 4 /「点击设置快捷键」/ 编辑中 / 当前快捷键 / 警告 四态，键位文本格式同上游。
      Linux 没有 RegisterHotKey 的等价 API：组合键可以录制并保存，但不会全局触发；
      说明写在下方 LunarWard 追加的段落里。

    LunarWard 追加（排在 Starward 两行之后）：
      Linux 全局热键说明 + .desktop 启动项位置 + 桌面入口内容预览。
  -->
  <ScrollViewer Background="{x:Null}"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel HorizontalAlignment="Stretch">

      <!-- HotkeySetting.xaml:17 -->
      <TextBlock Classes="section" Text="{x:Static lang:Lang.SettingPage_KeyboardShortcuts}" />

      <!-- HotkeySetting.xaml:20-23（Starward 原文是「单键快捷键需管理员权限」，
           Linux 换成同样位置的说明） -->
      <TextBlock Margin="0,12,0,0"
                 Classes="description"
                 Text="{Binding Strings[Settings.Hotkey.SingleKeyTips]}" />

      <!-- HotkeySetting.xaml:26-39 「打开主窗口」 -->
      <StackPanel Margin="0,20,0,0" Orientation="Horizontal" Spacing="12">
        <TextBlock MinWidth="200"
                   VerticalAlignment="Center"
                   Text="{x:Static lang:Lang.HotkeySetting_OpenMainWindow}" />

        <!-- HotkeySetting.xaml:32-38 HotkeyInput（控件实现见 HotkeyInput.axaml） -->
        <local:HotkeyInput x:Name="HotkeyInput_ShowMainWindow"
                          MinWidth="200"
                          HotkeyId="44444"
                          HotkeyDeleted="HotkeyInput_HotkeyDeleted"
                          HotkeyEditFinished="HotkeyInput_HotkeyEditFinished"
                          HotkeyEditing="HotkeyInput_HotkeyEditing" />
      </StackPanel>

      <!-- HotkeySetting.xaml:42-55 「游戏截图」 -->
      <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="12">
        <TextBlock MinWidth="200"
                   VerticalAlignment="Center"
                   Text="{x:Static lang:Lang.GamepadControlSetting_GameScreenshot}" />

        <!-- HotkeySetting.xaml:48-54 HotkeyInput -->
        <local:HotkeyInput x:Name="HotkeyInput_ScreenshotCapture"
                          MinWidth="200"
                          HotkeyId="44445"
                          HotkeyDeleted="HotkeyInput_HotkeyDeleted"
                          HotkeyEditFinished="HotkeyInput_HotkeyEditFinished"
                          HotkeyEditing="HotkeyInput_HotkeyEditing" />
      </StackPanel>

      <!-- ── LunarWard 追加：Linux 全局热键说明（Starward 没有这块）──────────── -->
      <TextBlock Margin="0,20,0,0"
                 Classes="section"
                 Text="{Binding Strings[Settings.Hotkey.LinuxSection]}" />

      <TextBlock Margin="0,12,0,0"
                 MaxWidth="820"
                 HorizontalAlignment="Left"
                 Classes="description"
                 Text="{Binding Strings[Settings.Hotkey.LinuxWay]}" />

      <!-- 桌面入口文件（等价于 Starward「热键已注册」的信息位） -->
      <Grid Margin="0,12,0,0" ColumnDefinitions="200,*" ColumnSpacing="12">
        <TextBlock Grid.Column="0"
                   MinWidth="200"
                   VerticalAlignment="Center"
                   Text="{Binding Strings[Settings.Hotkey.DesktopEntry]}" />

        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock FontFamily="{StaticResource StarMonoFontFamily}"
                     FontSize="12"
                     Foreground="{StaticResource StarTextSecondary}"
                     TextWrapping="Wrap"
                     Text="{Binding DesktopEntryPath}"
                     IsVisible="{Binding HasDesktopEntry}" />
          <TextBlock FontSize="12"
                     Foreground="{StaticResource StarTextSecondary}"
                     TextWrapping="Wrap"
                     Text="{Binding Strings[Settings.Hotkey.DesktopEntryMissing]}"
                     IsVisible="{Binding !HasDesktopEntry}" />
          <Button Height="32"
                  HorizontalAlignment="Left"
                  IsEnabled="{Binding HasDesktopEntry}"
                  Command="{Binding OpenDesktopEntryCommand}"
                  Content="{Binding Strings[Settings.Hotkey.OpenDesktopEntry]}" />
        </StackPanel>
      </Grid>

      <!-- 桌面入口内容（只读展示） -->
      <TextBlock Margin="0,20,0,0"
                 Classes="section"
                 Text="{Binding Strings[Settings.Hotkey.DesktopEntryContent]}" />

      <Border Classes="card" Margin="0,12,0,0">
        <TextBox IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="{StaticResource StarMonoFontFamily}"
                 FontSize="12"
                 Background="Transparent"
                 BorderThickness="0"
                 Text="{Binding DesktopEntryPreview}" />
      </Border>

      <TextBlock Margin="0,8,0,0"
                 FontSize="12"
                 Foreground="{StaticResource StarCautionBrush}"
                 TextWrapping="Wrap"
                 Text="{Binding Status}"
                 IsVisible="{Binding HasStatus}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
