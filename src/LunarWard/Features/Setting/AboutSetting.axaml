<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="using:LunarWard.Language"
             xmlns:local="using:LunarWard.Features.Setting"
             x:Class="LunarWard.Features.Setting.AboutSetting"
             x:DataType="local:AboutSetting">

  <!--
    1:1 复刻 Starward Features/Setting/AboutSetting.xaml（135 行）：
      18-22  Image 160×160（Logo，左对齐）
      24-27  0,12 → 24px Bold 应用名
      28     0,4  → 副标题（14px 次要色）
      32-39  0,12 → 「当前版本：」+ 版本号（SemiBold、强调色）
      43-46  0,12 → 预览版渠道 ToggleSwitch
      47-85  0,4  → Grid ColumnSpacing=16：检查更新强调按钮（40 高 / Padding 12,0,16,0 /
              CornerRadius 4,20,20,4）+ 状态列（已是最新版 / ProgressRing / 错误文字）
      89-91  0,20 → 20px「相关链接」
      92-126 每条链接 0,8、左对齐、粗体强调色（Starward 用 Hyperlink+Run，这里用透明
              按钮等价物，视觉一致）
    行号均指 Starward/src/Starward/Features/Setting/AboutSetting.xaml。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel HorizontalAlignment="Stretch">

      <!-- AboutSetting.xaml:18-22 -->
      <!-- Starward 是 Assets/logo.png；LunarWard 没有独立 logo，用强调色底 + 月亮图标占位 -->
      <Border Width="160" Height="160"
              HorizontalAlignment="Left"
              CornerRadius="24"
              Background="{StaticResource StarAccentBrush}">
        <TextBlock Classes="icon"
                   FontSize="80"
                   Foreground="{StaticResource StarAccentForegroundBrush}"
                   Text="&#xE708;" />
      </Border>

      <!-- AboutSetting.xaml:24-27 -->
      <TextBlock Margin="0,12,0,0"
                 FontSize="24"
                 FontWeight="Bold"
                 Text="{Binding AppName}" />

      <!-- AboutSetting.xaml:28（Starward：「Developed by Scighost, all rights reserved.」） -->
      <TextBlock Margin="0,4,0,0"
                 Classes="description"
                 Text="Linux 下的《原神》/《绝区零》启动器" />

      <!-- AboutSetting.xaml:32-39 -->
      <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="4">
        <TextBlock Text="{x:Static lang:Lang.SettingPage_CurrentVersion}" />
        <TextBlock FontWeight="SemiBold"
                   Foreground="{StaticResource StarAccentBrush}"
                   Text="{Binding Version}" />
      </StackPanel>

      <!-- LunarWard 追加：Linux 运行环境（Starward 没有；排查启动问题用）。
           只读 /proc 与 /sys，不调用外部命令，见 LinuxSystemInfo。 -->
      <Border Margin="0,16,0,0"
              Padding="12,10"
              Background="#0FFFFFFF"
              CornerRadius="8">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="110,*">
            <TextBlock Text="系统内核" />
            <TextBlock Grid.Column="1" Text="{Binding System.Kernel}" />
          </Grid>
          <Grid ColumnDefinitions="110,*">
            <TextBlock Text="桌面会话" />
            <TextBlock Grid.Column="1" Text="{Binding System.Session}" />
          </Grid>
          <Grid ColumnDefinitions="110,*">
            <TextBlock Text="显卡驱动" />
            <TextBlock Grid.Column="1" Text="{Binding System.GpuDriver}" />
          </Grid>
          <Grid ColumnDefinitions="110,*">
            <TextBlock Text="显卡 PCI ID" />
            <TextBlock Grid.Column="1" Text="{Binding System.GpuPciId}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- AboutSetting.xaml:43-46 预览版更新渠道（写回 AppConfig.EnablePreviewRelease） -->
      <ToggleSwitch Margin="0,12,0,0"
                    IsChecked="{Binding EnablePreviewRelease, Mode=TwoWay}"
                    OffContent="{x:Static lang:Lang.SettingPage_JoinPreviewReleaseChannel}"
                    OnContent="{x:Static lang:Lang.SettingPage_JoinPreviewReleaseChannel}" />

      <!-- AboutSetting.xaml:47-85 检查更新：按钮 +「已是最新版 / 错误文字」，
           有新版由 UpdateWindow 弹出（与上游同一路径）。 -->
      <Grid Margin="0,4,0,0" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- AboutSetting.xaml:54-64 -->
        <Button Grid.Column="0"
                Height="40"
                Padding="12,0,16,0"
                BorderThickness="0"
                CornerRadius="4,20,20,4"
                Classes="accent"
                Command="{Binding CheckUpdateCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" FontSize="16" Text="&#xE752;" />
            <TextBlock Text="{x:Static lang:Lang.SettingPage_CheckForUpdate}" />
          </StackPanel>
        </Button>

        <!-- AboutSetting.xaml:66-73 已是最新版本（TextBlock + 两个 Run） -->
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   IsVisible="{Binding LatestVersion, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Run Foreground="{StaticResource StarTextSecondary}"
               Text="{x:Static lang:Lang.AboutSetting_UpdatedToTheLatestVersion}" />
          <Run Foreground="{StaticResource StarSuccessBrush}" Text="{Binding LatestVersion}" />
        </TextBlock>

        <!-- Starward 的 ProgressRing；Avalonia 没有该控件，用不确定进度条（同 DownloadSetting） -->
        <ProgressBar Grid.Column="1"
                     Width="120"
                     Height="3"
                     VerticalAlignment="Center"
                     IsIndeterminate="True"
                     IsVisible="{Binding CheckUpdateCommand.IsRunning}" />

        <!-- AboutSetting.xaml:76-82 检查失败原因 -->
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   MaxWidth="620"
                   FontSize="12"
                   Foreground="{StaticResource StarTextSecondary}"
                   TextWrapping="Wrap"
                   Text="{Binding UpdateErrorText}" />
      </Grid>

      <!-- AboutSetting.xaml:89-126 相关链接 -->
      <TextBlock Margin="0,20,0,0"
                 Classes="section"
                 Text="{x:Static lang:Lang.AboutSettingPage_Links}" />

      <ItemsControl ItemsSource="{Binding Links}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:SettingLinkViewModel">
            <!-- 每条 0,8、左对齐、粗体强调色（对应 Hyperlink + Bold Run） -->
            <Button Classes="link"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    MinHeight="24"
                    Padding="0"
                    FontWeight="Bold"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip.Tip="{Binding Note}"
                    Content="{Binding Label}"
                    Command="{Binding $parent[UserControl].((local:AboutSetting)DataContext).OpenLinkCommand}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ── LunarWard 追加：复刻声明 / 许可 / 致谢（Starward 关于页没有这些，放在全部
              Starward 条目之后，12px 次要色，不改变上面任何一项的顺序）───────────────── -->
      <TextBlock Margin="0,20,0,0"
                 FontSize="12"
                 Foreground="{StaticResource StarTextSecondary}"
                 TextWrapping="Wrap"
                 Text="LunarWard 是 Starward 在 Linux 的重实现，界面排版复刻自 Starward（MIT）；启动、运行时与环境变量等平台相关部分为本项目重写。" />

      <TextBlock Margin="0,4,0,0"
                 FontSize="12"
                 Foreground="{StaticResource StarTextSecondary}"
                 TextWrapping="Wrap"
                 Text="本项目以 MIT 许可发布；Starward 的版权归 Scighost 所有。" />

      <TextBlock Margin="0,4,0,0"
                 FontSize="12"
                 Foreground="{StaticResource StarTextSecondary}"
                 TextWrapping="Wrap"
                 Text="致谢：Starward（Scighost）提供了完整的 UI 结构与 Core API；an-anime-team 提供 wine 组件索引；HoYoPlay 官方素材接口用于背景与公告。" />

      <TextBlock Margin="0,8,0,0"
                 FontSize="12"
                 Foreground="{StaticResource StarTextSecondary}"
                 TextWrapping="Wrap"
                 Text="「隐私策略」「赞助开发者」在 LunarWard 没有对应页面，保留 Starward 的链接位置并禁用。" />

      <TextBlock Margin="0,8,0,0"
                 Classes="tertiary"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource StarCautionBrush}"
                 Text="{Binding Status}"
                 IsVisible="{Binding HasStatus}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
