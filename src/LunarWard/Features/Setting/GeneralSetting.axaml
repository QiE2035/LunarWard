<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="using:LunarWard.Language"
             xmlns:local="using:LunarWard.Features.Setting"
             x:Class="LunarWard.Features.Setting.GeneralSetting"
             x:DataType="local:GeneralSetting">

  <!--
    1:1 复刻 Starward Features/Setting/GeneralSetting.xaml（87 行）：
      15      StackPanel Padding="0,0,24,0"（Avalonia 无 Padding；LunarWard 改由 SettingPage 的 SectionHost 统一留白）
      19      20px「语言」
      20-27   0,12 ComboBox（Height 36 / MinWidth 260 / Padding 18.5,0,0,0 /
              BorderThickness 0 / CornerRadius 8,18,18,8）
      30-34   0,12 左对齐「帮助我们翻译」链接
      38-40   0,20 20px「关闭窗口选项」
      41-54   0,12 水平 StackPanel Spacing=24：两个 RadioButton（最小化到托盘 / 完全退出）
      56-59   0,12 ToggleSwitch（基于注册表的游戏账号切换功能）
      62      0,20 MenuFlyoutSeparator
      65-68   0,20 14px 次要色说明（请在系统设置中启用以下功能）
      69-82   0,12 链接行：透明效果 / 动画效果（ms-settings:easeofaccess-visualeffects）
    行号均指 Starward/src/Starward/Features/Setting/GeneralSetting.xaml。

    LunarWard 落位说明：
      · 语言是真实可改项（config.json 的 launcher.language），控件尺寸照抄源码；
      · 「帮助我们翻译」LunarWard 只有 zh-CN / en-US，没有翻译协作页 → 保留链接位、禁用；
      · 关闭窗口：Linux 没有系统托盘，「最小化到托盘」保留位置并禁用，「完全退出」可用；
      · 注册表账号切换是 Windows 专属 → 开关保留位置、禁用并说明；
      · 透明/动画效果是 Windows「设置」深链 → 保留说明与链接行的位置，换成 Linux 说明；
      · 末尾「主题 / 启动行为 / 公告与动态背景」是 LunarWard 追加，排在 Starward 条目之后。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <!-- 右侧/底部留白由 SettingPage 的 SectionHost(Margin 24) 统一提供，子页不再重复。 -->
    <StackPanel>

      <!-- GeneralSetting.xaml:19 -->
      <TextBlock Classes="section" Text="{x:Static lang:Lang.SettingPage_Language}" />

      <!-- GeneralSetting.xaml:20-27 -->
      <ComboBox Height="36"
                MinWidth="260"
                Margin="0,12,0,0"
                Padding="18.5,0,0,0"
                BorderThickness="0"
                CornerRadius="8,18,18,8"
                HorizontalAlignment="Left"
                ItemsSource="{Binding LanguageOptions}"
                SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="local:SettingLanguageOption">
            <TextBlock Text="{Binding Display}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <!-- GeneralSetting.xaml:30-34（LunarWard 没有翻译协作页 → 禁用） -->
      <Button Classes="link"
              Margin="0,12,0,0"
              Padding="0"
              MinHeight="24"
              HorizontalAlignment="Left"
              IsEnabled="False"
              FontWeight="Bold"
              ToolTip.Tip="LunarWard 目前只有 zh-CN / en-US 两种文案，没有翻译协作页。"
              Content="{x:Static lang:Lang.AppearanceSettingPage_HelpUsTranslateStarward}" />

      <!-- GeneralSetting.xaml:38-40 -->
      <TextBlock Margin="0,20,0,0"
                 Classes="section"
                 Text="{x:Static lang:Lang.ExperienceSettingPage_CloseWindowOption}" />

      <!--
        GeneralSetting.xaml:41-54：上游 Hide/Exit 两项，配置为 0 时等于「每次询问」。
        这里把三种都做成选项（上游只能通过 MainWindowCloseDialog 写成 Hide/Exit，没有「问」的入口）。
        托盘用 Avalonia TrayIcon ≈ H.NotifyIcon。
      -->
      <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="24">
        <RadioButton GroupName="CloseWindowOption"
                     IsChecked="{Binding IsCloseToTray, Mode=TwoWay}"
                     Content="{x:Static lang:Lang.ExperienceSettingPage_MinimizeToSystemTray}" />
        <RadioButton GroupName="CloseWindowOption"
                     IsChecked="{Binding IsCloseToExit, Mode=TwoWay}"
                     Content="{x:Static lang:Lang.ExperienceSettingPage_ExitCompletely}" />
        <RadioButton GroupName="CloseWindowOption"
                     IsChecked="{Binding IsAskEveryTime, Mode=TwoWay}"
                     Content="每次关闭时询问" />
      </StackPanel>

      <TextBlock Margin="0,6,0,0"
                 MaxWidth="820"
                 HorizontalAlignment="Left"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="最小化到系统托盘需要桌面提供 StatusNotifier（KDE 默认支持，GNOME 需装 AppIndicator 扩展）。选「完全退出」时关闭窗口即退出进程。" />

      <!-- LunarWard 扩展：XDG autostart（上游 Windows 走注册表 Run 键） -->
      <StackPanel Margin="0,16,0,0" Orientation="Horizontal" Spacing="12">
        <ToggleSwitch IsChecked="{Binding IsAutostartEnabled, Mode=TwoWay}"
                      OffContent=""
                      OnContent="" />
        <TextBlock VerticalAlignment="Center"
                   Text="开机自动启动（最小化到托盘）" />
      </StackPanel>

      <TextBlock Margin="0,6,0,0"
                 MaxWidth="820"
                 HorizontalAlignment="Left"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="写入 $XDG_CONFIG_HOME/autostart/lunarward.desktop（Exec 带 --start-hidden），登录桌面后在托盘里待命。删除该文件等同于关闭此开关。" />

      <TextBlock Margin="0,8,0,0"
                 MaxWidth="820"
                 HorizontalAlignment="Left"
                 Classes="description"
                 Text="关闭主窗口时的行为：隐藏到托盘会继续在后台计时/跑更新；完全退出会结束进程。" />

      <!-- GeneralSetting.xaml:56-59（账号切换；Windows 走注册表，Linux 走 Wine prefix 的 user.reg） -->
      <ToggleSwitch Margin="0,12,0,0"
                    IsChecked="{Binding EnableGameAccountSwitcher, Mode=TwoWay}"
                    OffContent="{x:Static lang:Lang.SettingPage_RegistryBasedGameAccountSwitchingFeature}"
                    OnContent="{x:Static lang:Lang.SettingPage_RegistryBasedGameAccountSwitchingFeature}" />

      <TextBlock Margin="0,4,0,0"
                 MaxWidth="820"
                 HorizontalAlignment="Left"
                 FontSize="12"
                 Foreground="{StaticResource StarTextSecondary}"
                 TextWrapping="Wrap"
                 Text="账号数据保存在游戏 Wine prefix 的 user.reg 里；切换账号会把选中快照写回该值。开启后，启动器右下角还会出现账号切换条（需先保存过账号）。" />

      <!-- GeneralSetting.xaml:62 MenuFlyoutSeparator -->
      <Border Height="1" Margin="0,20,0,0" Background="{StaticResource StarDividerBrush}" />

      <!-- GeneralSetting.xaml:65-68 -->
      <TextBlock Margin="0,20,0,0"
                 Classes="description"
                 Text="{x:Static lang:Lang.SettingPage_ForABetterExperiencePleaseEnableTheFollowingFeaturesInSystemSettings}" />

      <!-- GeneralSetting.xaml:69-82 的透明/动画深链行：Linux 没有 ms-settings → 说明 -->
      <TextBlock Margin="0,12,0,0"
                 MaxWidth="820"
                 HorizontalAlignment="Left"
                 FontSize="12"
                 Foreground="{StaticResource StarTextSecondary}"
                 TextWrapping="Wrap"
                 Text="Linux 的透明与动画效果由桌面环境 / 合成器控制，没有 Windows「设置」里的系统效果深链。" />

      <!-- ── LunarWard 追加：主题（Starward 的「外观」在 AppearanceSettingPage，
              不在通用页；这里放在 Starward 条目之后）──────────────────────────── -->
      <TextBlock Margin="0,20,0,0"
                 Classes="section"
                 Text="主题" />

      <TextBlock Margin="0,12,0,0" Text="暗色（固定）" />

      <TextBlock Margin="0,4,0,0"
                 Classes="description"
                 Text="Starward 跟随 Windows 的亮/暗色设置；LunarWard 只使用暗色，与 Starward 的 Fallback 配色一致，不跟随桌面主题。" />

      <!-- ── LunarWard 追加：启动时行为 ─────────────────────────────── -->
      <TextBlock Margin="0,20,0,0"
                 Classes="section"
                 Text="启动时行为" />

      <TextBlock Margin="0,12,0,0" Text="回到上次使用的游戏档案" />

      <TextBlock Margin="0,4,0,0"
                 Classes="description"
                 Text="对应 config.json 的 launcher.last_profile_index，只读展示。" />

      <!-- ── LunarWard 追加：公告卡 + 动态背景（Starward 是「体验」页的开关）── -->
      <ToggleSwitch Margin="0,20,0,0"
                    IsChecked="{Binding Announcements, Mode=TwoWay}"
                    OffContent="显示公告卡"
                    OnContent="显示公告卡" />

      <TextBlock Margin="0,4,0,0"
                 Classes="description"
                 Text="启动器页左下角的公告卡（Banner 与活动 / 公告 / 资讯）。" />

      <ToggleSwitch Margin="0,12,0,0"
                    IsChecked="{Binding VideoBackground, Mode=TwoWay}"
                    OffContent="动态背景"
                    OnContent="动态背景" />

      <TextBlock Margin="0,4,0,0"
                 Classes="description"
                 Text="背景目录里的视频优先于静态图；缺少 libvlc 时自动回退静态图。" />

      <!-- 如实标注：两个开关已落盘，但启动器页尚未读取 -->
      <Border Classes="infobar warning" Margin="0,12,0,0">
        <TextBlock FontSize="12"
                   TextWrapping="Wrap"
                   Text="这两个开关写入 config.json，但启动器页的读取尚未接入，切换后不会立即生效。" />
      </Border>

      <TextBlock Margin="0,8,0,0"
                 FontSize="12"
                 Foreground="{StaticResource StarCautionBrush}"
                 TextWrapping="Wrap"
                 Text="{Binding Status}"
                 IsVisible="{Binding HasStatus}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
