<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        上游：Starward/Features/Background/AppBackgroundImageExStyle.xaml（5514 B）
        上游 Template 结构（Scighost.WinUI.ImageEx 控件模板）：
          Grid(Background/BorderBrush/BorderThickness/CornerRadius)
          ├─ Image PlaceholderImage  Opacity=1.0  Stretch=PlaceholderStretch  x:Load=False
          ├─ Image Image             Opacity=0.0  Stretch=Stretch
          └─ VisualStateManager "CommonStates"
               Failed  : Image=0, PlaceholderImage=1                     （图解码失败 → 只显示占位图）
               Loading : 无动画
               Loaded  : Image 0→1 Duration 0.3s BeginTime 0
                         PlaceholderImage 1→0 Duration 0.3s BeginTime 0.3s（先亮后淡）
               Unloaded: PlaceholderImage=1, Image=0（瞬时）

        Avalonia 等价：本文件只保留「模板→样式」的静态部分（对齐/拉伸/过渡），
        三个视觉状态由 AppBackground.xaml.cs 的
        ApplyLoadedVisualState / ApplyFailedVisualState / ApplyUnloadedVisualState 实现，
        一一对应上面的 Storyboard 参数（0.3s / 0.3s 延迟），逐条记录于
        docs/09-LINUX-DIVERGENCES.md「九、Features/Background」#1。
    -->
    <Style Selector="Image.app-background-placeholder">
        <Setter Property="Stretch" Value="UniformToFill" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Image.app-background-image">
        <Setter Property="Stretch" Value="UniformToFill" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
    </Style>

    <!-- 非 ImageEx 的补充层（上游 AppBackground.xaml 里的暗角矩形与视频叠加图） -->
    <Style Selector="Image.app-background-video-overlay">
        <Setter Property="Stretch" Value="UniformToFill" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>
