<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:LunarWard.Features.Background"
             xmlns:lang="using:LunarWard.Language"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="LunarWard.Features.Background.BackgroundViewPage"
             x:DataType="local:BackgroundViewPage">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24">

        <!--  标题栏  -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="{x:Static lang:Lang.SettingPage_AppBackground}" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton x:Name="ToggleButton_MultiSelect" IsChecked="{Binding MutliSelect, Mode=TwoWay}"
                              Content="{x:Static lang:Lang.Common_Select}" Padding="12,6" />
                <TextBlock Text="{Binding SelectCountText}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource StarTextSecondary}" />
            </StackPanel>
        </Grid>

        <!--  工具栏  -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Content="{x:Static lang:Lang.ScreenshotPage_OpenFolder}" Click="OnOpenFolderClick" Padding="12,6" />
            <Button Content="{x:Static lang:Lang.BackgroundViewPage_DeleteDuplicateFiles}" Click="OnDeleteDuplicateClick" Padding="12,6" />

            <Button Content="{x:Static lang:Lang.Common_Filter}" Padding="12,6">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem x:Name="RadioMenuFlyoutItem_Filter_All" Header="{x:Static lang:Lang.Common_All}"
                                  ToggleType="Radio" GroupName="Filter" IsChecked="True"
                                  Click="OnFilterSortClick" />
                        <MenuItem x:Name="RadioMenuFlyoutItem_Filter_Image" Header="Image"
                                  ToggleType="Radio" GroupName="Filter" Click="OnFilterSortClick" />
                        <MenuItem x:Name="RadioMenuFlyoutItem_Filter_Video" Header="Video"
                                  ToggleType="Radio" GroupName="Filter" Click="OnFilterSortClick" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Button Content="{x:Static lang:Lang.Common_Sort}" Padding="12,6">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem x:Name="RadioMenuFlyoutItem_Sort_Time" Header="{x:Static lang:Lang.Common_Time}"
                                  ToggleType="Radio" GroupName="Sort" IsChecked="True" Click="OnFilterSortClick" />
                        <MenuItem x:Name="RadioMenuFlyoutItem_Sort_FileSize" Header="{x:Static lang:Lang.Common_FileSize}"
                                  ToggleType="Radio" GroupName="Sort" Click="OnFilterSortClick" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <TextBlock x:Name="TextBlock_DeleteInfo" Text="{Binding DeleteInfoText}" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource StarTextSecondary}" />
        </StackPanel>

        <!--  无文件夹提示  -->
        <StackPanel x:Name="StackPanel_NoFolder" Grid.Row="2" IsVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="&#xE8B7;" FontSize="40" HorizontalAlignment="Center"
                       Foreground="{DynamicResource StarTextTertiary}" />
            <TextBlock Text="{x:Static lang:Lang.SettingPage_AppBackground}" FontSize="14"
                       Foreground="{DynamicResource StarTextSecondary}" />
        </StackPanel>

        <!--  背景图库  -->
        <ListBox x:Name="ListView_Images" Grid.Row="2" SelectionMode="None"
                 Background="Transparent" BorderThickness="0"
                 SelectionChanged="OnImagesSelectionChanged"
                 DoubleTapped="OnImagesDoubleTapped"
                 DragDrop.AllowDrop="False">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemWidth="220" ItemHeight="152" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:BackgroundFileItem">
                    <Border Width="208" Height="140" Margin="0,0,12,12" CornerRadius="8" ClipToBounds="True"
                            Background="{DynamicResource StarCardBackgroundBrush}"
                            BorderBrush="{DynamicResource StarCardStrokeBrush}" BorderThickness="1">
                        <Panel>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Text="&#xE714;" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding IsVideo}" />
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="{x:Static lang:Lang.Common_Open}" Click="OnItemOpenClick" />
                                    <MenuItem Header="{x:Static lang:Lang.Common_Copy}" Click="OnItemCopyClick" />
                                    <MenuItem Header="{x:Static lang:Lang.Common_Delete}" Click="OnItemDeleteClick" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Border VerticalAlignment="Bottom" Height="30" Background="#CC000000">
                                <TextBlock Text="{Binding FileInfo}" FontSize="11" Margin="10,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="White" />
                            </Border>
                        </Panel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</UserControl>
