<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="LunarWard.Features.GameRecord.Genshin.StygianOnslaughtPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fw="clr-namespace:LunarWard.Frameworks"
             xmlns:lang="clr-namespace:LunarWard.Language"
             xmlns:linq="clr-namespace:System.Linq"
             xmlns:local="clr-namespace:LunarWard.Features.GameRecord.Genshin"
             xmlns:sc="clr-namespace:LunarWard.Controls"
             xmlns:sf="clr-namespace:LunarWard.Frameworks"
             xmlns:sfg="clr-namespace:LunarWard.Features.Gacha"
             xmlns:sh="clr-namespace:LunarWard.Helpers"
             xmlns:so="clr-namespace:LunarWard.Core.GameRecord.Genshin.StygianOnslaught">

    <UserControl.Resources>
        <sfg:RarityToGIBgConverter x:Key="RarityToGIBgConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>


        <StackPanel  x:Name="Image_Emoji"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    IsVisible="False">
            <Image Width="160"
                   Height="160"
                   Source="avares://LunarWard/Assets/Image/UI_EmotionIcon5.png" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="{DynamicResource StarTextSecondary}"
                       Text="{Binding lang:Lang.HoyolabToolboxPage_NoData}" />
        </StackPanel>

        <StackPanel Margin="0,24,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Spacing="12">
            <Button Height="36"
                    BorderThickness="0"
                    Command="{Binding RefreshDataCommand}"
                    CornerRadius="0,18,18,0">
                <StackPanel Margin="4,0,4,0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <fw:FontIcon Classes="icon" FontSize="16" Glyph="&#xE72C;" />
                    <TextBlock Text="{Binding lang:Lang.Common_Refresh}" />
                </StackPanel>
            </Button>
            <Button Height="36"
                    BorderThickness="0"
                    CornerRadius="0,18,18,0"
                    Translation="0,0,16"
                    IsVisible="False">
                <StackPanel Margin="4,0,4,0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <fw:FontIcon Classes="icon" FontSize="16" Glyph="&#xE9D9;" />
                    <TextBlock Text="{Binding lang:Lang.Common_Summary}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ListBox  x:Name="ListView_StygianOnslaughtPageList"
                  Grid.Row="1"
                  Padding="12,0,12,0"
                  ItemsSource="{Binding SOList}"
                  SelectionChanged="ListView_StygianOnslaughtPageList_SelectionChanged"
                  SelectionMode="Single">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Margin" Value="0,4,0,4" />
                    <Setter Property="Padding" Value="4,0,4,0" />
                
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="so:StygianOnslaughtInfo">
                    <Grid
                         
                         
                          RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding StartDateTime, StringFormat='{}{0:yyyy-MM-dd}'}" />
                        <sc:CachedImage Grid.Row="1"
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Left"
                                        Source="{Binding local:StygianOnslaughtPage.DifficultyToImage(Difficulty)}" />
                        <TextBlock Grid.Row="1"
                                   Margin="36,0,0,2"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource StarTextSecondary}">
                            <Run Text="{Binding Second}" /><Run Text="s" />
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>



        <ScrollViewer Grid.RowSpan="2"
                      Grid.Column="1"
                      IsVisible="{Binding CurrentInfo, Converter={DynamicResource ObjectToVisibilityConverter}}">
            <StackPanel Width="700"
                        Margin="24"
                        Spacing="8">

                <Grid>
                    <!--  统计周期  -->
                    <TextBlock Foreground="{DynamicResource StarTextSecondary}">
                        <Run Text="{Binding lang:Lang.ForgottenHallPage_Period}" />
                        <Run Text="" />
                        <Run Text="{Binding CurrentInfo.Schedule.StartDateTime, StringFormat='{}{0:yyyy/MM/dd}'}" />
                        <Run Text=" - " />
                        <Run Text="{Binding CurrentInfo.Schedule.EndDateTime, StringFormat='{}{0:yyyy/MM/dd}'}" />
                    </TextBlock>
                </Grid>



                <Grid>

                    <!--  最佳记录  -->
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock FontSize="16"
                                   Foreground="{DynamicResource StarTextSecondary}"
                                   Text="{Binding lang:Lang.ImaginariumTheaterPage_BestRecord}" />
                        <sc:CachedImage Width="24"
                                        Height="24"
                                        Margin="8,0,0,0"
                                        Source="{Binding local:StygianOnslaughtPage.DifficultyToImage(CurrentSelectedBattle.Best.Difficulty)}" />
                        <TextBlock Margin="4,0,0,0" FontSize="16">
                            <Run Text="{Binding CurrentSelectedBattle.Best.Seconds}" /><Run Text="s" />
                        </TextBlock>
                    </StackPanel>

                    <!--  单人/多人模式切换  -->
                    <TabControl x:Name="Segmented_PlayerMode"
                                   HorizontalAlignment="Right"
                                   SelectionChanged="Segmented_PlayerMode_SelectionChanged">
                        <TabItem Content="{Binding lang:Lang.StygianOnslaughtPage_SinglePlayer}" Foreground="{DynamicResource StarTextSecondary}" />
                        <TabItem x:Name="SegmentedItem_MultiPlayer"
                                           Content="{Binding lang:Lang.StygianOnslaughtPage_CoOp}"
                                           Foreground="{DynamicResource StarTextSecondary}" />
                    </TabControl>

                </Grid>

                <ItemsControl ItemsSource="{Binding CurrentSelectedBattle.Challenge}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="so:StygianOnslaughtChallenge">
                            <Grid
                                 
                                 
                                  RowSpacing="8"
                                  Translation="0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="356" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <!--  怪物名称  -->
                                <TextBlock FontSize="16" Text="{Binding Name}" />
                                <!--  战斗时间  -->
                                <StackPanel Grid.Row="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="12">
                                    <TextBlock Foreground="{DynamicResource StarTextSecondary}" Text="{Binding lang:Lang.StygianOnslaughtPage_BattleTime}" />
                                    <TextBlock Grid.Row="1" Foreground="{DynamicResource StarTextSecondary}">
                                        <Run Text="{Binding Second}" /><Run Text="s" />
                                    </TextBlock>
                                </StackPanel>

                                <!--  阵容  -->
                                <ItemsControl Grid.Row="2"
                                              Grid.Column="0"
                                              MinHeight="73"
                                              Margin="0,4,0,8"
                                              HorizontalAlignment="Left"
                                              ItemsSource="{Binding Teams}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="12" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="so:StygianOnslaughtAvatar">
                                            <Grid Width="80" Height="97">
                                                <sc:CachedImage Source="{Binding Rarity, Converter={StaticResource RarityToGIBgConverter}}" />
                                                <sc:CachedImage VerticalAlignment="Top"
                                                                CornerRadius="0,0,12,0"
                                                                Source="{Binding Image}" />
                                                <Border Padding="4,0,4,2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource StarControlOnImageBrush}"
                                                        CornerRadius="0,4,0,4"
                                                        IsVisible="{Binding local:StygianOnslaughtPage.RankToVisibility(Rank)}">
                                                    <TextBlock Foreground="{DynamicResource StarTextSecondary}" Text="{Binding Rank}" />
                                                </Border>
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Bottom"
                                                           FontSize="14"
                                                           Foreground="#84603D">
                                                    <Run Text="Lv." /><Run Text="{Binding Level}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  怪物图  -->
                                <sc:CachedImage Grid.Row="0"
                                                Grid.RowSpan="4"
                                                Grid.Column="1"
                                                Height="220"
                                                Margin="0,-12,0,-12"
                                                Source="{Binding Monster.Icon}"
                                                Stretch="Uniform" />

                                <StackPanel Grid.Row="2"
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                    <!--  怪物等级  -->
                                    <Border Padding="8,2,8,2"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource StarControlOnImageBrush}"
                                            CornerRadius="8">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource StarTextSecondary}">
                                            <Run Text="Lv." /><Run Text="{Binding Monster.Level}" />
                                        </TextBlock>
                                    </Border>
                                    <!--  怪物描述  -->
                                    <Button Padding="0"
                                            VerticalAlignment="Center"
                                            sh:PointerCursor.CursorShape="Hand"
                                            BorderThickness="0"
                                            CornerRadius="8">
                                        <Border Padding="4" Background="{DynamicResource StarControlOnImageBrush}">
                                            <fw:FontIcon Classes="icon" FontSize="14"
                                                      Foreground="{DynamicResource StarTextSecondary}"
                                                      Glyph="&#xE721;" />
                                        </Border>
                                        <Button.Flyout>
                                            <Flyout>
                                                <ItemsControl Width="360" ItemsSource="{Binding Monster.TrimmedDesc}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <sc:ColorfulTextBlock Foreground="{DynamicResource StarTextSecondary}"
                                                                                  Text="{x:Bind}"
                                                                                  TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>


                                <!--  最强一击/最高总伤  -->
                                <ItemsControl Grid.Row="3"
                                              Grid.ColumnSpan="2"
                                              ItemsSource="{Binding BestAvatar}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="so:StygianOnslaughtBestAvatar">
                                            <StackPanel Orientation="Horizontal">
                                                <sc:CachedImage Width="40"
                                                                Height="40"
                                                                Margin="0,-16,0,0"
                                                                HorizontalAlignment="Left"
                                                                Source="{Binding SideIcon}" />
                                                <TextBlock Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource StarTextSecondary}"
                                                           Text="{Binding local:StygianOnslaughtPage.BestTypeToString(Type)}" />
                                                <TextBlock Margin="8,0,0,0"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding DPS}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>



                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


            </StackPanel>
        </ScrollViewer>


    </Grid>

</sf:PageBase>
