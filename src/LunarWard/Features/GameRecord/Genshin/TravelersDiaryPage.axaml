<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="LunarWard.Features.GameRecord.Genshin.TravelersDiaryPage"
        x:CompileBindings="False"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fw="clr-namespace:LunarWard.Frameworks"
             xmlns:diary="using:LunarWard.Core.GameRecord.Genshin.TravelersDiary"
             xmlns:lang="using:LunarWard.Language"
             xmlns:local="clr-namespace:LunarWard.Features.GameRecord.Genshin"
             xmlns:sc="clr-namespace:LunarWard.Controls"
             xmlns:sf="clr-namespace:LunarWard.Frameworks"
             xmlns:sfg="clr-namespace:LunarWard.Features.GameRecord"
             xmlns:sp="clr-namespace:LunarWard.Pages">

    <UserControl.Resources>
        <sfg:ColorToSolidColorBrushConverter x:Key="ColorToSolidColorBrushConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>



        <StackPanel  x:Name="Image_Emoji"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    IsVisible="False">
            <Image Width="160"
                   Height="160"
                   Source="avares://LunarWard/Assets/Image/UI_EmotionIcon5.png" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="{DynamicResource StarTextSecondary}"
                       Text="{x:Static lang:Lang.HoyolabToolboxPage_NoData}" />
        </StackPanel>


        <StackPanel Margin="0,24,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Spacing="12">
            <Button Height="36"
                    BorderThickness="0"
                    Command="{Binding InitializeDataCommand}"
                    CornerRadius="0,18,18,0">
                <StackPanel Margin="4,0,4,0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Grid>
                        <ProgressBar IsIndeterminate="True" Width="16"
                                      Height="16"
                                      />
                        <fw:FontIcon Classes="icon" FontSize="16"
                                  Glyph="&#xE72C;"
                                  IsVisible="{Binding InitializeDataCommand.IsRunning, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                    </Grid>
                    <TextBlock Text="{x:Static lang:Lang.Common_Refresh}" />
                </StackPanel>
            </Button>
            <Button x:Name="Button_GetDetails" Height="36"
                    BorderThickness="0"
                    CornerRadius="0,18,18,0"
                    IsEnabled="{Binding GetDataDetailsCommand.IsRunning, Converter={StaticResource BoolReversedConverter}}">
                <StackPanel Margin="4,0,4,0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Grid>
                        <ProgressBar IsIndeterminate="True" Width="16"
                                      Height="16"
                                      />
                        <fw:FontIcon Classes="icon" FontSize="16"
                                  Glyph="&#xEA37;"
                                  IsVisible="{Binding GetDataDetailsCommand.IsRunning, Converter={StaticResource BoolToVisibilityReversedConverter}}" />
                    </Grid>
                    <TextBlock Text="{x:Static lang:Lang.TravelersDiaryPage_GetDetails}" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="MenuFlyout_GetDetails" Placement="RightEdgeAlignedTop" />
                </Button.Flyout>
            </Button>
        </StackPanel>


        <ListBox  x:Name="ListView_MonthDataList"
                  Grid.Row="1"
                  Margin="0,12,0,0"
                  Padding="12,0,12,0"
                  ItemsSource="{Binding MonthDataList}"
                  SelectionChanged="ListView_MonthDataList_SelectionChanged"
                  SelectionMode="Single">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Margin" Value="0,4,0,4" />
                    <Setter Property="Padding" Value="4,0,4,0" />
                
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="diary:TravelersDiaryMonthData">
                    <Grid
                         
                         
                          RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="16">
                            <Run Text="{Binding Year}" /><Run Text="-" /><Run Text="{Binding Month, StringFormat='{}{0:D2}'}" />
                        </TextBlock>
                        <Image Grid.Row="1"
                               Width="20"
                               Height="20"
                               HorizontalAlignment="Left"
                               Source="ms-appx:///Assets/Image/UI_ItemIcon_201.png" />
                        <TextBlock Grid.Row="1"
                                   Margin="24,0,0,0"
                                   Foreground="{DynamicResource StarTextSecondary}"
                                   Text="{Binding CurrentPrimogems}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>




        <ScrollViewer Grid.RowSpan="2" Grid.Column="1">
            <StackPanel Margin="24" Spacing="8">

                <!--  Real-Time Data  -->
                <TextBlock FontSize="16"
                           Foreground="{DynamicResource StarTextSecondary}"
                           Text="{x:Static lang:Lang.TravelersDiaryPage_RealTimeData}"
                           IsVisible="{Binding CurrentSummary, Converter={StaticResource ObjectToVisibilityConverter}}" />
                <Grid RenderTransform="translate(0,0)"
                      IsVisible="{Binding CurrentSummary, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="{x:Static lang:Lang.TravelersDiaryPage_AcquiredThisDay}" />
                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Image Width="24" Source="ms-appx:///Assets/Image/UI_ItemIcon_201.png" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding CurrentSummary.DayData.CurrentPrimogems}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Image Width="24" Source="ms-appx:///Assets/Image/UI_ItemIcon_202.png" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding CurrentSummary.DayData.CurrentMora}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="{x:Static lang:Lang.TravelersDiaryPage_AcquiredThisMonth}" />
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Image Width="24" Source="ms-appx:///Assets/Image/UI_ItemIcon_201.png" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding CurrentSummary.MonthData.CurrentPrimogems}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Image Width="24" Source="ms-appx:///Assets/Image/UI_ItemIcon_202.png" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding CurrentSummary.MonthData.CurrentMora}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource StarTextSecondary}"
                               Text="{x:Static lang:Lang.TravelersDiaryPage_PrimogemsObtained}" />
                    <sc:ColorRectChart Grid.Row="3"
                                       Grid.ColumnSpan="3"
                                       Height="20"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Stretch"
                                       CornerRadius="4"
                                       Series="{Binding CurrentSeries}" />
                    <ItemsControl Grid.Row="4"
                                  Grid.ColumnSpan="3"
                                  Margin="0,8,-4,0"
                                  ItemsSource="{Binding CurrentSeries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="12"
                                              Orientation="Horizontal"
                                               LineSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Width="16"
                                            Height="16"
                                            Background="{Binding Color, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                            CornerRadius="4" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Legend}" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Percent}" /><Run Text="%" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!--  Historical Data  -->
                <TextBlock Margin="0,8,0,0"
                           FontSize="16"
                           Foreground="{DynamicResource StarTextSecondary}"
                           IsVisible="{Binding SelectMonthData, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Run Text="{x:Static lang:Lang.TravelersDiaryPage_HistoricalData}" />
                    <Run Text="" />
                    <Run Text="{Binding SelectMonthData.Year}" /><Run Text="-" /><Run Text="{Binding SelectMonthData.Month, StringFormat='{}{0:D2}'}" />
                </TextBlock>
                <Grid RenderTransform="translate(0,0)"
                      IsVisible="{Binding SelectMonthData, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="{x:Static lang:Lang.TravelersDiaryPage_AcquiredThisMonth}" />
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Image Width="24" Source="ms-appx:///Assets/Image/UI_ItemIcon_201.png" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding SelectMonthData.CurrentPrimogems}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Image Width="24" Source="ms-appx:///Assets/Image/UI_ItemIcon_202.png" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding SelectMonthData.CurrentMora}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource StarTextSecondary}"
                               Text="{x:Static lang:Lang.TravelersDiaryPage_PrimogemsObtained}" />
                    <sc:ColorRectChart Grid.Row="3"
                                       Grid.ColumnSpan="3"
                                       Height="20"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Stretch"
                                       CornerRadius="4"
                                       Series="{Binding SelectSeries}" />
                    <ItemsControl Grid.Row="4"
                                  Grid.ColumnSpan="3"
                                  Margin="0,8,-4,0"
                                  ItemsSource="{Binding SelectSeries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemSpacing="12"
                                              Orientation="Horizontal"
                                               LineSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Width="16"
                                            Height="16"
                                            Background="{Binding Color, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                            CornerRadius="4" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Legend}" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Percent}" /><Run Text="%" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!--  Daily Data  -->
                <TextBlock Margin="0,8,0,0"
                           FontSize="16"
                           Foreground="{DynamicResource StarTextSecondary}"
                           IsVisible="{Binding SelectMonthData, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Run Text="{x:Static lang:Lang.HoyolabToolboxPage_DailyData}" />
                    <Run Text="" />
                    <Run Text="{Binding SelectMonthData.Year}" /><Run Text="-" /><Run Text="{Binding SelectMonthData.Month, StringFormat='{}{0:D2}'}" />
                </TextBlock>
                <Border Padding="12,8,12,8"
                        Background="{DynamicResource StarOverlayAcrylicBrush}"
                        CornerRadius="8" RenderTransform="translate(0,0)"
                        IsVisible="{Binding SelectMonthData, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding DayDataList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource StarTextSecondary}"
                                               Text="{Binding Day}" />
                                    <Image Grid.Column="1"
                                           Width="24"
                                           Height="24"
                                           Source="ms-appx:///Assets/Image/UI_ItemIcon_201.png" />
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Text="{Binding Primogems}" />
                                    <ProgressBar Grid.Column="3"
                                                 MinHeight="20"
                                                 HorizontalAlignment="Stretch"
                                                 Background="Transparent"
                                                 Foreground="#A066BCF2"
                                                 Maximum="1"
                                                 Value="{Binding PrimogemsProgress}" />
                                    <Image Grid.Column="4"
                                           Width="24"
                                           Height="24"
                                           Source="ms-appx:///Assets/Image/UI_ItemIcon_202.png" />
                                    <TextBlock Grid.Column="5"
                                               VerticalAlignment="Center"
                                               Text="{Binding Mora}" />
                                    <ProgressBar Grid.Column="6"
                                                 MinHeight="20"
                                                 HorizontalAlignment="Stretch"
                                                 Background="Transparent"
                                                 Foreground="#A0F2DE77"
                                                 Maximum="1"
                                                 Value="{Binding MoraProgress}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>


            </StackPanel>
        </ScrollViewer>



    </Grid>

</sf:PageBase>
