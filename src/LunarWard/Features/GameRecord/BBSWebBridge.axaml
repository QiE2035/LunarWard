<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="LunarWard.Features.GameRecord.BBSWebBridge"
        x:CompileBindings="False"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fw="clr-namespace:LunarWard.Frameworks"
             xmlns:webview="clr-namespace:LunarWard.Frameworks.WebView"
             xmlns:lang="using:LunarWard.Language"
             xmlns:local="clr-namespace:LunarWard.Features.GameRecord">

    <Grid>

        <webview:WebView x:Name="webview2" />

        <Grid x:Name="Grid_Screenshot" IsVisible="False">
            <ScrollViewer ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <Image x:Name="Image_Screenshot" Stretch="Uniform" />
            </ScrollViewer>
            <Grid
                  VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!--  保存  -->
                    <Button Command="{Binding SaveScreenshotCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <fw:FontIcon Classes="icon" FontSize="16" Glyph="&#xE74E;" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Lang.Common_Save}" />
                        </StackPanel>
                    </Button>
                    <!--  复制  -->
                    <Button Command="{Binding CopyScreenshotCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <fw:FontIcon Classes="icon" FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Lang.Common_Copy}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!--  关闭  -->
                <Button HorizontalAlignment="Right"
                        Command="{Binding CloseScreenshotGridCommand}">
                    <fw:FontIcon Classes="icon" FontSize="16" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Grid>

    </Grid>

</UserControl>
