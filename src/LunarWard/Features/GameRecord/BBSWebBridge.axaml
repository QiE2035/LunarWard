<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="LunarWard.Features.GameRecord.BBSWebBridge"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:webview="clr-namespace:LunarWard.Frameworks.WebView"
             xmlns:lang="clr-namespace:LunarWard.Language"
             xmlns:local="clr-namespace:LunarWard.Features.GameRecord">

    <Grid>

        <webview:WebView x:Name="webview2" />

        <Grid x:Name="Grid_Screenshot" IsVisible="False">
            <ScrollViewer ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.ZoomMode="Disabled">
                <Image x:Name="Image_Screenshot" Stretch="Uniform" />
            </ScrollViewer>
            <Grid
                  VerticalAlignment="Bottom"
                 
                 >
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <!--  保存  -->
                    <Button Command="{Binding SaveScreenshotCommand}" Style="{DynamicResource DateTimePickerFlyoutButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="icon" FontSize="16" Text="&#xE74E;" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding lang:Lang.Common_Save}" />
                        </StackPanel>
                    </Button>
                    <!--  复制  -->
                    <Button Command="{Binding CopyScreenshotCommand}" Style="{DynamicResource DateTimePickerFlyoutButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="icon" FontSize="16" Text="&#xE8C8;" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding lang:Lang.Common_Copy}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!--  关闭  -->
                <Button HorizontalAlignment="Right"
                        Command="{Binding CloseScreenshotGridCommand}"
                        Style="{DynamicResource DateTimePickerFlyoutButtonStyle}">
                    <TextBlock Classes="icon" FontSize="16" Text="&#xE711;" />
                </Button>
            </Grid>
        </Grid>

    </Grid>

</UserControl>
