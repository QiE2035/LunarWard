<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="LunarWard.Features.GameRecord.StarRail.TrailblazeCalendarPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:calendar="clr-namespace:LunarWard.Core.GameRecord.StarRail.TrailblazeCalendar"
             xmlns:lang="clr-namespace:LunarWard.Language"
             xmlns:local="clr-namespace:LunarWard.Features.GameRecord.StarRail"
             xmlns:sc="clr-namespace:LunarWard.Controls"
             xmlns:sf="clr-namespace:LunarWard.Frameworks"
             xmlns:sfg="clr-namespace:LunarWard.Features.GameRecord"
             xmlns:sp="clr-namespace:LunarWard.Pages">

    <UserControl.Resources>
        <sfg:ColorToSolidColorBrushConverter x:Key="ColorToSolidColorBrushConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>



        <StackPanel  x:Name="Image_Emoji"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    IsVisible="False">
            <Image Width="160"
                   Height="160"
                   Source="{DynamicResource EmojiPom}" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding lang:Lang.HoyolabToolboxPage_NoData}" />
        </StackPanel>

        <StackPanel Margin="0,24,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Spacing="12">
            <Button Height="36"
                    BorderThickness="0"
                    Command="{Binding InitializeDataCommand}"
                    CornerRadius="0,18,18,0"
                    Style="{DynamicResource AccentButtonStyle}">
                <StackPanel Margin="4,0,4,0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Grid>
                        <ProgressBar IsIndeterminate="True" Width="16"
                                      Height="16"
                                      />
                        <TextBlock Classes="icon" FontSize="16"
                                  Text="&#xE72C;"
                                  IsVisible="{Binding InitializeDataCommand.IsRunning, Converter={DynamicResource BoolToVisibilityReversedConverter}}" />
                    </Grid>
                    <TextBlock Text="{Binding lang:Lang.Common_Refresh}" />
                </StackPanel>
            </Button>
            <Button x:Name="Button_GetDetails" Height="36"
                    BorderThickness="0"
                    CornerRadius="0,18,18,0"
                    IsEnabled="{Binding GetDataDetailsCommand.IsRunning, Converter={DynamicResource BoolReversedConverter}}"
                    Style="{DynamicResource AccentButtonStyle}">
                <StackPanel Margin="4,0,4,0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Grid>
                        <ProgressBar IsIndeterminate="True" Width="16"
                                      Height="16"
                                      />
                        <TextBlock Classes="icon" FontSize="16"
                                  Text="&#xEA37;"
                                  IsVisible="{Binding GetDataDetailsCommand.IsRunning, Converter={DynamicResource BoolToVisibilityReversedConverter}}" />
                    </Grid>
                    <TextBlock Text="{Binding lang:Lang.TravelersDiaryPage_GetDetails}" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="MenuFlyout_GetDetails" Placement="RightEdgeAlignedTop" />
                </Button.Flyout>
            </Button>
        </StackPanel>


        <ListBox  x:Name="ListView_MonthDataList"
                  Grid.Row="1"
                  Margin="0,12,0,0"
                  Padding="12,0,12,0"
                  ItemsSource="{Binding MonthDataList}"
                  SelectionChanged="ListView_MonthDataList_SelectionChanged"
                  SelectionMode="Single">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Margin" Value="0,4,0,4" />
                    <Setter Property="Padding" Value="4,0,4,0" />
                
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="calendar:TrailblazeCalendarMonthData">
                    <Grid
                         
                         
                          RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="16" Text="{Binding Month}" />
                        <Image Grid.Row="1"
                               Width="20"
                               Height="20"
                               HorizontalAlignment="Left"
                               Source="ms-appx:///Assets/Image/900001.png" />
                        <TextBlock Grid.Row="1"
                                   Margin="24,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding CurrentHcoin}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>




        <ScrollViewer Grid.RowSpan="2" Grid.Column="1">
            <StackPanel Margin="24" Spacing="8">

                <!--  Real-Time Data  -->
                <TextBlock FontSize="16"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding lang:Lang.TravelersDiaryPage_RealTimeData}"
                           IsVisible="{Binding CurrentSummary, Converter={DynamicResource ObjectToVisibilityConverter}}" />
                <Grid
                     
                     
                      Shadow="{DynamicResource ThemeShadow}"
                      Translation="0,0,16"
                      IsVisible="{Binding CurrentSummary, Converter={DynamicResource ObjectToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="{Binding lang:Lang.TravelersDiaryPage_AcquiredThisDay}" />
                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Image Width="24" Source="ms-appx:///Assets/Image/900001.png" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding CurrentSummary.DayData.CurrentHcoin}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="12">
                        <Grid>
                            <Image Width="24" Source="ms-appx:///Assets/Image/101.png" />
                            <Image Width="24"
                                   RenderTransformOrigin="0.25,0.75"
                                   Source="ms-appx:///Assets/Image/102.png"
                                   Translation="1,-2,0"
                                   IsVisible="True">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="30" />
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                        <TextBlock VerticalAlignment="Center" Text="{Binding CurrentSummary.DayData.CurrentRailsPass}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="{Binding lang:Lang.TravelersDiaryPage_AcquiredThisMonth}" />
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Image Width="24" Source="ms-appx:///Assets/Image/900001.png" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding CurrentSummary.MonthData.CurrentHcoin}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="12">
                        <Grid>
                            <Image Width="24" Source="ms-appx:///Assets/Image/101.png" />
                            <Image Width="24"
                                   RenderTransformOrigin="0.25,0.75"
                                   Source="ms-appx:///Assets/Image/102.png"
                                   Translation="1,-2,0"
                                   IsVisible="True">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="30" />
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                        <TextBlock VerticalAlignment="Center" Text="{Binding CurrentSummary.MonthData.CurrentRailsPass}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding lang:Lang.TrailblazeCalendarPage_StellarJadeSources}" />
                    <sc:ColorRectChart Grid.Row="3"
                                       Grid.ColumnSpan="3"
                                       Height="20"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Stretch"
                                       CornerRadius="4"
                                       Series="{Binding CurrentSeries}" />
                    <ItemsControl Grid.Row="4"
                                  Grid.ColumnSpan="3"
                                  Margin="0,8,-4,0"
                                  ItemsSource="{Binding CurrentSeries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalSpacing="12"
                                              Orientation="Horizontal"
                                              VerticalSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Width="16"
                                            Height="16"
                                            Background="{Binding Color, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                            CornerRadius="4" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Legend}" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Percent}" /><Run Text="%" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!--  Historical Data  -->
                <TextBlock Margin="0,8,0,0"
                           FontSize="16"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           IsVisible="{Binding SelectMonthData, Converter={DynamicResource ObjectToVisibilityConverter}}">
                    <Run Text="{Binding lang:Lang.TravelersDiaryPage_HistoricalData}" />
                    <Run Text="" />
                    <Run Text="{Binding SelectMonthData.Month}" />
                </TextBlock>
                <Grid
                     
                     
                      Shadow="{DynamicResource ThemeShadow}"
                      Translation="0,0,16"
                      IsVisible="{Binding SelectMonthData, Converter={DynamicResource ObjectToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="{Binding lang:Lang.TravelersDiaryPage_AcquiredThisMonth}" />
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Image Width="24" Source="ms-appx:///Assets/Image/900001.png" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding SelectMonthData.CurrentHcoin}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="12">
                        <Grid>
                            <Image Width="24" Source="ms-appx:///Assets/Image/101.png" />
                            <Image Width="24"
                                   RenderTransformOrigin="0.25,0.75"
                                   Source="ms-appx:///Assets/Image/102.png"
                                   Translation="1,-2,0"
                                   IsVisible="True">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="30" />
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                        <TextBlock VerticalAlignment="Center" Text="{Binding SelectMonthData.CurrentRailsPass}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding lang:Lang.TrailblazeCalendarPage_StellarJadeSources}" />
                    <sc:ColorRectChart Grid.Row="3"
                                       Grid.ColumnSpan="3"
                                       Height="20"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Stretch"
                                       CornerRadius="4"
                                       Series="{Binding SelectSeries}" />
                    <ItemsControl Grid.Row="4"
                                  Grid.ColumnSpan="3"
                                  Margin="0,8,-4,0"
                                  ItemsSource="{Binding SelectSeries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalSpacing="12"
                                              Orientation="Horizontal"
                                              VerticalSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Width="16"
                                            Height="16"
                                            Background="{Binding Color, Converter={StaticResource ColorToSolidColorBrushConverter}}"
                                            CornerRadius="4" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Legend}" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Percent}" /><Run Text="%" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!--  Daily Data  -->
                <TextBlock Margin="0,8,0,0"
                           FontSize="16"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           IsVisible="{Binding SelectMonthData, Converter={DynamicResource ObjectToVisibilityConverter}}">
                    <Run Text="{Binding lang:Lang.HoyolabToolboxPage_DailyData}" />
                    <Run Text="" />
                    <Run Text="{Binding SelectMonthData.Month}" />
                </TextBlock>
                <Border Padding="12,8,12,8"
                        Background="{DynamicResource CustomOverlayAcrylicBrush}"
                        CornerRadius="8"
                        Shadow="{DynamicResource ThemeShadow}"
                        Translation="0,0,16"
                        IsVisible="{Binding SelectMonthData, Converter={DynamicResource ObjectToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding DayDataList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Day}" />
                                    <Image Grid.Column="1"
                                           Width="24"
                                           Height="24"
                                           Source="ms-appx:///Assets/Image/900001.png" />
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Text="{Binding Jade}" />
                                    <ProgressBar Grid.Column="3"
                                                 MinHeight="20"
                                                 HorizontalAlignment="Stretch"
                                                 Background="Transparent"
                                                 Foreground="#A066BCF2"
                                                 Maximum="1"
                                                 Value="{Binding JadeProgress}" />
                                    <Grid Grid.Column="4"
                                          Width="24"
                                          Height="24">
                                        <Image Width="24" Source="ms-appx:///Assets/Image/101.png" />
                                        <Image Width="24"
                                               RenderTransformOrigin="0.25,0.75"
                                               Source="ms-appx:///Assets/Image/102.png"
                                               Translation="1,-2,0"
                                               IsVisible="True">
                                            <Image.RenderTransform>
                                                <RotateTransform Angle="30" />
                                            </Image.RenderTransform>
                                        </Image>
                                    </Grid>
                                    <TextBlock Grid.Column="5"
                                               VerticalAlignment="Center"
                                               Text="{Binding Pass}" />
                                    <ProgressBar Grid.Column="6"
                                                 MinHeight="20"
                                                 HorizontalAlignment="Stretch"
                                                 Background="Transparent"
                                                 Foreground="#A0F2DE77"
                                                 Maximum="1"
                                                 Value="{Binding PassProgress}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>


            </StackPanel>
        </ScrollViewer>


    </Grid>
</sf:PageBase>
