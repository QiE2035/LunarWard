<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="LunarWard.Features.GameRecord.StarRail.PureFictionPage"
        x:CompileBindings="False"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:grconv="clr-namespace:LunarWard.Features.GameRecord"
        xmlns:fw="clr-namespace:LunarWard.Frameworks"
             xmlns:fic="clr-namespace:LunarWard.Core.GameRecord.StarRail.PureFiction"
             xmlns:lang="clr-namespace:LunarWard.Language"
             xmlns:linq="clr-namespace:System.Linq"
             xmlns:local="clr-namespace:LunarWard.Features.GameRecord.StarRail"
             xmlns:sc="clr-namespace:LunarWard.Controls"
             xmlns:sf="clr-namespace:LunarWard.Frameworks"
             xmlns:sfg="clr-namespace:LunarWard.Features.Gacha"
             xmlns:sfgr="clr-namespace:LunarWard.Features.GameRecord">

    <UserControl.Resources>
        <grconv:RangeConverter x:Key="RangeConverter" />
        <grconv:RankToVisibilityConverter x:Key="RankToVisibilityConverter" />
        <sfg:RarityToSRBgConverter x:Key="RarityToSRBgConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>


        <StackPanel  x:Name="Image_Emoji"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    IsVisible="False">
            <Image Width="160"
                   Height="160"
                   Source="avares://LunarWard/Assets/Image/20008.png" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="{DynamicResource StarTextSecondary}"
                       Text="{x:Static lang:Lang.HoyolabToolboxPage_NoData}" />
        </StackPanel>

        <StackPanel Margin="0,24,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Spacing="12">
            <Button Height="36"
                    BorderThickness="0"
                    Command="{Binding RefreshDataCommand}"
                    CornerRadius="0,18,18,0">
                <StackPanel Margin="4,0,4,0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <fw:FontIcon Classes="icon" FontSize="16" Glyph="&#xE72C;" />
                    <TextBlock Text="{x:Static lang:Lang.Common_Refresh}" />
                </StackPanel>
            </Button>
            <Button Height="36"
                    BorderThickness="0"
                    CornerRadius="0,18,18,0" RenderTransform="translate(0,0)"
                    IsVisible="False">
                <StackPanel Margin="4,0,4,0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <fw:FontIcon Classes="icon" FontSize="16" Glyph="&#xE9D9;" />
                    <TextBlock Text="{x:Static lang:Lang.Common_Summary}" />
                </StackPanel>
            </Button>
        </StackPanel>


        <ListBox  x:Name="ListView_ForgottenHall"
                  Grid.Row="1"
                  Padding="12,0,12,0"
                  ItemsSource="{Binding PureFictionList}"
                  SelectionChanged="ListView_ForgottenHall_SelectionChanged"
                  SelectionMode="Single"
                  IsVisible="{Binding PureFictionList, Converter={StaticResource ObjectToVisibilityConverter}}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Margin" Value="0,4,0,4" />
                    <Setter Property="Padding" Value="4,0,4,0" />
                
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="fic:PureFictionInfo">
                    <Grid
                         
                         
                          RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding BeginTime, StringFormat='{}{0:yyyy-MM-dd}'}" />
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="4">
                            <Image Width="20"
                                   Height="20"
                                   VerticalAlignment="Center"
                                   Source="avares://LunarWard/Assets/Image/IconChallengeStarYellow.png" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource StarTextSecondary}"
                                       Text="{Binding StarNum}" />
                            <Border Width="1"
                                    Height="12"
                                    Margin="0,3,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource StarTextSecondary}"
                                    Opacity="0.25"
                                    IsVisible="{Binding ExtraStarNum, Converter={StaticResource Int32NotZeroToVisibilityConverter}}" />
                            <Image Width="20"
                                   Height="20"
                                   VerticalAlignment="Center"
                                   Source="avares://LunarWard/Assets/Image/IconChallengeStarStarward.png"
                                   IsVisible="{Binding ExtraStarNum, Converter={StaticResource Int32NotZeroToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>



        <ScrollViewer Grid.RowSpan="2"
                      Grid.Column="1"
                      IsVisible="{Binding CurrentPureFiction, Converter={StaticResource ObjectToVisibilityConverter}}">
            <StackPanel Margin="24" Spacing="8">

                <Grid>
                    <!--  统计周期  -->
                    <TextBlock Foreground="{DynamicResource StarTextSecondary}">
                        <Run Text="{x:Static lang:Lang.ForgottenHallPage_Period}" />
                        <Run Text="" />
                        <Run Text="{Binding CurrentPureFiction.BeginTime, StringFormat='{}{0:yyyy/MM/dd}'}" />
                        <Run Text=" - " />
                        <Run Text="{Binding CurrentPureFiction.EndTime, StringFormat='{}{0:yyyy/MM/dd}'}" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right" Text="{Binding CurrentPureFiction.Name}" />
                </Grid>

                <!--  出战统计  -->
                <Grid Margin="0,-4,0,0" RenderTransform="translate(0,0)">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <!--  Total Star  -->
                    <StackPanel Grid.RowSpan="2"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Image Width="24"
                               Height="24"
                               VerticalAlignment="Center"
                               Source="avares://LunarWard/Assets/Image/IconChallengeStarYellow.png" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="16"
                                   Text="{Binding CurrentPureFiction.StarNum}" />
                        <Border Width="1"
                                Height="13"
                                Margin="0,2,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource StarTextSecondary}"
                                Opacity="0.25"
                                IsVisible="{Binding CurrentPureFiction.ExtraStarNum, Converter={StaticResource Int32NotZeroToVisibilityConverter}}" />
                        <Image Width="24"
                               Height="24"
                               VerticalAlignment="Center"
                               Source="avares://LunarWard/Assets/Image/IconChallengeStarStarward.png"
                               IsVisible="{Binding CurrentPureFiction.ExtraStarNum, Converter={StaticResource Int32NotZeroToVisibilityConverter}}" />
                    </StackPanel>
                    <!--  最高关卡  -->
                    <TextBlock  x:Name="TextBlock_Deepest"
                               Grid.Column="1"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               IsTextTrimmedChanged="TextBlock_Deepest_IsTextTrimmedChanged"
                               TextTrimming="CharacterEllipsis">
                        <Run Foreground="{DynamicResource StarTextSecondary}" Text="{x:Static lang:Lang.ForgottenHallPage_FarthestStage}" />
                        <Run Text="" />
                        <Run Text="{Binding CurrentPureFiction.MaxFloor}" />
                    </TextBlock>
                    <!--  挑战次数  -->
                    <TextBlock  x:Name="TextBlock_Battles"
                               Grid.Column="2"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                        <Run Foreground="{DynamicResource StarTextSecondary}" Text="{x:Static lang:Lang.ForgottenHallPage_TimesChallenged}" />
                        <Run Text="" />
                        <Run Text="{Binding CurrentPureFiction.BattleNum}" />
                    </TextBlock>
                </Grid>


                <!--  卡片  -->
                <ItemsControl Margin="0,12,0,0"
                              HorizontalAlignment="Center"
                              ItemsSource="{Binding CurrentPureFiction.AllFloorDetail}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalSpacing="12"
                                          Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="fic:PureFictionFloorDetail">
                            <StackPanel Width="388"
                                        Background="{DynamicResource StarOverlayAcrylicBrush}"
                                        CornerRadius="8,28,8,8" RenderTransform="translate(0,0)">

                                <!--  title & Node1 & Node2  -->
                                <Grid Height="304">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="56" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.ColumnSpan="2"
                                            Margin="-24,0,-24,0"
                                            Background="{DynamicResource StarControlOnImageBrush}" />

                                    <!--  名称，回合数  -->
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontWeight="Bold"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource StarTextSecondary}">
                                            <Run Text="{x:Static lang:Lang.ForgottenHallPage_CyclesUsed}" />
                                            <Run Text="{Binding RoundNum}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!--  星星图标  -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                        <StackPanel HorizontalAlignment="Right"
                                                    Orientation="Horizontal"
                                                    Spacing="2">
                                            <ItemsControl ItemsSource="{Binding NormalStarNum, Converter={StaticResource RangeConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Image Width="24"
                                                               Height="24"
                                                               VerticalAlignment="Center"
                                                               Source="avares://LunarWard/Assets/Image/IconChallengeStarYellow.png" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!--  分割线  -->
                                            <Border x:Name="ExtraStarDivider"
                                                    Width="1"
                                                    Height="13"
                                                    Margin="0,3,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource StarTextSecondary}"
                                                    Opacity="0.25"
                                                    />
                                            <!--  额外星星  -->
                                            <ItemsControl x:Name="ExtraStarsControl"
                                                          ItemsSource="{Binding ExtraStarNum, Converter={StaticResource RangeConverter}}"
                                                         >
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Image Width="24"
                                                               Height="24"
                                                               VerticalAlignment="Center"
                                                               Source="avares://LunarWard/Assets/Image/IconChallengeStarStarward.png" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <!--  总分  -->
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontSize="12"
                                                   IsVisible="{Binding IsFast, Converter={StaticResource BoolToVisibilityReversedConverter}}">
                                            <Run Foreground="{DynamicResource StarTextSecondary}" Text="{x:Static lang:Lang.ApocalypticShadowPage_TotalScore}" />
                                            <Run Foreground="{DynamicResource StarAccentForegroundBrush}" Text="{Binding TotalScore}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!--  节点1  -->
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Margin="0,8,0,0"
                                               FontSize="12"
                                               IsVisible="{Binding IsFast, Converter={StaticResource BoolToVisibilityReversedConverter}}">
                                        <Run Text="{x:Static lang:Lang.ForgottenHallPage_TeamSetup}" />
                                        <Run Text="1" />
                                        <Run Text="" />
                                        <Run Foreground="{DynamicResource StarTextSecondary}" Text="{Binding Node1.ChallengeTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Right"
                                               FontSize="12"
                                               IsVisible="{Binding IsFast, Converter={StaticResource BoolToVisibilityReversedConverter}}">
                                        <Run Foreground="{DynamicResource StarTextSecondary}" Text="{x:Static lang:Lang.PureFictionPage_Score}" />
                                        <Run Foreground="{DynamicResource StarAccentForegroundBrush}" Text="{Binding Node1.Score}" />
                                    </TextBlock>

                                    <ItemsControl Grid.Row="2"
                                                  Grid.ColumnSpan="2"
                                                  HorizontalAlignment="Center"
                                                  ItemsSource="{Binding Node1.Avatars}"
                                                  IsVisible="{Binding IsFast, Converter={StaticResource BoolToVisibilityReversedConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="12" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="fic:PureFictionAvatar">
                                                <Grid Width="72" Height="84">
                                                    <sc:CachedImage Source="{Binding Rarity, Converter={StaticResource RarityToSRBgConverter}}" />
                                                    <sc:CachedImage VerticalAlignment="Top"
                                                                    CornerRadius="0,12,0,0"
                                                                    Source="{Binding Icon}"
                                                                    Stretch="UniformToFill" />
                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="#A0000000"
                                                            CornerRadius="0,12,0,8"
                                                            IsVisible="{Binding Rank, Converter={StaticResource RankToVisibilityConverter}}">
                                                        <TextBlock Margin="4,2,4,2"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource StarTextSecondary}"
                                                                   Text="{Binding Rank}" />
                                                    </Border>
                                                    <Border Height="16"
                                                            Margin="0,0,0,1.5"
                                                            VerticalAlignment="Bottom"
                                                            Background="#A0000000">
                                                        <TextBlock Margin="0,0,0,1"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="Lv." /><Run Text="{Binding Level}" />
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--  节点2  -->
                                    <TextBlock Grid.Row="3"
                                               Grid.ColumnSpan="2"
                                               FontSize="12"
                                               IsVisible="{Binding IsFast, Converter={StaticResource BoolToVisibilityReversedConverter}}">
                                        <Run Text="{x:Static lang:Lang.ForgottenHallPage_TeamSetup}" />
                                        <Run Text="2" />
                                        <Run Text="" />
                                        <Run Foreground="{DynamicResource StarTextSecondary}" Text="{Binding Node2.ChallengeTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="3"
                                               Grid.ColumnSpan="2"
                                               HorizontalAlignment="Right"
                                               FontSize="12"
                                               IsVisible="{Binding IsFast, Converter={StaticResource BoolToVisibilityReversedConverter}}">
                                        <Run Foreground="{DynamicResource StarTextSecondary}" Text="{x:Static lang:Lang.PureFictionPage_Score}" />
                                        <Run Foreground="{DynamicResource StarAccentForegroundBrush}" Text="{Binding Node2.Score}" />
                                    </TextBlock>

                                    <ItemsControl Grid.Row="4"
                                                  Grid.ColumnSpan="2"
                                                  Margin="0,0,0,4"
                                                  HorizontalAlignment="Center"
                                                  ItemsSource="{Binding Node2.Avatars}"
                                                  IsVisible="{Binding IsFast, Converter={StaticResource BoolToVisibilityReversedConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="12" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="fic:PureFictionAvatar">
                                                <Grid Width="72" Height="84">
                                                    <sc:CachedImage Source="{Binding Rarity, Converter={StaticResource RarityToSRBgConverter}}" />
                                                    <sc:CachedImage VerticalAlignment="Top"
                                                                    CornerRadius="0,12,0,0"
                                                                    Source="{Binding Icon}"
                                                                    Stretch="UniformToFill" />
                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="#A0000000"
                                                            CornerRadius="0,12,0,8"
                                                            IsVisible="{Binding Rank, Converter={StaticResource RankToVisibilityConverter}}">
                                                        <TextBlock Margin="4,2,4,2"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource StarTextSecondary}"
                                                                   Text="{Binding Rank}" />
                                                    </Border>
                                                    <Border Height="16"
                                                            Margin="0,0,0,1.5"
                                                            VerticalAlignment="Bottom"
                                                            Background="#A0000000">
                                                        <TextBlock Margin="0,0,0,1"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="Lv." /><Run Text="{Binding Level}" />
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--  快速通关  -->
                                    <StackPanel Grid.Row="1"
                                                Grid.RowSpan="4"
                                                Grid.ColumnSpan="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="8"
                                                IsVisible="{Binding IsFast, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Image Width="120" Source="ms-appx:///Assets/Image/20004.png" />
                                        <TextBlock HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource StarTextSecondary}"
                                                   Text="{x:Static lang:Lang.ForgottenHallPage_QuickCleared}" />
                                    </StackPanel>

                                </Grid>

                                <!--  节点3  -->
                                <Grid x:Name="Node3Root"
                                      Height="132"
                                     
                                      VerticalAlignment="Top"
                                     >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Row="0"
                                           MaxHeight="18"
                                           Margin="0,3,0,-1"
                                           Stretch="Fill"
                                           VerticalAlignment="Top"
                                           Source="avares://LunarWard/Assets/Image/StarwardModeNodeBg.png" />
                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal">
                                        <Image MaxHeight="14"
                                           Margin="4,3,0,0"
                                           Source="avares://LunarWard/Assets/Image/StarwardModeCrown.png" />
                                        <TextBlock FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="6,3,0,0">
                                            <Run Text="{x:Static lang:Lang.ForgottenHallPage_TeamSetup}" />
                                            <Run Text="3" />
                                            <Run Text="" />
                                            <Run Foreground="{DynamicResource StarTextSecondary}" Text="{Binding Node3.ChallengeTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Row="0"
                                               Grid.ColumnSpan="2"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Right"
                                               FontSize="12">
                                        <Run Foreground="{DynamicResource StarTextSecondary}" Text="{x:Static lang:Lang.PureFictionPage_Score}" />
                                        <Run Foreground="{DynamicResource StarAccentForegroundBrush}" Text="{Binding Node3.Score}" />
                                    </TextBlock>

                                    <ItemsControl Grid.Row="1"
                                                  Grid.ColumnSpan="2"
                                                  Margin="0,0,0,4"
                                                  HorizontalAlignment="Center"
                                                  ItemsSource="{Binding Node3.Avatars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="12" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="fic:PureFictionAvatar">
                                                <Grid Width="72" Height="84">
                                                    <sc:CachedImage Source="{Binding Rarity, Converter={StaticResource RarityToSRBgConverter}}" />
                                                    <sc:CachedImage VerticalAlignment="Top"
                                                                    CornerRadius="0,12,0,0"
                                                                    Source="{Binding Icon}"
                                                                    Stretch="UniformToFill" />
                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Background="#A0000000"
                                                            CornerRadius="0,12,0,8"
                                                            IsVisible="{Binding Rank, Converter={StaticResource RankToVisibilityConverter}}">
                                                        <TextBlock Margin="4,2,4,2"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource StarTextSecondary}"
                                                                   Text="{Binding Rank}" />
                                                    </Border>
                                                    <Border Height="16"
                                                            Margin="0,0,0,1.5"
                                                            VerticalAlignment="Bottom"
                                                            Background="#A0000000">
                                                        <TextBlock Margin="0,0,0,1"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="Lv." /><Run Text="{Binding Level}" />
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>




            </StackPanel>
        </ScrollViewer>



    </Grid>
</sf:PageBase>
