<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="LunarWard.Features.GameRecord.StarRail.ChallengePeakPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fw="clr-namespace:LunarWard.Frameworks"
             xmlns:cp="clr-namespace:LunarWard.Core.GameRecord.StarRail.ChallengePeak"
             xmlns:fic="clr-namespace:LunarWard.Core.GameRecord.StarRail.ApocalypticShadow"
             xmlns:lang="clr-namespace:LunarWard.Language"
             xmlns:linq="clr-namespace:System.Linq"
             xmlns:local="clr-namespace:LunarWard.Features.GameRecord.StarRail"
             xmlns:sc="clr-namespace:LunarWard.Controls"
             xmlns:sf="clr-namespace:LunarWard.Frameworks"
             xmlns:sfg="clr-namespace:LunarWard.Features.Gacha"
             xmlns:sfgr="clr-namespace:LunarWard.Features.GameRecord">

    <UserControl.Resources>
        <BitmapImage x:Key="StarIcon" Source="ms-appx:///Assets/Image/IconChallengeStarYellow.png" />
        <sfg:RarityToSRBgConverter x:Key="RarityToSRBgConverter" />

        <DataTemplate x:Key="StarRailTeamDataTemplate" x:DataType="cp:ChallengePeakAvatar">
            <Grid Width="72" Height="84">
                <sc:CachedImage Source="{Binding Rarity, Converter={StaticResource RarityToSRBgConverter}}" />
                <sc:CachedImage VerticalAlignment="Top"
                                CornerRadius="0,12,0,0"
                                Source="{Binding Icon}"
                                Stretch="UniformToFill" />
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#A0000000"
                        CornerRadius="0,12,0,8"
                        IsVisible="{Binding sfgr:AvatarRankHelper.RankToVisibility(Rank)}">
                    <TextBlock Margin="4,2,4,2"
                               FontSize="14"
                               Foreground="{DynamicResource StarTextSecondary}"
                               IsTextScaleFactorEnabled="False"
                               Text="{Binding Rank}" />
                </Border>
                <Border Height="16"
                        Margin="0,0,0,1.5"
                        VerticalAlignment="Bottom"
                        Background="#A0000000">
                    <TextBlock Margin="0,0,0,1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <Run Text="Lv." />
                        <Run Text="{Binding Level}" />
                    </TextBlock>
                </Border>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>


        <StackPanel  x:Name="Image_Emoji"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    IsVisible="False">
            <Image Width="160"
                   Height="160"
                   Source="avares://LunarWard/Assets/Image/20008.png" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="{DynamicResource StarTextSecondary}"
                       Text="{Binding lang:Lang.HoyolabToolboxPage_NoData}" />
        </StackPanel>

        <StackPanel Margin="0,24,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Spacing="12">
            <Button Height="36"
                    BorderThickness="0"
                    Command="{Binding RefreshDataCommand}"
                    CornerRadius="0,18,18,0">
                <StackPanel Margin="4,0,4,0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <fw:FontIcon Classes="icon" FontSize="16" Glyph="&#xE72C;" />
                    <TextBlock Text="{Binding lang:Lang.Common_Refresh}" />
                </StackPanel>
            </Button>
            <Button Height="36"
                    BorderThickness="0"
                    CornerRadius="0,18,18,0"
                    Translation="0,0,16"
                    IsVisible="False">
                <StackPanel Margin="4,0,4,0"
                            Orientation="Horizontal"
                            Spacing="8">
                    <fw:FontIcon Classes="icon" FontSize="16" Glyph="&#xE9D9;" />
                    <TextBlock Text="{Binding lang:Lang.Common_Summary}" />
                </StackPanel>
            </Button>
        </StackPanel>


        <ListBox  x:Name="ListView_ForgottenHall"
                  Grid.Row="1"
                  Padding="12,0,12,0"
                  ItemsSource="{Binding ChallengePeakDataList}"
                  SelectionChanged="ListView_ForgottenHall_SelectionChanged"
                  SelectionMode="Single"
                  IsVisible="{Binding ChallengePeakDataList, Converter={DynamicResource ObjectToVisibilityConverter}}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Margin" Value="0,4,0,4" />
                    <Setter Property="Padding" Value="4,0,4,0" />
                
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="cp:ChallengePeakData">
                    <Grid Width="112"
                         
                         
                         
                          RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <sc:CachedImage Grid.RowSpan="2"
                                        Height="60"
                                        Margin="0,-8,-8,-8"
                                        HorizontalAlignment="Right"
                                        Source="{Binding BossIcon}"
                                        Stretch="Uniform" />
                        <TextBlock Margin="2,0,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{Binding GameVersion}" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Image Width="20"
                                   Height="20"
                                   Source="ms-appx:///Assets/Image/boss_star.ae0258cf.png" />
                            <TextBlock Margin="0,0,0,2"
                                       Foreground="{DynamicResource StarTextSecondary}"
                                       Text="{Binding BossStars}" />
                            <Image Width="20"
                                   Height="20"
                                   Margin="4,0,0,0"
                                   Source="ms-appx:///Assets/Image/normal_star.751a6e2d.png" />
                            <TextBlock Margin="0,0,0,2"
                                       Foreground="{DynamicResource StarTextSecondary}"
                                       Text="{Binding MobStars}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>


        <ScrollViewer Grid.RowSpan="2"
                      Grid.Column="1"
                      IsVisible="{Binding CurrentChallengePeakData, Converter={DynamicResource ObjectToVisibilityConverter}}">
            <StackPanel Margin="24" Spacing="8">

                <!--  统计周期  -->
                <TextBlock Foreground="{DynamicResource StarTextSecondary}">
                    <Run Text="{Binding lang:Lang.ForgottenHallPage_Period}" />
                    <Run Text="" />
                    <Run Text="{Binding CurrentChallengePeakRecord.Group.BeginTime, StringFormat='{}{0:yyyy/MM/dd}'}" />
                    <Run Text=" - " />
                    <Run Text="{Binding CurrentChallengePeakRecord.Group.EndTime, StringFormat='{}{0:yyyy/MM/dd}'}" />
                </TextBlock>

                <!--  统计  -->
                <Grid Margin="0,-4,0,0"
                      Translation="0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>


                    <StackPanel HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="20">
                        <sc:CachedImage Width="48"
                                        Height="48"
                                        Source="{Binding CurrentChallengePeakRecord.Group.ThemePicPath}" />
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20"
                                       Height="20"
                                       Source="ms-appx:///Assets/Image/boss_star.ae0258cf.png" />
                                <TextBlock Foreground="{DynamicResource StarTextSecondary}">
                                    <Run Text="x" />
                                    <Run Text="{Binding CurrentChallengePeakRecord.BossStars}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20"
                                       Height="20"
                                       Source="ms-appx:///Assets/Image/normal_star.751a6e2d.png" />
                                <TextBlock Foreground="{DynamicResource StarTextSecondary}">
                                    <Run Text="x" />
                                    <Run Text="{Binding CurrentChallengePeakRecord.MobStars}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <AppBarSeparator Grid.Column="1" Padding="0" />

                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="4">
                        <TextBlock FontSize="16" Text="{Binding CurrentChallengePeakRecord.Group.NameMi18n}" />
                        <TextBlock>
                            <Run Text="{Binding lang:Lang.ChallengePeakPage_ChallengeAttempts}" />
                            <Run Text="" />
                            <Run Text="{Binding CurrentChallengePeakData.ChallengePeakBestRecordBrief.TotalBattleNum}" />
                        </TextBlock>
                    </StackPanel>

                </Grid>


                <!--  王棋通关战绩  -->
                <TextBlock Margin="0,8,0,0" Text="{Binding lang:Lang.ChallengePeakPage_KingInCheckStageRecords}" />

                <Grid Height="192"
                      Translation="0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <!--  BOSS 图  -->
                    <sc:CachedImage Grid.RowSpan="2"
                                    Grid.ColumnSpan="2"
                                    HorizontalAlignment="Right"
                                    Source="{Binding CurrentChallengePeakRecord.BossInfo.Icon}"
                                    Stretch="Uniform" />


                    <StackPanel Grid.Row="0" Margin="20,12,0,0">
                        <!--  BOSS 名称  -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal"
                                        IsVisible="{Binding CurrentChallengePeakRecord.BossRecord.HardMode, Converter={DynamicResource BoolToVisibilityConverter}}">
                                <TextBlock FontSize="16" FontWeight="Bold">
                                    <Run Text="["/>
                                    <Run Text="{Binding CurrentChallengePeakRecord.BossInfo.HardModeNameMi18n}"/>
                                    <Run Text="]"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="Bold"
                                       Text="{Binding CurrentChallengePeakRecord.BossInfo.NameMi18n}" />
                        </StackPanel>

                        <!--  通关数据  -->
                        <StackPanel Margin="0,8,0,0"
                                    Orientation="Horizontal"
                                    IsVisible="{Binding CurrentChallengePeakRecord.BossRecord, Converter={DynamicResource ObjectToVisibilityConverter}}">
                            <!--  使用轮次  -->
                            <TextBlock>
                                <Run Text="{Binding lang:Lang.ForgottenHallPage_CyclesUsed}" />
                                <Run Text="{Binding CurrentChallengePeakRecord.BossRecord.RoundNum}" />
                            </TextBlock>

                            <!--  已通关  -->
                            <fw:FontIcon Classes="icon" Margin="20,2,4,0"
                                      VerticalAlignment="Center"
                                      FontSize="12"
                                      Foreground="{DynamicResource StarTextSecondary}"
                                      Glyph="&#xEC61;" />
                            <TextBlock Margin="0,0,4,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding lang:Lang.ChallengePeakPage_Cleared}" />

                            <!--  星星数  -->
                            <ItemsControl ItemsSource="{Binding linq:Enumerable.Range(0, CurrentChallengePeakRecord.BossStars)}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Width="20"
                                               Height="20"
                                               VerticalAlignment="Center"
                                               Source="{StaticResource StarIcon}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                        <!--  暂无通关战绩  -->
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource StarTextSecondary}"
                                   Text="{Binding lang:Lang.ChallengePeakPage_NoClearanceRecords}"
                                   IsVisible="{Binding CurrentChallengePeakRecord.BossRecord, Converter={DynamicResource ObjectToVisibilityReversedConverter}}" />

                    </StackPanel>


                    <StackPanel Grid.Row="1"
                                Margin="20,4,0,0"
                                VerticalAlignment="Top"
                                Spacing="8"
                                IsVisible="{Binding CurrentChallengePeakRecord.BossRecord, Converter={DynamicResource ObjectToVisibilityConverter}}">
                        <!--  通关时间  -->
                        <TextBlock Foreground="{DynamicResource StarTextSecondary}" Text="{Binding CurrentChallengePeakRecord.BossRecord.ChallengeTime, StringFormat='{}{0:yyyy.MM.dd HH:mm}'}" />
                        <!--  队伍  -->
                        <ItemsControl Grid.Row="3"
                                      Grid.ColumnSpan="3"
                                      HorizontalAlignment="Left"
                                      ItemTemplate="{StaticResource StarRailTeamDataTemplate}"
                                      ItemsSource="{Binding CurrentChallengePeakRecord.BossRecord.Avatars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="12,0,12,0"
                                IsVisible="{Binding CurrentChallengePeakRecord.BossRecord, Converter={DynamicResource ObjectToVisibilityConverter}}">
                        <!--  Buff  -->
                        <StackPanel Orientation="Horizontal">
                            <sc:CachedImage Width="28"
                                            Height="28"
                                            Source="{Binding CurrentChallengePeakRecord.BossRecord.Buff.Icon}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding CurrentChallengePeakRecord.BossRecord.Buff.NameMi18n}" />
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource StarTextSecondary}"
                                   Text="{Binding CurrentChallengePeakRecord.BossRecord.Buff.DescMi18n}"
                                   TextWrapping="Wrap" />
                    </StackPanel>


                </Grid>


                <!--  骑士关卡战绩  -->
                <TextBlock Margin="0,8,0,0" Text="{Binding lang:Lang.ChallengePeakPage_KnightStageRecords}" />


                <Grid
                      Translation="0,0,16">

                    <ItemsControl ItemsSource="{Binding CurrentChallengePeakRecord.Mobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="cp:ChallengePeakRecordMob">

                                <Grid Height="200">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <!--  BOSS 图  -->
                                    <Grid Grid.RowSpan="2"
                                          Width="80"
                                          Height="80"
                                          Margin="0,12,20,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Top">
                                        <sc:CachedImage Source="{Binding MobInfo.MonsterIcon}" Stretch="Uniform" />
                                    </Grid>

                                    <StackPanel Grid.Row="0" Margin="20,12,0,0">
                                        <!--  BOSS 名称  -->
                                        <TextBlock FontSize="16" FontWeight="Bold">
                                            <Run Text="{Binding MobInfo.Name}" />
                                            <Run Text="{Binding MobInfo.MonsterName}" />
                                        </TextBlock>

                                        <!--  通关数据  -->
                                        <StackPanel Margin="0,8,0,0"
                                                    Orientation="Horizontal"
                                                    IsVisible="{Binding HasChallengeRecord, Converter={DynamicResource BoolToVisibilityConverter}}">
                                            <!--  使用轮次  -->
                                            <TextBlock>
                                                <Run Text="{Binding lang:Lang.ForgottenHallPage_CyclesUsed}" />
                                                <Run Text="{Binding MobRecord.RoundNum}" />
                                            </TextBlock>

                                            <!--  已通关 / 快速通关  -->
                                            <fw:FontIcon Classes="icon" Margin="20,2,4,0"
                                                      VerticalAlignment="Center"
                                                      FontSize="12"
                                                      Foreground="{DynamicResource StarTextSecondary}"
                                                      Glyph="&#xEC61;" />
                                            <TextBlock Margin="0,0,4,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding lang:Lang.ChallengePeakPage_Cleared}"
                                                       IsVisible="{Binding MobRecord.IsFast, Converter={DynamicResource BoolToVisibilityReversedConverter}}" />
                                            <TextBlock Margin="0,0,4,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding lang:Lang.ForgottenHallPage_QuickCleared}"
                                                       IsVisible="{Binding MobRecord.IsFast, Converter={DynamicResource BoolToVisibilityConverter}}" />

                                            <!--  星星数  -->
                                            <ItemsControl HorizontalAlignment="Right" ItemsSource="{Binding linq:Enumerable.Range(0, MobRecord.StarNum)}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Image Width="20"
                                                               Height="20"
                                                               VerticalAlignment="Center"
                                                               Source="{StaticResource StarIcon}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>

                                        <!--  暂无通关战绩  -->
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{DynamicResource StarTextSecondary}"
                                                   Text="{Binding lang:Lang.ChallengePeakPage_NoClearanceRecords}"
                                                   IsVisible="{Binding HasChallengeRecord, Converter={DynamicResource BoolToVisibilityReversedConverter}}" />

                                    </StackPanel>


                                    <StackPanel Grid.Row="1"
                                                Margin="20,4,0,0"
                                                VerticalAlignment="Top"
                                                Spacing="8"
                                                IsVisible="{Binding MobRecord.HasChallengeRecord, Converter={DynamicResource BoolToVisibilityConverter}}">
                                        <StackPanel Spacing="8"
                                                    IsVisible="{Binding MobRecord.IsFast, Converter={DynamicResource BoolToVisibilityReversedConverter}}">
                                            <!--  通关时间  -->
                                            <TextBlock Foreground="{DynamicResource StarTextSecondary}"
                                                       Text="{Binding MobRecord.ChallengeTime, StringFormat='{}{0:yyyy.MM.dd HH:mm}'}" />
                                            <!--  队伍  -->
                                            <ItemsControl HorizontalAlignment="Left"
                                                          ItemTemplate="{StaticResource StarRailTeamDataTemplate}"
                                                          ItemsSource="{Binding MobRecord.Avatars}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- 快速通关 -->
                                        <Image Width="120"
                                               Margin="60,0,0,0"
                                               HorizontalAlignment="Left"
                                               Source="ms-appx:///Assets/Image/20004.png"
                                               IsVisible="{Binding MobRecord.IsFast, Converter={DynamicResource BoolToVisibilityConverter}}" />

                                    </StackPanel>



                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Grid>



            </StackPanel>
        </ScrollViewer>


    </Grid>




</sf:PageBase>