<controls:StarwardContentDialog xmlns="https://github.com/avaloniaui"
                                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                 xmlns:controls="using:LunarWard.Views.Starward.Controls"
                                 xmlns:lang="using:LunarWard.Language"
                                 xmlns:local="using:LunarWard.Features.Gacha"
                                 x:Class="LunarWard.Features.Gacha.DeleteGachaLogDialog"
                                 x:DataType="local:DeleteGachaLogDialog"
                                 Loaded="ContentDialog_Loaded">

  <!--
    上游 Starward/Features/Gacha/DeleteGachaLogDialog.xaml 的逐结构移植。
    ContentDialog -> StarwardContentDialog（关闭按钮/ESC 由容器提供，底部自绘按钮保留原样）；
    CalendarDatePicker/TimePicker 用 Avalonia 同名控件；Visibility -> IsVisible（docs/09）。
  -->

  <StackPanel Margin="24" Spacing="12">

    <TextBlock FontSize="20" Text="{x:Static lang:Lang.DeleteGachaLogDialog_DeleteGachaRecordsForASpecificTimePeriod}" />

    <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="12">
      <TextBlock VerticalAlignment="Center" Text="Uid" />
      <ComboBox Name="ComboBox_Uid"
                MinWidth="140"
                ItemsSource="{Binding UidList}"
                SelectedItem="{Binding SelectUid, Mode=TwoWay}" />
    </StackPanel>

    <TextBlock Name="TextBlock_GachaLogNumber"
               Foreground="{StaticResource StarTextSecondary}"
               IsVisible="False" />

    <StackPanel Orientation="Horizontal" Spacing="12">
      <StackPanel Spacing="8">
        <Border Height="32">
          <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Lang.DeleteGachaLogDialog_BeginTime}" />
        </Border>
        <Border Height="32">
          <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Lang.DeleteGachaLogDialog_EndTime}" />
        </Border>
      </StackPanel>
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <CalendarDatePicker Name="CalendarDatePicker_BeginTime"
                              MinWidth="160"
                              SelectedDateFormat="Custom"
                              CustomDateFormatString="yyyy/MM/dd"
                              SelectedDateChanged="CalendarDatePicker_DateChanged" />
          <TimePicker Name="TimePicker_BeginTime"
                      ClockIdentifier="24HourClock"
                      SelectedTimeChanged="TimePicker_SelectedTimeChanged" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <CalendarDatePicker Name="CalendarDatePicker_EndTime"
                              MinWidth="160"
                              SelectedDateFormat="Custom"
                              CustomDateFormatString="yyyy/MM/dd"
                              SelectedDateChanged="CalendarDatePicker_DateChanged" />
          <TimePicker Name="TimePicker_EndTime"
                      ClockIdentifier="24HourClock"
                      SelectedTimeChanged="TimePicker_SelectedTimeChanged" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <TextBlock Name="TextBlock_SelectedCount"
               Foreground="{StaticResource StarTextSecondary}"
               IsVisible="False" />
    <TextBlock Name="TextBlock_Warning"
               Foreground="{StaticResource StarCautionBrush}"
               Text="{x:Static lang:Lang.DeleteGachaLogDialog_6MonthsDeletingWarning}"
               TextWrapping="Wrap"
               IsVisible="False" />

    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
      <Button Name="Button_Delete"
              MinWidth="100"
              Content="{x:Static lang:Lang.Common_Delete}"
              IsEnabled="False">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Command="{Binding DeleteCommand}"
                      Foreground="{StaticResource StarErrorBrush}"
                      Header="{x:Static lang:Lang.LauncherPage_ConfirmDelete}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Button Name="Button_Cancel"
              MinWidth="100"
              Command="{Binding CancelCommand}"
              Content="{x:Static lang:Lang.Common_Cancel}" />
    </StackPanel>

  </StackPanel>

</controls:StarwardContentDialog>
