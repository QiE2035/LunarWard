<fw:PageBase x:Class="LunarWard.Features.Gacha.GenshinBeyondGachaPage"
            xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="using:LunarWard.Controls"
            xmlns:fw="using:LunarWard.Frameworks"
            xmlns:lang="using:LunarWard.Language"
            xmlns:local="using:LunarWard.Features.Gacha">

    <fw:PageBase.Resources>
        <SolidColorBrush x:Key="Rarity5ForegroundBrush">#FFA500</SolidColorBrush>
        <SolidColorBrush x:Key="Rarity4ForegroundBrush">#C864E0</SolidColorBrush>
        <SolidColorBrush x:Key="Rarity3ForegroundBrush">#5EAAED</SolidColorBrush>
        <SolidColorBrush x:Key="Rarity2ForegroundBrush">#3BA272</SolidColorBrush>

        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Foreground" Value="{StaticResource StarTextSecondary}" />
        </Style>

        <local:GenshinBeyondGachaPityProgressBackgroundBrushConverter x:Key="GenshinBeyondGachaPityProgressBackgroundBrushConverter" />
        <local:RarityToGIBgConverter x:Key="RarityToGIBgConverter" />
    </fw:PageBase.Resources>

    <Grid RowDefinitions="44,*">

        <TextBlock Margin="24,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontSize="20"
                   FontWeight="Bold"
                   Text="{x:Static lang:Lang.GenshinBeyondGachaPage_MiliastraWonderlandOde}" />

        <StackPanel HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="16">
            <!--  Uid List  -->
            <ComboBox Name="ComboBox_Uid"
                      MinWidth="140"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding UidList}"
                      SelectedItem="{Binding SelectUid, Mode=TwoWay}" />
            <!--  Update  -->
            <SplitButton Height="32" Command="{Binding UpdateGachaLogCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Margin="0,2,0,0"
                               Classes="icon"
                               FontSize="14"
                               Text="&#xE72C;" />
                    <TextBlock Text="{x:Static lang:Lang.GachaLogPage_UpdateRecords}" />
                </StackPanel>
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuItem Command="{Binding UpdateGachaLogCommand}"
                                  CommandParameter="cache"
                                  Header="{x:Static lang:Lang.GachaLogPage_UpdateSavedURL}" />
                        <MenuItem Command="{Binding UpdateGachaLogCommand}"
                                  CommandParameter="all"
                                  Header="{x:Static lang:Lang.GachaLogPage_UpdateAll}" />
                        <MenuItem Command="{Binding InputUrlCommand}" Header="{x:Static lang:Lang.GachaLogPage_InputURL}" />
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>
            <!--  Setting  -->
            <Button>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Margin="0,2,0,0"
                               Classes="icon"
                               FontSize="14"
                               Text="&#xE713;" />
                    <TextBlock Text="{x:Static lang:Lang.Common_Setting}" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout>
                        <StackPanel MinWidth="200" Spacing="8">
                            <TextBlock FontSize="16" Text="{x:Static lang:Lang.GachaLogPage_OtherSettings}" />

                            <!--  复制 URL  -->
                            <Button Margin="0,8,0,0" Command="{Binding CopyUrlCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Name="TextBlock_CopyUrl"
                                               Classes="icon"
                                               FontSize="16"
                                               Text="&#xE8C8;" />
                                    <TextBlock Text="{x:Static lang:Lang.GachaLogPage_CopyURL}" />
                                </StackPanel>
                            </Button>

                            <!--  总是出现 Authkey Timeout  -->
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource StarTextSecondary}"
                                       Text="{x:Static lang:Lang.GachaLogPage_AuthkeyTimeoutAlwaysOccurs}" />
                            <TextBlock Margin="0,-4,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource StarTextSecondary}"
                                       Text="{x:Static lang:Lang.GachaLogPage_RestartGameAfterDeletingTheCacheFolder}"
                                       TextWrapping="Wrap" />
                            <Button Command="{Binding DeleteGachaCacheFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="icon" FontSize="16" Text="&#xEA99;" />
                                    <TextBlock Text="{x:Static lang:Lang.GachaLogPage_DeleteCacheFolder}" />
                                </StackPanel>
                            </Button>

                            <!--  语言  -->
                            <StackPanel Margin="0,4,0,0"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <TextBlock Foreground="{StaticResource StarTextSecondary}" Text="{x:Static lang:Lang.GachaLogPage_Language}" />
                                <Button Padding="1"
                                        VerticalAlignment="Bottom"
                                        Classes="icon-button">
                                    <TextBlock Classes="icon" FontSize="12" Text="&#xE9CE;" />
                                    <Button.Flyout>
                                        <Flyout>
                                            <TextBlock Text="{x:Static lang:Lang.GachaLogPage_GachaLanguageDesc}" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <TextBox MinWidth="100" Text="{Binding GachaLanguage, Mode=TwoWay}" />

                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <!--  Pane  -->
            <Button Height="32"
                    BorderThickness="0"
                    Classes="accent"
                    Command="{Binding OpenItemStatsPaneCommand}"
                    CornerRadius="14,0,0,14"
                    IsEnabled="{Binding GachaItemStats, Converter={StaticResource ObjectToBoolConverter}}">
                <TextBlock Margin="6,2,4,0"
                           Classes="icon"
                           FontSize="18"
                           Text="&#xE8A0;" />
            </Button>
        </StackPanel>


        <StackPanel Name="StackPanel_Emoji"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    IsVisible="False">
            <Image Name="Image_Emoji"
                   Width="160"
                   Height="160"
                   Source="avares://LunarWard/Assets/Image/UI_EmotionIcon5.png" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="{StaticResource StarTextSecondary}"
                       Text="{x:Static lang:Lang.GachaLogPage_NoGachaRecords}" />
        </StackPanel>


        <SplitView Name="SplitView_Content"
                   Grid.Row="1"
                   BorderThickness="0"
                   CornerRadius="12,0,0,12"
                   DisplayMode="Overlay"
                   OpenPaneLength="508"
                   PaneBackground="{StaticResource StarOverlayAcrylicBrush}"
                   PanePlacement="Right">

            <ScrollViewer Name="ScrollViewer_GachaStats"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Name="Grid_GachaStats"
                      Margin="20,0,20,16"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <!--  常驻颂愿  -->
                    <Border Padding="12,8,12,8"
                            Background="{StaticResource StarOverlayAcrylicBrush}"
                            CornerRadius="8"
                            IsVisible="{Binding GachaStatsType1000, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="4">

                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock FontSize="16"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="{Binding GachaStatsType1000.GachaTypeText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           FontSize="16"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="{Binding GachaStatsType1000.Count}" />
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="0">
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="{Binding GachaStatsType1000.StartTime, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss}'}" />
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="-" />
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="{Binding GachaStatsType1000.EndTime, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss}'}" />
                            </StackPanel>

                            <Separator Grid.Row="2" />

                            <!--  4★ 平均  -->
                            <StackPanel Grid.Row="3"
                                        Orientation="Horizontal"
                                        Spacing="0">
                                <TextBlock Foreground="{StaticResource Rarity4ForegroundBrush}" Text="4★" />
                                <TextBlock Foreground="{StaticResource Rarity4ForegroundBrush}" Text="{x:Static lang:Lang.GachaStatsCard_Average}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Foreground="{StaticResource Rarity4ForegroundBrush}"
                                           Text="{Binding GachaStatsType1000.Average_4, StringFormat='{}{0:F2}'}" />
                            </StackPanel>

                            <!--  4★ 统计  -->
                            <StackPanel Grid.Row="4"
                                        Orientation="Horizontal"
                                        Spacing="0">
                                <TextBlock Foreground="{StaticResource Rarity4ForegroundBrush}" Text="4★" />
                                <TextBlock Foreground="{StaticResource Rarity4ForegroundBrush}" Text="{x:Static lang:Lang.GachaStatsCard_Stats}" />
                                <TextBlock Foreground="{StaticResource Rarity4ForegroundBrush}" Text="{Binding GachaStatsType1000.Count_4}" />
                                <TextBlock Foreground="{StaticResource Rarity4ForegroundBrush}" Text="[" />
                                <TextBlock Foreground="{StaticResource Rarity4ForegroundBrush}"
                                           Text="{Binding GachaStatsType1000.Ratio_4, StringFormat='{}{0:P2}'}" />
                                <TextBlock Foreground="{StaticResource Rarity4ForegroundBrush}" Text="]" />
                            </StackPanel>

                            <!--  3★ 统计  -->
                            <StackPanel Grid.Row="5"
                                        Orientation="Horizontal"
                                        Spacing="0">
                                <TextBlock Foreground="{StaticResource Rarity3ForegroundBrush}" Text="3★" />
                                <TextBlock Foreground="{StaticResource Rarity3ForegroundBrush}" Text="{x:Static lang:Lang.GachaStatsCard_Stats}" />
                                <TextBlock Foreground="{StaticResource Rarity3ForegroundBrush}" Text="{Binding GachaStatsType1000.Count_3}" />
                                <TextBlock Foreground="{StaticResource Rarity3ForegroundBrush}" Text="[" />
                                <TextBlock Foreground="{StaticResource Rarity3ForegroundBrush}"
                                           Text="{Binding GachaStatsType1000.Ratio_3, StringFormat='{}{0:P2}'}" />
                                <TextBlock Foreground="{StaticResource Rarity3ForegroundBrush}" Text="]" />
                            </StackPanel>

                            <!--  2★ 统计  -->
                            <StackPanel Grid.Row="6"
                                        Orientation="Horizontal"
                                        Spacing="0">
                                <TextBlock Foreground="{StaticResource Rarity2ForegroundBrush}" Text="2★" />
                                <TextBlock Foreground="{StaticResource Rarity2ForegroundBrush}" Text="{x:Static lang:Lang.GachaStatsCard_Stats}" />
                                <TextBlock Foreground="{StaticResource Rarity2ForegroundBrush}" Text="{Binding GachaStatsType1000.Count_2}" />
                                <TextBlock Foreground="{StaticResource Rarity2ForegroundBrush}" Text="[" />
                                <TextBlock Foreground="{StaticResource Rarity2ForegroundBrush}"
                                           Text="{Binding GachaStatsType1000.Ratio_2, StringFormat='{}{0:P2}'}" />
                                <TextBlock Foreground="{StaticResource Rarity2ForegroundBrush}" Text="]" />
                            </StackPanel>

                            <Grid Grid.Row="8" RowDefinitions="Auto,*">
                                <StackPanel HorizontalAlignment="Stretch"
                                            Orientation="Horizontal"
                                            Spacing="0">
                                    <ToggleButton Name="ToggleButton_1000_Rarity4"
                                                  Classes="segment"
                                                  Content="4★"
                                                  IsChecked="True"
                                                  Foreground="{StaticResource Rarity4ForegroundBrush}"
                                                  Click="SegmentedItem_1000_Click" />
                                    <ToggleButton Name="ToggleButton_1000_Rarity3"
                                                  Classes="segment"
                                                  Content="3★"
                                                  Foreground="{StaticResource Rarity3ForegroundBrush}"
                                                  Click="SegmentedItem_1000_Click" />
                                </StackPanel>
                                <TabControl Name="Segmented_GachaItemList1000"
                                            Grid.Row="1"
                                            SelectedIndex="0"
                                            SelectionChanged="Segmented_GachaItemList1000_SelectionChanged">
                                    <TabControl.Styles>
                                        <Style Selector="TabItem">
                                            <Setter Property="IsVisible" Value="False" />
                                            <Setter Property="Height" Value="0" />
                                        </Style>
                                        <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
                                            <Setter Property="IsVisible" Value="False" />
                                        </Style>
                                    </TabControl.Styles>
                                    <TabItem>
                                        <ItemsControl ItemsSource="{Binding GachaStatsType1000.List_4}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Name="Grid_Rarity5Item"
                                                          Height="28"
                                                          Background="Transparent"
                                                          ColumnDefinitions="36,*,24"
                                                          Tag="{Binding}"
                                                          ToolTip.Tip="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}">
                                                        <controls:CachedImage Grid.Column="0"
                                                                              Width="28"
                                                                              Height="28"
                                                                              HorizontalAlignment="Left"
                                                                              Source="{Binding Icon}" />
                                                        <Border Grid.Column="1"
                                                                Height="24"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding Converter={StaticResource GenshinBeyondGachaPityProgressBackgroundBrushConverter}}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="4,0,4,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding ItemName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Pity}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </TabItem>
                                    <TabItem>
                                        <ItemsControl ItemsSource="{Binding GachaStatsType1000.List_3}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Name="Grid_Rarity4Item"
                                                          Height="28"
                                                          Background="Transparent"
                                                          ColumnDefinitions="28,*,24"
                                                          ColumnSpacing="8"
                                                          Tag="{Binding}"
                                                          ToolTip.Tip="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}">
                                                        <controls:CachedImage Grid.Column="0"
                                                                              Width="28"
                                                                              Height="28"
                                                                              Source="{Binding Icon}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="4,0,4,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding ItemName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Pity}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Grid>
                    </Border>


                    <!--  活动颂愿  -->
                    <Border Grid.Column="1"
                            Padding="12,8,12,8"
                            Background="{StaticResource StarOverlayAcrylicBrush}"
                            CornerRadius="8"
                            IsVisible="{Binding GachaStatsType2000, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="4">

                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock FontSize="16"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="{Binding GachaStatsType2000.GachaTypeText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           FontSize="16"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="{Binding GachaStatsType2000.Count}" />
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="0">
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="{Binding GachaStatsType2000.StartTime, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss}'}" />
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="-" />
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource StarTextSecondary}"
                                           Text="{Binding GachaStatsType2000.EndTime, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss}'}" />
                            </StackPanel>

                            <Separator Grid.Row="2" />

                            <!--  5★ 平均  -->
                            <StackPanel Grid.Row="3"
                                        Orientation="Horizontal"
                                        Spacing="0">
                                <TextBlock Foreground="{StaticResource Rarity5ForegroundBrush}" Text="5★" />
                                <TextBlock Foreground="{StaticResource Rarity5ForegroundBrush}" Text="{x:Static lang:Lang.GachaStatsCard_Average}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Foreground="{StaticResource Rarity5ForegroundBrush}"
                                           Text="{Binding GachaStatsType2000.Average_5, StringFormat='{}{0:F2}'}" />
                            </StackPanel>

                            <!--  5★ 统计  -->
                            <StackPanel Grid.Row="4"
                                        Orientation="Horizontal"
                                        Spacing="0">
                                <TextBlock Foreground="{StaticResource Rarity5ForegroundBrush}" Text="5★" />
                                <TextBlock Foreground="{StaticResource Rarity5ForegroundBrush}" Text="{x:Static lang:Lang.GachaStatsCard_Stats}" />
                                <TextBlock Foreground="{StaticResource Rarity5ForegroundBrush}" Text="{Binding GachaStatsType2000.Count_5}" />
                                <TextBlock Foreground="{StaticResource Rarity5ForegroundBrush}" Text="[" />
                                <TextBlock Foreground="{StaticResource Rarity5ForegroundBrush}"
                                           Text="{Binding GachaStatsType2000.Ratio_5, StringFormat='{}{0:P2}'}" />
                                <TextBlock Foreground="{StaticResource Rarity5ForegroundBrush}" Text="]" />
                            </StackPanel>

                            <!--  4★ 统计  -->
                            <StackPanel Grid.Row="5"
                                        Orientation="Horizontal"
                                        Spacing="0">
                                <TextBlock Foreground="{StaticResource Rarity4ForegroundBrush}" Text="4★" />
                                <TextBlock Foreground="{StaticResource Rarity4ForegroundBrush}" Text="{x:Static lang:Lang.GachaStatsCard_Stats}" />
                                <TextBlock Foreground="{StaticResource Rarity4ForegroundBrush}" Text="{Binding GachaStatsType2000.Count_4}" />
                                <TextBlock Foreground="{StaticResource Rarity4ForegroundBrush}" Text="[" />
                                <TextBlock Foreground="{StaticResource Rarity4ForegroundBrush}"
                                           Text="{Binding GachaStatsType2000.Ratio_4, StringFormat='{}{0:P2}'}" />
                                <TextBlock Foreground="{StaticResource Rarity4ForegroundBrush}" Text="]" />
                            </StackPanel>

                            <!--  3★ 统计  -->
                            <StackPanel Grid.Row="6"
                                        Orientation="Horizontal"
                                        Spacing="0">
                                <TextBlock Foreground="{StaticResource Rarity3ForegroundBrush}" Text="3★" />
                                <TextBlock Foreground="{StaticResource Rarity3ForegroundBrush}" Text="{x:Static lang:Lang.GachaStatsCard_Stats}" />
                                <TextBlock Foreground="{StaticResource Rarity3ForegroundBrush}" Text="{Binding GachaStatsType2000.Count_3}" />
                                <TextBlock Foreground="{StaticResource Rarity3ForegroundBrush}" Text="[" />
                                <TextBlock Foreground="{StaticResource Rarity3ForegroundBrush}"
                                           Text="{Binding GachaStatsType2000.Ratio_3, StringFormat='{}{0:P2}'}" />
                                <TextBlock Foreground="{StaticResource Rarity3ForegroundBrush}" Text="]" />
                            </StackPanel>

                            <Grid Grid.Row="8" RowDefinitions="Auto,*">
                                <StackPanel HorizontalAlignment="Stretch"
                                            Orientation="Horizontal"
                                            Spacing="0">
                                    <ToggleButton Name="ToggleButton_2000_Rarity5"
                                                  Classes="segment"
                                                  Content="5★"
                                                  IsChecked="True"
                                                  Foreground="{StaticResource Rarity5ForegroundBrush}"
                                                  Click="SegmentedItem_2000_Click" />
                                    <ToggleButton Name="ToggleButton_2000_Rarity4"
                                                  Classes="segment"
                                                  Content="4★"
                                                  Foreground="{StaticResource Rarity4ForegroundBrush}"
                                                  Click="SegmentedItem_2000_Click" />
                                </StackPanel>
                                <TabControl Name="Segmented_GachaItemList2000"
                                            Grid.Row="1"
                                            SelectedIndex="0"
                                            SelectionChanged="Segmented_GachaItemList2000_SelectionChanged">
                                    <TabControl.Styles>
                                        <Style Selector="TabItem">
                                            <Setter Property="IsVisible" Value="False" />
                                            <Setter Property="Height" Value="0" />
                                        </Style>
                                        <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
                                            <Setter Property="IsVisible" Value="False" />
                                        </Style>
                                    </TabControl.Styles>
                                    <TabItem>
                                        <ItemsControl ItemsSource="{Binding GachaStatsType2000.List_5}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Name="Grid_Rarity5Item"
                                                          Height="28"
                                                          Background="Transparent"
                                                          ColumnDefinitions="36,*,24"
                                                          Tag="{Binding}"
                                                          ToolTip.Tip="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}">
                                                        <controls:CachedImage Grid.Column="0"
                                                                              Width="28"
                                                                              Height="28"
                                                                              HorizontalAlignment="Left"
                                                                              Source="{Binding Icon}" />
                                                        <Border Grid.Column="1"
                                                                Height="24"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding Converter={StaticResource GenshinBeyondGachaPityProgressBackgroundBrushConverter}}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="4,0,4,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding ItemName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Pity}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </TabItem>
                                    <TabItem>
                                        <ItemsControl ItemsSource="{Binding GachaStatsType2000.List_4}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Name="Grid_Rarity4Item"
                                                          Height="28"
                                                          Background="Transparent"
                                                          ColumnDefinitions="28,*,24"
                                                          ColumnSpacing="8"
                                                          Tag="{Binding}"
                                                          ToolTip.Tip="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}">
                                                        <controls:CachedImage Grid.Column="0"
                                                                              Width="28"
                                                                              Height="28"
                                                                              Source="{Binding Icon}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="4,0,4,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding ItemName}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Pity}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
            </ScrollViewer>

            <SplitView.Pane>
                <ScrollViewer>
                    <ItemsControl Name="GridView_GachaItemStats"
                                  Margin="24,12,24,12"
                                  ItemsSource="{Binding GachaItemStats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="80"
                                      Height="97"
                                      Margin="4,2,4,2">
                                    <controls:CachedImage Source="{Binding RankType, Converter={StaticResource RarityToGIBgConverter}}" />
                                    <controls:CachedImage Height="80"
                                                          VerticalAlignment="Top"
                                                          CornerRadius="0,0,16,0"
                                                          Source="{Binding Icon}" />
                                    <StackPanel Margin="0,0,0,1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Orientation="Horizontal"
                                                Spacing="0">
                                        <TextBlock FontSize="12"
                                                   Foreground="#84603D"
                                                   Text="{Binding Count}" />
                                        <TextBlock FontSize="12"
                                                   Foreground="#84603D"
                                                   Text="{x:Static lang:Lang.SpiralAbyssPage_Times}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </SplitView.Pane>

        </SplitView>

    </Grid>

</fw:PageBase>
