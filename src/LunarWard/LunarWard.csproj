<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>LunarWard</RootNamespace>
    <AssemblyName>LunarWard</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- 上游 Starward.csproj 开启 /unsafe：Helpers/AccentColorHelper 用指针取像素。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets/lunarward.ico</ApplicationIcon>
    <!--
      AVLN3001：XAML 资源「找不到公共无参构造函数」，因为页面 ctor 接收 PageContext
      （docs/07-UI-REPLICA.md §6 的契约）。这些页面只由代码创建，不走 XAML runtime loader。
    -->
    <NoWarn>$(NoWarn);CS8618;AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 上游 src/Starward/Starward.csproj 直接引用：Dapper 数据访问、Microsoft.Data.Sqlite。
         endgame 折叠 LunarWard.Games/Launch 后必须显式声明，不能靠项目引用传递。 -->
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="DialogHost.Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Iciclecreek.Avalonia.Terminal" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- 以下与上游 src/Starward/Starward.csproj 的依赖清单逐项对齐（平台专有包除外），
         供 AppConfig.*（DI/配置/日志）与 Helpers/FileCache 直接使用。 -->
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Ini" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="MiniExcel" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="ZiggyCreatures.FusionCache" />
    <!-- 区服 logo / 游戏图标等品牌素材，来自上游的内容包（contentFiles 拷进输出 Assets/） -->
    <PackageReference Include="Starward.Assets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LunarWard.Core\LunarWard.Core.csproj" />
    <ProjectReference Include="..\LunarWard.Language\LunarWard.Language.csproj" />
    <ProjectReference Include="..\LunarWard.Platform\LunarWard.Platform.csproj" />
    <ProjectReference Include="..\LunarWard.Wine\LunarWard.Wine.csproj" />
    <ProjectReference Include="..\LunarWard.Installer\LunarWard.Installer.csproj" />
    <ProjectReference Include="..\LunarWard.RPC\LunarWard.RPC.csproj" />
    <ProjectReference Include="..\LunarWard.Setup.Core\LunarWard.Setup.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 抽卡 Excel 导出模板：上游需要输出目录下的 Assets/Template；源码随 Launch 折叠放这里，靠 Link 保持输出相对路径 -->
    <None Update="Launch\Assets\Template\*.xlsx" CopyToOutputDirectory="PreserveNewest" Link="Assets/Template/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Frameworks/WebView/SelfTest（原生层，不依赖 Avalonia）与 SelfTest.Avalonia
      （真实 Avalonia 窗口里的嵌入自检）各自有 csproj，直接编译本目录下的源码，
      不属于主程序编译单元。
    -->
    <Compile Remove="Frameworks\WebView\SelfTest*\**" />
    <None Remove="Frameworks\WebView\SelfTest*\**" />
    <EmbeddedResource Remove="Frameworks\WebView\SelfTest*\**" />
    <AvaloniaResource Remove="Frameworks\WebView\SelfTest*\**" />
    <!-- Avalonia 12 的 XAML 编译项是 AvaloniaXaml；只 Remove AvaloniaResource 仍会把 XProbe.axaml
         带进主程序编译单元，导致整个程序集的 x:Name 字段生成失败（AXN0001 之后所有页面壳字段消失）。 -->
    <AvaloniaXaml Remove="Frameworks\WebView\SelfTest*\**" />
  </ItemGroup>
</Project>
