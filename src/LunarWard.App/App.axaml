<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LunarWard.App"
             x:Class="LunarWard.App.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://LunarWard/Styles/LunarWard.axaml" />
  </Application.Styles>

</Application>
