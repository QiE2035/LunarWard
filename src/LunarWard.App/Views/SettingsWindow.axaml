<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LunarWard.App.ViewModels"
        xmlns:svc="using:LunarWard.App.Services"
        x:Class="LunarWard.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="设置"
        Width="980" Height="700"
        Background="#101418">

  <Grid RowDefinitions="*,Auto" Margin="16">

    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="14">

        <!-- 游戏目录 -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="游戏目录" Classes="title" />
            <Grid ColumnDefinitions="Auto,160,Auto,*">
              <ComboBox Grid.Column="0" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}"
                        MinWidth="140" Margin="0,0,8,0" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Editions}" SelectedItem="{Binding Edition}" Margin="0,0,8,0" />
              <Button Grid.Column="2" Classes="toolbar" Content="扫描" Command="{Binding ScanGamesCommand}" Margin="0,0,8,0" />
              <TextBox Grid.Column="3" Text="{Binding GamePath}" PlaceholderText="例如 /home/you/games/hk4e_cn" />
            </Grid>
            <ItemsControl ItemsSource="{Binding DetectedGames}" MaxHeight="150">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="svc:DetectedGame">
                  <TextBlock Text="{Binding Directory}" Classes="status" TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 渠道 -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="区服渠道" Classes="title" />
            <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" MinWidth="180" />
            <TextBlock Classes="status" TextWrapping="Wrap"
                       Text="Bilibili 仅原神国服可用，且需要 YuanShen_Data/Plugins/PCGameSDK.dll；缺 DLL 时启动会被拒绝（不会静默回落官服）。" />
          </StackPanel>
        </Border>

        <!-- 运行时 -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="wine 运行时" Classes="title" />
              <Button Grid.Column="1" Classes="toolbar" Content="重新扫描" Command="{Binding ScanRuntimesCommand}" />
            </Grid>
            <ComboBox ItemsSource="{Binding Runtimes}" SelectedItem="{Binding SelectedRuntime}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="svc:AvailableRuntime">
                  <StackPanel Spacing="0">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Path}" Classes="status" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding Message}" Classes="status" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- wine 选项 -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="wine 与增强" Classes="title" />
            <Grid ColumnDefinitions="200,*">
              <TextBlock Grid.Column="0" Text="同步原语" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding SyncOptions}" SelectedItem="{Binding SyncSelection}" />
            </Grid>
            <CheckBox IsChecked="{Binding Borderless}" Content="无边框窗口（borderless）" />
            <CheckBox IsChecked="{Binding WineWayland}" Content="winewayland（把 DISPLAY 设为空字符串，而不是删除）" />
            <CheckBox IsChecked="{Binding TimeoutFix}" Content="超时修复补丁（WINE_ENABLE_TIMEOUT_FIX）" />
            <CheckBox IsChecked="{Binding Fsr}" Content="FSR（WINE_FULLSCREEN_FSR）" />
            <CheckBox IsChecked="{Binding Dx12}" Content="DX12（仅绝区零：DXVK_ENABLE_NVAPI + VKD3D）" />
            <Grid ColumnDefinitions="200,*">
              <TextBlock Grid.Column="0" Text="HUD" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding HudOptions}" SelectedItem="{Binding Hud}" />
            </Grid>
            <Grid ColumnDefinitions="200,*">
              <TextBlock Grid.Column="0" Text="就绪保护期 (ms)" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1" Value="{Binding ReadyGraceMs}" Minimum="0" Maximum="600000"
                             Increment="500" FormatString="0" />
            </Grid>
            <TextBlock Classes="status" TextWrapping="Wrap"
                       Text="保护期长度随游戏/wine 版本漂移。若诊断里 signal 是 Grace 且很快返回，把这里调大（例如 8000）。" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <TextBlock Grid.Column="0" Classes="status" VerticalAlignment="Center"
                 Text="设置会写入 ~/.config/lunarward/config.json（原子写，未知字段保留）。" />
      <Button Grid.Column="1" Classes="launch" Content="保存" Command="{Binding SaveCommand}" Click="OnSaveClick" />
    </Grid>
  </Grid>
</Window>
