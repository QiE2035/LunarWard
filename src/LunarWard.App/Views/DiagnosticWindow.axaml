<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LunarWard.App.ViewModels"
        x:Class="LunarWard.App.Views.DiagnosticWindow"
        x:DataType="vm:DiagnosticViewModel"
        Title="诊断"
        Width="940" Height="680"
        Background="#101418">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="启动诊断" Classes="title" />
      <TextBlock Text="{Binding Summary}" Classes="status" />
      <TextBlock Text="{Binding ReportPath}" Classes="status" TextWrapping="Wrap" />
      <TextBlock Text="{Binding GameLogPath}" Classes="status" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="1" Classes="card" Margin="0,12">
      <ItemsControl ItemsSource="{Binding TroubleshootingSteps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" Classes="status" TextWrapping="Wrap" Margin="0,1" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <TextBox Grid.Row="2" Text="{Binding Json}" IsReadOnly="True"
             AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="monospace" FontSize="12"
             VerticalContentAlignment="Top" />

    <TextBlock Grid.Row="3" Classes="status" Margin="0,8,0,0"
               Text="提示：『signal: Grace』且很快返回，说明保护期可能比 6 秒长，可在 profile 高级项里调大 ready_grace_ms。" />
  </Grid>
</Window>
