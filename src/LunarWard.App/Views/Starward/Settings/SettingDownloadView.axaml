<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunarWard.App.ViewModels.Starward"
             x:Class="LunarWard.App.Views.Starward.Settings.SettingDownloadView"
             x:DataType="vm:SettingDownloadViewModel">

  <!--
    1:1 复刻 Starward Features/Setting/DownloadSetting.xaml（104 行）：
      18     20px「默认安装路径」
      19-22  0,12 说明（14px 次要色、换行）
      23-67  0,12 水平 StackPanel：强调按钮（40 高 / Padding 16,0 / CornerRadius 8,20,20,8，
             定位 E8DE）+ 已选择文件夹胶囊（40 高 / Margin 16,0 / CornerRadius 20）
      71-73  0,20 20px「硬链接」
      74-77  0,12 说明
      78-80  ToggleSwitch（已禁用/已启用）
      83-85  0,20 20px「速度限制」
      86-89  0,12 说明
      90-97  0,12 水平 StackPanel Spacing=12：NumberBox(MinWidth 100 / Minimum 0) + 「KB/s」
    行号均指 Starward/src/Starward/Features/Setting/DownloadSetting.xaml。

    LunarWard 落位说明：
      · 安装/更新界面已可用（启动器「安装游戏」走 InstallGameDialog），但**全局默认值**这一组还没接线 → 「定位」按钮、文件夹胶囊、硬链接开关、速度数字框
        全部保留 Starward 的位置并禁用，旁边用 12px 次要色写原因（不伪造功能）。
      · 「下载参数（只读）」「托管组件源」是 LunarWard 追加项，排在 Starward 三块之后。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel HorizontalAlignment="Stretch">

      <!-- DownloadSetting.xaml:18 -->
      <TextBlock Classes="section" Text="{Binding Strings[Settings.Download.InstallPath]}" />

      <!-- DownloadSetting.xaml:19-22 -->
      <TextBlock Margin="0,12,0,0"
                 Classes="description"
                 Text="{Binding Strings[Settings.Download.InstallPathDesc]}" />

      <!-- DownloadSetting.xaml:23-67（Starward：定位按钮 + 已选择文件夹胶囊） -->
      <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
        <!-- DownloadSetting.xaml:25-35 -->
        <Button Height="40"
                Padding="16,0"
                BorderThickness="0"
                CornerRadius="8,20,20,8"
                Classes="accent"
                IsEnabled="False">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" FontSize="16" Text="&#xE8DE;" />
            <TextBlock Text="{Binding Strings[Settings.Common.Locate]}" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- DownloadSetting.xaml:37-66 的「已选择文件夹」位置：没有安装器 → 说明文字 -->
      <TextBlock Margin="0,8,0,0"
                 MaxWidth="820"
                 HorizontalAlignment="Left"
                 FontSize="12"
                 Foreground="{StaticResource StarTextSecondary}"
                 TextWrapping="Wrap"
                 Text="{Binding Strings[Settings.Download.InstallPathUnavailable]}" />

      <!-- DownloadSetting.xaml:71-73 -->
      <TextBlock Margin="0,20,0,0"
                 Classes="section"
                 Text="{Binding Strings[Settings.Download.HardLink]}" />

      <!-- DownloadSetting.xaml:74-77 -->
      <TextBlock Margin="0,12,0,0"
                 Classes="description"
                 Text="{Binding Strings[Settings.Download.HardLinkDesc]}" />

      <!-- DownloadSetting.xaml:78-80（Linux 没有可写的硬链接开关） -->
      <ToggleSwitch IsEnabled="False"
                    OffContent="{Binding Strings[Settings.Common.Disabled]}"
                    OnContent="{Binding Strings[Settings.Common.Enabled]}" />

      <TextBlock Margin="0,4,0,0"
                 MaxWidth="820"
                 HorizontalAlignment="Left"
                 FontSize="12"
                 Foreground="{StaticResource StarTextSecondary}"
                 TextWrapping="Wrap"
                 Text="{Binding Strings[Settings.Download.HardLinkUnavailable]}" />

      <!-- DownloadSetting.xaml:83-85 -->
      <TextBlock Margin="0,20,0,0"
                 Classes="section"
                 Text="{Binding Strings[Settings.Download.SpeedLimit]}" />

      <!-- DownloadSetting.xaml:86-89 -->
      <TextBlock Margin="0,12,0,0"
                 Classes="description"
                 Text="{Binding Strings[Settings.Download.SpeedLimitDesc]}" />

      <!-- DownloadSetting.xaml:90-97（NumberBox → Avalonia NumericUpDown，禁用） -->
      <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="12">
        <NumericUpDown MinWidth="100"
                       Minimum="0"
                       Value="0"
                       IsEnabled="False" />
        <TextBlock VerticalAlignment="Center" Text="KB/s" />
      </StackPanel>

      <TextBlock Margin="0,4,0,0"
                 MaxWidth="820"
                 HorizontalAlignment="Left"
                 FontSize="12"
                 Foreground="{StaticResource StarTextSecondary}"
                 TextWrapping="Wrap"
                 Text="{Binding Strings[Settings.Download.SpeedLimitUnavailable]}" />

      <!-- ── LunarWard 追加：下载参数（只读）。
              Starward 下载页没有这些项；LunarWard 的安装器参数是代码常量，
              放在 Starward 三块之后，不改动原有顺序。────────────────────────── -->
      <TextBlock Margin="0,20,0,0"
                 Classes="section"
                 Text="{Binding Strings[Settings.Download.ReadOnly]}" />

      <TextBlock Margin="0,12,0,0"
                 MaxWidth="820"
                 HorizontalAlignment="Left"
                 Classes="description"
                 Text="{Binding Strings[Settings.Download.ReadOnlyNote]}" />

      <TextBlock Margin="0,12,0,0" Text="{Binding Strings[Settings.Download.Concurrency]}" />
      <TextBlock Margin="0,4,0,0"
                 FontSize="12"
                 Foreground="{StaticResource StarTextSecondary}"
                 TextWrapping="Wrap"
                 Text="{Binding ConcurrencyValue}" />

      <TextBlock Margin="0,12,0,0" Text="{Binding Strings[Settings.Download.Timeout]}" />
      <TextBlock Margin="0,4,0,0"
                 FontSize="12"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="{Binding TimeoutValue}" />

      <TextBlock Margin="0,12,0,0" Text="{Binding Strings[Settings.Download.Retries]}" />
      <TextBlock Margin="0,4,0,0"
                 FontSize="12"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="{Binding RetriesValue}" />

      <!-- ── LunarWard 追加：托管组件源（可操作的唯一入口）────────────────── -->
      <TextBlock Margin="0,20,0,0"
                 Classes="section"
                 Text="{Binding Strings[Settings.Download.ComponentSource]}" />

      <TextBlock Margin="0,12,0,0"
                 Classes="description"
                 Text="{Binding Strings[Settings.Download.ComponentSourceDesc]}" />

      <TextBlock Margin="0,8,0,0"
                 Classes="tertiary"
                 FontFamily="{StaticResource StarMonoFontFamily}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding ComponentSource}"
                 Text="{Binding ComponentSource}" />

      <TextBlock Margin="0,8,0,0" Text="{Binding IndexState}" />

      <TextBlock Margin="0,4,0,0"
                 Classes="tertiary"
                 Text="{Binding ComponentCount}"
                 IsVisible="{Binding HasComponentCount}" />

      <!-- 「更新索引」按钮（对应 Starward AccentButtonStyle 的胶囊圆角） -->
      <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="16">
        <Button Height="40"
                Padding="16,0"
                BorderThickness="0"
                CornerRadius="8,20,20,8"
                Classes="accent"
                IsEnabled="{Binding !IsUpdating}"
                Command="{Binding UpdateIndexCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" FontSize="16" Text="&#xE896;" />
            <TextBlock Text="{Binding Strings[Settings.Download.UpdateIndex]}" />
          </StackPanel>
        </Button>
        <!-- Starward 用 ProgressRing；Avalonia 没有该控件，用等宽不确定进度条 -->
        <ProgressBar Width="120"
                     Height="3"
                     VerticalAlignment="Center"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsUpdating}" />
      </StackPanel>

      <!-- 索引分组（LunarWard 追加，Starward 在同样位置显示「已选择文件夹」） -->
      <ItemsControl ItemsSource="{Binding WineGroups}" Margin="0,12,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Border Margin="0,0,8,8"
                    Padding="10,3"
                    CornerRadius="4"
                    Background="{StaticResource StarControlFillBrush}"
                    BorderBrush="{StaticResource StarCardStrokeBrush}"
                    BorderThickness="1">
              <TextBlock FontSize="12"
                         Foreground="{StaticResource StarTextSecondary}"
                         Text="{Binding}" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Margin="0,8,0,0"
                 FontSize="12"
                 Foreground="{StaticResource StarCautionBrush}"
                 TextWrapping="Wrap"
                 Text="{Binding Status}"
                 IsVisible="{Binding HasStatus}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
