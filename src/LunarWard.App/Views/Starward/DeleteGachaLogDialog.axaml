<Window x:Class="LunarWard.App.Views.Starward.DeleteGachaLogDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:LunarWard.App.ViewModels.Starward"
        mc:Ignorable="d"
        x:DataType="vm:DeleteGachaLogDialogViewModel"
        x:Name="Root"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Strings[Gacha.DeleteByTimeTitle]}">

  <!--
    复刻 Starward `Features/Gacha/DeleteGachaLogDialog.xaml`（96 行）：
    标题 20px → Uid 选择（MinWidth 140）→ 记录数（次要色）→
    开始/结束时间（CalendarDatePicker 160 宽 + 24 小时制 TimePicker）→
    6 个月提示（Caution 色、可换行）→ 右下「删除（Flyout: 确认删除）」+「取消（强调色）」。
    Avalonia 没有 ContentDialog，沿用 InstallGameDialog 的无边框窗口 + 亚克力卡片。
  -->

  <Border Background="{StaticResource StarAcrylicBrush}"
          BorderThickness="1"
          BorderBrush="#14FFFFFF"
          CornerRadius="8"
          BoxShadow="0 16 48 0 #99000000">
    <StackPanel Margin="24" Spacing="12">

      <!--  标题（源码 :20）  -->
      <TextBlock FontSize="20" Text="{Binding Strings[Gacha.DeleteByTimeTitle]}" />

      <!--  Uid（源码 :21-31）  -->
      <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="12">
        <TextBlock VerticalAlignment="Center" Text="Uid" />
        <ComboBox MinWidth="140"
                  ItemsSource="{Binding UidList}"
                  SelectedItem="{Binding SelectUid, Mode=TwoWay}" />
      </StackPanel>

      <!--  记录数（源码 :33-36，加载后显示）  -->
      <TextBlock Foreground="{StaticResource StarTextSecondary}"
                 IsVisible="{Binding HasSelection}"
                 Text="{Binding SelectedCountText}" />

      <!--  开始 / 结束时间（源码 :38-66）  -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <StackPanel Spacing="8">
          <Border Height="32">
            <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Gacha.BeginTime]}" />
          </Border>
          <Border Height="32">
            <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Gacha.EndTime]}" />
          </Border>
        </StackPanel>
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <DatePicker MinWidth="150"
                        YearFormat="yyyy"
                        MonthFormat="MM"
                        DayFormat="dd"
                        SelectedDate="{Binding BeginDate, Mode=TwoWay}" />
            <TimePicker Width="132" ClockIdentifier="24HourClock" SelectedTime="{Binding BeginTime, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <DatePicker MinWidth="150"
                        YearFormat="yyyy"
                        MonthFormat="MM"
                        DayFormat="dd"
                        SelectedDate="{Binding EndDate, Mode=TwoWay}" />
            <TimePicker Width="132" ClockIdentifier="24HourClock" SelectedTime="{Binding EndTime, Mode=TwoWay}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!--  6 个月提示（源码 :68-70，Caution 色、默认折叠）  -->
      <TextBlock Foreground="{StaticResource StarCautionBrush}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding ShowSixMonthsWarning}"
                 Text="{Binding Strings[Gacha.SixMonthsWarning]}" />

      <!--  结束早于开始（源码没有这一行，Avalonia 的 DatePicker 不会自动纠正）  -->
      <TextBlock Foreground="{StaticResource StarErrorBrush}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Text="{Binding ErrorText}" />

      <!--  按钮（源码 :72-94）：删除带「确认删除」Flyout，取消是强调色  -->
      <StackPanel Margin="0,16,0,0"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal"
                  Spacing="12">
        <Button MinWidth="100"
                Content="{Binding Strings[Common.Delete]}"
                IsEnabled="{Binding CanDelete}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="{Binding Strings[Gacha.DeleteConfirm]}"
                        Foreground="{StaticResource StarErrorBrush}"
                        Command="{Binding DeleteCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button MinWidth="100"
                Classes="accent"
                Command="{Binding CancelCommand}"
                Content="{Binding Strings[Common.Cancel]}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
