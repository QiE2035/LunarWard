<controls:StarwardContentDialog xmlns="https://github.com/avaloniaui"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:controls="using:LunarWard.App.Views.Starward.Controls"
                                xmlns:dialog="using:LunarWard.App.Views.Starward"
                                x:Class="LunarWard.App.Views.Starward.BackgroundViewDialog"
                                MaxWidth="1016">

  <!-- Starward BackgroundViewWindow / BackgroundViewPage 的浮层版：
       官方背景 + 本地自定义背景的缩略图墙，点一张就切过去；左上角「打开文件夹」跳缓存目录。 -->
  <Grid Width="960" Height="516" RowDefinitions="Auto,*,Auto">

    <Grid Grid.Row="0" Margin="24,12,56,0">
      <!-- 标题由 StarwardContentDialog 容器画（避免和容器标题重复） -->
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource StarTextSecondary}" />
        <Button x:Name="OpenFolderButton" Click="OnOpenFolderClick" Padding="12,6" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" Margin="24,12,24,0"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Tiles" Margin="0,0,4,12">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" ItemWidth="220" ItemHeight="152" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="dialog:BackgroundGalleryItem">
            <Button Classes="gallery-tile" Click="OnTileClick" Tag="{Binding Index}"
                    Padding="0" Margin="0,0,12,12" Background="Transparent" BorderThickness="0">
              <Border Width="208" Height="140" CornerRadius="8" ClipToBounds="True"
                      Background="{DynamicResource StarCardBackgroundBrush}"
                      BorderBrush="{DynamicResource StarCardStrokeBrush}" BorderThickness="1">
                <Panel>
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                  <TextBlock Classes="icon" FontSize="28" Text="&#xE91B;" HorizontalAlignment="Center"
                             VerticalAlignment="Center" IsVisible="{Binding !HasThumbnail}" />
                  <!-- 底部署名条 -->
                  <Border VerticalAlignment="Bottom" Height="34" Background="#CC000000">
                    <Panel Margin="10,0">
                      <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Foreground="{DynamicResource StarTextPrimary}" />
                      <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                              CornerRadius="4" Padding="6,1" Background="#66000000"
                              IsVisible="{Binding IsVideo}">
                        <TextBlock Text="{Binding VideoLabel}" FontSize="10"
                                   Foreground="{DynamicResource StarTextPrimary}" />
                      </Border>
                    </Panel>
                  </Border>
                  <!-- 当前选中角标 -->
                  <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                          CornerRadius="10" Padding="6,1" Background="{DynamicResource StarAccentBrush}"
                          IsVisible="{Binding IsCurrent}">
                    <TextBlock Text="{Binding CurrentLabel}" FontSize="10"
                               Foreground="{DynamicResource StarAccentForegroundBrush}" />
                  </Border>
                </Panel>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="2" x:Name="HintText" Margin="24,0,24,16" FontSize="12"
               Foreground="{DynamicResource StarTextTertiary}" TextWrapping="Wrap" />
  </Grid>
</controls:StarwardContentDialog>
