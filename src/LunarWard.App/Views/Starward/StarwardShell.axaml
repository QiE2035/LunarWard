<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunarWard.App.ViewModels.Starward"
             xmlns:local="using:LunarWard.App.Views.Starward"
             x:Class="LunarWard.App.Views.Starward.StarwardShell"
             x:DataType="vm:ShellViewModel"
             KeyDown="OnKeyDown">

  <!--
    Starward MainView 结构（Features/ViewHost/MainView.xaml）：
      背景层（全窗，含标题栏） → 左栏 56px → NavigationView 内容（Frame，上边距 48）
      → GameSelector（全屏层，在最上）。
    标题栏是 Window 自己的 48px 层，见 MainWindow.axaml。
  -->
  <Grid ClipToBounds="True">

    <!-- ── 背景层 ─────────────────────────────────────────────── -->
    <Grid>
      <!-- 没有素材时的底色（Starward 用 Placeholder + 模糊图） -->
      <Border Background="#FF1E1E1E" IsVisible="{Binding !HasBackgroundImage}" />
      <Image Source="{Binding BackgroundImage}"
             Stretch="UniformToFill"
             IsVisible="{Binding HasBackgroundImage}" />
      <ContentPresenter x:Name="VideoBackgroundHost" IsHitTestVisible="False" />

      <!-- Starward AppBackground：右上有两片 400×400 的暗角渐变 -->
      <Panel HorizontalAlignment="Right" VerticalAlignment="Top" Width="400" Height="400" IsHitTestVisible="False">
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
              <GradientStop Offset="0.5" Color="#00000000" />
              <GradientStop Offset="1" Color="#50000000" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Panel>
      <Panel HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="400" Height="400" IsHitTestVisible="False">
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Offset="0.5" Color="#00000000" />
              <GradientStop Offset="1" Color="#50000000" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Panel>
      <Panel HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="200" IsHitTestVisible="False">
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Offset="0" Color="#00000000" />
              <GradientStop Offset="1" Color="#30000000" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Panel>

    </Grid>

    <!--
      Starward Border_OverlayMask：全窗铺一层 CustomAcrylic，只有启动器页不盖
      （MainView.NavigateTo 里 page is BlankPage or GameLauncherPage → Opacity 0）。
      声明顺序也照 Starward：背景 → 56px 竖条 → mask → 导航 → 内容。
    -->
    <Border Background="{StaticResource StarAcrylicBrush}"
            IsVisible="{Binding !IsLauncherSelected}"
            IsHitTestVisible="False" />

    <!-- ── 左栏 56px（Starward 是一个独立的 CustomAcrylic 竖条） ── -->
    <Border Width="56" HorizontalAlignment="Left" Background="{StaticResource StarAcrylicBrush}" />
    <local:NavigationRail HorizontalAlignment="Left" VerticalAlignment="Stretch" />

    <!-- ── 页面宿主（Starward MainView_Frame，Margin="0,48,0,0"） ── -->
    <ContentPresenter x:Name="PageHost" Margin="56,48,0,0" />


    <!-- ── 游戏选择层（Starward GameSelector：全屏 #80000000 + 192×108 卡片） ── -->
    <Grid x:Name="GameSelectorOverlayCard" IsVisible="{Binding IsGameSelectorOpen}">
      <Border Background="{StaticResource StarScrimBrush}" PointerPressed="OnGameSelectorScrimPressed" />

      <!-- Starward Border_FullBackground Padding="68,80,0,0" -->
      <ScrollViewer Padding="68,80,24,24"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalContentAlignment="Top">
        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Left" VerticalAlignment="Top">
          <ItemsControl ItemsSource="{Binding GameChoices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="16" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GameChoiceViewModel">
                <Border Width="192" Height="108" CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                        Background="#40000000"
                        Tapped="OnGameChoiceTapped">
                  <Panel>
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                    <!-- Logo（Starward 中央 Logo，带 #60000000 底） -->
                    <Border Margin="24" Background="#60000000" IsVisible="{Binding HasLogo}">
                      <Image Source="{Binding Logo}" Stretch="Uniform" />
                    </Border>
                    <!-- 没有 Logo 时用名字兜底 -->
                    <TextBlock Text="{Binding Title}"
                               Margin="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" FontWeight="Bold"
                               TextWrapping="Wrap" TextAlignment="Center"
                               IsVisible="{Binding !HasLogo}" />
                    <!-- 已安装标记 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="6" Padding="6,2" CornerRadius="4"
                            Background="#99000000"
                            IsVisible="{Binding IsInstalled}">
                      <TextBlock FontSize="11" Foreground="{StaticResource StarTextSecondary}" Text="已安装" />
                    </Border>
                  </Panel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- 关闭提示（Starward 用 TeachingTip / 点空白关闭） -->
      <Button Classes="overlay"
              Margin="0,0,24,24"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Content="关闭"
              Command="{Binding CloseGameSelectorCommand}" />
    </Grid>
  </Grid>
</UserControl>
