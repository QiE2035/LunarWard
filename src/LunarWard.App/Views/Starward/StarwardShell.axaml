<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunarWard.App.ViewModels.Starward"
             xmlns:local="using:LunarWard.App.Views.Starward"
             x:Class="LunarWard.App.Views.Starward.StarwardShell"
             x:DataType="vm:ShellViewModel"
             KeyDown="OnKeyDown">

  <!--
    Starward MainView 结构（Features/ViewHost/MainView.xaml）：
      背景层（全窗，含标题栏） → 左栏 56px → NavigationView 内容（Frame，上边距 48）
      → GameSelector（全屏层，在最上）。
    标题栏是 Window 自己的 48px 层，见 MainWindow.axaml。
  -->
  <Grid ClipToBounds="True">

    <!-- ── 背景层 ─────────────────────────────────────────────── -->
    <Grid>
      <!-- 没有素材时的底色（Starward 用 Placeholder + 模糊图） -->
      <Border Background="#FF1E1E1E" IsVisible="{Binding !HasBackgroundImage}" />
      <Image Source="{Binding BackgroundImage}"
             Stretch="UniformToFill"
             IsVisible="{Binding HasBackgroundImage}" />
      <ContentPresenter x:Name="VideoBackgroundHost" IsHitTestVisible="False" />

      <!-- Starward AppBackground：右上有两片 400×400 的暗角渐变 -->
      <Panel HorizontalAlignment="Right" VerticalAlignment="Top" Width="400" Height="400" IsHitTestVisible="False">
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
              <GradientStop Offset="0.5" Color="#00000000" />
              <GradientStop Offset="1" Color="#50000000" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Panel>
      <Panel HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="400" Height="400" IsHitTestVisible="False">
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Offset="0.5" Color="#00000000" />
              <GradientStop Offset="1" Color="#50000000" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Panel>
      <Panel HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="200" IsHitTestVisible="False">
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Offset="0" Color="#00000000" />
              <GradientStop Offset="1" Color="#30000000" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Panel>

    </Grid>

    <!--
      Starward Border_OverlayMask：全窗铺一层 CustomAcrylic，只有启动器页不盖
      （MainView.NavigateTo 里 page is BlankPage or GameLauncherPage → Opacity 0）。
      声明顺序也照 Starward：背景 → 56px 竖条 → mask → 导航 → 内容。
    -->
    <Border Background="{StaticResource StarAcrylicBrush}"
            IsVisible="{Binding !IsLauncherSelected}"
            IsHitTestVisible="False" />

    <!-- ── 左栏（Starward 是一个独立的 CustomAcrylic 竖条；悬停展开到 240px） ── -->
    <Border Width="56" HorizontalAlignment="Left" Background="{StaticResource StarAcrylicBrush}" />
    <local:NavigationRail HorizontalAlignment="Left" VerticalAlignment="Stretch" />

    <!-- ── 页面宿主（Starward MainView_Frame，Margin="0,48,0,0"） ── -->
    <ContentPresenter x:Name="PageHost" Margin="56,48,0,0" />



    <!-- ── 游戏选择层（Starward GameSelector：全屏 #80000000 + 192×108 卡片） ── -->
    <Grid x:Name="GameSelectorOverlayCard" IsVisible="{Binding IsGameSelectorOpen}">
      <Border Background="{StaticResource StarScrimBrush}" PointerPressed="OnGameSelectorScrimPressed" />

      <!-- Starward Border_FullBackground Padding="68,80,0,0" -->
      <ScrollViewer Padding="68,80,24,24"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalContentAlignment="Top">
        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Left" VerticalAlignment="Top">
          <ItemsControl ItemsSource="{Binding GameChoices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="16" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GameChoiceViewModel">
                <Border Width="192" Height="108" CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                        Background="#40000000"
                        Tapped="OnGameChoiceTapped">
                  <Panel>
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                    <!-- Logo（Starward 中央 Logo，带 #60000000 底） -->
                    <Border Margin="24" Background="#60000000" IsVisible="{Binding HasLogo}">
                      <Image Source="{Binding Logo}" Stretch="Uniform" />
                    </Border>
                    <!-- 既没 Logo 也没缩略图时才用名字兜底（有缩略图时缩略图里已含主视觉） -->
                    <TextBlock Text="{Binding Title}"
                               Margin="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" FontWeight="Bold"
                               TextWrapping="Wrap" TextAlignment="Center"
                               IsVisible="{Binding ShowFallbackTitle}" />
                    <!-- 已安装标记 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="6" Padding="6,2" CornerRadius="4"
                            Background="#99000000"
                            IsVisible="{Binding IsInstalled}">
                      <TextBlock FontSize="11" Foreground="{StaticResource StarTextSecondary}" Text="{Binding Strings[Launcher.Installed]}" />
                    </Border>
                  </Panel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- 关闭（Starward 用点空白 / ESC 关闭；这里补一个显式按钮，放在右上不挡启动按钮） -->
      <Button Classes="overlay"
              Margin="0,60,24,0"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Content="{Binding Strings[Shell.Close]}"
              Command="{Binding CloseGameSelectorCommand}" />
    </Grid>

    <!--
      ── 横排游戏图标条（Starward GameSelector 的 Grid_GameIconsArea）─────────
      Margin 56,0,0,0 / Height 60 / Padding 6,0,12,0；
      图标 40×40、CornerRadius 8、每项 Padding 6,8（ListViewItem 的 ContentMargin）；
      未选中的图标盖 #60000000 遮罩，当前图标与悬停图标无遮罩（MaskOpacity 0/1）。
      平时 Translation -100 收起，悬停左上角当前游戏图标滑出；全屏选择层打开时保持可见。
      以 IsVisible 代替 Translation 动画（Avalonia 侧栏动画在 docs/07 §8 记为已知偏差）。
    -->
    <Grid x:Name="GameIconsArea"
          Margin="56,0,0,0"
          Height="60"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          IsVisible="{Binding IsGameIconsVisible}"
          PointerExited="OnGameIconsAreaPointerExited">

      <Grid.Styles>
        <Style Selector="Button.game-icon">
          <Setter Property="Width" Value="40" />
          <Setter Property="Height" Value="40" />
          <Setter Property="Margin" Value="6,8" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="CornerRadius" Value="8" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- 未选中/未悬停：压暗（Starward MaskOpacity 默认 1.0） -->
        <Style Selector="Button.game-icon Border.icon-mask">
          <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- 当前游戏：不压暗（GameBizIcon.IsSelected → MaskOpacity 0） -->
        <Style Selector="Button.game-icon.current Border.icon-mask">
          <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- 悬停：不压暗（Grid_GameIcon_PointerEntered → MaskOpacity 0） -->
        <Style Selector="Button.game-icon:pointerover Border.icon-mask">
          <Setter Property="Opacity" Value="0" />
        </Style>
      </Grid.Styles>

      <!-- Starward Grid_GameIconsArea 的 Padding="6,0,12,0"（Avalonia Grid 无 Padding，落在内容上） -->
      <ItemsControl ItemsSource="{Binding GameChoices}"
                    Margin="6,0,12,0"
                    VerticalAlignment="Top">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GameChoiceViewModel">
            <Button Classes="game-icon"
                    Classes.current="{Binding IsCurrent}"
                    Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).SelectGameIconCommand}"
                    CommandParameter="{Binding}"
                    ToolTip.Tip="{Binding Title}">
              <Panel>
                <Border CornerRadius="8" Background="#33FFFFFF" />
                <Image Width="40" Height="40" Source="{Binding Icon}" Stretch="UniformToFill"
                       IsVisible="{Binding HasIcon}" />
                <TextBlock Classes="icon" FontSize="20" Text="&#xE8A9;" IsVisible="{Binding !HasIcon}" />
                <Border Classes="icon-mask" Background="#60000000" CornerRadius="8" />
              </Panel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</UserControl>
