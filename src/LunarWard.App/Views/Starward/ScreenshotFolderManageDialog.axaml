<Window x:Class="LunarWard.App.Views.Starward.ScreenshotFolderManageDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:LunarWard.App.ViewModels.Starward"
        mc:Ignorable="d"
        x:DataType="vm:ScreenshotFolderManageDialogViewModel"
        x:Name="Root"
        Width="600"
        SizeToContent="Height"
        MinHeight="240"
        MaxHeight="400"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Strings[Screenshot.ManageFolders]}">

  <!--
    复刻 Starward `Features/Screenshot/ScreenshotFolderManageDialog.xaml`（158 行）：
    600 宽 / 最小 240 / 最大 400，五行 Grid —— 说明文字、分隔线、文件夹列表
    （路径 + 打开 + 移除 / 备份）、备份中与备份结果、底部「添加文件夹」与「保存 / 取消」。
    Avalonia 没有 ContentDialog，这里用无边框 Window + 亚克力描边卡片（沿用 InstallGameDialog 的写法）。
  -->

  <Window.Styles>
    <Style Selector="Button.folder-action">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.folder-action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource StarControlFillHoverBrush}" />
    </Style>
  </Window.Styles>

  <Border Background="{StaticResource StarAcrylicBrush}"
          BorderThickness="1"
          BorderBrush="#14FFFFFF"
          CornerRadius="8"
          BoxShadow="0 16 48 0 #99000000">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

      <!--  说明（源码 :30-36）  -->
      <TextBlock Grid.Row="0"
                 Margin="24,24,0,12"
                 Foreground="{StaticResource StarTextSecondary}"
                 TextWrapping="Wrap"
                 Text="{Binding Strings[Screenshot.FoldersHint]}" />

      <!--  分隔线（源码 :39）  -->
      <Border Grid.Row="1"
              Height="1"
              Margin="24,0"
              Background="{StaticResource StarDividerBrush}" />

      <!--  文件夹列表（源码 :42-106）  -->
      <ListBox Grid.Row="2"
               Padding="12,0,12,0"
               MaxHeight="280"
               Background="Transparent"
               ItemsSource="{Binding Folders}"
               SelectionMode="Single">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ScreenshotFolderItem">
            <Grid ColumnDefinitions="*,32,32" ColumnSpacing="4">
              <TextBlock Grid.Column="0"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource StarTextSecondary}"
                         TextWrapping="Wrap"
                         Text="{Binding Folder}" />

              <!--  打开文件夹（源码 :59，Glyph E8A7）  -->
              <Button Grid.Column="1"
                      Classes="folder-action"
                      ToolTip.Tip="{Binding #Root.((vm:ScreenshotFolderManageDialogViewModel)DataContext).Strings[Common.Open]}"
                      Click="OnOpenFolderClick">
                <TextBlock Classes="icon" FontSize="16"
                           Foreground="{StaticResource StarTextSecondary}"
                           Text="&#xE8A7;" />
              </Button>

              <!--  移除文件夹（源码 :71，Glyph E711，仅额外目录可见）  -->
              <Button Grid.Column="2"
                      Classes="folder-action"
                      IsVisible="{Binding CanRemove}"
                      ToolTip.Tip="{Binding #Root.((vm:ScreenshotFolderManageDialogViewModel)DataContext).Strings[Common.Remove]}"
                      Click="OnRemoveFolderClick">
                <TextBlock Classes="icon" FontSize="16"
                           Foreground="{StaticResource StarTextSecondary}"
                           Text="&#xE711;" />
              </Button>

              <!--  备份截图（源码 :83，Glyph F413）  -->
              <Button Grid.Column="2"
                      Classes="folder-action"
                      IsVisible="{Binding CanBackup}"
                      ToolTip.Tip="{Binding #Root.((vm:ScreenshotFolderManageDialogViewModel)DataContext).Strings[Screenshot.BackupScreenshots]}"
                      Click="OnBackupFolderClick">
                <TextBlock Classes="icon" FontSize="16"
                           Foreground="{StaticResource StarTextSecondary}"
                           Text="&#xF413;" />
              </Button>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!--  备份中（源码 :109-122）  -->
      <StackPanel Grid.Row="3"
                  Margin="24,12,24,0"
                  Orientation="Horizontal"
                  Spacing="12"
                  IsVisible="{Binding IsBackingUp}">
        <ProgressBar Width="16" Height="16" IsIndeterminate="True" />
        <TextBlock VerticalAlignment="Center"
                   Foreground="{StaticResource StarAccentBrush}"
                   Text="{Binding Strings[Screenshot.BackingUp]}" />
      </StackPanel>

      <!--  备份结果（源码 :125-131）  -->
      <TextBlock Grid.Row="3"
                 Margin="24,12,24,0"
                 Foreground="{StaticResource StarTextSecondary}"
                 TextWrapping="Wrap"
                 Text="{Binding BackupResult}"
                 IsVisible="{Binding BackupResult, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!--  添加文件夹（源码 :134-142）  -->
      <Button Grid.Row="4"
              Margin="24"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              Content="{Binding Strings[Screenshot.AddFolder]}"
              Click="OnAddFolderClick" />

      <!--  保存 / 取消（源码 :145-153）  -->
      <StackPanel Grid.Row="4"
                  Margin="24"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Orientation="Horizontal"
                  Spacing="12">
        <Button Classes="accent"
                Content="{Binding Strings[Common.Save]}"
                IsEnabled="{Binding CanSave}"
                Click="OnSaveClick" />
        <Button Content="{Binding Strings[Common.Cancel]}" Click="OnCancelClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
