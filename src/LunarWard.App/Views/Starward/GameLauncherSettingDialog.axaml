<controls:StarwardContentDialog xmlns="https://github.com/avaloniaui"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:controls="using:LunarWard.App.Views.Starward.Controls"
                                xmlns:loc="using:LunarWard.App.Localization"
                                x:Class="LunarWard.App.Views.Starward.GameLauncherSettingDialog"
                                MaxWidth="800">

  <!--
    Starward Features/GameLauncher/GameLauncherSettingDialog.xaml（724 行）：
    ContentDialog 内 Grid 800×480、Padding 24,24,24,0；左边 NavigationView（OpenPaneLength=200、
    面板标题「游戏设置」20px 次要色、4 个 36 高导航项），右边 FlipView（Margin 24,24,0,0）横向翻页。
    Avalonia 没有 NavigationView/FlipView，左侧用 ListBox + 选中态、右侧用四块面板切 IsVisible，
    版式（36 高导航项 / 12 间距 / 40×40 游戏图标 / 36 高路径胶囊）照源码。
  -->
  <controls:StarwardContentDialog.Styles>
    <!-- 源码 DateTimePickerFlyoutButtonStyle：36 高、透明底、悬停浅底、左对齐内容 -->
    <Style Selector="Button.row">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StarControlFillHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem.nav">
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource StarTextSecondary}" />
    </Style>
    <Style Selector="ListBoxItem.nav:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource StarSelectionBrush}" />
    </Style>
    <Style Selector="ListBoxItem.nav:selected">
      <Setter Property="Foreground" Value="{DynamicResource StarTextPrimary}" />
    </Style>
  </controls:StarwardContentDialog.Styles>

  <Grid Width="800" Height="480" ColumnDefinitions="200,*">

      <!-- ── 左导航（源码 NavigationView PaneHeader + 4 项）──────────── -->
      <StackPanel Margin="16,24,0,0" Spacing="4">
        <TextBlock Text="{Binding [Shell.GameSetting], Source={x:Static loc:AppStrings.Instance}}"
                   Margin="0,0,0,8"
                   FontSize="20"
                   Foreground="{DynamicResource StarTextSecondary}" />
        <ListBox x:Name="NavList" SelectionMode="Single" SelectionChanged="OnNavSelectionChanged">
          <ListBoxItem Classes="nav" Tag="0"
                       Content="{Binding [LauncherSetting.BasicInformation], Source={x:Static loc:AppStrings.Instance}}" />
          <ListBoxItem Classes="nav" Tag="1"
                       Content="{Binding [LauncherSetting.StartupArguments], Source={x:Static loc:AppStrings.Instance}}" />
          <ListBoxItem Classes="nav" Tag="2"
                       Content="{Binding [LauncherSetting.CustomBackground], Source={x:Static loc:AppStrings.Instance}}" />
          <ListBoxItem Classes="nav" Tag="3"
                       Content="{Binding [LauncherSetting.GamePackages], Source={x:Static loc:AppStrings.Instance}}" />
        </ListBox>
      </StackPanel>

      <!-- ── 右内容（源码 FlipView Margin 24,24,0,0；四页垂直翻页）────── -->
      <ScrollViewer Grid.Column="1" Margin="24,24,24,0">
        <StackPanel>

          <!-- ══ 基本信息 ══════════════════════════════════════════════ -->
          <StackPanel x:Name="PanelBasic" Spacing="12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
              <Border Width="40" Height="40" CornerRadius="8" ClipToBounds="True">
                <Image x:Name="GameIcon" Stretch="UniformToFill" />
              </Border>
              <TextBlock x:Name="GameNameText"
                         Grid.Column="1"
                         VerticalAlignment="Center"
                         FontSize="16" />
            </Grid>

            <!-- 游戏安装位置：36 高胶囊，点击打开目录，右侧文件夹字形 -->
            <Button x:Name="PathButton" Classes="row" IsVisible="False"
                    Click="OnOpenGameFolderClick"
                    ToolTip.Tip="{Binding [LauncherSetting.OpenGameFolder], Source={x:Static loc:AppStrings.Instance}}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock x:Name="PathText"
                           VerticalAlignment="Center"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource StarTextSecondary}" />
                <TextBlock Grid.Column="1" Classes="icon" Text="&#xE8A7;"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource StarTextSecondary}" />
              </Grid>
            </Button>

            <!--
              网络驱动器警告（Starward GameLauncherSettingDialog.xaml:214-219）。
              源码判定 DriveType.Network && !IsUnc；Linux 等价物是「以 // 开头的 UNC 路径
              或文件系统类型属于网络文件系统」（见 Installer/NetworkPath.cs）。
            -->
            <TextBlock x:Name="NetworkWarning"
                       Margin="0,0,0,-4"
                       FontSize="12"
                       TextWrapping="Wrap"
                       IsVisible="False"
                       Foreground="{DynamicResource StarCautionBrush}"
                       Text="{Binding [LauncherSetting.NetworkDriveWarning], Source={x:Static loc:AppStrings.Instance}}" />

            <!-- 游戏大小：源码是禁用按钮里两段 Run -->
            <TextBlock x:Name="SizeText" FontSize="12"
                       Foreground="{DynamicResource StarTextSecondary}" IsVisible="False">
              <Run Text="{Binding [LauncherSetting.Size], Source={x:Static loc:AppStrings.Instance}}" />
              <Run Text=" " />
              <Run x:Name="SizeRun" />
            </TextBlock>

            <!-- 定位游戏：源码在没装游戏时显示（:178-196），与「重新定位」是同一个目录选择器 -->
            <Button x:Name="LocateButton" Classes="row" Width="160"
                    HorizontalAlignment="Left"
                    Click="OnRelocateClick"
                    IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" FontSize="16" Text="&#xE838;"
                           Foreground="{DynamicResource StarTextSecondary}" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource StarTextSecondary}"
                           Text="{Binding [Launcher.LocateGame], Source={x:Static loc:AppStrings.Instance}}" />
              </StackPanel>
            </Button>

            <!-- 游戏公告 + 红点提醒（源码 :330-352 两个 ToggleSwitch） -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <ToggleSwitch x:Name="ShowNoticeToggle"
                            OnContent="" OffContent=""
                            IsCheckedChanged="OnShowNoticeToggled" />
              <TextBlock Grid.Column="1"
                         VerticalAlignment="Center"
                         Text="{Binding [LauncherSetting.ShowGameAnnouncement], Source={x:Static loc:AppStrings.Instance}}" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <ToggleSwitch x:Name="DisableNoticeRedDotToggle"
                            OnContent="" OffContent=""
                            IsCheckedChanged="OnDisableNoticeRedDotToggled" />
              <TextBlock Grid.Column="1"
                         VerticalAlignment="Center"
                         Text="{Binding [LauncherSetting.DisableNoticeRedDot], Source={x:Static loc:AppStrings.Instance}}" />
            </Grid>

            <!--
              「使用 CMD 启动游戏」（源码 :360-400）在 Windows 上用 cmd 包一层设置窗口标题/优先级，
              Linux 没有等价物：保留控件位置但禁用，右侧说明原因（parity 文档同一口径）。
            -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <ToggleSwitch x:Name="UseCmdToggle"
                            OnContent="" OffContent=""
                            IsEnabled="False"
                            ToolTip.Tip="{Binding [LauncherSetting.UseCmdHint], Source={x:Static loc:AppStrings.Instance}}" />
              <TextBlock Grid.Column="1"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource StarTextDisabled}"
                         Text="{Binding [LauncherSetting.UseCmd], Source={x:Static loc:AppStrings.Instance}}" />
            </Grid>

            <!-- 源码 :392-400 的提示段落 -->
            <TextBlock FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource StarTextTertiary}"
                       Text="{Binding [LauncherSetting.AvoidIllegalToolHint], Source={x:Static loc:AppStrings.Instance}}" />

            <!-- 一些操作：重新定位 / 修复游戏 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="RelocateButton" Classes="row" Width="120"
                      Click="OnRelocateClick">
                <TextBlock Text="{Binding [LauncherSetting.RelocateGame], Source={x:Static loc:AppStrings.Instance}}"
                           Foreground="{DynamicResource StarAccentBrush}" />
              </Button>
              <Button x:Name="RepairButton" Classes="row" Width="120"
                      Click="OnRepairClick">
                <TextBlock Text="{Binding [LauncherSetting.RepairGame], Source={x:Static loc:AppStrings.Instance}}"
                           Foreground="{DynamicResource StarAccentBrush}" />
              </Button>
            </StackPanel>

            <!--
              卸载游戏 + 警告行（Starward GameLauncherSettingDialog.xaml:222-246）。
              源码：按钮 36 高、Critical 字色、Glyph E74D；点一次只展开警告行，
              警告行里左侧 Caution 文字、右侧 Critical「确认卸载」，再点才真删。
            -->
            <Button x:Name="UninstallButton" Classes="row" Width="160"
                    HorizontalAlignment="Left"
                    IsVisible="False"
                    Click="OnUninstallClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" FontSize="16" Text="&#xE74D;"
                           Foreground="{DynamicResource StarErrorBrush}" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource StarErrorBrush}"
                           Text="{Binding [LauncherSetting.UninstallGame], Source={x:Static loc:AppStrings.Instance}}" />
              </StackPanel>
            </Button>

            <Grid x:Name="UninstallWarning"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12"
                  IsVisible="False">
              <TextBlock Grid.Column="0"
                         VerticalAlignment="Center"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource StarCautionBrush}"
                         Text="{Binding [LauncherSetting.UninstallGameWarning], Source={x:Static loc:AppStrings.Instance}}" />
              <Button Grid.Column="1"
                      x:Name="ConfirmUninstallButton"
                      Classes="row"
                      Width="120"
                      Click="OnConfirmUninstallClick">
                <TextBlock Text="{Binding [LauncherSetting.ConfirmUninstall], Source={x:Static loc:AppStrings.Instance}}"
                           Foreground="{DynamicResource StarErrorBrush}" />
              </Button>
            </Grid>

            <TextBlock x:Name="UninstallError"
                       FontSize="12"
                       TextWrapping="Wrap"
                       IsVisible="False"
                       Foreground="{DynamicResource StarErrorBrush}" />

            <!--
              选择语音包（源码 Segmented，四段）。整组（标题 + 分段器）在游戏没有语音包目录时隐藏
              （源码 <c>_hasAudioPackages</c> 控制 Visibility），所以包一层 StackPanel 一起切。
            -->
            <StackPanel x:Name="AudioLanguageGroup" Spacing="4" IsVisible="False">
              <TextBlock Text="{Binding [LauncherSetting.SelectAudioLanguage], Source={x:Static loc:AppStrings.Instance}}"
                         Margin="0,8,0,0"
                         FontSize="14" />
              <Border Classes="segmented" Height="32" Padding="4"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource StarControlFillBrush}">
                <StackPanel x:Name="AudioLanguagePanel" Orientation="Horizontal" Spacing="2" />
              </Border>
            </StackPanel>

            <!-- 操作结果 / 错误 -->
            <TextBlock x:Name="StatusText" FontSize="12"
                       Foreground="{DynamicResource StarCautionBrush}"
                       TextWrapping="Wrap" IsVisible="False" />
          </StackPanel>

          <!-- ══ 启动参数 ══════════════════════════════════════════════ -->
          <StackPanel x:Name="PanelArguments" Spacing="12" IsVisible="False">
            <TextBlock Text="{Binding [LauncherSetting.CommandLineArgument], Source={x:Static loc:AppStrings.Instance}}"
                       FontSize="14" />
            <TextBox x:Name="ArgumentBox" Height="32" CornerRadius="8" FontSize="14" />
            <Button Classes="row" Height="28" Click="OnSeeMoreArgumentsClick">
              <TextBlock Text="{Binding [LauncherSetting.SeeMoreInformation], Source={x:Static loc:AppStrings.Instance}}"
                         FontSize="12"
                         Foreground="{DynamicResource StarAccentBrush}" />
            </Button>

            <TextBlock Text="{Binding [LauncherSetting.AfterStartingGame], Source={x:Static loc:AppStrings.Instance}}"
                       Margin="0,12,0,0"
                       FontSize="14" />
            <ComboBox x:Name="BehaviorBox" Width="200" HorizontalAlignment="Left">
              <ComboBoxItem Content="{Binding [LauncherSetting.DoNothing], Source={x:Static loc:AppStrings.Instance}}" Tag="Nothing" />
              <ComboBoxItem Content="{Binding [LauncherSetting.MinimizeToTaskbar], Source={x:Static loc:AppStrings.Instance}}" Tag="Minimize" />
              <ComboBoxItem Content="{Binding [LauncherSetting.HideToSystemTray], Source={x:Static loc:AppStrings.Instance}}" Tag="Hide" />
            </ComboBox>

            <!-- 自定义启动程序（源码 ToggleSwitch + 路径行 + 选择） -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
              <ToggleSwitch x:Name="CustomProgramToggle" IsCheckedChanged="OnCustomProgramToggled" />
              <TextBlock Text="{Binding [LauncherSetting.CustomStartExecutable], Source={x:Static loc:AppStrings.Instance}}"
                         VerticalAlignment="Center"
                         FontSize="14" />
            </StackPanel>
            <Grid x:Name="CustomProgramRow" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="False">
              <Button Classes="row" Click="OnOpenCustomProgramClick">
                <TextBlock x:Name="CustomProgramPath"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource StarTextSecondary}" />
              </Button>
              <Button Grid.Column="1" Classes="row" Width="88" Click="OnSelectCustomProgramClick">
                <TextBlock Text="{Binding [LauncherSetting.Select], Source={x:Static loc:AppStrings.Instance}}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource StarAccentBrush}" />
              </Button>
            </Grid>
          </StackPanel>

          <!-- ══ 自定义背景 ════════════════════════════════════════════ -->
          <StackPanel x:Name="PanelBackground" Spacing="12" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ToggleSwitch x:Name="VideoBackgroundToggle" IsCheckedChanged="OnVideoBackgroundToggled" />
              <TextBlock Text="{Binding [LauncherSetting.SupportVideo], Source={x:Static loc:AppStrings.Instance}}"
                         VerticalAlignment="Center"
                         FontSize="14" />
            </StackPanel>
            <TextBlock Text="{Binding [LauncherSetting.BgSizeTip], Source={x:Static loc:AppStrings.Instance}}"
                       FontSize="12"
                       Foreground="{DynamicResource StarTextSecondary}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="BackgroundNameText" FontSize="14" />
            <Button Classes="row" Width="120" HorizontalAlignment="Left" Click="OnSelectBackgroundClick">
              <TextBlock Text="{Binding [LauncherSetting.Select], Source={x:Static loc:AppStrings.Instance}}"
                         Foreground="{DynamicResource StarAccentBrush}" />
            </Button>
            <TextBlock x:Name="BackgroundErrorText" FontSize="12"
                       Foreground="{DynamicResource StarErrorBrush}"
                       TextWrapping="Wrap" IsVisible="False" />
          </StackPanel>

          <!-- ══ 游戏包体 ══════════════════════════════════════════════ -->
          <StackPanel x:Name="PanelPackages" Spacing="8" IsVisible="False">
            <!--  Starward 这一页是 Pivot（正式版 / 预下载），每页一列 Expander 分组：
                  完整包 + 每个增量包（组头右侧复制该组全部下载链接）。  -->
            <TabControl x:Name="PackageTabs" Background="Transparent" Padding="0">
              <TabItem x:Name="LatestPackagesTab" Header="—">
                <Grid RowDefinitions="Auto,*">
                  <!--  副标题：包体清单（getGamePackages）里的版本。标签页标题固定是游戏版本，
                        两者互不覆盖（问题 7，见 docs/09-LINUX-DIVERGENCES.md）。  -->
                  <TextBlock x:Name="LatestPackageManifestText"
                             Grid.Row="0"
                             Margin="0,0,8,8"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Foreground="{StaticResource StarTextSecondary}"
                             Text="—" />
                  <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="LatestPackagesList" Margin="0,0,8,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </TabItem>
              <TabItem x:Name="PrePackagesTab" Header="—">
                <Grid RowDefinitions="Auto,*">
                  <TextBlock x:Name="PrePackageManifestText"
                             Grid.Row="0"
                             Margin="0,0,8,8"
                             FontSize="12"
                             TextWrapping="Wrap"
                             Foreground="{StaticResource StarTextSecondary}"
                             Text="—" />
                  <ScrollViewer Grid.Row="1">
                    <ItemsControl x:Name="PrePackagesList" Margin="0,0,8,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </TabItem>
            </TabControl>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
  </Grid>
</controls:StarwardContentDialog>
