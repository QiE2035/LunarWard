<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:LunarWard.App.Localization"
        xmlns:vm="using:LunarWard.App.ViewModels.Starward"
        x:Class="LunarWard.App.Views.Starward.ImageViewWindow2"
        x:DataType="vm:ImageViewWindow2ViewModel"
        Title="{Binding Title}"
        Width="1000" Height="700"
        MinWidth="560" MinHeight="400"
        Background="#FF1B1B1B"
        WindowStartupLocation="CenterOwner">

  <!--
    Starward Features/Screenshot/ImageViewWindow2.xaml(731 行)：
    48 顶栏（文件名居中 + 左侧编辑/打开/复制/删除 + 右侧全屏）/
    图片区（可缩放拖动、两侧上一张下一张）/
    可选图库条（128×72）/
    48 底栏（图库开关、索引、像素、文件大小 ｜ 适应窗口、百分比、缩小、滑块、放大）/
    右侧编辑面板（本移植改为信息 + 导出）。
  -->
  <Window.Styles>
    <!-- 左右两侧的翻页按钮：平时透明，指针移上去才显形（Starward 0.083s 淡入淡出） -->
    <Style Selector="Button.nav">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.083" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="48,*,Auto,48" ColumnDefinitions="*,Auto">

    <!-- 文件名（Starward Margin=300,0,300,0 FontSize=12 次要色居中） -->
    <TextBlock Grid.ColumnSpan="2"
               Margin="300,0,300,0"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="12"
               Foreground="{StaticResource StarTextSecondaryBrush}"
               Text="{Binding Title}"
               TextTrimming="CharacterEllipsis" />

    <!-- 左上角命令（Starward StackPanel_LeftTopCommands） -->
    <StackPanel Grid.ColumnSpan="2"
                Margin="6,0"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Orientation="Horizontal" Spacing="6">

      <!-- 编辑图像（AccentButtonStyle，36 高） -->
      <Button x:Name="ButtonEditImage"
              Height="36" Padding="10,5"
              BorderThickness="0"
              Classes="accent"
              Click="OnEditImageClick">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon" FontSize="16" Text="&#xE70F;" />
          <TextBlock VerticalAlignment="Center" FontSize="12"
                     Text="{Binding [ImageView2.EditImage], Source={x:Static loc:AppStrings.Instance}}" />
        </StackPanel>
      </Button>

      <!-- 打开菜单 -->
      <Button x:Name="ButtonOpenMenu" Width="40" Height="36" Padding="0" Click="OnOpenMenuClick">
        <TextBlock Classes="icon" FontSize="16"
                   Foreground="{StaticResource StarTextSecondaryBrush}" Text="&#xE8DA;" />
      </Button>

      <!-- 复制菜单 -->
      <Button x:Name="ButtonCopyMenu" Width="40" Height="36" Padding="0" Click="OnCopyPathClick">
        <TextBlock Classes="icon" FontSize="16"
                   Foreground="{StaticResource StarTextSecondaryBrush}" Text="&#xE8C8;" />
      </Button>

      <!-- 删除（Flyout 里二次确认） -->
      <Button x:Name="ButtonDelete" Width="40" Height="36" Padding="0">
        <TextBlock Classes="icon" FontSize="16"
                   Foreground="{StaticResource StarTextSecondaryBrush}" Text="&#xE74D;" />
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <StackPanel Spacing="12">
              <TextBlock TextWrapping="Wrap"
                         Text="{Binding [ImageView2.DeleteImageFile], Source={x:Static loc:AppStrings.Instance}}" />
              <Button Content="{Binding [Common.Delete], Source={x:Static loc:AppStrings.Instance}}"
                      Click="OnDeleteConfirmedClick" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </StackPanel>

    <!-- 右上角（Starward StackPanel_RightTopCommands，源码右移 144 让开系统标题栏按钮） -->
    <StackPanel Grid.ColumnSpan="2"
                Margin="0,0,12,0"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Orientation="Horizontal" Spacing="6">
      <Button x:Name="ButtonFullScreen" Width="40" Height="36" Padding="0"
              Click="OnFullScreenClick"
              ToolTip.Tip="{Binding [ImageView2.FullScreen], Source={x:Static loc:AppStrings.Instance}}">
        <TextBlock Classes="icon" FontSize="14"
                   Foreground="{StaticResource StarTextSecondaryBrush}" Text="&#xE740;" />
      </Button>
    </StackPanel>

    <!-- 图片区（Starward ScrollViewer_Image：ZoomMode=Enabled、可拖动、双击还原） -->
    <Panel x:Name="ImagePanel"
           Grid.Row="1"
           ClipToBounds="True"
           Background="Transparent"
           PointerWheelChanged="OnImagePointerWheelChanged"
           PointerPressed="OnImagePointerPressed"
           PointerMoved="OnImagePointerMoved"
           PointerReleased="OnImagePointerReleased"
           DoubleTapped="OnImageDoubleTapped">

      <!-- LayoutTransformControl 让布局尺寸跟着缩放走，居中由 HorizontalAlignment 自然完成；
           平移只是拖动/锚点缩放时的补偿（RenderTransform 不参与布局）。 -->
      <LayoutTransformControl x:Name="ImageTransformHost"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsVisible="{Binding HasImage}">
        <Image x:Name="ImagePreview" Stretch="None" Source="{Binding Image}" />
      </LayoutTransformControl>

      <!-- 没有要显示的图像（Starward StackPanel_NoImage） -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                  IsVisible="{Binding !HasImage}">
        <TextBlock HorizontalAlignment="Center"
                   Foreground="{StaticResource StarTextSecondaryBrush}"
                   IsVisible="{Binding !HasError}"
                   Text="{Binding [ImageView2.NoImage], Source={x:Static loc:AppStrings.Instance}}" />
        <!-- 显示图像遇到错误（Starward StackPanel_DisplayImageError） -->
        <TextBlock HorizontalAlignment="Center"
                   Foreground="{StaticResource StarTextSecondaryBrush}"
                   IsVisible="{Binding HasError}"
                   Text="{Binding [ImageView2.FailedToDisplay], Source={x:Static loc:AppStrings.Instance}}" />
        <TextBlock HorizontalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                   MaxWidth="520"
                   Foreground="{StaticResource StarTextSecondaryBrush}"
                   IsVisible="{Binding HasError}"
                   Text="{Binding ErrorText}" />
        <Button x:Name="ButtonOpenFiles" HorizontalAlignment="Center"
                Click="OnOpenNewFilesClick"
                Content="{Binding [ImageView2.OpenNewFiles], Source={x:Static loc:AppStrings.Instance}}"
                Foreground="{StaticResource StarTextSecondaryBrush}" />
      </StackPanel>
    </Panel>

    <!-- 上一张 / 下一张（80 宽，整条高度，悬停显形） -->
    <Button x:Name="ButtonPrevious"
            Grid.Row="1" Width="80"
            HorizontalAlignment="Left" VerticalAlignment="Stretch"
            HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
            Background="Transparent" BorderThickness="0" Padding="24,0,0,0"
            Classes="nav"
            Click="OnPreviousClick"
            IsVisible="{Binding HasItems}"
            ToolTip.Tip="{Binding [ImageView2.Previous], Source={x:Static loc:AppStrings.Instance}}">
      <TextBlock Classes="icon" FontSize="16" Text="&#xE76B;" />
    </Button>

    <Button x:Name="ButtonNext"
            Grid.Row="1" Width="80"
            HorizontalAlignment="Right" VerticalAlignment="Stretch"
            HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
            Background="Transparent" BorderThickness="0" Padding="0,0,24,0"
            Classes="nav"
            Click="OnNextClick"
            IsVisible="{Binding HasItems}"
            ToolTip.Tip="{Binding [ImageView2.Next], Source={x:Static loc:AppStrings.Instance}}">
      <TextBlock Classes="icon" FontSize="16" Text="&#xE76C;" />
    </Button>

    <!-- 图库条（Starward GridView_ImageCollection：128×72 横排） -->
    <ListBox x:Name="GalleryList"
             Grid.Row="2"
             Height="88"
             Margin="0,0,0,4"
             Padding="6,0"
             Background="Transparent"
             BorderThickness="0"
             ItemsSource="{Binding Items}"
             IsVisible="{Binding IsGalleryOpen}"
             SelectionChanged="OnGallerySelectionChanged">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="6" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ImageViewItem">
          <Border Width="128" Height="72" CornerRadius="4" ClipToBounds="True" Background="#22FFFFFF">
            <Image Width="128" Height="72" Stretch="UniformToFill" Source="{Binding Thumbnail}" />
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- 左下角（Starward Grid.Row=3 左 StackPanel） -->
    <StackPanel Grid.Row="3" Margin="6,0"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Orientation="Horizontal" Spacing="6">

      <ToggleButton x:Name="ButtonGallery"
                    Width="40" Height="36" Padding="0"
                    IsEnabled="{Binding HasItems}"
                    IsChecked="{Binding IsGalleryOpen, Mode=TwoWay}"
                    ToolTip.Tip="{Binding [ImageView2.ShowGallery], Source={x:Static loc:AppStrings.Instance}}">
        <TextBlock Classes="icon" FontSize="16"
                   Foreground="{StaticResource StarTextSecondaryBrush}" Text="&#xE8B9;" />
      </ToggleButton>

      <TextBlock VerticalAlignment="Center"
                 Foreground="{StaticResource StarTextTertiaryBrush}"
                 Text="{Binding IndexText}"
                 IsVisible="{Binding HasItems}" />

      <Border Width="1" Height="16" Background="{StaticResource StarDividerBrush}" />

      <TextBlock Classes="icon" FontSize="16" Margin="12,0,4,0"
                 Foreground="{StaticResource StarTextTertiaryBrush}" Text="&#xE91B;"
                 IsVisible="{Binding HasImage}" />
      <TextBlock VerticalAlignment="Center"
                 Foreground="{StaticResource StarTextTertiaryBrush}"
                 Text="{Binding PixelSizeText}"
                 IsVisible="{Binding HasImage}" />

      <TextBlock Classes="icon" FontSize="16" Margin="12,0,4,0"
                 Foreground="{StaticResource StarTextTertiaryBrush}" Text="&#xE74E;"
                 IsVisible="{Binding HasImage}" />
      <TextBlock VerticalAlignment="Center"
                 Foreground="{StaticResource StarTextTertiaryBrush}"
                 Text="{Binding FileSizeText}"
                 IsVisible="{Binding HasImage}" />
    </StackPanel>

    <!-- 右下角（Starward Grid.Row=3 右 StackPanel：适应窗口 / 百分比 / 缩小 / 滑块 / 放大） -->
    <StackPanel Grid.Row="3" Margin="6,0"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Orientation="Horizontal" Spacing="6">

      <Button x:Name="ButtonFit" Width="40" Height="36" Padding="0"
              Click="OnFitClick"
              ToolTip.Tip="{Binding [ImageView2.FitToWindow], Source={x:Static loc:AppStrings.Instance}}">
        <TextBlock Classes="icon" FontSize="16"
                   Foreground="{StaticResource StarTextSecondaryBrush}" Text="&#xE9A6;" />
      </Button>

      <TextBlock MinWidth="44" VerticalAlignment="Center"
                 TextAlignment="Center"
                 Foreground="{StaticResource StarTextSecondaryBrush}"
                 Text="{Binding ZoomPercentText}" />

      <Button x:Name="ButtonZoomOut" Width="40" Height="36" Padding="0"
              Click="OnZoomOutClick"
              ToolTip.Tip="{Binding [ImageView2.ZoomOut], Source={x:Static loc:AppStrings.Instance}}">
        <TextBlock Classes="icon" FontSize="16"
                   Foreground="{StaticResource StarTextSecondaryBrush}" Text="&#xE71F;" />
      </Button>

      <Slider x:Name="SliderZoom"
              Width="160" VerticalAlignment="Center"
              Minimum="0.1" Maximum="5" TickFrequency="0.01" IsSnapToTickEnabled="True"
              PointerPressed="OnZoomSliderPointerPressed"
              Value="{Binding ZoomFactor, Mode=TwoWay}" />

      <Button x:Name="ButtonZoomIn" Width="40" Height="36" Padding="0"
              Click="OnZoomInClick"
              ToolTip.Tip="{Binding [ImageView2.ZoomIn], Source={x:Static loc:AppStrings.Instance}}">
        <TextBlock Classes="icon" FontSize="16"
                   Foreground="{StaticResource StarTextSecondaryBrush}" Text="&#xE8A3;" />
      </Button>
    </StackPanel>

    <!-- 右侧信息面板（Starward Grid_EditImage：MinWidth=360、左侧 8 圆角、可滚动） -->
    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="1"
            MinWidth="360"
            IsVisible="{Binding IsInfoPanelOpen}"
            BorderBrush="{StaticResource StarDividerBrush}"
            BorderThickness="1,0,0,0">
      <Grid>
        <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Margin="0,0,0,20" FontSize="20"
                       Text="{Binding [ImageView2.ImageInformation], Source={x:Static loc:AppStrings.Instance}}" />

            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource StarTextSecondaryBrush}"
                       Text="{Binding ImageInformationText}" />

            <TextBlock Margin="0,16,0,0"
                       Text="{Binding [ImageView2.MonitorInformation], Source={x:Static loc:AppStrings.Instance}}" />
            <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource StarTextSecondaryBrush}"
                       Text="{Binding MonitorInformationText}" />

            <TextBlock Margin="0,16,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource StarTextSecondaryBrush}"
                       Text="{Binding [ImageView2.NotSupportedOnLinux], Source={x:Static loc:AppStrings.Instance}}" />

            <Button x:Name="ButtonExport" Height="32" Margin="0,16,0,0"
                    BorderThickness="0" Classes="accent"
                    Click="OnExportClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" FontSize="16" Text="&#xE792;" />
                <TextBlock Text="{Binding [ImageView2.ExportImage], Source={x:Static loc:AppStrings.Instance}}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <Button x:Name="ButtonCloseInfo" Width="36" Height="36" Margin="4" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Click="OnCloseInfoClick">
          <TextBlock Classes="icon" FontSize="16"
                     Foreground="{StaticResource StarTextSecondaryBrush}" Text="&#xE711;" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
