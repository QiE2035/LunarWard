<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LunarWard.App.Views.Starward.DX12IntroDialog"
        Width="680" SizeToContent="Height"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        x:DataType="local:DX12IntroDialog"
        xmlns:local="using:LunarWard.App.Views.Starward">
  <!--
    1:1 复刻 Starward Features/GameLauncher/DX12IntroDialog.xaml（93 行）。
    源码用 GameDXConfig.DX11PreviewImage / DX12PreviewImage 官方截图 + I18nIntro 接口文案；
    LunarWard 没有这两张素材、也没有游戏 DX 配置接口，改用同尺寸占位面板 + 固定说明文案。
  -->
  <Border Margin="8"
          Background="{StaticResource StarAcrylicBrush}"
          BorderBrush="#14FFFFFF"
          BorderThickness="1"
          CornerRadius="8"
          BoxShadow="0 16 48 0 #99000000">
    <Grid Margin="24" RowDefinitions="Auto,*">
      <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding Heading}" />

      <Button Grid.Row="0"
              Width="32" Height="32" Padding="0"
              Margin="0,-12,-12,0"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Background="Transparent" BorderThickness="0"
              Click="OnCloseClick">
        <TextBlock Classes="icon" FontSize="16"
                   Foreground="{StaticResource StarTextSecondary}" Text="&#xE711;" />
      </Button>

      <StackPanel Grid.Row="1" Spacing="20" Margin="0,20,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
          <Panel Width="300" Height="225">
            <Border CornerRadius="16" Background="{StaticResource StarControlFillBrush}" />
            <Border Padding="0,4" VerticalAlignment="Bottom" Background="#8C000000" CornerRadius="0,0,16,16">
              <TextBlock HorizontalAlignment="Center" FontWeight="Bold" FontSize="12"
                         Foreground="{StaticResource StarTextSecondary}" Text="{Binding RegularGraphics}" />
            </Border>
          </Panel>
          <Panel Width="300" Height="225">
            <Border CornerRadius="16" Background="{StaticResource StarControlFillBrush}" />
            <Border Padding="0,4" VerticalAlignment="Bottom" Background="#8C000000" CornerRadius="0,0,16,16">
              <TextBlock HorizontalAlignment="Center" FontWeight="Bold" FontSize="12"
                         Foreground="{StaticResource StarTextSecondary}" Text="{Binding EnhancedGraphics}" />
            </Border>
          </Panel>
        </StackPanel>

        <TextBlock FontSize="16" TextWrapping="Wrap"
                   Foreground="{StaticResource StarTextPrimary}" Text="{Binding Description}" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
