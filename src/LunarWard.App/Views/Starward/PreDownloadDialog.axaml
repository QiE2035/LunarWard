<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:LunarWard.App.Localization"
        x:Class="LunarWard.App.Views.Starward.PreDownloadDialog"
        Title="预下载"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <!--  Starward Features/GameInstall/PreDownloadDialog.xaml：400 宽、24 内边距、标题 18 Bold、
          一块 12,8 的浅底卡片写三个体积、两条 Caution 警告、右下 Accent 主按钮、右上关闭。  -->
    <Border Background="{DynamicResource StarAcrylicBrush}"
            BorderBrush="#14FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            BoxShadow="0 16 48 0 #99000000">
        <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

            <TextBlock FontSize="18"
                       FontWeight="Bold"
                       Text="{Binding [Launcher.PreInstall], Source={x:Static loc:AppStrings.Instance}}" />

            <!--  体积信息卡  -->
            <Border Grid.Row="1"
                    Margin="0,20,0,0"
                    Padding="12,8"
                    Background="{DynamicResource StarControlFillBrush}"
                    CornerRadius="8">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,Auto">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource StarTextSecondaryBrush}"
                                   Text="{Binding [PreDownloadDialog.PackageSize], Source={x:Static loc:AppStrings.Instance}}" />
                        <TextBlock x:Name="PackageSizeValue" Grid.Column="1" Margin="4,0,0,0" FontSize="12" Foreground="{DynamicResource StarTextSecondaryBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource StarTextSecondaryBrush}"
                                   Text="{Binding [InstallGameDialog.SpaceRequired], Source={x:Static loc:AppStrings.Instance}}" />
                        <TextBlock x:Name="UnzipSpaceValue" Grid.Column="1" Margin="4,0,0,0" FontSize="12" Foreground="{DynamicResource StarTextSecondaryBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource StarTextSecondaryBrush}"
                                   Text="{Binding [InstallGameDialog.SpaceAvailable], Source={x:Static loc:AppStrings.Instance}}" />
                        <TextBlock x:Name="AvailableSpaceValue" Grid.Column="1" Margin="4,0,0,0" FontSize="12" Foreground="{DynamicResource StarTextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  两条 Caution 警告（源码是同一 StackPanel 里两行）  -->
            <StackPanel Grid.Row="2" Margin="1,8,1,0" Spacing="4">
                <!--  无补丁包可用，建议先更新  -->
                <TextBlock x:Name="NoPatchesText"
                           FontSize="12"
                           Foreground="{DynamicResource StarCautionBrush}"
                           TextWrapping="Wrap"
                           IsVisible="False" />
                <!--  预下载不可用  -->
                <TextBlock x:Name="UnavailableText"
                           FontSize="12"
                           Foreground="{DynamicResource StarCautionBrush}"
                           TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>

            <Button x:Name="StartButton"
                    Grid.Row="3"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Classes="accent"
                    FontSize="14"
                    IsEnabled="False"
                    Content="{Binding [PreDownloadDialog.Start], Source={x:Static loc:AppStrings.Instance}}"
                    Click="OnStartClick" />

            <!--  不兼容提醒（源码默认折叠，这里同样默认折叠）  -->
            <StackPanel x:Name="IncompatibilityPanel"
                        Grid.Row="4"
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        Spacing="4"
                        IsVisible="False">
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource StarTextSecondaryBrush}"
                           Text="{Binding [PreDownloadDialog.IncompatibilityNotice], Source={x:Static loc:AppStrings.Instance}}" />
                <Button Padding="4" Classes="link" ToolTip.Tip="{Binding [PreDownloadDialog.IncompatibilityNoticeContent], Source={x:Static loc:AppStrings.Instance}}">
                    <TextBlock Classes="icon" FontSize="12" Foreground="{DynamicResource StarTextSecondaryBrush}" Text="&#xE9CE;" />
                </Button>
            </StackPanel>

            <!--  关闭  -->
            <Button Grid.Row="0"
                    Grid.RowSpan="2"
                    Width="32"
                    Height="32"
                    Margin="-20,-20,0,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Click="OnCloseClick">
                <TextBlock Classes="icon" FontSize="16" Foreground="{DynamicResource StarTextSecondaryBrush}" Text="&#xE711;" />
            </Button>
        </Grid>
    </Border>
</Window>
