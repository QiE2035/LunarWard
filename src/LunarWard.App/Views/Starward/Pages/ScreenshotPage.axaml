<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunarWard.App.ViewModels.Starward"
             xmlns:oldvm="using:LunarWard.App.ViewModels"
             x:Class="LunarWard.App.Views.Starward.Pages.ScreenshotPage"
             x:DataType="vm:ScreenshotPageViewModel">

  <!--
    复刻 Starward Features/Screenshot/ScreenshotPage2.xaml（顶部 44px 工具条 + 内容区）。
    本页按 docs/07-UI-REPLICA.md 的页面合同做成「左 360 列表 + 右大预览」：
      - 工具条：标题 20（Starward FontSize=20）+ 截图目录（12 次要色，可复制）
                + 刷新 / 导出选中 / 打开目录
      - 左栏 360：ListBox，行高 44，文件名 14 + 时间 12 次要色，选中左强调条 3×16
      - 右侧：Image Stretch=Uniform 居中；空态 64+ 图标 + 说明
      - 底部：截图目录来源说明（12px 次要色）
    颜色/字号全部取自 Styles/Starward.axaml，页面内不写裸色值。
  -->

  <UserControl.Styles>
    <!--
      页面局部覆盖 card：Starward 的卡片在能模糊时是 CustomAcrylicBrush（半透明 + 模糊）。
      Linux 上没有模糊，用 Starward 自己的 Fallback 值 #F52C2C2C 才压得住背景图上的文字。
      这里只改本页作用域，不动 Styles/Starward.axaml。
    -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource StarAcrylicBrush}" />
    </Style>

    <!-- 截图列表：行高 44、选中态左侧 3px 强调条（Starward 的 ListBoxItem 选中语义） -->
    <Style Selector="ListBox#ScreenshotList ListBoxItem">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ListBox#ScreenshotList ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource StarSelectionBrush}" />
    </Style>

    <Style Selector="ListBox#ScreenshotList ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource StarControlFillHoverBrush}" />
    </Style>

    <!-- 选中强调条默认隐藏，选中时出现（与导航栏 3×16 的竖条同构） -->
    <Style Selector="Border.accent-bar">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Background" Value="{StaticResource StarAccentBrush}" />
    </Style>

    <Style Selector="ListBoxItem:selected Border.accent-bar">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="44,*,Auto">

    <!-- ══ 顶部工具条（Starward：标题左、操作右，行高 44） ═══════════════ -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="24,0,24,0" ColumnSpacing="16">

      <TextBlock Grid.Column="0"
                 VerticalAlignment="Center"
                 Classes="section"
                 Text="{Binding Strings[Screenshot.Title]}" />

      <!-- 截图目录：12px 次要色 + 复制路径 -->
      <Border Grid.Column="1"
              HorizontalAlignment="Left"
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              CornerRadius="4"
              Background="{StaticResource StarOverlayAcrylicBrush}"
              Padding="8,2,4,2">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Classes="tertiary"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     MaxWidth="360"
                     Text="{Binding DirectoryDisplay}"
                     ToolTip.Tip="{Binding DirectoryDisplay}" />
          <Button Classes="icon-button"
                  Width="24" Height="24" MinHeight="24"
                  Command="{Binding CopyPathCommand}"
                  ToolTip.Tip="{Binding Strings[Screenshot.CopyPath]}">
            <TextBlock Classes="icon" FontSize="12"
                       Foreground="{StaticResource StarTextTertiary}" Text="&#xE8C8;" />
          </Button>
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="overlay"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="{Binding Strings[Screenshot.Refresh]}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="icon" FontSize="14" Text="&#xE72C;" />
            <TextBlock Text="{Binding Strings[Screenshot.Refresh]}" />
          </StackPanel>
        </Button>

        <Button Classes="accent"
                Command="{Binding ExportSelectedCommand}"
                IsEnabled="{Binding CanExport}"
                ToolTip.Tip="{Binding Strings[Screenshot.ExportSelected]}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="icon" FontSize="14" Text="&#xE8E5;" />
            <TextBlock Text="{Binding Strings[Screenshot.ExportSelected]}" />
          </StackPanel>
        </Button>

        <Button Classes="overlay"
                Command="{Binding OpenDirectoryCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="icon" FontSize="14" Text="&#xE8B7;" />
            <TextBlock Text="{Binding Strings[Screenshot.OpenDirectory]}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ══ 主体：左 360 列表 + 右预览 ═══════════════════════════════════ -->
    <Grid Grid.Row="1"
          Margin="24,8,24,8"
          ColumnDefinitions="360,16,*">

      <!-- ── 左：文件列表 ─────────────────────────────────────────── -->
      <Border Grid.Column="0" Classes="card" Padding="8">
        <Grid RowDefinitions="Auto,*" RowSpacing="4">

          <Grid Grid.Row="0" ColumnDefinitions="Auto,8,*" Margin="8,4,8,4">
            <TextBlock Grid.Column="0"
                       Classes="tertiary"
                       VerticalAlignment="Center"
                       Text="{Binding Strings[Screenshot.ListHeader]}" />
            <TextBlock Grid.Column="2"
                       Classes="tertiary"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding SummaryText}"
                       IsVisible="{Binding HasSummary}" />
          </Grid>

          <ListBox Grid.Row="1"
                   x:Name="ScreenshotList"
                   ItemsSource="{Binding Browser.Items}"
                   SelectedItem="{Binding Browser.Selected, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   IsVisible="{Binding HasItems}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="oldvm:ScreenshotItemViewModel">
                <Grid ColumnDefinitions="3,8,*,Auto" Height="44" Background="Transparent">
                  <!-- 选中时出现的强调条 -->
                  <Border Grid.Column="0"
                          Classes="accent-bar"
                          Width="3" Height="16"
                          CornerRadius="1.5"
                          VerticalAlignment="Center" />

                  <StackPanel Grid.Column="2"
                              VerticalAlignment="Center"
                              Spacing="2"
                              Margin="0,0,8,0">
                    <TextBlock FontSize="14"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding FileName}" />
                    <TextBlock Classes="tertiary" Text="{Binding Time}" />
                  </StackPanel>

                  <TextBlock Grid.Column="3"
                             Classes="tertiary"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             Text="{Binding SizeText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 左栏空态：只给一句紧凑提示，详细说明在右侧空态里 -->
          <StackPanel Grid.Row="1"
                      Margin="8,4,8,8"
                      Spacing="6"
                      IsVisible="{Binding IsEmpty}">
            <TextBlock Classes="tertiary" TextWrapping="Wrap"
                       Text="{Binding Strings[Screenshot.EmptyTitle]}" />
            <TextBlock Classes="tertiary" TextWrapping="Wrap"
                       IsVisible="{Binding HasGameDirectory}"
                       Text="{Binding DirectoryDisplay}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ── 右：大预览 ───────────────────────────────────────────── -->
      <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
        <Panel>

          <!-- 选中项：整幅 Uniform 居中 -->
          <Image Source="{Binding Browser.Selected.Preview}"
                 Stretch="Uniform"
                 Margin="16"
                 IsVisible="{Binding HasSelection}" />

          <!-- 空态（本机很可能没有截图，这里必须精致） -->
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="16"
                      MaxWidth="380"
                      IsVisible="{Binding !HasSelection}">
            <Border Width="112" Height="112"
                    CornerRadius="56"
                    HorizontalAlignment="Center"
                    Background="{StaticResource StarControlFillBrush}"
                    BorderBrush="{StaticResource StarCardStrokeBrush}"
                    BorderThickness="1">
              <TextBlock Classes="icon"
                         FontSize="64"
                         Foreground="{StaticResource StarTextTertiary}"
                         Text="&#xE722;" />
            </Border>

            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Text="{Binding Strings[Screenshot.PreviewHint]}" />

            <TextBlock HorizontalAlignment="Center"
                       Classes="tertiary"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       IsVisible="{Binding IsEmpty}"
                       Text="{Binding Strings[Screenshot.EmptyDetail]}" />

            <TextBlock HorizontalAlignment="Center"
                       Classes="tertiary"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       IsVisible="{Binding !HasGameDirectory}"
                       Text="{Binding Strings[Screenshot.NoGameDirectoryDetail]}" />

            <Button HorizontalAlignment="Center"
                    IsVisible="{Binding IsEmpty}"
                    Command="{Binding OpenDirectoryCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="icon" FontSize="14" Text="&#xE8B7;" />
                <!-- 没配游戏目录时，按钮实际是「去游戏设置」，文案跟着换 -->
                <TextBlock Text="{Binding Strings[Screenshot.EmptyAction]}"
                           IsVisible="{Binding HasGameDirectory}" />
                <TextBlock Text="{Binding Strings[Screenshot.EmptyActionNoDir]}"
                           IsVisible="{Binding !HasGameDirectory}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Panel>
      </Border>
    </Grid>

    <!-- ══ 底部说明 + 操作反馈 ═════════════════════════════════════════ -->
    <Grid Grid.Row="2" Margin="24,0,24,12" RowDefinitions="Auto,Auto" RowSpacing="4">
      <Border Grid.Row="0"
              HorizontalAlignment="Stretch"
              CornerRadius="4"
              Background="{StaticResource StarOverlayAcrylicBrush}"
              Padding="12,6">
        <TextBlock Classes="tertiary"
                   Foreground="{StaticResource StarTextSecondary}"
                   TextWrapping="Wrap"
                   Text="{Binding Strings[Screenshot.FootNote]}" />
      </Border>

      <StackPanel Grid.Row="1" Spacing="4">
        <TextBlock Classes="tertiary"
                   Foreground="{StaticResource StarSuccessBrush}"
                   Text="{Binding ActionText}"
                   IsVisible="{Binding HasActionText}" />

        <Border Classes="infobar error"
                HorizontalAlignment="Left"
                IsVisible="{Binding HasErrorText}">
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </Grid>

  </Grid>
</UserControl>
