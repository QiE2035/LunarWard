<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunarWard.App.ViewModels.Starward"
             xmlns:oldvm="using:LunarWard.App.ViewModels"
             x:Class="LunarWard.App.Views.Starward.Pages.ScreenshotPage"
             x:DataType="vm:ScreenshotPageViewModel">

  <!--
    复刻 Starward Features/Screenshot/ScreenshotPage2.xaml（1:1 结构，不是「受启发」的重设计）：
      Row0 44px 页头（源码 130-150 行）
        · 标题：Margin 24,0,0,0 / 左对齐 / 垂直居中 / FontSize 20 / Bold
        · 右侧 StackPanel：Margin 0,0,38,0 / HorizontalAlignment Right / Spacing 16，
          里面只有「管理截图文件夹」按钮（Starward 全页唯一的按钮）
      Row1 磁贴墙：ItemsView + UniformGridLayout（源码 169-282 行）
        · Padding 24,0,0,12（:171）
        · MinColumnSpacing 12 / MinItemHeight 115 / MinItemWidth 204 / MinRowSpacing 12（:177-180）
        · 每项：圆角 4（:188）、ClipToBounds（:186）、背景 ControlAltFillColorTertiary（:197）
        · 缩略图居中（:194-201）、悬停信息层（#60000000 + 时间 12px #F3F3F3，:206-232）
    空态：StackPanel 居中 Spacing 16 + 160×160 图标 + 16px 次要色文案（源码 153-166 行）。
    AnnotatedScrollBar（源码 285-312）：Avalonia 无等价控件，改为滚动浮出的月份胶囊
    （ScreenshotMonthIndex + 本页 OnWallScrollChanged，已验证 2026-10→2026-05，见 docs/09）。
  -->

  <UserControl.Resources>
    <!-- Starward ScreenshotPage2.xaml:207 Grid_ImageInfo Background="#60000000" -->
    <SolidColorBrush x:Key="ScreenshotTileInfoBackground" Color="#60000000" />
    <!-- Starward ScreenshotPage2.xaml:229 时间文字 Foreground="#F3F3F3" -->
    <SolidColorBrush x:Key="ScreenshotTileTimeForeground" Color="#F3F3F3" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!--
      磁贴外壳（Starward Grid_ImageItem，:185-192）：圆角 4 + ClipToBounds。
      Avalonia 的 Grid 没有 CornerRadius，用 Border 承载圆角，内部结构不变。
    -->
    <Style Selector="Border.tile">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!--
      悬停信息层（Starward Grid_ImageInfo，:206-208 + Storyboard :235-251）：
      Starward 用 0.6s 的 DoubleAnimation 把 Opacity 0→1；Avalonia 用等价的
      DoubleTransition。另外 Starward 还会把缩略图放大到 1.2，Avalonia 12 没有
      等价的 Transform 过渡，这部分未移植（记录在 docs/07 §8）。
    -->
    <Style Selector="Grid.info">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.6" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.tile Image.thumb">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform"
                                         Duration="0:0:0.6"
                                         Easing="QuadraticEaseOut" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.tile:pointerover Image.thumb">
      <Setter Property="RenderTransform" Value="scale(1.2)" />
    </Style>

    <Style Selector="Border.tile:pointerover Grid.info">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Flyout 里的三行操作（LunarWard 追加，见页头按钮注释） -->
    <Style Selector="Button.flyout-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="11,6" />
    </Style>

    <Style Selector="Button.flyout-row /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.flyout-row:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource StarControlFillHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="44,*">

    <!-- ══ 页头（Starward :137-150） ═════════════════════════════════════ -->
    <TextBlock Grid.Row="0"
               Margin="24,0,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               FontSize="20"
               FontWeight="Bold"
               Text="{Binding Strings[Screenshot.Title]}" />

    <StackPanel Grid.Row="0"
                Margin="0,0,38,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="16">

      <!--
        Starward 唯一的按钮（:149）：Command=ManageScreenshotFolderCommand，
        打开 ScreenshotFolderManageDialog（已移植为 Views/Starward/ScreenshotFolderManageDialog.axaml）。
        原 Flyout 里的刷新 / 打开目录 / 导出全部保留在磁贴右键菜单里。
      -->
      <Button x:Name="ManageButton"
              Content="{Binding Strings[Screenshot.ManageFolders]}"
              Click="OnManageFoldersClick" />
    </StackPanel>

    <!-- ══ 磁贴墙（Starward ItemsView，:169-282） ═══════════════════════ -->
    <ScrollViewer x:Name="WallScroller"
                  Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  ScrollChanged="OnWallScrollChanged">
      <!-- Starward ItemsView Padding="24,0,0,12"（:171） -->
      <Border Padding="24,0,0,12">
        <ItemsControl x:Name="ScreenshotWall"
                      ItemsSource="{Binding Browser.Items}"
                      SizeChanged="OnWallSizeChanged">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <!--
                Starward UniformGridLayout 的 Avalonia 等价物（:177-180）。
                UniformGridLayout 会把每一行拉伸到可用宽度，WrapPanel 不支持拉伸，
                因此 ItemWidth 由 code-behind 按列数重算（见 ScreenshotPage.axaml.cs）。
              -->
              <WrapPanel Orientation="Horizontal"
                         ItemWidth="204"
                         ItemHeight="115"
                         ItemSpacing="12"
                         LineSpacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="oldvm:ScreenshotItemViewModel">
              <!--
                Starward Grid_ImageItem（:185-192）：圆角 4、ClipToBounds、点击打开大图。
                背景是 Starward 的 ControlAltFillColorTertiaryBrush（:197）；该 Fluent token
                在 Styles/Starward.axaml 里统一收敛成 StarControlFillBrush（#0FFFFFFF）。
              -->
              <Border Classes="tile"
                      Height="115"
                      Background="{StaticResource StarControlFillBrush}"
                      AttachedToVisualTree="OnTileAttached"
                      Tapped="OnTileTapped">
                <Grid>
                  <!--
                    Starward CachedImage（:193-205）：水平/垂直居中、IsThumbnail=True。
                    LunarWard 的缩略图是 ScreenshotItemViewModel.Thumbnail：
                    背景线程解码到 412 宽（Starward ImageThumbnail 的同一档尺寸），
                    不会一次性解码原图。
                  -->
                  <!--
                    Starward 悬停动画（:240-280）：缩略图 ScaleX/Y → 1.2（X 1s / Y 0.6s，
                    CircleEase），信息条 opacity → 1（0.6s）；离开时 1s 还原。
                    Avalonia 用 TransformOperationsTransition 表达同一组时长与缓动。
                  -->
                  <Image Classes="thumb"
                         Source="{Binding Thumbnail}"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />

                  <!-- Starward Grid_ImageInfo（:206-232）：悬停显示时间，背景 #60000000 -->
                  <Grid Classes="info" Background="{StaticResource ScreenshotTileInfoBackground}">
                    <TextBlock Margin="8,0,8,4"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               FontSize="12"
                               Foreground="{StaticResource ScreenshotTileTimeForeground}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Time}" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </ScrollViewer>

    <!--
      月份胶囊（替代上游 AnnotatedScrollBar，见 docs/07 §8）：贴在磁贴墙右侧垂直居中，
      滚动时按磁贴实际 Y 坐标找到视口顶端所在的月份分组，显示 1.1s 后自动隐藏。
      命中不到月份（空墙/未布局完）时整块不显示。
    -->
    <Border x:Name="MonthIndicator"
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,16,0"
            Padding="10,6"
            CornerRadius="14"
            Background="#CC202020"
            IsVisible="False"
            IsHitTestVisible="False">
      <TextBlock x:Name="MonthIndicatorText" FontSize="12" Foreground="#E6FFFFFF" />
    </Border>

    <!-- ══ 空态（Starward StackPanel_Emoji，:153-166） ═══════════════════ -->
    <!--
      Starward 放的是游戏 emoji 的 160×160 PNG（派蒙/帕姆/…）。LunarWard 没有这套素材，
      用同尺寸占位框 + 72px 的图标字形（E722 相机），字号按 160 框放大到 72。
    -->
    <StackPanel Grid.RowSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                IsVisible="{Binding IsEmpty}">
      <Border Width="160" Height="160" HorizontalAlignment="Center">
        <TextBlock Classes="icon"
                   FontSize="72"
                   Foreground="{StaticResource StarTextTertiary}"
                   Text="&#xE722;" />
      </Border>
      <!-- 目录不存在：Starward 的原文案（ScreenshotPage_ScreenshotFolderDoesNotExist） -->
      <TextBlock HorizontalAlignment="Center"
                 FontSize="16"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="{Binding Strings[Screenshot.FolderDoesNotExist]}"
                 IsVisible="{Binding DirectoryMissing}" />

      <!-- 目录存在但还没截图：Starward 此时是空白墙，这里补一句说明（LunarWard 追加） -->
      <TextBlock HorizontalAlignment="Center"
                 FontSize="16"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="{Binding Strings[Screenshot.EmptyTitle]}"
                 IsVisible="{Binding FolderExistsButEmpty}" />
    </StackPanel>

    <!--
      操作反馈（LunarWard 追加）：主窗口已有 InAppToast（Services/InAppToast.cs），
      但截图页在独立窗口里无法直接用；这里保留页面内的底部提示条，
      重要操作成功/失败同时发 InAppToast；无操作时不显示。
    -->
    <StackPanel Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="24,0,24,24"
                Spacing="8">
      <Border Classes="infobar"
              MaxWidth="600"
              IsVisible="{Binding HasActionText}">
        <TextBlock Text="{Binding ActionText}" TextWrapping="Wrap" />
      </Border>
      <Border Classes="infobar error"
              MaxWidth="600"
              IsVisible="{Binding HasErrorText}">
        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

  </Grid>
</UserControl>
