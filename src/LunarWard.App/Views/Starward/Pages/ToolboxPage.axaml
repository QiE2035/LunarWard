<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunarWard.App.ViewModels.Starward"
             xmlns:oldvm="using:LunarWard.App.ViewModels"
             x:Class="LunarWard.App.Views.Starward.Pages.ToolboxPage"
             x:DataType="vm:ToolboxPageViewModel">

  <!--
    复刻 Starward Features/GameRecord/GameRecordPage.xaml 的容器结构：顶部页签 + 卡片流。
    Starward 用 NavigationView 左侧列表，本页按 docs/07-UI-REPLICA.md 的合同改成顶部 Pivot：
      16px Bold 表头（Classes="pivot-header"）+ 选中项下方 3px 圆角强调条。
    两个 Tab：每日便笺（cookie 卡 + 便笺卡） / 账号记录（操作行 + 列表 + 安全提示）。
    颜色/字号全部取自 Styles/Starward.axaml，页面内不写裸色值。
  -->

  <UserControl.Styles>
    <!--
      页面局部覆盖 card：Starward 卡片能模糊时是 CustomAcrylicBrush。
      Linux 无模糊，用 Starward 自己的 Fallback #F52C2C2C 才能压住背景图上的密集文字。
    -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource StarAcrylicBrush}" />
    </Style>

    <!-- Pivot 表头文字：未选中次要色、选中主色（Starward Pivot 的选中语义） -->
    <Style Selector="TextBlock.pivot-header">
      <Setter Property="Foreground" Value="{StaticResource StarTextSecondary}" />
    </Style>

    <Style Selector="TextBlock.pivot-header.active">
      <Setter Property="Foreground" Value="{StaticResource StarTextPrimary}" />
    </Style>

    <!-- Pivot 表头按钮（Starward PivotHeaderItem：高 36、左右 12） -->
    <Style Selector="Button.pivot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.pivot /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.pivot:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource StarControlFillHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="44,44,*">

    <!-- ══ 标题（Starward 页面标题：20、左 24、行高 44） ═════════════════ -->
    <TextBlock Grid.Row="0"
               Margin="24,0,0,0"
               VerticalAlignment="Center"
               Classes="section"
               Text="{Binding Strings[Toolbox.Title]}" />

    <!-- ══ Pivot 表头 ═════════════════════════════════════════════════════ -->
    <StackPanel Grid.Row="1"
                Margin="24,0,0,0"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Stretch">

      <!-- 每日便笺 -->
      <Button Classes="pivot"
              Command="{Binding ShowDailyNoteCommand}">
        <Panel>
          <TextBlock Classes="pivot-header"
                     Classes.active="{Binding IsDailyNoteTab}"
                     Margin="0,0,0,4"
                     VerticalAlignment="Center"
                     Text="{Binding Strings[Toolbox.DailyNote]}" />
          <Border Height="3"
                  CornerRadius="1.5"
                  VerticalAlignment="Bottom"
                  Background="{StaticResource StarAccentBrush}"
                  IsVisible="{Binding IsDailyNoteTab}" />
        </Panel>
      </Button>

      <!-- 账号记录 -->
      <Button Classes="pivot"
              Command="{Binding ShowAccountsCommand}">
        <Panel>
          <TextBlock Classes="pivot-header"
                     Classes.active="{Binding IsAccountTab}"
                     Margin="0,0,0,4"
                     VerticalAlignment="Center"
                     Text="{Binding Strings[Toolbox.Accounts]}" />
          <Border Height="3"
                  CornerRadius="1.5"
                  VerticalAlignment="Bottom"
                  Background="{StaticResource StarAccentBrush}"
                  IsVisible="{Binding IsAccountTab}" />
        </Panel>
      </Button>
    </StackPanel>

    <!-- ══ 内容区 ═════════════════════════════════════════════════════════ -->
    <Panel Grid.Row="2">

      <!-- ─────────────────────────────────────────────────────────────
           每日便笺：左 cookie 配置卡 + 右便笺卡
           ───────────────────────────────────────────────────────────── -->
      <Grid Margin="24,4,24,16" ColumnDefinitions="320,16,*"
            IsVisible="{Binding IsDailyNoteTab}">

        <!-- ── 左：cookie 配置卡 ───────────────────────────────── -->
        <Border Grid.Column="0" Classes="card">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8">

            <StackPanel Grid.Row="0" Spacing="2">
              <TextBlock Text="{Binding Strings[Toolbox.CookieCard]}" />
              <TextBlock Classes="tertiary" TextWrapping="Wrap"
                         Text="{Binding Strings[Toolbox.CookieHint]}" />
            </StackPanel>

            <TextBox Grid.Row="1"
                     Height="120"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     PlaceholderText="{Binding Strings[Toolbox.Cookie]}"
                     Text="{Binding DailyNote.Cookie, Mode=TwoWay}" />

            <Grid Grid.Row="2" ColumnDefinitions="*,8,*">
              <TextBox Grid.Column="0"
                       PlaceholderText="{Binding Strings[Toolbox.Uid]}"
                       Text="{Binding DailyNote.Uid, Mode=TwoWay}" />
              <TextBox Grid.Column="2"
                       PlaceholderText="{Binding Strings[Toolbox.Region]}"
                       Text="{Binding DailyNote.Region, Mode=TwoWay}" />
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="*,8,*">
              <Button Grid.Column="0"
                      HorizontalContentAlignment="Center"
                      Command="{Binding DailyNote.SaveCookieCommand}"
                      Content="{Binding Strings[Toolbox.Save]}" />
              <Button Grid.Column="2"
                      HorizontalContentAlignment="Center"
                      Command="{Binding DailyNote.ClearCookieCommand}"
                      Content="{Binding Strings[Toolbox.Clear]}" />
            </Grid>

            <Button Grid.Row="4"
                    Classes="accent"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{Binding IsNotBusy}"
                    Command="{Binding DailyNote.RefreshCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="icon" FontSize="14" Text="&#xE72C;" />
                <TextBlock Text="{Binding Strings[Toolbox.Refresh]}" />
              </StackPanel>
            </Button>

            <!-- 状态/错误紧跟按钮（Starward 的 InfoBar 也是贴着操作区，不吸底） -->
            <StackPanel Grid.Row="5" Spacing="6">
              <TextBlock Classes="tertiary" TextWrapping="Wrap"
                         Text="{Binding DailyNote.StatusText}"
                         IsVisible="{Binding HasStatusText}" />

              <Border Classes="infobar error" IsVisible="{Binding HasDailyNoteError}">
                <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding DailyNote.ErrorText}" />
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ── 右：便笺卡 ─────────────────────────────────────── -->
        <Border Grid.Column="2" Classes="card">
          <Panel>

            <!-- 空态：没有 cookie -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" MaxWidth="340"
                        IsVisible="{Binding !HasCookie}">
              <Border Width="72" Height="72" CornerRadius="36"
                      HorizontalAlignment="Center"
                      Background="{StaticResource StarControlFillBrush}"
                      BorderBrush="{StaticResource StarCardStrokeBrush}"
                      BorderThickness="1">
                <TextBlock Classes="icon" FontSize="32"
                           Foreground="{StaticResource StarTextTertiary}"
                           Text="&#xE7C3;" />
              </Border>
              <TextBlock HorizontalAlignment="Center" FontSize="16"
                         Text="{Binding Strings[Toolbox.NoCookie]}" />
              <TextBlock Classes="tertiary" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap"
                         Text="{Binding Strings[Toolbox.NoCookieDetail]}" />
            </StackPanel>

            <!-- 有 cookie，但还没拉到数据 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" MaxWidth="340"
                        IsVisible="{Binding ShowNotePlaceholder}">
              <TextBlock HorizontalAlignment="Center" FontSize="16"
                         Text="{Binding Strings[Toolbox.NoNote]}" />
              <TextBlock Classes="tertiary" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap"
                         Text="{Binding Strings[Toolbox.NoNoteDetail]}" />
            </StackPanel>

            <!-- 便笺正文 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasNote}">
              <StackPanel Spacing="16">

                <!-- 昵称 + UID -->
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" FontSize="16" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding DailyNote.Nickname}" />
                  <TextBlock Grid.Column="1" Classes="tertiary" VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             Text="{Binding DailyNote.Uid}" />
                </Grid>

                <!-- 主资源 -->
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding DailyNote.PrimaryName}" />
                    <TextBlock Grid.Column="1" Classes="secondary">
                      <Run Text="{Binding DailyNote.PrimaryCurrent}" />
                      <Run Text="/" />
                      <Run Text="{Binding DailyNote.PrimaryMax}" />
                    </TextBlock>
                  </Grid>
                  <ProgressBar Classes="height-10"
                               Minimum="0" Maximum="1"
                               Value="{Binding DailyNote.PrimaryPercent}" />
                  <TextBlock Classes="tertiary" Text="{Binding DailyNote.RecoveryText}" />
                </StackPanel>

                <Border Classes="divider" />

                <!-- 每日任务完成状态 -->
                <Grid ColumnDefinitions="Auto,8,*" IsVisible="{Binding HasDailyTasks}">
                  <TextBlock Grid.Column="0" Classes="icon" FontSize="14"
                             Foreground="{StaticResource StarSuccessBrush}"
                             Text="{Binding DailyTasksGlyph}"
                             IsVisible="{Binding DailyTasksOk}" />
                  <TextBlock Grid.Column="0" Classes="icon" FontSize="14"
                             Foreground="{StaticResource StarErrorBrush}"
                             Text="{Binding DailyTasksGlyph}"
                             IsVisible="{Binding DailyTasksFailed}" />
                  <TextBlock Grid.Column="2" Classes="secondary"
                             Text="{Binding DailyTasksText}" />
                </Grid>

                <!-- 其余条目：两列 -->
                <StackPanel Spacing="4" IsVisible="{Binding HasNoteItems}">
                  <TextBlock Classes="tertiary" Text="{Binding Strings[Toolbox.NoteItems]}" />
                  <ItemsControl ItemsSource="{Binding DailyNote.Items}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="oldvm:DailyNoteItemViewModel">
                        <Grid ColumnDefinitions="Auto,8,*" Margin="0,4">
                          <TextBlock Grid.Column="0" Classes="tertiary" Text="{Binding Name}" />
                          <TextBlock Grid.Column="2" HorizontalAlignment="Left" Text="{Binding Value}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Panel>
        </Border>
      </Grid>

      <!-- ─────────────────────────────────────────────────────────────
           账号记录：操作行 + 列表 + 当前账号摘要 + 安全提示
           ───────────────────────────────────────────────────────────── -->
      <Grid Margin="24,4,24,16" RowDefinitions="Auto,*,Auto,16,Auto"
            IsVisible="{Binding IsAccountTab}">

        <!-- 操作行 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
          <Button Command="{Binding Accounts.SaveCurrentCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="icon" FontSize="14" Text="&#xE74E;" />
              <TextBlock Text="{Binding Strings[Toolbox.SaveCurrent]}" />
            </StackPanel>
          </Button>

          <Button Command="{Binding Accounts.SwitchCommand}"
                  IsEnabled="{Binding HasSelectedAccount}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="icon" FontSize="14" Text="&#xE8AB;" />
              <TextBlock Text="{Binding Strings[Toolbox.Switch]}" />
            </StackPanel>
          </Button>

          <Button Command="{Binding Accounts.RenameCommand}"
                  IsEnabled="{Binding HasSelectedAccount}"
                  Content="{Binding Strings[Toolbox.Rename]}" />

          <Button Command="{Binding Accounts.DeleteCommand}"
                  IsEnabled="{Binding HasSelectedAccount}"
                  Content="{Binding Strings[Toolbox.Delete]}" />

          <Button Command="{Binding Accounts.ReloadCommand}"
                  Content="{Binding Strings[Toolbox.Refresh]}" />
        </StackPanel>

        <!-- 账号列表 + 空态 -->
        <Border Grid.Row="1" Classes="card" Padding="8">
          <Panel>
            <ListBox ItemsSource="{Binding Accounts.Accounts}"
                     SelectedItem="{Binding Accounts.Selected, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     IsVisible="{Binding HasAccounts}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="oldvm:SavedAccountViewModel">
                  <Grid ColumnDefinitions="*,Auto" Height="48">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="tertiary" Text="{Binding Detail}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="tertiary"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Text="{Binding SavedAt}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空态：没有保存的账号 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" MaxWidth="360"
                        IsVisible="{Binding IsAccountsEmpty}">
              <Border Width="72" Height="72" CornerRadius="36"
                      HorizontalAlignment="Center"
                      Background="{StaticResource StarControlFillBrush}"
                      BorderBrush="{StaticResource StarCardStrokeBrush}"
                      BorderThickness="1">
                <TextBlock Classes="icon" FontSize="32"
                           Foreground="{StaticResource StarTextTertiary}"
                           Text="&#xE77B;" />
              </Border>
              <TextBlock HorizontalAlignment="Center" FontSize="16"
                         Text="{Binding Strings[Toolbox.NoAccounts]}" />
              <TextBlock Classes="tertiary" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap"
                         Text="{Binding Strings[Toolbox.NoAccountsDetail]}" />
            </StackPanel>
          </Panel>
        </Border>

        <!-- 当前账号摘要 + 状态 -->
        <StackPanel Grid.Row="2" Spacing="6">
          <Grid ColumnDefinitions="Auto,8,*">
            <TextBlock Grid.Column="0" Classes="tertiary" VerticalAlignment="Center"
                       Text="{Binding Strings[Toolbox.CurrentAccount]}" />
            <TextBlock Grid.Column="2" Classes="secondary" TextWrapping="Wrap"
                       Text="{Binding Accounts.CurrentAccountText}" />
          </Grid>

          <TextBlock Classes="tertiary" TextWrapping="Wrap"
                     Text="{Binding Accounts.StatusText}"
                     IsVisible="{Binding HasAccountStatus}" />

          <Border Classes="infobar error" HorizontalAlignment="Left"
                  IsVisible="{Binding HasAccountError}">
            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Accounts.ErrorText}" />
          </Border>
        </StackPanel>

        <!-- 安全提示（12px Caution） -->
        <Border Grid.Row="4" Classes="infobar warning">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" FontSize="14" VerticalAlignment="Top"
                       Foreground="{StaticResource StarCautionBrush}"
                       Text="&#xE7BA;" />
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource StarCautionBrush}"
                       Text="{Binding Strings[Toolbox.AccountSafety]}" />
          </StackPanel>
        </Border>
      </Grid>
    </Panel>
  </Grid>
</UserControl>
