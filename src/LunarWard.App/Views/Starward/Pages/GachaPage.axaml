<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunarWard.App.ViewModels.Starward"
             xmlns:controls="using:LunarWard.App.Controls"
             xmlns:pages="using:LunarWard.App.Views.Starward.Pages"
             x:Class="LunarWard.App.Views.Starward.Pages.GachaPage"
             x:DataType="vm:GachaPageViewModel">

  <!--
    1:1 复刻 Starward Features/Gacha/GachaLogPage.xaml。
      Row 0 / 44px  页头：标题（GachaTypeText）+ 右侧 UID ComboBox / 更新记录 / 设置 / Pane 按钮
      Row 1 / *     状态行 + InfoBar（LunarWard 追加，Starward 用 ContentDialog/InfoBar 显示进度），
                    下方是 SplitView（Overlay、Pane 在右、OpenPaneLength 508）。
    颜色 / 字号 / 圆角只用 Styles/Starward.axaml 的资源键；页面里新增的尺寸都注了 Starward 出处。
  -->

  <UserControl.Resources>
    <!-- 右侧 Pane 占位卡底色：稀有度色取自 GachaStatsCard.xaml:15-17（素材缺失的占位方案） -->
    <pages:GachaRarityBackgroundConverter x:Key="RarityBackgroundConverter" />
    <x:Double x:Key="StarGachaStatsCardWidth">262</x:Double>
  </UserControl.Resources>

  <Grid RowDefinitions="44,*">

    <!-- ══ 页头（GachaLogPage.xaml:21-24：Height 44） ═══════════════════ -->
    <!-- GachaLogPage.xaml:27-32：标题 = GachaTypeText，Margin 24,0,0,0，20px Bold，垂直居中 -->
    <TextBlock Grid.Row="0"
               Margin="24,0,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               FontSize="20"
               FontWeight="Bold"
               Text="{Binding GachaTypeText}" />

    <!-- GachaLogPage.xaml:35-37：右侧 StackPanel，HorizontalAlignment Right，Spacing 16 -->
    <StackPanel Grid.Row="0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="16">

      <!-- GachaLogPage.xaml:38-43：UID ComboBox，MinWidth 140 -->
      <ComboBox MinWidth="140"
                VerticalAlignment="Center"
                ItemsSource="{Binding UidList}"
                SelectedItem="{Binding SelectUid, Mode=TwoWay}"
                IsEnabled="{Binding HasUids}"
                PlaceholderText="{Binding Strings[Gacha.UidPlaceholder]}" />

      <!--
        GachaLogPage.xaml:44-90：更新记录 SplitButton（Height 32，图标 E72C + 文字）。
        Avalonia 没有 SplitButton，按实现约定用两个拼接按钮：主按钮执行读取，
        右侧小按钮带 MenuFlyout；分隔线用 1px Border 复刻 SplitButton 的内部分隔。
      -->
      <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
        <Button x:Name="Button_UpdateRecords"
                Height="32"
                Padding="11,0"
                CornerRadius="4,0,0,4"
                IsEnabled="{Binding !IsBusy}"
                Command="{Binding FetchCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" FontSize="14" Margin="0,2,0,0" Text="&#xE72C;" />
            <TextBlock Text="{Binding Strings[Gacha.UpdateRecords]}" />
          </StackPanel>
        </Button>
        <Border Width="1"
                Height="20"
                VerticalAlignment="Center"
                Background="{StaticResource StarDividerBrush}" />
        <Button x:Name="Button_UpdateRecordsMenu"
                Height="32"
                Width="32"
                Padding="0"
                CornerRadius="0,4,4,0">
          <TextBlock Classes="icon" FontSize="12" Text="&#xE70D;" />
          <Button.Flyout>
            <MenuFlyout>
              <!-- GachaLogPage.xaml:56-58「更新 (保存的 URL)」 -->
              <MenuItem Header="{Binding Strings[Gacha.UpdateSavedUrl]}"
                        Command="{Binding FetchCommand}" />
              <!-- GachaLogPage.xaml:84「输入 URL」：Starward 打开输入对话框，这里打开 URL Flyout -->
              <MenuItem Header="{Binding Strings[Gacha.InputUrl]}"
                        Click="OnShowInputUrlFlyout" />
              <!--
                Starward「更新 (全部)」是 ForceUpdate；LunarWard 的 FetchAsync 每次都读全部分页，
                所以「重新定位」放在这里（任务要求：重新定位归入更新记录 Flyout 或设置 Flyout）。
              -->
              <MenuItem Header="{Binding Strings[Gacha.Relocate]}"
                        Command="{Binding RelocateCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>

      <!-- GachaLogPage.xaml:91-278：设置按钮（图标 E713 + 文字） + Flyout -->
      <Button Height="32" Padding="11,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon" FontSize="14" Margin="0,2,0,0" Text="&#xE713;" />
          <TextBlock Text="{Binding Strings[Gacha.Settings]}" />
        </StackPanel>
        <Button.Flyout>
          <Flyout>
            <StackPanel MinWidth="200" Spacing="8">
              <!-- GachaLogPage.xaml:103-104「其他设置」 -->
              <TextBlock FontSize="16" Text="{Binding Strings[Gacha.OtherSettings]}" />

              <!-- GachaLogPage.xaml:106-114 复制 URL -->
              <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="OnCopyUrlClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="icon" FontSize="16" Text="&#xE8C8;" />
                  <TextBlock Text="{Binding Strings[Gacha.CopyUrl]}" />
                </StackPanel>
              </Button>

              <!-- GachaLogPage.xaml:116-131 Authkey Timeout 说明 + 打开缓存文件夹 -->
              <TextBlock Margin="0,8,0,0"
                         Classes="secondary"
                         Text="{Binding Strings[Gacha.AuthkeyTimeout]}" />
              <TextBlock Margin="0,-4,0,0"
                         FontSize="12"
                         Classes="secondary"
                         TextWrapping="Wrap"
                         Text="{Binding Strings[Gacha.RestartAfterDeletingCache]}" />
              <!-- Starward 的 DeleteGachaCacheFolderCommand 实际是打开 webCaches 所在目录 -->
              <Button HorizontalAlignment="Stretch" Command="{Binding OpenCacheFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="icon" FontSize="16" Text="&#xEA99;" />
                  <TextBlock Text="{Binding Strings[Gacha.DeleteCacheFolder]}" />
                </StackPanel>
              </Button>

              <!-- GachaLogPage.xaml:133-165 语言 -->
              <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="secondary" Text="{Binding Strings[Gacha.Language]}" />
                <Button Padding="1" VerticalAlignment="Bottom">
                  <TextBlock Classes="icon" FontSize="12" Text="&#xE9CE;" />
                  <Button.Flyout>
                    <Flyout>
                      <TextBlock Text="{Binding Strings[Gacha.LanguageDesc]}"
                                 TextWrapping="Wrap"
                                 MaxWidth="240" />
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBox Grid.Column="0"
                         MinWidth="100"
                         Text="{Binding GachaLanguage, Mode=TwoWay}"
                         IsEnabled="{Binding IsLanguageChangeAvailable}" />
                <Button Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Command="{Binding ChangeGachaLanguageCommand}"
                        IsEnabled="{Binding IsLanguageChangeAvailable}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" FontSize="16" Margin="0,2,0,0" Text="&#xE8FB;" />
                    <TextBlock Text="{Binding Strings[Gacha.Apply]}" />
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock FontSize="12"
                         Classes="secondary"
                         TextWrapping="Wrap"
                         Text="{Binding LanguageHint}" />

              <!-- GachaLogPage.xaml:167-168 分割线（MenuFlyoutSeparator） -->
              <Border Classes="divider" Margin="0,4" />

              <!-- GachaLogPage.xaml:170-236 导入 & 导出（嵌套 Flyout） -->
              <Button HorizontalAlignment="Stretch" Content="{Binding Strings[Gacha.ImportExport]}">
                <Button.Flyout>
                  <Flyout>
                    <StackPanel MinWidth="200" Spacing="8">
                      <!-- GachaLogPage.xaml:175-194 导出为（UIGF/SRGF 说明） -->
                      <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="secondary" Text="{Binding Strings[Gacha.ExportAs]}" />
                        <Button Padding="1" VerticalAlignment="Bottom">
                          <TextBlock Classes="icon" FontSize="12" Text="&#xE9CE;" />
                          <Button.Flyout>
                            <Flyout>
                              <!-- Starward 是指向 https://uigf.org/ 的超链接；Avalonia 这里只显示文字 -->
                              <TextBlock Text="UIGF/SRGF" />
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>

                      <!-- GachaLogPage.xaml:196-214 Excel + 旧版 JSON（UIGF v3.0 / JSON） -->
                      <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                CornerRadius="4,0,0,4"
                                IsEnabled="{Binding IsExcelAvailable}"
                                Command="{Binding ExportExcelCommand}"
                                Content="{Binding Strings[Gacha.ExportExcel]}" />
                        <Button Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                CornerRadius="0,4,4,0"
                                Command="{Binding ExportJsonCommand}"
                                Content="{Binding LegacyFormatName}" />
                      </Grid>

                      <!-- GachaLogPage.xaml:216-225 从旧格式导入（本仓库还没有导入实现） -->
                      <Button HorizontalAlignment="Stretch"
                              Command="{Binding ImportLegacyCommand}"
                              IsEnabled="{Binding IsImportAvailable}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="icon" FontSize="16" Margin="0,2,0,0" Text="&#xEA52;" />
                          <TextBlock Text="{Binding LegacyImportText}" />
                        </StackPanel>
                      </Button>
                      <TextBlock FontSize="12"
                                 Classes="secondary"
                                 TextWrapping="Wrap"
                                 Text="{Binding ImportHint}" />

                      <Border Classes="divider" />

                      <!-- GachaLogPage.xaml:228-232 UIGF v4.2 导出 / 导入窗口 -->
                      <Button HorizontalAlignment="Stretch"
                              IsEnabled="{Binding IsUigfAvailable}"
                              Command="{Binding OpenUigfCommand}"
                              Content="UIGF v4.2" />
                      <TextBlock FontSize="12"
                                 Classes="secondary"
                                 TextWrapping="Wrap"
                                 Text="{Binding UigfHint}" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <!-- GachaLogPage.xaml:238-254 隐藏卡池（ListView 多选 → 这里用 CheckBox 复刻同一语义） -->
              <Button HorizontalAlignment="Stretch" Content="{Binding Strings[Gacha.HideBanners]}">
                <Button.Flyout>
                  <Flyout>
                    <StackPanel MinWidth="200" Spacing="8">
                      <TextBlock FontSize="12"
                                 Classes="secondary"
                                 TextWrapping="Wrap"
                                 Text="{Binding Strings[Gacha.HideBannersHint]}" />
                      <ItemsControl ItemsSource="{Binding BannerOptions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GachaBannerViewModel">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Content="{Binding Text}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <!-- GachaLogPage.xaml:256-274 删除记录（红色） -->
              <Button HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="icon"
                             FontSize="14"
                             Foreground="{StaticResource StarErrorBrush}"
                             Text="&#xE74D;" />
                  <TextBlock Foreground="{StaticResource StarErrorBrush}"
                             Text="{Binding Strings[Gacha.DeleteRecords]}" />
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="{Binding Strings[Gacha.DeleteAll]}"
                              Command="{Binding ClearRecordsCommand}" />
                    <!-- GachaLogPage.xaml:256-274 → DeleteGachaLogDialog（UID + 时间段） -->
                    <MenuItem Header="{Binding Strings[Gacha.DeleteByTime]}"
                              Command="{Binding DeleteByTimeCommand}"
                              IsEnabled="{Binding HasRecords}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>

      <!--
        GachaLogPage.xaml:279-289：Pane 按钮（Height 32、BorderThickness 0、
        CornerRadius 14,0,0,14、强调色、图标 E8A0），数据不具备时禁用。
      -->
      <Button Height="32"
              Padding="11,0"
              BorderThickness="0"
              Classes="accent"
              CornerRadius="14,0,0,14"
              Command="{Binding ToggleItemStatsPaneCommand}"
              IsEnabled="{Binding HasItemStats}">
        <TextBlock Classes="icon"
                   FontSize="18"
                   Margin="6,2,4,0"
                   Foreground="{StaticResource StarAccentForegroundBrush}"
                   Text="&#xE8A0;" />
      </Button>
    </StackPanel>

    <!-- ══ 内容区（GachaLogPage.xaml:308-470 SplitView） ═══════════════════ -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*">

      <!-- 状态行 + InfoBar（LunarWard 追加；位置在页头正下方，不另造卡片） -->
      <StackPanel Grid.Row="0"
                  Margin="20,4,20,8"
                  Spacing="8"
                  IsVisible="{Binding ShowStatusArea}">
        <TextBlock FontSize="12"
                   Foreground="{StaticResource StarTextSecondary}"
                   Text="{Binding StatusText}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasStatus}" />
        <Border Classes="infobar error" IsVisible="{Binding HasError}">
          <TextBlock FontSize="12"
                     Foreground="{StaticResource StarErrorBrush}"
                     Text="{Binding ErrorText}"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <!--
        GachaLogPage.xaml:308-315：SplitView，Overlay、OpenPaneLength 508、Pane 在右、
        PaneBackground = CustomOverlayAcrylicBrush、CornerRadius 12,0,0,12。
        Avalonia 的 SplitView 没有 CornerRadius，用同样圆角的 Border 包一层并裁剪。
      -->
      <Border Grid.Row="1" CornerRadius="12,0,0,12" ClipToBounds="True">
        <SplitView DisplayMode="Overlay"
                   OpenPaneLength="508"
                   PanePlacement="Right"
                   PaneBackground="{StaticResource StarOverlayAcrylicBrush}"
                   IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
                   Background="Transparent">

          <!-- GachaLogPage.xaml:318-357：ScrollViewer + Grid Margin 20,0,20,16 + 横向 StackPanel Spacing 12 -->
          <ScrollViewer x:Name="ScrollViewer_GachaStats"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
            <Grid x:Name="Grid_GachaStats"
                  Margin="20,0,20,16"
                  Background="Transparent">
              <!--
                Starward GachaLogPage.xaml:318-357 用 x:Load 在
                GachaStatsCard / ZZZGachaStatsCard 之间切换（IsZZZGachaStatsCardVisible）。
                Avalonia 这里改成两个等价的 ItemsControl，各自绑同一个 Pools，用 IsVisible 互斥。
              -->
              <ItemsControl x:Name="ItemsControl_GachaStats"
                            ItemsSource="{Binding Pools}"
                            IsVisible="{Binding ShowGenericStatsCard}">
                <!-- Starward 的 StackPanel 会把每张卡拉到同一高度（最宽内容决定），这里显式拉伸容器 -->
                <ItemsControl.ItemContainerTheme>
                  <ControlTheme TargetType="ContentPresenter">
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                  </ControlTheme>
                </ItemsControl.ItemContainerTheme>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GachaPoolCardViewModel">
                    <!-- 宽度由页面代码按 Starward GachaLogPage.xaml.cs:393-413 的公式算好放进资源 -->
                    <controls:GachaStatsCard Width="{DynamicResource StarGachaStatsCardWidth}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl x:Name="ItemsControl_ZzzGachaStats"
                            ItemsSource="{Binding Pools}"
                            IsVisible="{Binding ShowZzzStatsCard}">
                <ItemsControl.ItemContainerTheme>
                  <ControlTheme TargetType="ContentPresenter">
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                  </ControlTheme>
                </ItemsControl.ItemContainerTheme>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GachaPoolCardViewModel">
                    <controls:ZZZGachaStatsCard Width="{DynamicResource StarGachaStatsCardWidth}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </ScrollViewer>

          <!-- GachaLogPage.xaml:360-467：Pane = 材料统计 GridView（80 宽卡片，图标 + 次数） -->
          <SplitView.Pane>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <Border Padding="24,12,24,12">
                <ItemsControl ItemsSource="{Binding ItemStats}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GachaItemStatsViewModel">
                    <Grid Width="80" Height="97" Margin="4,2">
                      <!--
                        Starward 用 RarityToGIBgConverter 的稀有度底图 + CachedImage 图标；
                        素材缺失：保留 80×97 卡片，用稀有度色半透明底 + 名称 + 次数占位。
                      -->
                      <Border Background="{Binding RankType, Converter={StaticResource RarityBackgroundConverter}}"
                              CornerRadius="4" />
                      <!--
                        Starward GachaLogPage.xaml:373-376：图标 80 高贴顶、左下圆角 16；
                        有图标时不再显示名称（上游同样只有图标 + 次数），没图标时退回名称占位。
                      -->
                      <Border Height="64"
                              Margin="8,6,8,20"
                              VerticalAlignment="Top"
                              CornerRadius="0,0,12,0"
                              ClipToBounds="True"
                              IsVisible="{Binding HasIcon}">
                        <Image Stretch="Uniform" Source="{Binding Icon}" />
                      </Border>
                      <TextBlock Margin="4,0"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap"
                                 MaxLines="3"
                                 IsVisible="{Binding !HasIcon}"
                                 Text="{Binding Name}" />
                      <TextBlock Margin="0,0,0,3"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 FontSize="12"
                                 Foreground="{StaticResource StarTextSecondary}"
                                 Text="{Binding CountText}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </ScrollViewer>
          </SplitView.Pane>
        </SplitView>
      </Border>
    </Grid>

    <!--
      GachaLogPage.xaml:292-305：没有记录时整页居中的空态（160 图 + 16px 文案）。
      Starward 显示派蒙 / 帕姆 / 邦布表情图；LunarWard 没有这些素材，用 160 图标占位。
    -->
    <StackPanel Grid.Row="0"
                Grid.RowSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                IsVisible="{Binding ShowEmptyState}">
      <Border Width="160"
              Height="160"
              CornerRadius="80"
              Background="{StaticResource StarControlFillBrush}">
        <TextBlock Classes="icon"
                   FontSize="64"
                   Foreground="{StaticResource StarTextTertiary}"
                   Text="&#xE734;" />
      </Border>
      <TextBlock HorizontalAlignment="Center"
                 FontSize="16"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="{Binding Strings[Gacha.NoRecords]}" />
    </StackPanel>

    <!--
      输入 URL 的 Flyout 宿主：Starward 用 ContentDialog（GachaLogPage.xaml.cs InputUrlCommand）。
      这里按任务要求把「输入 URL」放进更新记录的 Flyout，隐藏按钮只作为 Flyout 的锚点。
    -->
    <Button x:Name="Button_InputUrlHost" IsVisible="False" Width="0" Height="0">
      <Button.Flyout>
        <Flyout Placement="Bottom">
          <StackPanel MinWidth="360" Spacing="8">
            <TextBlock FontSize="16" Text="{Binding Strings[Gacha.InputUrl]}" />
            <TextBox Text="{Binding GachaUrl}"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     PlaceholderText="{Binding Strings[Gacha.UrlPlaceholder]}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding Strings[Gacha.Relocate]}"
                      Command="{Binding RelocateCommand}"
                      Click="OnCloseInputUrlFlyout" />
              <Button Classes="accent"
                      Content="{Binding Strings[Gacha.Fetch]}"
                      Command="{Binding FetchCommand}"
                      Click="OnCloseInputUrlFlyout" />
            </StackPanel>
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>
  </Grid>
</UserControl>
