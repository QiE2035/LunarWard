<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunarWard.App.ViewModels.Starward"
             x:Class="LunarWard.App.Views.Starward.Pages.GameLauncherPage"
             x:DataType="vm:GameLauncherPageViewModel">

  <!--
    复刻 Starward Features/GameLauncher/GameLauncherPage.xaml。
    坐标全部是相对内容区（x=56 起）的偏移，和 Starward 的 Margin 一致：
      公告卡   左 60、底 40，380×304
      开始按钮 右 40、底 40，高 44 胶囊
      时长胶囊 紧挨开始按钮左侧，ColumnSpacing 12
      便笺等    右上角纵向栈，Margin 4
  -->

  <Grid x:Name="RootGrid" Background="Transparent">

    <!-- ── 公告卡（GameBannerAndPost） ───────────────────────────── -->
    <Border Width="380" Height="304"
          Margin="60,0,0,40"
          HorizontalAlignment="Left"
          VerticalAlignment="Bottom"
          CornerRadius="8"
          Background="{StaticResource StarAcrylicBrush}"
          ClipToBounds="True"
          IsVisible="{Binding HasContent}">
      <Grid RowDefinitions="176,*" RowSpacing="4">

      <!-- Banner（FlipView 等价物：单张 Image + PipsPager） -->
      <Grid x:Name="BannerHost"
            PointerEntered="OnBannerPointerEntered"
            PointerExited="OnBannerPointerExited"
            Cursor="Hand"
            Tapped="OnBannerTapped">
        <Image Source="{Binding CurrentBanner.Image}" Stretch="UniformToFill" />
        <Border Padding="10,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8,0,8,0"
                IsVisible="{Binding ShowBannerCounter}">
          <TextBlock FontSize="14" Foreground="{StaticResource StarTextSecondary}" Text="{Binding BannerCounterText}" />
        </Border>
      </Grid>

      <!-- 活动 / 公告 / 资讯（Pivot 等价物：表头 + 列表） -->
      <Grid Grid.Row="1" RowDefinitions="36,*">
        <ItemsControl Grid.Row="0" ItemsSource="{Binding Posts}" Margin="12,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="0" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PostGroupViewModel">
              <Button Background="Transparent" Padding="0" MinHeight="36" Height="36"
                      BorderThickness="0"
                      Command="{Binding $parent[UserControl].((vm:GameLauncherPageViewModel)DataContext).SelectPivotCommand}"
                      CommandParameter="{Binding}">
                <Panel Height="36">
                  <TextBlock Classes="pivot-header" Margin="12,0"
                             VerticalAlignment="Center"
                             Text="{Binding Header}" />
                  <Border Height="3" CornerRadius="1.5" Margin="12,0"
                          VerticalAlignment="Bottom"
                          Background="{StaticResource StarAccentBrush}"
                          IsVisible="{Binding IsSelected}" />
                </Panel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 游戏公告铃铛（Starward Pivot.RightHeader） -->
        <Button Grid.Row="0" Grid.Column="0"
                Width="36" Height="32" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,8,0"
                Background="Transparent"
                Command="{Binding OpenInGameNoticesCommand}"
                ToolTip.Tip="{Binding Strings[Launcher.GameNotices]}">
          <Panel>
            <TextBlock Classes="icon" FontSize="18" Text="&#xE789;" Foreground="{StaticResource StarTextSecondary}" />
            <Ellipse Width="8" Height="8" Fill="#FFE81123"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,2,4,0"
                     IsVisible="{Binding HasNoticeAlert}" />
          </Panel>
        </Button>

        <ScrollViewer Grid.Row="1" Margin="12,2,0,0" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding CurrentPosts}" Margin="0,0,16,8">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PostItemViewModel">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,0,0,8">
                  <TextBlock Grid.Column="0"
                             VerticalAlignment="Center"
                             Text="{Binding Title}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource StarTextSecondary}"
                             Text="{Binding Date}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
      </Grid>
    </Border>

    <!-- 没有拿到资讯时的轻提示（Starward 离线时整卡隐藏，这里同构但不留白坑） -->
    <TextBlock Margin="76,0,0,40"
               HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Classes="tertiary"
               Text="{Binding ContentStatus}"
               IsVisible="{Binding !HasContent}" />

    <!-- 拖放图片/视频文件提醒（Starward Border_BackgroundDragIn：顶部居中、24 内边、圆角 8） -->
    <Border x:Name="BackgroundDragInOverlay"
            Margin="0,40,0,0"
            Padding="24"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            CornerRadius="8"
            Background="{StaticResource StarOverlayAcrylicBrush}"
            IsHitTestVisible="False"
            IsVisible="{Binding IsDragOverlayVisible}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Classes="icon" FontSize="24" Foreground="{StaticResource StarTextSecondary}" Text="&#xE91B;" />
        <TextBlock VerticalAlignment="Center"
                   FontSize="16"
                   Foreground="{StaticResource StarTextSecondary}"
                   Text="{Binding Strings[Launcher.DropBackground]}" />
      </StackPanel>
    </Border>

    <!-- ── 右下：安装进度弹层 + 时长胶囊 + 开始按钮 ─────────────────── -->
    <StackPanel Margin="0,0,40,40"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Spacing="8">

      <!--
        Starward StartGameButton 的 Popup_GameInfoOrDownloadProgress：
        安装/下载时在按钮上方浮出 320 宽的进度卡（状态 + 百分比 + 速度 + 暂停/继续/取消）。
      -->
      <Border Width="320"
              Padding="16,12"
              HorizontalAlignment="Right"
              CornerRadius="8"
              Background="{StaticResource StarAcrylicBrush}"
              BorderBrush="{StaticResource StarCardStrokeBrush}"
              BorderThickness="1"
              BoxShadow="0 8 16 0 #33000000"
              IsVisible="{Binding IsInstalling}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Foreground="{StaticResource StarTextPrimary}"
                     Text="{Binding InstallStatusText}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" FontSize="12" Foreground="{StaticResource StarTextSecondary}"
                       Text="{Binding InstallDetailText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource StarTextSecondary}"
                       Text="{Binding InstallPercentText}" VerticalAlignment="Center" />
          </Grid>
          <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding InstallProgress}"
                       Foreground="{StaticResource StarAccentBrush}"
                       Background="#24FFFFFF" CornerRadius="2" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{Binding Strings[InstallGameDialog.Pause]}"
                    Command="{Binding PauseInstallCommand}"
                    IsVisible="{Binding !InstallCanResume}" />
            <Button Content="{Binding Strings[InstallGameDialog.Resume]}"
                    Command="{Binding ResumeInstallCommand}"
                    IsVisible="{Binding InstallCanResume}" />
            <Button Content="{Binding Strings[InstallGameDialog.Cancel]}"
                    Command="{Binding CancelInstallCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12" HorizontalAlignment="Right">

      <Border Grid.Column="0"
              Height="44"
              CornerRadius="22"
              BoxShadow="0 8 16 0 #33000000"
              Background="{StaticResource StarOverlayAcrylicBrush}">
        <Button Background="Transparent" BorderThickness="0" Padding="16,0" MinHeight="44" CornerRadius="22"
                Click="OnPlayTimeClick">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="icon" FontSize="20" Text="&#xE823;" Foreground="{StaticResource StarTextSecondary}" />
            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource StarTextSecondary}" Text="{Binding PlayTimeText}" />
          </StackPanel>
        </Button>
      </Border>

      <!-- Starward StartGameButton：44 高胶囊，可用时强调色底 -->
      <Grid Grid.Column="1" Height="44" MinWidth="180">
        <Border CornerRadius="22" Background="{StaticResource StarAcrylicBrush}" />
        <Border CornerRadius="22"
                Background="{StaticResource StarAccentBrush}"
                IsVisible="{Binding IsAccentBackground}" />

        <Button Padding="0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="Transparent" BorderThickness="0"
                CornerRadius="22"
                Command="{Binding StartGameCommand}"
                IsEnabled="{Binding IsStartButtonEnabled}">
          <Grid>
            <Border Width="20" Height="20" Margin="14,0,0,0"
                    HorizontalAlignment="Left"
                    CornerRadius="10"
                    IsVisible="{Binding IsBusy}">
              <Arc Width="18" Height="18" Stroke="{StaticResource StarTextSecondary}" StrokeThickness="2" StartAngle="0" SweepAngle="270" />
            </Border>
            <TextBlock Margin="41,0,53,0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{Binding StartButtonForeground}"
                       Text="{Binding StartButtonText}" />
          </Grid>
        </Button>

        <!-- 游戏设置齿轮（Starward Button_Setting，前景跟随强调色底） -->
        <Button Width="44" Height="44" Padding="0"
                HorizontalAlignment="Right"
                Background="Transparent" BorderThickness="0" CornerRadius="22"
                Command="{Binding OpenGameSettingsCommand}"
                ToolTip.Tip="{Binding Strings[Shell.GameSetting]}">
          <TextBlock Classes="icon" FontSize="16" Text="&#xE713;" Foreground="{Binding SettingButtonForeground}" />
        </Button>
      </Grid>
      </Grid>
    </StackPanel>

    <!-- 用 DX12 启动（Starward 右下角 CompactCheckBox；Linux 落 profile.enhancements.dx12 → -use-d3d12） -->
    <Border Margin="0,0,44,16"
            Padding="10,0"
            Height="32"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            CornerRadius="12"
            Background="{StaticResource StarOverlayAcrylicBrush}"
            IsVisible="{Binding ShowDx12Option}"
            ToolTip.Tip="{Binding Strings[Launcher.Dx12Hint]}">
      <CheckBox IsChecked="{Binding EnableDx12, Mode=TwoWay}"
                Content="{Binding Strings[Launcher.EnableDx12]}"
                FontSize="12"
                Foreground="{StaticResource StarTextSecondary}" />
    </Border>

    <!-- 定位游戏 / 未配置（Starward 在按钮正下方一行 12px 小字） -->
    <Button Classes="link"
            Margin="0,0,44,18"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Foreground="{StaticResource StarCautionBrush}"
            IsVisible="{Binding ShowLocateGame}"
            Command="{Binding OpenGameSettingsCommand}">
      <TextBlock FontSize="12" Foreground="{StaticResource StarCautionBrush}">
        <Run Foreground="{StaticResource StarTextSecondary}" Text="{Binding Strings[Launcher.Installed]}" />
        <Run Text=" " />
        <Run Text="{Binding Strings[Launcher.LocateGame]}" />
      </TextBlock>
    </Button>

    <Button Classes="link"
            Margin="0,0,44,18"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            IsVisible="{Binding ShowNotConfigured}"
            Command="{Binding OpenGameSettingsCommand}">
      <TextBlock FontSize="12" Foreground="{StaticResource StarCautionBrush}" Text="{Binding Strings[Launcher.ConfigureGame]}" />
    </Button>

    <!--
      ── 右上：每日便笺（Starward DailyNoteButton.xaml：40×40、圆角 8、Flyout 左对齐）──
      结构照源码：刷新 → 角色行 → 分隔线 → 错误行 → 原神/绝区零分区。
      BH3/星铁分区不出现（LunarWard 不支持；Starward 也按 IsXxxEnabled 隐藏）。
    -->
    <Button x:Name="Button_DailyNote"
            Classes="icon-button"
            Margin="4"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            ToolTip.Tip="{Binding Strings[Main.DailyNote]}">
      <Panel Width="40" Height="40">
        <Border CornerRadius="8" Background="{StaticResource StarOverlayAcrylicBrush}" />
        <TextBlock Classes="icon" FontSize="20" Text="&#xE823;" />
      </Panel>
      <Button.Flyout>
        <Flyout Placement="LeftEdgeAlignedTop" Opened="OnDailyNoteFlyoutOpened">
          <Grid x:Name="DailyNoteFlyoutRoot"
                x:DataType="vm:DailyNoteButtonViewModel"
                MinWidth="180"
                MaxWidth="340"
                RowDefinitions="Auto,Auto,Auto,*">

            <!-- 刷新（DailyNoteButton.xaml:53-65） -->
            <Button Grid.Row="0"
                    Margin="-8,0,0,0"
                    Padding="4"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="4"
                    Command="{Binding RefreshCommand}"
                    ToolTip.Tip="{Binding Strings[DailyNote.Refresh]}">
              <TextBlock Classes="icon"
                         FontSize="14"
                         Foreground="{StaticResource StarTextSecondary}"
                         Text="&#xE72C;" />
            </Button>

            <!-- 角色信息（DailyNoteButton.xaml:68-84） -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,28,0"
                        Orientation="Horizontal"
                        Spacing="12">
              <Border Width="40" Height="40"
                      CornerRadius="20"
                      Background="{StaticResource StarControlFillBrush}">
                <TextBlock Classes="icon"
                           FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource StarTextSecondary}"
                           Text="&#xE77B;" />
              </Border>
              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Nickname}" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="12" Foreground="{StaticResource StarTextSecondary}">
                  <Run Text="{Binding RegionText}" />
                </TextBlock>
              </StackPanel>
            </StackPanel>

            <!-- 分隔线（DailyNoteButton.xaml:87 MenuFlyoutSeparator Margin 0,8） -->
            <Border Grid.Row="1" Height="1" Margin="0,8" Background="{StaticResource StarDividerBrush}" />

            <!-- 错误 / 无凭据（DailyNoteButton.xaml:90-95） -->
            <StackPanel Grid.Row="2" Spacing="8">
              <TextBlock HorizontalAlignment="Center"
                         FontSize="12"
                         Foreground="{StaticResource StarTextSecondary}"
                         TextWrapping="Wrap"
                         Text="{Binding StatusText}"
                         IsVisible="{Binding !HasCredentials}" />
              <Button HorizontalAlignment="Center"
                      Height="28"
                      Padding="10,0"
                      Content="{Binding Strings[DailyNote.OpenToolbox]}"
                      Command="{Binding OpenToolboxCommand}"
                      IsVisible="{Binding !HasCredentials}" />
              <TextBlock HorizontalAlignment="Center"
                         FontSize="12"
                         Foreground="{StaticResource StarTextSecondary}"
                         TextWrapping="Wrap"
                         Text="{Binding ErrorText}"
                         IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <!-- ══ 原神（DailyNoteButton.xaml:100-260） ══ -->
            <Grid Grid.Row="3"
                  Margin="0,8,0,0"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="4"
                  IsVisible="{Binding ShowGenshin}">

              <!-- 树脂 60×60（:105-115） -->
              <StackPanel Grid.RowSpan="4">
                <Border Width="60" Height="60"
                        CornerRadius="30"
                        Background="{StaticResource StarControlFillBrush}">
                  <TextBlock Classes="icon"
                             FontSize="28"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{StaticResource StarTextSecondary}"
                             Text="&#xE823;" />
                </Border>
                <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold">
                  <Run Text="{Binding PrimaryCurrent}" /><Run Text="/" /><Run Text="{Binding PrimaryMax}" />
                </TextBlock>
              </StackPanel>

              <!-- 每日委托奖励（:118-138） -->
              <TextBlock Grid.Row="0" Grid.Column="1"
                         Margin="0,0,0,0"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding Strings[DailyNote.Commission]}" />
              <TextBlock Grid.Row="0" Grid.Column="2"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="12"
                         IsVisible="{Binding !Genshin.IsExtraTaskRewardReceived}">
                <Run Text="{Binding Genshin.FinishedTaskNum}" /><Run Text="/" /><Run Text="{Binding Genshin.TotalTaskNum}" />
              </TextBlock>
              <TextBlock Grid.Row="0" Grid.Column="2"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="14"
                         Foreground="{StaticResource StarSuccessBrush}"
                         Text="&#xE930;"
                         IsVisible="{Binding Genshin.IsExtraTaskRewardReceived}" />

              <!-- 洞天宝钱（:196-210） -->
              <TextBlock Grid.Row="1" Grid.Column="1"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding Strings[DailyNote.HomeCoin]}" />
              <TextBlock Grid.Row="1" Grid.Column="2"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="12">
                <Run Text="{Binding Genshin.CurrentHomeCoin}" /><Run Text="/" /><Run Text="{Binding Genshin.MaxHomeCoin}" />
              </TextBlock>

              <!-- 探索派遣（:214-228） -->
              <TextBlock Grid.Row="2" Grid.Column="1"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding Strings[DailyNote.Expedition]}" />
              <TextBlock Grid.Row="2" Grid.Column="2"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="12">
                <Run Text="{Binding Genshin.CurrentExpeditionNum}" /><Run Text="/" /><Run Text="{Binding Genshin.MaxExpeditionNum}" />
              </TextBlock>

              <!-- 周本减半（LunarWard 的便笺汇总里有；Starward 只在札记里） -->
              <TextBlock Grid.Row="3" Grid.Column="1"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding Strings[DailyNote.ResinDiscount]}" />
              <TextBlock Grid.Row="3" Grid.Column="2"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="12">
                <Run Text="{Binding Genshin.RemainResinDiscountNum}" /><Run Text="/" /><Run Text="{Binding Genshin.ResinDiscountNumLimit}" />
              </TextBlock>
            </Grid>

            <!-- ══ 绝区零（DailyNoteButton.xaml:262-700） ══ -->
            <Grid Grid.Row="3"
                  Margin="0,8,0,0"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="4"
                  IsVisible="{Binding ShowZzz}">

              <!-- 电量（:270-300） -->
              <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                <Border Width="40" Height="40"
                        CornerRadius="20"
                        Background="{StaticResource StarControlFillBrush}">
                  <TextBlock Classes="icon"
                             FontSize="20"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{StaticResource StarTextSecondary}"
                             Text="&#xE823;" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontSize="15">
                    <Run Text="{Binding PrimaryCurrent}" /><Run Text="/" /><Run Text="{Binding PrimaryMax}" />
                  </TextBlock>
                  <TextBlock FontSize="12" Foreground="{StaticResource StarTextSecondary}"
                             Text="{Binding RecoveryText}" />
                </StackPanel>
              </StackPanel>

              <!-- 绳网会员（:302-322） -->
              <TextBlock Grid.Row="1" Grid.Column="0"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding Strings[DailyNote.MemberCard]}"
                         IsVisible="{Binding Zzz.MemberCardOpen}" />
              <TextBlock Grid.Row="1" Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="12"
                         IsVisible="{Binding Zzz.MemberCardOpen}">
                <Run Text="{Binding Zzz.MemberCardRemainingDays}" /><Run Text="d" />
              </TextBlock>

              <!-- 每日任务（:324-340） -->
              <TextBlock Grid.Row="2" Grid.Column="0"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding Strings[DailyNote.DailyMissions]}" />
              <TextBlock Grid.Row="2" Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="14"
                         Foreground="{StaticResource StarSuccessBrush}"
                         Text="&#xE930;"
                         IsVisible="{Binding Zzz.IsDailyMissionComplete}" />

              <!-- 今日活跃度（:342-356） -->
              <TextBlock Grid.Row="3" Grid.Column="0"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding Strings[DailyNote.Vitality]}" />
              <TextBlock Grid.Row="3" Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="12">
                <Run Text="{Binding Zzz.VitalityCurrent}" /><Run Text="/" /><Run Text="{Binding Zzz.VitalityMax}" />
              </TextBlock>

              <!-- 刮刮卡（:358-374） -->
              <TextBlock Grid.Row="4" Grid.Column="0"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding Strings[DailyNote.ScratchCard]}" />
              <TextBlock Grid.Row="4" Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Foreground="{StaticResource StarSuccessBrush}"
                         Text="{Binding Strings[DailyNote.Completed]}"
                         IsVisible="{Binding Zzz.IsCardSignDone}" />
              <TextBlock Grid.Row="4" Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Foreground="{StaticResource StarCautionBrush}"
                         Text="{Binding Strings[DailyNote.Incomplete]}"
                         IsVisible="{Binding !Zzz.IsCardSignDone}" />

              <!-- 录像店经营（:376-398） -->
              <TextBlock Grid.Row="5" Grid.Column="0"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding Strings[DailyNote.VideoStore]}" />
              <TextBlock Grid.Row="5" Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding Strings[DailyNote.Operating]}"
                         IsVisible="{Binding Zzz.IsVideoStoreOperating}" />
              <TextBlock Grid.Row="5" Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding Strings[DailyNote.NotOperating]}"
                         IsVisible="{Binding Zzz.IsVideoStoreIdle}" />
              <TextBlock Grid.Row="5" Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding Strings[DailyNote.Completed]}"
                         IsVisible="{Binding Zzz.IsVideoStoreDone}" />

              <!-- 悬赏委托（:400-430） -->
              <TextBlock Grid.Row="6" Grid.Column="0"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding Strings[DailyNote.Bounty]}"
                         IsVisible="{Binding Zzz.HasBounty}" />
              <TextBlock Grid.Row="6" Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="12"
                         IsVisible="{Binding Zzz.HasBounty}">
                <Run Text="{Binding Zzz.BountyCommissionNum}" /><Run Text="/" /><Run Text="{Binding Zzz.BountyCommissionTotal}" />
              </TextBlock>

              <!-- 丽都周纪（:432-465） -->
              <TextBlock Grid.Row="7" Grid.Column="0"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Text="{Binding Strings[DailyNote.WeeklyTask]}"
                         IsVisible="{Binding Zzz.HasWeeklyTask}" />
              <TextBlock Grid.Row="7" Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         FontSize="12"
                         IsVisible="{Binding Zzz.HasWeeklyTask}">
                <Run Text="{Binding Zzz.WeeklyTaskCur}" /><Run Text="/" /><Run Text="{Binding Zzz.WeeklyTaskMax}" />
              </TextBlock>
            </Grid>
          </Grid>
        </Flyout>
      </Button.Flyout>
    </Button>

    <!-- ── 游戏账号切换（Starward GameAccountSwitcher，Margin 0,0,40,100，40 高亚克力胶囊） ── -->
    <StackPanel IsVisible="{Binding IsAccountSwitcherVisible}"
                Margin="0,0,40,100"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="16">
      <Border Height="40" CornerRadius="20" Background="{StaticResource StarAcrylicBrush}">
        <ComboBox Height="40" MinWidth="200" BorderThickness="0" Background="Transparent"
                  ItemsSource="{Binding GameAccounts}"
                  SelectedItem="{Binding SelectedGameAccount}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LauncherAccountItem">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Uid}"
                           FontSize="12"
                           Foreground="{StaticResource StarTextSecondary}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Border>
      <Border Height="40" CornerRadius="20" Background="{StaticResource StarAcrylicBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <Button Height="40" BorderThickness="0" Background="Transparent"
                  CornerRadius="20,0,0,20"
                  Command="{Binding ChangeGameAccountCommand}"
                  IsEnabled="{Binding CanChangeGameAccount}"
                  ToolTip.Tip="{Binding AccountStatusText}">
            <TextBlock Margin="8,0,0,0" Text="{Binding Strings[Launcher.SwitchAccount]}" />
          </Button>
          <Button Grid.Column="1" Height="40" BorderThickness="0" Background="Transparent"
                  CornerRadius="0,20,20,0"
                  Command="{Binding OpenAccountManagerCommand}"
                  ToolTip.Tip="{Binding Strings[Launcher.ManageAccount]}">
            <TextBlock Classes="icon" FontSize="14" Margin="0,0,4,0" Text="&#xE70F;" />
          </Button>
        </Grid>
      </Border>
    </StackPanel>

    <!-- ── 底部背景切换条（悬停 60px 区域出现） ─────────────────── -->
    <Panel x:Name="BackgroundBarHost"
           Height="60"
           VerticalAlignment="Bottom"
           PointerEntered="OnBackgroundBarPointerEntered"
           PointerExited="OnBackgroundBarPointerExited"
           PointerWheelChanged="OnBackgroundBarPointerWheelChanged">
      <Border IsVisible="{Binding ShowBackgroundBar}"
              VerticalAlignment="Stretch"
              PointerEntered="OnBackgroundBarPointerEntered"
              PointerExited="OnBackgroundBarPointerExited">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#00000000" />
            <GradientStop Offset="1" Color="#88000000" />
          </LinearGradientBrush>
        </Border.Background>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="16,0,0,4"
                    Orientation="Horizontal" Spacing="4">
          <!-- 圆点指示器（Starward PipsPager：选中 8 号字形、普通 6 号；这里用可点的圆点） -->
          <StackPanel x:Name="PipsPanel" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2" />

          <Border Width="1" Height="16" Margin="4,0" Background="#44FFFFFF" />

          <!-- 图库（Starward OpenBackgroundViewWindow；Linux 等价为打开背景目录） -->
          <Button Classes="overlay" Padding="6" MinWidth="28"
                  Command="{Binding OpenBackgroundFolderCommand}"
                  ToolTip.Tip="{Binding Strings[Launcher.Gallery]}">
            <TextBlock Classes="icon" Text="&#xE91B;" Foreground="{StaticResource StarTextSecondary}" />
          </Button>
          <!-- 复制 -->
          <Button Classes="overlay" Padding="6" MinWidth="28"
                  Click="OnCopyBackgroundClick"
                  ToolTip.Tip="{Binding Strings[Launcher.Copy]}">
            <TextBlock Classes="icon" Text="&#xE8C8;" Foreground="{StaticResource StarTextSecondary}" />
          </Button>
          <!-- 另存为 -->
          <Button Classes="overlay" Padding="6" MinWidth="28"
                  Click="OnSaveBackgroundClick"
                  ToolTip.Tip="{Binding Strings[Launcher.SaveAs]}">
            <TextBlock Classes="icon" Text="&#xE74E;" Foreground="{StaticResource StarTextSecondary}" />
          </Button>
          <!-- 播放/暂停（仅视频背景，Starward Visibility={x:Bind CanStopVideo}） -->
          <Button Classes="overlay" Padding="6" MinWidth="28"
                  IsVisible="{Binding CanToggleVideo}"
                  Command="{Binding ToggleVideoCommand}"
                  ToolTip.Tip="{Binding Strings[Launcher.PlayPause]}">
            <TextBlock Classes="icon" Text="{Binding VideoToggleGlyph}" Foreground="{StaticResource StarTextSecondary}" />
          </Button>
        </StackPanel>
      </Border>
    </Panel>

    <!-- 错误提示（启动失败时 Starward 用 Toast；这里用同位置的小条） -->
    <Border Margin="0,0,0,100"
            HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Classes="infobar error"
            MaxWidth="600"
            IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
    </Border>

  </Grid>
</UserControl>
