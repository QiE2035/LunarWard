<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunarWard.App.ViewModels.Starward"
             xmlns:local="using:LunarWard.App.Views.Starward.Pages"
             xmlns:scs="using:LunarWard.Core.SelfQuery"
             x:Class="LunarWard.App.Views.Starward.Pages.SelfQueryPage"
             x:DataType="vm:SelfQueryPageViewModel">

  <!--
    复刻 Starward Features/SelfQuery/SelfQueryPage.xaml（266 行，1:1 结构）：
      Grid RowDefinitions 44/Auto/* + ColumnDefinitions Auto/*
      Row0 页头（源码 26-34 行）：标题 24,0,0,0 / 20 Bold；
           右侧 StackPanel（:36-49）Margin 0,0,24,0 Right Spacing 16：
           ComboBox_Uid（MinWidth 140）+ 「输入 URL」（AccentButtonStyle、BorderThickness 0）
      Row1 用户信息卡（:52-75）：Margin 28,0,28,8 / Padding 8 / CustomOverlayAcrylicBrush /
           CornerRadius 4；40×40 圆角 20 的游戏图标 + 昵称 + UID(12px 次要色)
      Row2 类型统计 ListBox（:78-139）：Container Margin 0,4,0,4 / Padding 4,0,4,0；
           每行 Grid Padding 8 +  acrylic + 圆角 4 + ColumnSpacing 8；
           图标 40×40、收入(成功色)/支出(错误色) 14px、进度环 24 + 页码 12px（更新中）、
           32×32 刷新按钮（Glyph E895）
      右侧详情（:142-260）：Row1..2 / Column1 / RowSpacing 12；
           顶栏 Margin 20,0,0,0 Spacing 24：名称 16px + 月份 ComboBox(120) + 本月收支 +
           「删除本月数据」+「重新获取所有数据」；
           下面三个 ListBox（原神/星铁/绝区零各一，Padding 0,0,0,12，SelectionMode None）。
    差异（已记录在 docs/08-UI-PARITY.md）：
      · Starward 的 ProgressRing 在 Avalonia 没有对应控件，用 Arc 静态画环（不旋转）；
      · 类型图标在 Starward 是 Assets 里的 PNG，LunarWard 没有这批素材，用字形占位；
      · 游戏图标同样是字形占位。
  -->

  <UserControl.Resources>
    <local:SelfQueryStatsNumberConverter x:Key="SelfQueryStatsNumberConverter" />
    <local:SelfQueryStatsNumberBrushConverter x:Key="SelfQueryStatsNumberBrushConverter" />
    <local:SelfQueryStringToVisibilityConverter x:Key="SelfQueryStringToVisibilityConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 源码 :84-88 DefaultListBoxItemStyle 的覆盖：Margin 0,4,0,4 / Padding 4,0,4,0 -->
    <Style Selector="ListBox.typeStats ListBoxItem">
      <Setter Property="Margin" Value="0,4,0,4" />
      <Setter Property="Padding" Value="4,0,4,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="44,Auto,*" ColumnDefinitions="Auto,*">

    <!-- Row0：标题 -->
    <TextBlock Margin="24,0,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               FontSize="20"
               FontWeight="Bold"
               Text="{Binding Strings[SelfQuery.AccountRecords]}" />

    <!-- Row0：UID 选择 + 输入 URL -->
    <StackPanel Grid.ColumnSpan="2"
                Margin="0,0,24,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="16">
      <ComboBox MinWidth="140"
                VerticalAlignment="Center"
                ItemsSource="{Binding UidList}"
                SelectedItem="{Binding SelectUid}" />
      <Button BorderThickness="0"
              Classes="accent"
              Command="{Binding InputURLCommand}"
              Content="{Binding Strings[SelfQuery.InputURL]}" />
    </StackPanel>


    <!-- Row1：用户信息卡 -->
    <Border Grid.Row="1"
            Margin="28,0,28,8"
            Padding="8"
            Background="{StaticResource StarOverlayAcrylicBrush}"
            CornerRadius="4"
            IsVisible="{Binding HasQueryUserInfo}">
      <Grid ColumnDefinitions="Auto,*">
        <Border Width="40"
                Height="40"
                Margin="4,0,0,0"
                HorizontalAlignment="Left"
                Background="{StaticResource StarCardBackgroundBrush}"
                CornerRadius="20">
          <TextBlock Classes="icon large"
                     Foreground="{StaticResource StarTextSecondary}"
                     Text="{Binding GameIconGlyph}" />
        </Border>
        <StackPanel Grid.Column="1"
                    Margin="56,0,0,0"
                    VerticalAlignment="Center"
                    Spacing="2">
          <TextBlock Text="{Binding QueryUserInfo.Nickname}" />
          <TextBlock FontSize="12"
                     Foreground="{StaticResource StarTextSecondary}"
                     Text="{Binding QueryUserInfo.Uid}" />
        </StackPanel>
      </Grid>
    </Border>


    <!-- Row2：类型统计 -->
    <ListBox Grid.Row="2"
              Margin="24,0,24,0"
              Classes="typeStats"
              ItemsSource="{Binding TypeStatsList}"
              SelectedItem="{Binding SelectTypeStats}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:QueryTypeStats">
          <Border Padding="8"
                  Background="{StaticResource StarOverlayAcrylicBrush}"
                  CornerRadius="4">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" MinWidth="32" />
            </Grid.ColumnDefinitions>

            <!-- 图标：Starward 是 40×40 PNG，这里用同尺寸字形占位 -->
            <Border Width="40"
                    Height="40"
                    Background="{StaticResource StarCardBackgroundBrush}"
                    CornerRadius="4">
              <TextBlock Classes="icon large"
                         FontSize="20"
                         Foreground="{StaticResource StarTextSecondary}"
                         Text="{Binding IconGlyph}" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Left"
                         FontSize="14"
                         Foreground="{StaticResource StarSuccessBrush}"
                         Text="{Binding AddText}" />
              <TextBlock HorizontalAlignment="Left"
                         FontSize="14"
                         Foreground="{StaticResource StarErrorBrush}"
                         Text="{Binding SubText}" />
            </StackPanel>

            <!-- 更新中：进度环（Arc 静态）+ 页码 -->
            <Grid Grid.Column="2" IsVisible="{Binding IsUpdating}">
              <Arc Width="24"
                   Height="24"
                   StartAngle="0"
                   SweepAngle="270"
                   Stroke="{StaticResource StarAccentBrush}"
                   StrokeThickness="2"
                   StrokeLineCap="Round" />
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="12"
                         Foreground="{StaticResource StarTextSecondary}"
                         Text="{Binding Page}" />
            </Grid>

            <Button Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding $parent[ListBox].((vm:SelfQueryPageViewModel)DataContext).UpdateItemCommand}"
                    CommandParameter="{Binding}"
                    IsVisible="{Binding !IsUpdating}"
                    ToolTip.Tip="{Binding Name}">
              <TextBlock Classes="icon"
                         Foreground="{StaticResource StarTextSecondary}"
                         Text="&#xE895;" />
            </Button>
          </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>


    <!-- 右侧详情：名称 / 月份 / 本月收支 / 删除 / 重新获取 -->
    <Grid Grid.Row="1"
          Grid.RowSpan="2"
          Grid.Column="1"
          RowSpacing="12"
          IsVisible="{Binding SelectTypeStats, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>

      <StackPanel Margin="20,0,0,0"
                  Orientation="Horizontal"
                  Spacing="24">
        <TextBlock VerticalAlignment="Center"
                   FontSize="16"
                   Text="{Binding SelectTypeStats.Name}" />
        <ComboBox Width="120"
                  ItemsSource="{Binding TypeStatsMonthList}"
                  SelectedItem="{Binding SelectTypeStatsMonth}" />
        <TextBlock VerticalAlignment="Center"
                   Foreground="{StaticResource StarSuccessBrush}"
                   Text="{Binding MonthAddText}" />
        <TextBlock VerticalAlignment="Center"
                   Foreground="{StaticResource StarErrorBrush}"
                   Text="{Binding MonthSubText}" />
        <Button Command="{Binding DeleteCurrentMonthDataCommand}"
                Content="{Binding Strings[SelfQuery.DeleteThisMonth]}" />
        <Button Command="{Binding UpdateAllQueryItemsCommand}"
                Content="{Binding Strings[SelfQuery.RetrieveAll]}" />
      </StackPanel>


      <!-- 原神明细 -->
      <ScrollViewer Grid.Row="1" Padding="0,0,0,12" IsVisible="{Binding IsGenshin}">
      <ItemsControl ItemsSource="{Binding GenshinQueryItemList}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="scs:GenshinQueryItem">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Width="160"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource StarTextSecondary}"
                         Text="{Binding DateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
              <TextBlock Width="220"
                         VerticalAlignment="Center"
                         Text="{Binding Reason}"
                         TextWrapping="Wrap" />
              <TextBlock Width="220"
                         VerticalAlignment="Center"
                         Text="{Binding Name}"
                         IsVisible="{Binding Name, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBlock VerticalAlignment="Center"
                         Foreground="{Binding AddNum, Converter={StaticResource SelfQueryStatsNumberBrushConverter}}"
                         Text="{Binding AddNum, Converter={StaticResource SelfQueryStatsNumberConverter}}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>

      <!-- 星穹铁道明细 -->
      <ScrollViewer Grid.Row="1" Padding="0,0,0,12" IsVisible="{Binding IsStarRail}">
      <ItemsControl ItemsSource="{Binding StarRailQueryItemList}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="scs:StarRailQueryItem">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Width="160"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource StarTextSecondary}"
                         Text="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
              <TextBlock Width="240"
                         VerticalAlignment="Center"
                         Text="{Binding Action}"
                         TextWrapping="Wrap" />
              <TextBlock Width="220"
                         VerticalAlignment="Center"
                         Text="{Binding EquipmentName}"
                         IsVisible="{Binding EquipmentName, Converter={StaticResource SelfQueryStringToVisibilityConverter}}" />
              <TextBlock Width="220"
                         VerticalAlignment="Center"
                         Text="{Binding RelicName}"
                         IsVisible="{Binding RelicName, Converter={StaticResource SelfQueryStringToVisibilityConverter}}" />
              <TextBlock VerticalAlignment="Center"
                         Foreground="{Binding AddNum, Converter={StaticResource SelfQueryStatsNumberBrushConverter}}"
                         Text="{Binding AddNum, Converter={StaticResource SelfQueryStatsNumberConverter}}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>

      <!-- 绝区零明细 -->
      <ScrollViewer Grid.Row="1" Padding="0,0,0,12" IsVisible="{Binding IsZZZ}">
      <ItemsControl ItemsSource="{Binding ZZZQueryItemList}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="scs:ZZZQueryItem">
            <StackPanel Orientation="Horizontal" Spacing="16">
              <TextBlock Width="160"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource StarTextSecondary}"
                         Text="{Binding DateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
              <TextBlock Width="220"
                         VerticalAlignment="Center"
                         Text="{Binding Reason}"
                         TextWrapping="Wrap" />
              <TextBlock Width="220"
                         VerticalAlignment="Center"
                         Text="{Binding EquipName}"
                         IsVisible="{Binding EquipName, Converter={StaticResource SelfQueryStringToVisibilityConverter}}" />
              <TextBlock Width="220"
                         VerticalAlignment="Center"
                         Text="{Binding WeaponName}"
                         IsVisible="{Binding WeaponName, Converter={StaticResource SelfQueryStringToVisibilityConverter}}" />
              <TextBlock VerticalAlignment="Center"
                         Foreground="{Binding AddNum, Converter={StaticResource SelfQueryStatsNumberBrushConverter}}"
                         Text="{Binding AddNum, Converter={StaticResource SelfQueryStatsNumberConverter}}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>

    </Grid>

  </Grid>

</UserControl>
