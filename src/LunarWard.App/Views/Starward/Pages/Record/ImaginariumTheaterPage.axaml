<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LunarWard.App.ViewModels.Starward"
             xmlns:pages="using:LunarWard.App.Views.Starward.Pages"
             x:Class="LunarWard.App.Views.Starward.Pages.Record.ImaginariumTheaterPage"
             x:DataType="vm:ImaginariumTheaterPageViewModel">

  <!--
    1:1 复刻 Starward Features/GameRecord/Genshin/ImaginariumTheaterPage.xaml（669 行）。
      Row 0 / Auto  左栏：刷新胶囊（0,18,18,0）
      Row 1 / *     左栏：各期列表（日期 / 难度·幕数 / 星章数）
      右侧：统计周期 + 演出回顾卡 + 战斗统计卡 + 参演名单卡（每幕：星章/幕名/时间 + 阵容 + Buff）
    素材说明：Starward 的勋章/星章/幻剧之花/爱心 PNG 未打包，用同色系圆章 + 星形字形占位；
    头像与 Buff 图标来自米游社 CDN（CachedImage 的等价物是 Image + URL 下载）。
  -->

  <UserControl.Resources>
    <pages:GachaRarityBackgroundConverter x:Key="RarityBackgroundConverter" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

    <!-- ══ 空态（Starward Image_Emoji + 暂无数据） ══════════════════════ -->
    <StackPanel Grid.RowSpan="2"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                IsVisible="{Binding ShowEmpty}">
      <Border Width="160"
              Height="160"
              CornerRadius="80"
              Background="{StaticResource StarControlFillBrush}">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="64"
                   Foreground="{StaticResource StarTextTertiary}"
                   Text="&#xE7BA;" />
      </Border>
      <TextBlock HorizontalAlignment="Center"
                 FontSize="16"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="{Binding Strings[Common.NoData]}" />
    </StackPanel>

    <!-- ══ 左栏：刷新（Starward Margin="0,24,0,0"） ═════════════════════ -->
    <StackPanel Margin="0,24,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Spacing="12">
      <Button Height="36"
              BorderThickness="0"
              Classes="accent"
              CornerRadius="0,18,18,0"
              Command="{Binding RefreshCommand}">
        <StackPanel Margin="4,0,4,0" Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon" FontSize="16" Text="&#xE72C;" />
          <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Common.Refresh]}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- ══ 左栏：各期列表（Starward ListView_TheaterList） ═══════════════ -->
    <ListBox Grid.Row="1"
             Margin="0,12,0,0"
             Padding="12,0,12,0"
             Background="Transparent"
             ItemsSource="{Binding TheaterList}"
             SelectedItem="{Binding CurrentTheater, Mode=TwoWay}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="4,0" />
          <Setter Property="Margin" Value="0,4" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TheaterPeriodItem">
          <Border Padding="12,8"
                  Background="{StaticResource StarOverlayAcrylicBrush}"
                  CornerRadius="4">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
            <TextBlock Text="{Binding DateText}" />
            <Grid Grid.Row="1">
              <!-- 勋章 PNG 缺失：同色系圆章 + 字形占位（Starward HeraldryImage） -->
              <Border Width="20"
                      Height="20"
                      HorizontalAlignment="Left"
                      Background="{Binding MedalColor}"
                      CornerRadius="10">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="#1F1408"
                           Text="&#x2726;" />
              </Border>
              <TextBlock Margin="24,0,0,2"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource StarTextSecondary}"
                         Text="{Binding ActOfMaxText}" />
              <TextBlock Margin="64,0,0,2"
                         VerticalAlignment="Center"
                         FontSize="20"
                         Foreground="#E4C891"
                         Text="&#x2605;" />
              <TextBlock Margin="88,0,0,2"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource StarTextSecondary}"
                         Text="{Binding MedalText}" />
            </Grid>
          </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- ══ 右侧详情（Starward ScrollViewer Grid.RowSpan=2 Grid.Column=1） ══ -->
    <ScrollViewer Grid.RowSpan="2" Grid.Column="1" IsVisible="{Binding HasData}">
      <StackPanel Margin="12,24,24,24" Spacing="8">

        <Grid>
          <TextBlock HorizontalAlignment="Right"
                     Foreground="{StaticResource StarTextSecondary}"
                     Text="{Binding PeriodText}" />
          <TextBlock FontSize="16"
                     Foreground="{StaticResource StarTextSecondary}"
                     Text="{Binding Strings[Theater.PastPerformances]}" />
        </Grid>

        <!-- ══ 演出回顾（Starward Padding="24,0,24,0"，5×32 行 + 4*/3* 列） ══ -->
        <Border Padding="24,0"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                BoxShadow="0 4 16 0 #40000000">
          <Grid RowDefinitions="32,32,32,32,32" ColumnDefinitions="4*,3*">
            <Border Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="-24,0"
                    Background="{StaticResource StarDividerBrush}" />
            <Border Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="-24,0"
                    Background="{StaticResource StarDividerBrush}" />

            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{Binding Strings[Theater.BestRecord]}" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{Binding Strings[Theater.StarChallengeStellas]}" />
            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding Strings[Theater.FantasiaFlowersUsed]}" />
            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="{Binding Strings[Theater.ExternalAudienceSupport]}" />
            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="{Binding Strings[Theater.SupportingCastAssist]}" />

            <!-- 最佳纪录：难度圆章 + 模式 + 幕数；月谕模式追加圣牌数 -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Border Width="28"
                      Height="28"
                      Background="{Binding HeraldryColor}"
                      CornerRadius="14">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#1F1408"
                           Text="&#x2726;" />
              </Border>
              <TextBlock VerticalAlignment="Center" Text="{Binding BestRecordText}" />
              <TextBlock VerticalAlignment="Center"
                         IsVisible="{Binding LunarVisible}"
                         Text="{Binding ArcanaText}" />
            </StackPanel>

            <!-- 明星挑战星章：逐幕星形（金 = 已点亮，暗 = 未点亮） -->
            <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding MedalStars}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TheaterStarItem">
                  <Grid Width="20" Height="20">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Foreground="#33FFFFFF"
                               Text="&#x2605;" />
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Foreground="#E4C891"
                               IsVisible="{Binding IsGold}"
                               Text="&#x2605;" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBlock VerticalAlignment="Center"
                         FontSize="20"
                         Foreground="#E4C891"
                         Text="&#x273F;" />
              <TextBlock VerticalAlignment="Center" Text="{Binding CoinText}" />
            </StackPanel>
            <TextBlock Grid.Row="3"
                       Grid.Column="1"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding AvatarBonusText}" />
            <TextBlock Grid.Row="4"
                       Grid.Column="1"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding RentText}" />
          </Grid>
        </Border>

        <!-- ══ 战斗统计（Starward Margin="0,8,0,0"） ═══════════════════════ -->
        <Border Margin="0,8,0,0"
                Padding="24,0"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                BoxShadow="0 4 16 0 #40000000"
                IsVisible="{Binding HasFightStats}">
          <Grid RowDefinitions="32,32,32,32,32" ColumnDefinitions="4*,3*">
            <Border Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="-24,0"
                    Background="{StaticResource StarDividerBrush}" />
            <Border Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Margin="-24,0"
                    Background="{StaticResource StarDividerBrush}" />

            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{Binding Strings[Theater.TotalDuration]}" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{Binding Strings[Theater.HighestDamage]}" />
            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{Binding Strings[Theater.MostDefeats]}" />
            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="{Binding Strings[SpiralAbyss.MostDamageTaken]}" />
            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="{Binding Strings[Theater.FastestTeam]}" />

            <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding TotalDurationText}" />

            <!-- Starward CachedImage Width=44 Height=36 Margin="-12,-4,0,4" -->
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding HasMaxDamageAvatar}">
              <Grid Width="44" Height="36" Margin="-12,-4,0,4">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="20"
                           Foreground="#66FFFFFF"
                           Text="&#xE77B;" />
                <Image Source="{Binding MaxDamageAvatar.Icon}" Stretch="UniformToFill" />
              </Grid>
              <TextBlock VerticalAlignment="Center" Text="{Binding MaxDamageAvatar.Value}" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding HasMaxDefeatAvatar}">
              <Grid Width="44" Height="36" Margin="-12,-4,0,4">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="20"
                           Foreground="#66FFFFFF"
                           Text="&#xE77B;" />
                <Image Source="{Binding MaxDefeatAvatar.Icon}" Stretch="UniformToFill" />
              </Grid>
              <TextBlock VerticalAlignment="Center" Text="{Binding MaxDefeatAvatar.Value}" />
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding HasMaxTakeDamageAvatar}">
              <Grid Width="44" Height="36" Margin="-12,-4,0,4">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="20"
                           Foreground="#66FFFFFF"
                           Text="&#xE77B;" />
                <Image Source="{Binding MaxTakeDamageAvatar.Icon}" Stretch="UniformToFill" />
              </Grid>
              <TextBlock VerticalAlignment="Center" Text="{Binding MaxTakeDamageAvatar.Value}" />
            </StackPanel>
            <ItemsControl Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ShortestAvatars}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TheaterFightAvatarItem">
                  <Grid Width="44" Height="36" Margin="-12,-4,0,4">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Foreground="#66FFFFFF"
                               Text="&#xE77B;" />
                    <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <!-- ══ 参演名单（Starward Padding="24,12,24,12" + ItemsRepeater） ═══ -->
        <Border Margin="0,8,0,0"
                Padding="24,12"
                Background="{StaticResource StarOverlayAcrylicBrush}"
                CornerRadius="8"
                BoxShadow="0 4 16 0 #40000000">
          <ItemsControl ItemsSource="{Binding Rounds}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="16" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TheaterRoundItem">
                <Grid RowDefinitions="28,*" ColumnDefinitions="Auto,*" ColumnSpacing="24" RowSpacing="4">

                  <!-- 第几幕：星章 + 幕名 / 圣牌挑战 + 完成时间 -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Grid Width="24" Height="24">
                      <TextBlock HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="24"
                                 Foreground="#33FFFFFF"
                                 Text="&#x2605;" />
                      <TextBlock HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="24"
                                 Foreground="#E4C891"
                                 IsVisible="{Binding IsGetMedal}"
                                 Text="&#x2605;" />
                    </Grid>
                    <TextBlock VerticalAlignment="Center" FontSize="16" Text="{Binding TitleText}" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource StarTextSecondary}"
                               Text="{Binding FinishText}" />
                  </StackPanel>

                  <!-- 阵容 80×97（稀有度底 + 头像 + Lv 文字） -->
                  <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Avatars}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TheaterAvatarItem">
                        <Grid Width="80" Height="97">
                          <!-- 稀有度底图缺失：RarityToGIBgConverter 的等价占位底色 -->
                          <Border Background="{Binding Rarity, Converter={StaticResource RarityBackgroundConverter}}" />
                          <TextBlock HorizontalAlignment="Center"
                                     VerticalAlignment="Top"
                                     Margin="0,26,0,0"
                                     FontSize="32"
                                     Foreground="#66FFFFFF"
                                     Text="&#xE77B;" />
                          <Border Height="80"
                                  VerticalAlignment="Top"
                                  CornerRadius="0,0,12,0"
                                  ClipToBounds="True">
                            <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                          </Border>
                          <TextBlock HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     Foreground="#84603D"
                                     Text="{Binding LevelText}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Buff：辉彩祝福 / 奇妙助益 / 神秘收获（Starward 三段，均 32×32 图标） -->
                  <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Spacing="8">

                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4" IsVisible="{Binding HasSplendourBuff}">
                      <TextBlock Foreground="{StaticResource StarTextSecondary}" Text="{Binding Strings[Theater.BrilliantBlessing]}" />
                      <TextBlock Grid.Row="1"
                                 FontSize="12"
                                 Foreground="{StaticResource StarTextSecondary}"
                                 Text="{Binding SplendourDesc}"
                                 TextWrapping="Wrap" />
                      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
                        <ItemsControl ItemsSource="{Binding SplendourBuffs}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="16" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TheaterBuffItem">
                              <StackPanel>
                                <Grid Width="32" Height="32">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           Foreground="#66FFFFFF"
                                           Text="&#x2726;" />
                                <Image Opacity="{Binding IconOpacity}" Source="{Binding Icon}">
                                  <ToolTip.Tip>
                                    <StackPanel Margin="8" MaxWidth="260" Spacing="4">
                                      <TextBlock FontSize="14" Text="{Binding Name}" />
                                      <TextBlock FontSize="12"
                                                 Foreground="{StaticResource StarTextSecondary}"
                                                 Text="{Binding LevelText}" />
                                      <ItemsControl ItemsSource="{Binding TooltipLines}">
                                        <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="x:String">
                                            <TextBlock FontSize="12"
                                                       Foreground="{StaticResource StarTextSecondary}"
                                                       Text="{Binding}"
                                                       TextWrapping="Wrap" />
                                          </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                      </ItemsControl>
                                    </StackPanel>
                                  </ToolTip.Tip>
                                </Image>
                                </Grid>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4" IsVisible="{Binding HasWondrousBuffs}">
                      <TextBlock Foreground="{StaticResource StarTextSecondary}" Text="{Binding WondrousTitle}" />
                      <ItemsControl ItemsSource="{Binding WondrousBuffs}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TheaterBuffItem">
                            <Grid Width="32" Height="32">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="#66FFFFFF"
                                       Text="&#x2726;" />
                            <Image Source="{Binding Icon}">
                              <ToolTip.Tip>
                                <StackPanel Margin="8" MaxWidth="260" Spacing="4">
                                  <TextBlock FontSize="14" Text="{Binding Name}" />
                                  <ItemsControl ItemsSource="{Binding TooltipLines}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="x:String">
                                        <TextBlock FontSize="12"
                                                   Foreground="{StaticResource StarTextSecondary}"
                                                   Text="{Binding}"
                                                   TextWrapping="Wrap" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </ToolTip.Tip>
                            </Image>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding HasChoiceCards}">
                      <TextBlock Foreground="{StaticResource StarTextSecondary}" Text="{Binding ChoiceTitle}" />
                      <ItemsControl ItemsSource="{Binding ChoiceCards}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:TheaterBuffItem">
                            <Grid Width="32" Height="32">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="#66FFFFFF"
                                       Text="&#x2726;" />
                            <Image Source="{Binding Icon}">
                              <ToolTip.Tip>
                                <StackPanel Margin="8" MaxWidth="260" Spacing="4">
                                  <TextBlock FontSize="14" Text="{Binding Name}" />
                                  <ItemsControl ItemsSource="{Binding TooltipLines}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="x:String">
                                        <TextBlock FontSize="12"
                                                   Foreground="{StaticResource StarTextSecondary}"
                                                   Text="{Binding}"
                                                   TextWrapping="Wrap" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </ToolTip.Tip>
                            </Image>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <TextBlock FontSize="12"
                   Foreground="{StaticResource StarErrorBrush}"
                   IsVisible="{Binding HasError}"
                   Text="{Binding ErrorText}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
