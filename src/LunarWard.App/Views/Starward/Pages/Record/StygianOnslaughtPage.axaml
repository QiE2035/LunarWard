<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:LunarWard.App.Views.Starward.Pages"
             xmlns:vm="using:LunarWard.App.ViewModels.Starward"
             x:Class="LunarWard.App.Views.Starward.Pages.Record.StygianOnslaughtPage"
             x:DataType="vm:StygianOnslaughtPageViewModel">

  <!--
    幽境危战页：逐行对照 Starward Features/GameRecord/Genshin/StygianOnslaughtPage.xaml。
    结构 = 左栏（刷新 + 各期列表） + 右侧（统计周期 / 最佳记录 + 单人·多人 / 每个 Boss 卡片）。
    Starward 用本地 PNG（难度勋章、元素底图）与 Segmented 控件；LunarWard 没有这些素材：
    - 难度勋章 → 同色数字圆章占位（DifficultyColor，见 VM 注释）；
    - Segmented → 两个 Button 以 Classes.selected 表示选中态（IsSinglePlayer / CanSelectMultiPlayer）。
  -->
  <UserControl.Resources>
    <pages:GachaRarityBackgroundConverter x:Key="RarityBackgroundConverter" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">

    <!-- ══ 空态（Starward Image_Emoji：派蒙 + 暂无数据） ═══════════════ -->
    <StackPanel Grid.RowSpan="2"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                IsVisible="{Binding ShowEmpty}">
      <Border Width="160"
              Height="160"
              CornerRadius="80"
              Background="{StaticResource StarControlFillBrush}">
        <TextBlock HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="64"
                   Foreground="{StaticResource StarTextTertiary}"
                   Text="&#xE7BA;" />
      </Border>
      <TextBlock HorizontalAlignment="Center"
                 FontSize="16"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="{Binding Strings[Common.NoData]}" />
    </StackPanel>

    <!-- ══ 左栏：刷新（Starward StackPanel Margin="0,24,0,0"） ═════════ -->
    <StackPanel Margin="0,24,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Spacing="12">
      <Button Height="36"
              BorderThickness="0"
              Classes="accent"
              CornerRadius="0,18,18,0"
              Command="{Binding RefreshCommand}">
        <StackPanel Margin="4,0,4,0" Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon" FontSize="16" Text="&#xE72C;" />
          <TextBlock VerticalAlignment="Center" Text="{Binding Strings[Common.Refresh]}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- ══ 左栏：各期列表 ═══════════════════════════════════════════════ -->
    <ListBox Grid.Row="1"
             Margin="0,12,0,0"
             Padding="12,0,12,0"
             Background="Transparent"
             ItemsSource="{Binding PeriodList}"
             SelectedItem="{Binding CurrentPeriod, Mode=TwoWay}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="4,0" />
          <Setter Property="Margin" Value="0,4" />
          <Setter Property="CornerRadius" Value="4" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:StygianPeriodItem">
          <Border Padding="12,8"
                  Background="{StaticResource StarOverlayAcrylicBrush}"
                  CornerRadius="4">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding DateText}" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <!-- Starward: CachedImage DifficultyToImage(Difficulty) 28x28（本地勋章 PNG，缺素材 → 数字圆章） -->
                <Border Width="28"
                        Height="28"
                        CornerRadius="14"
                        Background="{Binding DifficultyColor}">
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="#1A1A1A"
                             Text="{Binding Difficulty}" />
                </Border>
                <TextBlock Margin="4,0,0,2"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource StarTextSecondary}"
                           Text="{Binding SecondText}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- ══ 右侧详情（Starward ScrollViewer Grid.Column="1"，StackPanel Width=700） ═ -->
    <ScrollViewer Grid.RowSpan="2"
                  Grid.Column="1"
                  IsVisible="{Binding HasData}">
      <StackPanel Width="700" Margin="24" Spacing="8">

        <!-- 统计周期 -->
        <TextBlock Foreground="{StaticResource StarTextSecondary}" Text="{Binding PeriodText}" />

        <Grid ColumnDefinitions="*,Auto">

          <!-- 最佳记录 -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="{StaticResource StarTextSecondary}"
                       Text="{Binding Strings[Stygian.BestRecord]}" />
            <!-- Starward: CachedImage DifficultyToImage(Best.Difficulty) 24x24（占位同上） -->
            <Border Width="24"
                    Height="24"
                    Margin="8,0,0,0"
                    CornerRadius="12"
                    Background="{Binding BestDifficultyColor}"
                    IsVisible="{Binding BestDifficulty, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="#1A1A1A"
                         Text="{Binding BestDifficulty}" />
            </Border>
            <TextBlock Margin="4,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Text="{Binding BestSecondsText}" />
          </StackPanel>

          <!-- 单人 / 多人（Starward Segmented_PlayerMode） -->
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="2"
                      VerticalAlignment="Center">
            <Button Classes="segmented"
                    Classes.selected="{Binding IsSinglePlayer}"
                    Command="{Binding SelectSinglePlayerCommand}"
                    Content="{Binding Strings[Stygian.SinglePlayer]}" />
            <Button Classes="segmented"
                    Classes.selected="{Binding !IsSinglePlayer}"
                    Command="{Binding SelectMultiPlayerCommand}"
                    IsEnabled="{Binding CanSelectMultiPlayer}"
                    Content="{Binding Strings[Stygian.CoOp]}" />
          </StackPanel>
        </Grid>

        <!-- 每个 Boss 一张卡（Starward ItemsControl Spacing=20） -->
        <ItemsControl ItemsSource="{Binding Challenges}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="20" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StygianChallengeItem">
              <Border Padding="24,12"
                      Background="{StaticResource StarOverlayAcrylicBrush}"
                      CornerRadius="8"
                      BoxShadow="0 4 16 0 #40000000">
              <Grid RowSpacing="8"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    ColumnDefinitions="356,2*">

                <!-- 怪物名称 -->
                <TextBlock FontSize="16" Text="{Binding MonsterName}" />

                <!-- 战斗用时 -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                  <TextBlock Foreground="{StaticResource StarTextSecondary}"
                             Text="{Binding Strings[Stygian.BattleTime]}" />
                  <TextBlock Foreground="{StaticResource StarTextSecondary}" Text="{Binding SecondsText}" />
                </StackPanel>

                <!-- 阵容（Starward 80x97，稀有度底 + Rank 角标 + Lv） -->
                <ItemsControl Grid.Row="2"
                              Grid.Column="0"
                              MinHeight="73"
                              Margin="0,4,0,8"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding Teams}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StygianAvatarItem">
                      <Grid Width="80" Height="97">
                        <Border Background="{Binding Rarity, Converter={StaticResource RarityBackgroundConverter}}" />
                        <Border VerticalAlignment="Top"
                                CornerRadius="0,0,12,0"
                                ClipToBounds="True">
                          <Panel>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="28"
                                       Foreground="{StaticResource StarTextTertiary}"
                                       Text="&#xE77B;" />
                            <Image Height="80" Stretch="Uniform" Source="{Binding Icon}" />
                          </Panel>
                        </Border>
                        <Border Padding="4,0,4,2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{StaticResource StarControlFillBrush}"
                                CornerRadius="0,4,0,4"
                                IsVisible="{Binding HasRank}">
                          <TextBlock Foreground="{StaticResource StarTextSecondary}" Text="{Binding Rank}" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   FontSize="14"
                                   Foreground="#84603D"
                                   Text="{Binding LevelText}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 怪物立绘（Starward CachedImage RowSpan=4 Height=220 Margin=-12） -->
                <Panel Grid.Row="0"
                       Grid.RowSpan="4"
                       Grid.Column="1"
                       Height="220"
                       Margin="0,-12,0,-12">
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontSize="72"
                             Foreground="{StaticResource StarTextTertiary}"
                             Text="&#xE7BA;" />
                  <Image Stretch="Uniform" Source="{Binding MonsterImage}" />
                </Panel>

                <!-- 怪物等级 + 描述 -->
                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal"
                            Spacing="4">
                  <Border Padding="8,2"
                          VerticalAlignment="Center"
                          Background="{StaticResource StarControlFillBrush}"
                          CornerRadius="8">
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource StarTextSecondary}"
                               Text="{Binding MonsterLevelText}" />
                  </Border>
                  <Button Padding="0"
                          VerticalAlignment="Center"
                          BorderThickness="0"
                          CornerRadius="8">
                    <Border Padding="4"
                            Background="{StaticResource StarControlFillBrush}">
                      <TextBlock Classes="icon"
                                 FontSize="14"
                                 Foreground="{StaticResource StarTextSecondary}"
                                 Text="&#xE721;" />
                    </Border>
                    <Button.Flyout>
                      <Flyout>
                        <ItemsControl Width="360" ItemsSource="{Binding MonsterDesc}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Foreground="{StaticResource StarTextSecondary}"
                                         Text="{Binding}"
                                         TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>

                <!-- 最强一击 / 最高总伤（Starward ItemsControl Grid.Row=3 ColSpan=2 Spacing=16） -->
                <ItemsControl Grid.Row="3"
                              Grid.ColumnSpan="2"
                              ItemsSource="{Binding BestAvatars}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="16" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StygianBestAvatarItem">
                      <StackPanel Orientation="Horizontal">
                        <Panel Width="40" Height="40" Margin="0,-16,0,0">
                          <TextBlock HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="20"
                                     Foreground="{StaticResource StarTextTertiary}"
                                     Text="&#xE7BA;" />
                          <Image Stretch="Uniform" Source="{Binding SideIcon}" />
                        </Panel>
                        <TextBlock Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource StarTextSecondary}"
                                   Text="{Binding TypeText}" />
                        <TextBlock Margin="8,0,0,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="{Binding DpsText}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Foreground="#FF6B6B"
                   Text="{Binding ErrorText}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasError}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
