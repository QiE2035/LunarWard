<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LunarWard.App.ViewModels.Starward"
             mc:Ignorable="d"
             x:Class="LunarWard.App.Views.Starward.Pages.GenshinBeyondGachaPage"
             x:DataType="vm:GenshinBeyondGachaPageViewModel">

  <!--
    千星奇域颂愿 —— Starward `Features/Gacha/GenshinBeyondGachaPage.xaml`（637 行）。

    布局：
      Row 0 / 44px  页头：标题「千星奇域颂愿」+ 右侧 UID ComboBox / 更新记录 / 设置 / 材料统计 Pane 按钮
      Row 1 / *     空态（居中图标 + 「没有抽卡记录」）或 SplitView（右侧 Pane = 材料统计）

    内容区是两张统计卡（常驻颂愿 1000 / 活动颂愿 2000）横向并排，
    每张卡上是「标题 + 抽数、起止时间、四行统计（平均/统计）、两个页签（保底列表）」。
    与源码的差异：
      - Pivot + Segmented → 两个按钮切换（Avalonia 无 Segmented 控件）。
      - 列表图标（远程 PNG）→ 只显示名称（App 内无远程图片加载控件，与 GachaPage 取舍一致）。
      - 统计卡背景的 ThemeShadow/Translation → 只有圆角与亚克力底（Avalonia 阴影在 Border 上表现不同）。
  -->

  <UserControl.Resources>

    <!-- Starward GenshinBeyondGachaPage.xaml:16-19：四档稀有度前景色 -->
    <SolidColorBrush x:Key="BeyondRarity5Brush" Color="#FFA500" />
    <SolidColorBrush x:Key="BeyondRarity4Brush" Color="#C864E0" />
    <SolidColorBrush x:Key="BeyondRarity3Brush" Color="#5EAAED" />
    <SolidColorBrush x:Key="BeyondRarity2Brush" Color="#3BA272" />

  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.beyond-text">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground" Value="{StaticResource StarTextSecondary}" />
    </Style>

    <Style Selector="Button.beyond-tab">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="44,*">

    <!-- ══ 页头（GenshinBeyondGachaPage.xaml:36-166） ══════════════════ -->
    <TextBlock Margin="24,0,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               FontSize="20"
               FontWeight="Bold"
               Text="{Binding PageTitle}" />

    <StackPanel Margin="0,0,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">

      <!-- GenshinBeyondGachaPage.xaml:58-62：UID 列表，MinWidth 140 -->
      <ComboBox MinWidth="132"
                VerticalAlignment="Center"
                ItemsSource="{Binding UidList}"
                SelectedItem="{Binding SelectUid, Mode=TwoWay}"
                PlaceholderText="{Binding Strings[Gacha.UidPlaceholder]}" />

      <!--
        GenshinBeyondGachaPage.xaml:64-96：更新记录 SplitButton（E72C + 「更新记录」），
        下拉是「更新 (保存的 URL) / 更新 (全部) / 输入 URL」。
        Avalonia 无 SplitButton，按 GachaPage 的约定拼成「主按钮 + 下拉按钮」。
      -->
      <Button Height="32" Padding="8,0" Command="{Binding UpdateGachaLogCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon" FontSize="14" Margin="0,2,0,0" Text="&#xE72C;" />
          <TextBlock Text="{Binding Strings[Gacha.UpdateRecords]}" />
        </StackPanel>
      </Button>
      <Button Height="32" Padding="6,0" Margin="-12,0,0,0">
        <TextBlock Classes="icon" FontSize="12" Text="&#xE70D;" />
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="{Binding Strings[Gacha.UpdateSavedUrl]}"
                      Command="{Binding UpdateGachaLogCommand}"
                      CommandParameter="cache" />
            <MenuItem Header="{Binding Strings[Gacha.UpdateAll]}"
                      Command="{Binding UpdateGachaLogCommand}"
                      CommandParameter="all" />
            <MenuItem Header="{Binding Strings[Gacha.InputUrl]}"
                      Click="OnShowInputUrlFlyout" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>

      <!-- GenshinBeyondGachaPage.xaml:97-161：设置按钮（E713）+ Flyout -->
      <Button Height="32" Padding="8,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="icon" FontSize="14" Margin="0,2,0,0" Text="&#xE713;" />
          <TextBlock Text="{Binding Strings[Gacha.Settings]}" />
        </StackPanel>
        <Button.Flyout>
          <Flyout>
            <StackPanel MinWidth="200" Spacing="8">
              <TextBlock FontSize="16" Text="{Binding Strings[Gacha.OtherSettings]}" />

              <!-- 复制 URL -->
              <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="OnCopyUrlClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="icon" FontSize="16" Text="&#xE8C8;" />
                  <TextBlock Text="{Binding Strings[Gacha.CopyUrl]}" />
                </StackPanel>
              </Button>

              <!-- Authkey Timeout 说明 + 打开缓存目录（Starward 的实现是打开 webCaches） -->
              <TextBlock Margin="0,8,0,0" Classes="secondary" Text="{Binding Strings[Gacha.AuthkeyTimeout]}" />
              <TextBlock Margin="0,-4,0,0"
                         FontSize="12"
                         Classes="secondary"
                         TextWrapping="Wrap"
                         Text="{Binding Strings[Gacha.RestartAfterDeletingCache]}" />
              <Button HorizontalAlignment="Stretch" Command="{Binding OpenCacheFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="icon" FontSize="16" Text="&#xEA99;" />
                  <TextBlock Text="{Binding Strings[Gacha.DeleteCacheFolder]}" />
                </StackPanel>
              </Button>

              <!-- 语言 -->
              <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="secondary" Text="{Binding Strings[Gacha.Language]}" />
                <Button Padding="1" VerticalAlignment="Bottom">
                  <TextBlock Classes="icon" FontSize="12" Text="&#xE9CE;" />
                  <Button.Flyout>
                    <Flyout>
                      <TextBlock Text="{Binding Strings[Gacha.LanguageDesc]}"
                                 TextWrapping="Wrap"
                                 MaxWidth="240" />
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
              <!-- 上游是 TextBox 双向绑定 GachaLanguage；LunarWard 只保留显示（请求固定 zh-cn） -->
              <TextBox MinWidth="100" Text="{Binding GachaLanguage, Mode=OneWay}" IsEnabled="False" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>

      <!-- GenshinBeyondGachaPage.xaml:162-166：材料统计 Pane（AccentButton、CornerRadius 14,0,0,14、Glyph E8A0） -->
      <Button Height="32"
              BorderThickness="0"
              CornerRadius="14,0,0,14"
              Command="{Binding OpenItemStatsPaneCommand}"
              IsEnabled="{Binding HasItemStats}"
              Background="{StaticResource StarAccentBackgroundBrush}">
        <TextBlock Classes="icon"
                   Margin="6,2,4,0"
                   FontSize="18"
                   Foreground="{StaticResource StarAccentForegroundBrush}"
                   Text="&#xE8A0;" />
      </Button>
    </StackPanel>


    <!-- ══ 空态（GenshinBeyondGachaPage.xaml:169-175） ═══════════════════ -->
    <!--
      Starward 用 Assets/Image/UI_EmotionIcon5.png 的 160×160 表情图；
      LunarWard 没有图片素材，用同尺寸字形占位（与 GachaPage 的处理一致）。
    -->
    <StackPanel Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                IsVisible="{Binding ShowEmptyState}">
      <TextBlock HorizontalAlignment="Center"
                 FontSize="120"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="&#xE7BA;" />
      <TextBlock HorizontalAlignment="Center"
                 FontSize="16"
                 Foreground="{StaticResource StarTextSecondary}"
                 Text="{Binding Strings[Gacha.NoRecords]}" />
    </StackPanel>


    <!-- ══ 内容区（GenshinBeyondGachaPage.xaml:178-586 SplitView） ════════ -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*">

      <!-- 状态行 + 错误条（LunarWard 追加，位置页头下方） -->
      <StackPanel Grid.Row="0"
                  Margin="20,4,20,8"
                  Spacing="8"
                  IsVisible="{Binding ShowStatusArea}">
        <TextBlock FontSize="12"
                   Foreground="{StaticResource StarTextSecondary}"
                   Text="{Binding StatusText}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasStatus}" />
        <Border Classes="infobar error" IsVisible="{Binding HasError}">
          <TextBlock FontSize="12"
                     Foreground="{StaticResource StarErrorBrush}"
                     Text="{Binding ErrorText}"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>

      <Border Grid.Row="1" CornerRadius="12,0,0,12" ClipToBounds="True">
        <SplitView DisplayMode="Overlay"
                   OpenPaneLength="508"
                   PanePlacement="Right"
                   PaneBackground="{StaticResource StarOverlayAcrylicBrush}"
                   IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
                   Background="Transparent">

          <!-- GenshinBeyondGachaPage.xaml:185-190：ScrollViewer + Grid Margin 20,0,20,16 ColumnSpacing 12 -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20,0,20,16" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>

              <!-- ── 常驻颂愿（1000） ───────────────────────────────── -->
              <Border Padding="12,8"
                      Background="{StaticResource StarOverlayAcrylicBrush}"
                      CornerRadius="8"
                      IsVisible="{Binding Card1000, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="4">
                  <!-- 标题 + 总抽数 -->
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Classes="beyond-text"
                               FontSize="16"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Card1000.Title}" />
                    <TextBlock Grid.Column="1" Classes="beyond-text" FontSize="16" Text="{Binding Card1000.CountText}" />
                  </Grid>

                  <!-- 起止时间 -->
                  <TextBlock Grid.Row="1"
                             Classes="beyond-text"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding Card1000.RangeText}" />

                  <!-- 分割线（MenuFlyoutSeparator） -->
                  <Border Grid.Row="2" Classes="divider" />

                  <!-- 四行统计：4★平均 / 4★统计 / 3★统计 / 2★统计 -->
                  <ItemsControl Grid.Row="3" ItemsSource="{Binding Card1000.Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GenshinBeyondGachaRowViewModel">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="beyond-text" Foreground="{Binding Brush}" Text="{Binding Label}" />
                          <TextBlock Grid.Column="1"
                                     Classes="beyond-text"
                                     Foreground="{Binding Brush}"
                                     Text="{Binding Value}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- 页签（Pivot + Segmented：4★ / 3★） -->
                  <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="4">
                    <Button Classes="beyond-tab"
                            Background="{Binding Card1000.Tab1Background}"
                            Click="OnSelectFirstTab"
                            ToolTip.Tip="{Binding Card1000.Tab1Text}">
                      <TextBlock Foreground="{Binding Card1000.Tab1Brush}" Text="{Binding Card1000.Tab1Text}" />
                    </Button>
                    <Button Classes="beyond-tab"
                            Background="{Binding Card1000.Tab2Background}"
                            Click="OnSelectSecondTab"
                            ToolTip.Tip="{Binding Card1000.Tab2Text}">
                      <TextBlock Foreground="{Binding Card1000.Tab2Brush}" Text="{Binding Card1000.Tab2Text}" />
                    </Button>
                  </StackPanel>

                  <!-- 保底列表 -->
                  <ScrollViewer Grid.Row="5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Card1000.VisibleList}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GenshinBeyondGachaPityRowViewModel">
                          <Grid Height="28" ColumnDefinitions="36,*,24" ToolTip.Tip="{Binding TimeText}">
                            <Border Grid.Column="1"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Background="{Binding Background}" />
                            <TextBlock Grid.Column="1"
                                       Margin="4,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource StarTextSecondary}"
                                       Text="{Binding Name}" />
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource StarTextSecondary}"
                                       Text="{Binding PityText}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>

              <!-- ── 活动颂愿（2000） ───────────────────────────────── -->
              <Border Grid.Column="1"
                      Padding="12,8"
                      Background="{StaticResource StarOverlayAcrylicBrush}"
                      CornerRadius="8"
                      IsVisible="{Binding Card2000, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="4">
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Classes="beyond-text"
                               FontSize="16"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Card2000.Title}" />
                    <TextBlock Grid.Column="1" Classes="beyond-text" FontSize="16" Text="{Binding Card2000.CountText}" />
                  </Grid>

                  <TextBlock Grid.Row="1"
                             Classes="beyond-text"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding Card2000.RangeText}" />

                  <Border Grid.Row="2" Classes="divider" />

                  <ItemsControl Grid.Row="3" ItemsSource="{Binding Card2000.Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GenshinBeyondGachaRowViewModel">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="beyond-text" Foreground="{Binding Brush}" Text="{Binding Label}" />
                          <TextBlock Grid.Column="1"
                                     Classes="beyond-text"
                                     Foreground="{Binding Brush}"
                                     Text="{Binding Value}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="4">
                    <Button Classes="beyond-tab"
                            Background="{Binding Card2000.Tab1Background}"
                            Click="OnSelectFirstTab"
                            ToolTip.Tip="{Binding Card2000.Tab1Text}">
                      <TextBlock Foreground="{Binding Card2000.Tab1Brush}" Text="{Binding Card2000.Tab1Text}" />
                    </Button>
                    <Button Classes="beyond-tab"
                            Background="{Binding Card2000.Tab2Background}"
                            Click="OnSelectSecondTab"
                            ToolTip.Tip="{Binding Card2000.Tab2Text}">
                      <TextBlock Foreground="{Binding Card2000.Tab2Brush}" Text="{Binding Card2000.Tab2Text}" />
                    </Button>
                  </StackPanel>

                  <ScrollViewer Grid.Row="5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Card2000.VisibleList}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GenshinBeyondGachaPityRowViewModel">
                          <Grid Height="28" ColumnDefinitions="36,*,24" ToolTip.Tip="{Binding TimeText}">
                            <Border Grid.Column="1"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Background="{Binding Background}" />
                            <TextBlock Grid.Column="1"
                                       Margin="4,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource StarTextSecondary}"
                                       Text="{Binding Name}" />
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource StarTextSecondary}"
                                       Text="{Binding PityText}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
          </ScrollViewer>

          <!-- GenshinBeyondGachaPage.xaml:589-634：Pane = 材料统计（80×97 卡片，图标 + 次数） -->
          <SplitView.Pane>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <Border Padding="24,12">
                <ItemsControl ItemsSource="{Binding ItemStats}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GenshinBeyondGachaItemCardViewModel">
                      <Grid Width="80" Height="97" Margin="4,2">
                        <!--
                          Starward 用 RarityToGIBgConverter 的稀有度底图 + CachedImage 图标；
                          素材缺失：保留 80×97 卡片，用稀有度色半透明底 + 名称 + 次数占位。
                        -->
                        <Border Background="{Binding Background}" CornerRadius="4" />
                        <TextBlock Margin="4,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxLines="3"
                                   Foreground="{StaticResource StarTextSecondary}"
                                   Text="{Binding Name}" />
                        <TextBlock Margin="0,0,0,3"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   FontSize="12"
                                   Foreground="#84603D"
                                   Text="{Binding CountText, StringFormat='{}{0} 次'}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </ScrollViewer>
          </SplitView.Pane>
        </SplitView>
      </Border>
    </Grid>
  </Grid>
</UserControl>
