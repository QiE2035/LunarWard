<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LunarWard.App.ViewModels"
        x:Class="LunarWard.App.Views.AccountWindow"
        x:DataType="vm:AccountViewModel"
        Title="{Binding Title}"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

  <!--
    与 Starward 的 ContentDialog 同款外观：无边框 + 亚克力卡片。
    上游用 ContentDialog 展示账号列表（保存/切换/重命名/删除），Avalonia 没有
    ContentDialog，沿用 DeleteGachaLogDialog / InstallGameDialog 的无边框窗口。
  -->

  <Border Background="{StaticResource StarAcrylicBrush}"
          BorderThickness="1"
          BorderBrush="#14FFFFFF"
          CornerRadius="8"
          BoxShadow="0 16 48 0 #99000000">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="12">

      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock FontSize="20" Text="{Binding Title}" />
        <TextBlock Classes="status" Text="{Binding CurrentAccountText}" TextWrapping="Wrap" />
        <TextBlock Classes="status" FontSize="11" Text="{Binding Prefix}" TextWrapping="Wrap" />
        <TextBlock Classes="status" Text="{Binding StatusText}" TextWrapping="Wrap" />
        <TextBlock Classes="error" Text="{Binding ErrorText}" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <Border Grid.Row="1" Classes="card" MaxHeight="320">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Classes="toolbar" Content="保存当前账号" Command="{Binding SaveCurrentCommand}" />
            <Button Classes="toolbar" Content="切换到选中" Command="{Binding SwitchCommand}" />
            <Button Classes="toolbar" Content="重命名" Command="{Binding RenameCommand}" />
            <Button Classes="toolbar" Content="删除" Command="{Binding DeleteCommand}" />
            <Button Classes="toolbar" Content="刷新" Command="{Binding ReloadCommand}" />
          </StackPanel>

          <ListBox Grid.Row="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}"
                   Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SavedAccountViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <StackPanel Grid.Column="0" Spacing="1">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Detail}" Classes="status" FontSize="11" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="status" FontSize="11" Text="{Binding SavedAt}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Classes="status"
                   FontSize="11"
                   MaxWidth="360"
                   TextWrapping="Wrap"
                   Text="账号数据里含 cookie 明文，只保存在本机 LunarWardDatabase.db 的 GameAccount 表（权限 0600），不会上传、不写日志。切换前请先退出游戏。" />
        <Button Grid.Column="1"
                Classes="accent"
                Click="OnCloseClick"
                Content="关闭"
                HorizontalAlignment="Right" />
      </Grid>
    </Grid>
  </Border>
</Window>
