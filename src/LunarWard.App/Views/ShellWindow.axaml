<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LunarWard.App.ViewModels"
        x:Class="LunarWard.App.Views.ShellWindow"
        x:DataType="vm:EnvironmentShellViewModel"
        Title="{Binding Title}"
        Width="980" Height="620"
        Background="#101418">

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <Border Grid.Row="0" Classes="topbar">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="{Binding Title}" Classes="title" />
          <TextBlock Text="{Binding Prefix}" Classes="status" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Classes="toolbar" Content="导出 env.sh" Command="{Binding ExportEnvCommand}" />
      </Grid>
    </Border>

    <!-- 命令预设 -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                  Background="#88101418">
      <ItemsControl ItemsSource="{Binding CommandPresets}" Margin="10,8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Button Classes="toolbar" Content="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- 终端 -->
    <Border Grid.Row="2" Background="#0B0E12">
      <Panel>
        <TextBlock x:Name="TerminalHint" Classes="status" Margin="16"
                   Text="正在启动终端…（若长时间无输出，说明 PTY 创建失败，可在下方查看导出脚本）" />
        <!-- 终端控件由 code-behind 注入：Iciclecreek.Terminal.TerminalView -->
        <ContentControl x:Name="TerminalHost" />
      </Panel>
    </Border>

    <Border Grid.Row="3" Background="#88101418" Padding="10">
      <TextBlock Text="{Binding ErrorText}" Classes="status" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
