<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LunarWard.App.ViewModels"
        x:Class="LunarWard.App.Views.GachaWindow"
        x:DataType="vm:GachaViewModel"
        Title="{Binding Title}"
        Width="980" Height="680"
        Background="#101418">

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="{Binding Title}" Classes="title" />
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBox Grid.Column="0" Text="{Binding GachaUrl}" PlaceholderText="抽卡链接（从游戏网页缓存自动定位）" />
        <Button Grid.Column="1" Classes="toolbar" Content="重新定位" Command="{Binding RelocateCommand}" Margin="8,0,0,0" />
        <Button Grid.Column="2" Classes="toolbar" Content="读取记录" Command="{Binding FetchCommand}" Margin="8,0,0,0" />
        <Button Grid.Column="3" Classes="toolbar" Content="导出 JSON" Command="{Binding ExportJsonCommand}" Margin="8,0,0,0" />
      </Grid>
      <TextBlock Text="{Binding StatusText}" Classes="status" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ErrorText}" Classes="error" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Text="{Binding SummaryText}" Classes="status" FontWeight="SemiBold" />
    </StackPanel>

    <!-- 卡池统计 -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10">
      <ItemsControl ItemsSource="{Binding Pools}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:GachaPoolViewModel">
            <Border Classes="card" MinWidth="220">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Pulls}" Classes="status" />
                <TextBlock Text="{Binding FiveStars}" Classes="status" />
                <TextBlock Text="{Binding Pity}" Classes="status" />
                <TextBlock Text="{Binding Average}" Classes="status" />
                <TextBlock Text="{Binding PityHistory}" Classes="status" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- 记录列表 -->
    <Border Grid.Row="2" Classes="card">
      <Grid RowDefinitions="Auto,*">
        <CheckBox Grid.Row="0" IsChecked="{Binding FiveStarsOnly}" Content="只看 5 星" Margin="0,0,0,8" />
        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Records}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GachaRecordViewModel">
                <Grid ColumnDefinitions="110,60,*,140,180" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Stars}" Foreground="#FFD54F" />
                  <TextBlock Grid.Column="1" Text="{Binding ItemType}" Classes="status" />
                  <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding Pool}" Classes="status" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="4" Text="{Binding Time}" Classes="status" FontSize="11" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <TextBlock Grid.Row="3" Classes="status" Margin="0,8,0,0" TextWrapping="Wrap"
               Text="提示：抽卡链接来自游戏的网页缓存。若提示找不到链接，请先在游戏内打开一次「祈愿 / 调频」页面，再点『重新定位』。" />
  </Grid>
</Window>
