<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LunarWard.App.ViewModels"
        x:Class="LunarWard.App.Views.ScreenshotWindow"
        x:DataType="vm:ScreenshotViewModel"
        Title="{Binding Title}"
        Width="1040" Height="680"
        Background="#101418">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="10">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
      <StackPanel Grid.Column="0" Spacing="3">
        <TextBlock Text="{Binding Title}" Classes="title" />
        <TextBlock Text="{Binding StatusText}" Classes="status" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ErrorText}" Classes="error" TextWrapping="Wrap"
                   IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="toolbar" Content="刷新" Command="{Binding ReloadCommand}" VerticalAlignment="Top" />
      <Button Grid.Column="2" Classes="toolbar" Content="导出选中" Command="{Binding ExportSelectedCommand}"
              VerticalAlignment="Top" Margin="8,0,0,0" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="12">

      <!-- 列表（延迟解码，只显示文件名与时间） -->
      <Border Grid.Column="0" Classes="card" Padding="6">
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ScreenshotItemViewModel">
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Time}" Classes="status" FontSize="11" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- 预览 -->
      <Border Grid.Column="1" Classes="card">
        <Panel>
          <Image Source="{Binding Selected.Preview}" Stretch="Uniform" />
          <TextBlock Text="选中左侧任意一张截图即可预览" Classes="status"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}" />
        </Panel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Classes="status" TextWrapping="Wrap"
               Text="截图目录由游戏自己写入（原神/绝区零为 &lt;游戏目录&gt;/ScreenShot，星穹铁道为 StarRail_Data/ScreenShots）。本页只读，导出会复制到 ~/Pictures/LunarWard。" />
  </Grid>
</Window>
