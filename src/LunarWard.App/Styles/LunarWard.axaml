<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    LunarWard 视觉基调对齐 Starward（Fluent / WinUI 3）：
    CornerRadius 是 Starward 用得最多的视觉属性（371 次），
    ThemeShadow → DropShadowEffect（跨平台一致），
    Acrylic → 半透明渐变层（L2，见 docs/04-FEATURES.md §5.6）。
  -->

  <Styles.Resources>
    <ResourceDictionary>
      <Color x:Key="LunarWardAccentColor">#4FC3F7</Color>
      <SolidColorBrush x:Key="LunarWardAccentBrush" Color="#4FC3F7" />
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="#CC1A1F2A" />
      <SolidColorBrush x:Key="CardBorderBrush" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="SubtleTextBrush" Color="#99FFFFFF" />

      <x:Double x:Key="CardCornerRadius">10</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- 卡片（Fluent Modern 主题的基本单位） -->
  <Style Selector="Border.card">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Effect">
      <DropShadowEffect BlurRadius="24" OffsetX="0" OffsetY="6" Opacity="0.45" Color="#000000" />
    </Setter>
  </Style>

  <!-- 主启动按钮 -->
  <Style Selector="Button.launch">
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="Padding" Value="44,14" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="#E64FC3F7" />
    <Setter Property="Foreground" Value="#FF08131A" />
  </Style>

  <Style Selector="Button.launch:pointerover">
    <Setter Property="Background" Value="#FF7FD8FF" />
  </Style>

  <Style Selector="Button.launch:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="Button.toolbar">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Background" Value="#33FFFFFF" />
  </Style>

  <!-- 顶部栏 -->
  <Style Selector="Border.topbar">
    <Setter Property="Background" Value="#99101418" />
    <Setter Property="Padding" Value="16,10" />
  </Style>

  <!-- 状态文字 -->
  <Style Selector="TextBlock.status">
    <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="#FFFF8A80" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Classic 主题：去掉卡片边框与背景，让背景图铺满 -->
  <Style Selector="Window.classic Border.card">
    <Setter Property="Background" Value="#66101418" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Effect" Value="{x:Null}" />
  </Style>

</Styles>
