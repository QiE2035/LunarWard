<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="DialogHost.Avalonia" Version="0.12.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Iciclecreek.Avalonia.Terminal" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Ini" Version="10.0.11" />
    <PackageVersion Include="Polly" Version="8.7.0" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageVersion Include="Serilog" Version="4.2.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- 上游 src/Starward/Starward.csproj 用 Dapper 2.1.79；本仓库同步引入以对齐 Features/Database 的写法。 -->
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="MiniExcel" Version="1.46.0" />
    <!-- 上游 Starward.Setup（安装器，SharpCompress 0.50.4）解压 7z/zip；本仓库安装器同用。 -->
    <PackageVersion Include="SharpCompress" Version="0.50.4" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.11" />
    <!-- 上游 HEAD 的 src/Starward/Helpers/FileCache.cs 用 ZiggyCreatures.Caching.Fusion，
         但上游 Starward.csproj 漏了 PackageReference（HEAD df8ae07 提交『filecache powered by fusioncache』
         未同步依赖，属上游缺陷）。这里按代码需要补上，版本取 2.x 最新稳定。 -->
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.9.0" />

  </ItemGroup>

  <ItemGroup Label="Assets">
    <!--
      Starward 的品牌素材（游戏图标、区服 logo、字体等）不在源码仓库里，而是打包成
      内容包发布（package.json 的 contentFiles 全部 copyToOutput=true，还原后落到
      输出目录 Assets/ 下）。LunarWard 引用同一个包来复刻区服 logo。
      版本与上游 Starward HEAD 对齐：src/Starward/Starward.csproj 的 0.6.5。
    -->
    <PackageVersion Include="Starward.Assets" Version="0.6.5" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
