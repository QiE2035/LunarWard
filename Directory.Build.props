<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      上游 Starward.Core 有大量 CS8618，逐条修会破坏"只改三处"的约束。
      NU1900 = 取不到 NuGet 漏洞数据（只读缓存/离线 CI/镜像源没有漏洞库时必然出现），
      是环境问题而非代码问题；审计本身仍开着，真实漏洞（NU1901–NU1904）照常报。
    -->
    <!--
      NoWarn 只剩三族，其余全部放开：
      ① CS8618：上游 Starward.Core 的模型属性大量未初始化，逐条修违背"只改三处"约束（审计 M-06 待办）；
      ② CA1416：仅剩主程序 `EnvironmentShellViewModel` 的 `File.SetUnixFileMode` 已用
         `OperatingSystem.IsLinux()` 守卫；测试程序集整体标注 `[assembly: SupportedOSPlatform("linux")]`。
      ③ NU1900：离线/镜像环境取不到漏洞库的环境噪音，NU1901–NU1904 真实漏洞仍会报。
      CS8600/CS8602/CS8603/CS8604/CS8625 已于 2026-10-25 全量修完（9 处），不再压制。
    -->
    <NoWarn>$(NoWarn);CS8618;NU1900</NoWarn>
    <EnableWindowsTargeting>false</EnableWindowsTargeting>

  </PropertyGroup>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
