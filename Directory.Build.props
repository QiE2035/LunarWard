<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      上游 Starward.Core 有大量 CS8618，逐条修会破坏"只改三处"的约束。
      NU1900 = 取不到 NuGet 漏洞数据（只读缓存/离线 CI/镜像源没有漏洞库时必然出现），
      是环境问题而非代码问题；审计本身仍开着，真实漏洞（NU1901–NU1904）照常报。
    -->
    <!--
      NoWarn 现在只剩 CS8618（上游移植模型的非空引用属性未标注，待单独批次收敛）：
      CA1416 已通过程序集级 SupportedOSPlatform("linux") + OperatingSystem.IsLinux() 守卫解决；
      CS8600/8602/8603/8604/8625 已于 2026-10-25 全量修完（9 处）；NU1900 已解除压制。
    -->
    <NoWarn>$(NoWarn);CS8618</NoWarn>
    <!-- NU1900（漏洞库取不到）已不再压制：联机时可正常审计；离线开发用 no-restore 构建。 -->
    <EnableWindowsTargeting>false</EnableWindowsTargeting>

  </PropertyGroup>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
